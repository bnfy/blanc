    "heading": {
      "kind": "title1",
      "maxW": 8000,
      "text": "Blanc for iPhone 1.0 · App Store screenshots, dawn to day",
      "w": 240,
      "x": 0,
      "y": -420
    },
    "howto": {
      "size": 40,
      "text": "Each artboard is one 6.9-inch App Store screenshot (1320 × 2868), in order. Retype a headline or subtitle in place; every caption must pass docs/marketing-claims.md before it goes to Apple. The phone screens are real captures from Blanc for iPhone, made by npm run ios:app-store-screenshots; never draw or edit them. When this canvas changes, ask Claude to pull it into docs/ios/app-store/design/ and re-render the 6.9-inch and 6.3-inch sets.",
      "w": 1320,
      "x": 0,
      "y": 3040
    },
    "cpp-companion-heading": {
      "kind": "title1",
      "maxW": 8000,
      "page": "cpp-companion",
      "text": "Custom product page · Blanc on your computer",
      "w": 240,
      "x": 0,
      "y": -420
    },
    "cpp-companion-about": {
      "page": "cpp-companion",
      "size": 40,
      "w": 2640,
      "x": 0,
      "y": 3040,
      "text": "For: People who already use Blanc on a Mac or PC: blanc.day's iPhone links, the desktop app's Connect your iPhone, What's New pages, the newsletter and r/blancbrowser.\n\nPromotional text (160/170): Use Blanc on your Mac or PC? Scan the code in its Settings → Sync, and your computer’s tabs, the pages it sends and the Spaces you share are on your iPhone too.\n\nThe same captures and sky as the default page, in this page's order. Every caption must pass docs/marketing-claims.md; see the Custom product pages section of docs/ios/app-store-listing.md."
    },
    "cpp-spaces-and-groups-heading": {
      "kind": "title1",
      "maxW": 8000,
      "page": "cpp-spaces-and-groups",
      "text": "Custom product page · Spaces and groups",
      "w": 240,
      "x": 0,
      "y": -420
    },
    "cpp-spaces-and-groups-about": {
      "page": "cpp-spaces-and-groups",
      "size": 40,
      "w": 2640,
      "x": 0,
      "y": 3040,
      "text": "For: People who keep a lot of tabs and want them sorted: blanc.day's Spaces and Arc alternative pages, and posts about organizing tabs.\n\nPromotional text (158/170): Give each part of your day a Space, like Work or Trip. Keep tabs that belong together in named groups, and share a Space to keep it the same on your computer.\n\nThe same captures and sky as the default page, in this page's order. Every caption must pass docs/marketing-claims.md; see the Custom product pages section of docs/ios/app-store-listing.md."
    },
    "cpp-private-heading": {
      "kind": "title1",
      "maxW": 8000,
      "page": "cpp-private",
      "text": "Custom product page · Private browsing",
      "w": 240,
      "x": 0,
      "y": -420
    },
    "cpp-private-about": {
      "page": "cpp-private",
      "size": 40,
      "w": 2640,
      "x": 0,
      "y": 3040,
      "text": "For: People looking for a private browser: blanc.day's private tabs and privacy pages, and privacy-minded communities.\n\nPromotional text (165/170): Private tabs keep no history, and their cookies and site data go when the last one closes. Ads and trackers are blocked by default, and Sync is end-to-end encrypted.\n\nThe same captures and sky as the default page, in this page's order. Every caption must pass docs/marketing-claims.md; see the Custom product pages section of docs/ios/app-store-listing.md."
    }
  },
