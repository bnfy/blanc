{
  "$note": "Single source of truth for Blanc design tokens (substrate S2). Desktop CSS (styles.css chrome + overlay, pages.css internal pages) is guarded against drift from this file by `npm run tokens:check`; the mobile Swift/Kotlin token files in tokens/generated/ are emitted from it by `npm run tokens:build`. Edit values HERE, then run build + check. A token is themed when it has light/dark/private values; otherwise it carries a single `common` value emitted only in :root. A token whose only consumer is the virtual `mobile` consumer (no desktop CSS file) is emitted to Swift/Kotlin only and skipped by the CSS guard and the reference tokens.css.",
  "themes": ["light", "dark", "private"],
  "consumers": {
    "chrome": "src/renderer/styles.css",
    "pages": "src/renderer/pages/pages.css"
  },
  "virtualConsumers": {
    "mobile": "iOS/Android only (native Island geometry, D27) — no desktop CSS file, so no drift guard; emitted to Tokens.swift / Tokens.kt only"
  },
  "tokens": [
    { "name": "bg",             "group": "color", "consumers": ["chrome", "pages"], "values": { "light": "#ffffff", "dark": "#0e0e0e", "private": "#0a0a0a" } },
    { "name": "surface",        "group": "color", "consumers": ["chrome", "pages"], "values": { "light": "#f7f7f7", "dark": "#171717", "private": "#131313" } },
    { "name": "surface-raised", "group": "color", "consumers": ["chrome", "pages"], "values": { "light": "#ffffff", "dark": "#1f1f1f", "private": "#191919" } },
    { "name": "island-resting-surface", "group": "color", "consumers": ["chrome"], "values": { "light": "rgba(255,255,255,.94)", "dark": "rgba(31,31,31,.94)", "private": "rgba(25,25,25,.94)" } },
    { "name": "border",         "group": "color", "consumers": ["chrome", "pages"], "values": { "light": "#dedede", "dark": "#2e2e2e", "private": "#333333" } },
    { "name": "text",           "group": "color", "consumers": ["chrome", "pages"], "values": { "light": "#0e0e0e", "dark": "#f5f5f5", "private": "#f5f5f5" } },
    { "name": "text-dim",       "group": "color", "consumers": ["chrome", "pages"], "values": { "light": "#6b6b6b", "dark": "#9c9c9c", "private": "#9c9c9c" } },
    { "name": "accent",         "group": "color", "consumers": ["chrome", "pages"], "values": { "light": "#111111", "dark": "#f5f5f5", "private": "#f5f5f5" } },
    { "name": "accent-dim",     "group": "color", "consumers": ["chrome", "pages"], "values": { "light": "rgba(17, 17, 17, 0.08)", "dark": "rgba(245, 245, 245, 0.12)", "private": "rgba(245, 245, 245, 0.12)" } },
    { "name": "danger",         "group": "color", "consumers": ["chrome", "pages"], "values": { "light": "#ff3b30", "dark": "#ff453a", "private": "#ff453a" } },
    { "name": "on-danger",      "group": "color", "consumers": ["chrome", "pages"], "values": { "light": "#ffffff", "dark": "#0e0e0e", "private": "#0a0a0a" } },

    { "name": "font-ui",        "group": "type", "consumers": ["chrome", "pages"], "values": { "common": "\"Inter\", -apple-system, \"Segoe UI Variable\", \"Segoe UI\", system-ui, sans-serif" } },
    { "name": "font-mono",      "group": "type", "consumers": ["chrome", "pages"], "values": { "common": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", \"Cascadia Code\", Menlo, Consolas, monospace" } },
    { "name": "font-kbd",       "group": "type", "consumers": ["chrome", "pages"], "values": { "common": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif" } },

    { "name": "shadow-popover", "group": "shadow", "consumers": ["chrome"], "values": { "common": "inset 0 1px 0 rgba(255,255,255,0.55), inset 0 -6px 10px -8px rgba(14,14,14,0.12), inset 0 -1px 0 rgba(14,14,14,0.035), 0 10px 44px -4px rgba(14,14,14,0.12)" } },
    { "name": "shadow-pill",    "group": "shadow", "consumers": ["chrome"], "values": { "common": "inset 0 1px 0 rgba(255,255,255,0.65), inset 1px 0 0.5px -0.5px rgba(255,255,255,0.28), inset -1px 0 0.5px -0.5px rgba(255,255,255,0.28), inset 0 -5px 7px -6px rgba(14,14,14,0.16), inset 0 -1px 0 rgba(14,14,14,0.045), 0 2px 16px -3px rgba(14,14,14,0.10)" } },
    { "name": "shadow-island-resting", "group": "shadow", "consumers": ["chrome"], "values": { "common": "inset 0 1px 0 rgba(255,255,255,.72), inset 0 -1px 0 rgba(14,14,14,.035), 0 5px 18px -12px rgba(14,14,14,.24)" } },
    { "name": "strip-h",        "group": "geometry", "consumers": ["chrome"], "values": { "common": "68px" } },
    { "name": "pill-zoom",      "group": "geometry", "consumers": ["chrome"], "values": { "common": "1.15" } },
    { "name": "radius",         "group": "geometry", "consumers": ["chrome", "pages"], "values": { "common": "6px" } },
    { "name": "island-resting-height", "group": "geometry", "consumers": ["chrome"], "values": { "common": "44px" } },
    { "name": "island-resting-radius", "group": "geometry", "consumers": ["chrome"], "values": { "common": "17px" } },
    { "name": "island-panel-radius", "group": "geometry", "consumers": ["chrome"], "values": { "common": "18px" } },

    { "name": "island-readout-height", "group": "geometry", "consumers": ["mobile"], "comment": "The horizontal readout capsule on iPhone Duo's vertical-control postures (D27); matches the desktop resting height so the two read as one Island.", "values": { "common": "44px" } },
    { "name": "island-readout-radius", "group": "geometry", "consumers": ["mobile"], "comment": "Half the readout height: a true capsule.", "values": { "common": "22px" } },
    { "name": "island-dot-size",       "group": "geometry", "consumers": ["mobile"], "comment": "Tab dot diameter for the mobile pill and the vertical dots item; matches the desktop .island-dot (6px).", "values": { "common": "6px" } },
    { "name": "island-dot-gap",        "group": "geometry", "consumers": ["mobile"], "comment": "Spacing between tab dots in either axis.", "values": { "common": "6px" } },

    { "name": "select-caret",   "group": "asset", "consumers": ["pages"], "comment": "File, not data: URI — the pages' CSP has no img-src data: allowance, and CSS can't recolor a background image, hence one SVG per theme.", "values": { "light": "url(\"select-caret.svg\")", "dark": "url(\"select-caret-dark.svg\")", "private": "url(\"select-caret-dark.svg\")" } }
  ]
}
