{
  "name": "blanc",
  "productName": "Blanc",
  "version": "1.27.0",
  "description": "Minimal Electron browser shell: custom chrome UI + built-in ad/tracker blocking, no extension-store dependency.",
  "main": "src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "postinstall": "node adblock/seed.mjs --prepare",
    "start": "electron .",
    "predist": "npm run brand:check && npm run icons:windows:check && node scripts/preflight-mac-signing.mjs",
    "dist": "electron-builder",
    "predist:dir": "npm run brand:check && npm run icons:windows:check && node scripts/preflight-mac-signing.mjs",
    "dist:dir": "electron-builder --dir",
    "release": "scripts/release.sh",
    "site:changelog": "node scripts/generate-site-changelog.mjs",
    "site:changelog:check": "node scripts/generate-site-changelog.mjs --check",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm run brand:check && npm --prefix site run build",
    "site:deploy": "npm run site:build && npx wrangler pages deploy site/dist --project-name=blancbrowser --branch=main",
    "test:unit": "node --test test/unit/*.test.js",
    "test:shield-provider:desktop": "node test/desktop/shield-provider.mjs",
    "test:ublock:desktop": "node test/desktop/ublock-origin.mjs",
    "test:ublock-retirement:desktop": "node test/desktop/ublock-retirement.mjs",
    "test:ublock-unavailable:desktop": "node test/desktop/ublock-retirement.mjs --unavailable",
    "test:ublock-noscript:desktop": "node test/desktop/ublock-noscript.mjs",
    "test:ublock-noscript:packaged": "node test/desktop/packaged-ublock-noscript.mjs",
    "test:ublock:installed": "node test/desktop/packaged-ublock-acceptance.mjs",
    "ublock:check": "node scripts/check-ublock-package.cjs && node scripts/build-ublock-adaptation.cjs",
    "ublock:distribution": "node scripts/check-ublock-distribution.cjs",
    "test:mouse-gestures:desktop": "node test/desktop/mouse-gestures.mjs",
    "test:oauth:desktop": "node --test test/oauth/desktop.test.js",
    "test:modified-links:desktop": "node test/desktop/modified-link-click-smoke.mjs",
    "test:oauth:live": "node scripts/oauth-canary.js",
    "test:acceptance:dry": "cucumber-js -c test/desktop/cucumber.mjs -p dry",
    "test:acceptance:desktop": "cucumber-js -c test/desktop/cucumber.mjs -p runnable",
    "test:workspaces:desktop": "cucumber-js -c test/desktop/cucumber.mjs -p runnable --tags @workspace",
    "test:onepassword:utility": "node test/desktop/onepassword-utility-smoke.mjs",
    "test:onepassword:live-server": "node scripts/onepassword-live-gate-server.mjs",
    "test:dns-smoke": "node test/desktop/dns-smoke.mjs",
    "test:mahjong-standalone": "node test/desktop/mahjong-standalone-smoke.mjs",
    "test:favorites-picker:desktop": "node test/desktop/favorites-folder-picker-smoke.mjs",
    "test:wallpaper:desktop": "node test/desktop/newtab-wallpaper-smoke.mjs",
    "test:dark-websites:desktop": "node test/desktop/dark-websites-smoke.mjs",
    "capture:start-page:installed": "node scripts/capture-installed-start-page.mjs",
    "capture:mahjong:installed": "node scripts/capture-installed-mahjong.mjs",
    "test:tab-handoff": "node test/desktop/tab-handoff-smoke.mjs",
    "test:packaged:tab-handoff-protocol": "node test/desktop/packaged-tab-handoff-protocol-smoke.mjs",
    "test:cold-launch": "node test/desktop/cold-launch-smoke.mjs",
    "test:external-links": "node test/desktop/external-links-smoke.mjs",
    "test:web-store-guard": "npm run test:web-store",
    "test:startup-layout": "node test/desktop/startup-layout-smoke.mjs",
    "test:window-state": "node test/desktop/window-state-persistence-smoke.mjs",
    "test:recovery-reopen": "node test/desktop/startup-layout-smoke.mjs --reopened-window",
    "test:recovery-lifecycle": "node test/desktop/startup-recovery-lifecycle-smoke.mjs",
    "test:window-close-quit": "node test/desktop/window-close-quit-smoke.mjs",
    "test:packaged:external-links": "node test/desktop/packaged-external-links-smoke.mjs",
    "test:packaged:first-run": "node test/desktop/packaged-first-run-smoke.mjs",
    "test:packaged:migration": "node test/desktop/packaged-migration-smoke.mjs",
    "test:packaged:workspaces": "node test/desktop/packaged-workspace-recovery-smoke.mjs",
    "test:packaged:regressions": "node test/desktop/release-regressions-smoke.mjs",
    "test:packaged:native-media": "node test/desktop/packaged-native-media-smoke.mjs",
    "test:packaged:native-camera": "node test/desktop/packaged-native-media-smoke.mjs --media=camera",
    "test:packaged:favicons-live": "node test/desktop/packaged-live-favicons-smoke.mjs",
    "test:packaged:update-staging": "node test/desktop/packaged-update-staging-smoke.mjs",
    "test:packaged:update-staging:linux": "node test/desktop/packaged-update-staging-linux.mjs",
    "update:staging:prepare": "node scripts/prepare-staging-update-feed.mjs",
    "compliance:build": "node scripts/generate-compliance.mjs",
    "compliance:check": "node scripts/generate-compliance.mjs --check",
    "compatibility:build": "node scripts/compatibility-check.mjs --write",
    "compatibility:check": "node scripts/compatibility-check.mjs --check",
    "bench:memory": "node bench/memory/run.js",
    "security:dependencies": "node scripts/audit-dependencies.mjs",
    "release:security": "npm audit --omit=dev --audit-level=high",
    "release:verify:press": "npm run substrate:check && npm run icons:windows:check && npm run test:unit && npm run test:acceptance:dry && npm run test:acceptance:desktop && npm run test:favorites-picker:desktop && npm run test:wallpaper:desktop && npm run test:cold-launch && npm run test:browser-shortcuts:desktop && npm run test:web-store && npm run test:oauth:desktop && npm run test:modified-links:desktop && npm run test:dns-smoke && npm run release:security && npm run site:build",
    "icons:windows:build": "node scripts/build-windows-icons.js",
    "icons:windows:check": "node scripts/build-windows-icons.js --check",
    "brand:build": "node scripts/build-brand-assets.js",
    "brand:check": "node scripts/build-brand-assets.js --check",
    "adblock:build": "node adblock/build.mjs && node adblock/seed.mjs",
    "adblock:check": "node adblock/build.mjs --check && node adblock/seed.mjs --check",
    "tokens:build": "node tokens/build.mjs",
    "tokens:check": "node tokens/build.mjs --check",
    "darkreader:build": "node dark-reader/build.mjs",
    "darkreader:check": "node dark-reader/build.mjs --check",
    "settings:build": "node settings-schema/build.mjs",
    "settings:check": "node settings-schema/build.mjs --check",
    "copy:build": "node copy/build.mjs",
    "copy:check": "node copy/build.mjs --check",
    "browser-api:build": "node browser-api/build.mjs",
    "browser-api:check": "node browser-api/build.mjs --check",
    "substrate:check": "npm run brand:check && npm run tokens:check && npm run settings:check && npm run copy:check && npm run browser-api:check && npm run adblock:check && npm run darkreader:check && npm run ublock:check && npm run compliance:check && npm run compatibility:check",
    "lint": "eslint \"src/**/*.js\" \"cloudflare/**/src/**/*.js\" --max-warnings 0",
    "test:ublock-dashboard:desktop": "node test/desktop/ublock-dashboard.mjs",
    "runtime:check": "node scripts/preflight-electron-runtime.js",
    "test:browser-shortcuts:desktop": "node test/desktop/browser-shortcuts-smoke.mjs",
    "test:web-store": "node test/desktop/chrome-web-store-smoke.mjs",
    "test:web-store:runtime": "node test/desktop/chrome-web-store-runtime-probe.mjs",
    "prestart": "npm run runtime:check",
    "pretest:mouse-gestures:desktop": "npm run runtime:check",
    "pretest:oauth:desktop": "npm run runtime:check",
    "pretest:modified-links:desktop": "npm run runtime:check",
    "pretest:acceptance:dry": "npm run runtime:check",
    "pretest:acceptance:desktop": "npm run runtime:check",
    "pretest:workspaces:desktop": "npm run runtime:check",
    "pretest:onepassword:utility": "npm run runtime:check",
    "pretest:dns-smoke": "npm run runtime:check",
    "pretest:mahjong-standalone": "npm run runtime:check",
    "pretest:favorites-picker:desktop": "npm run runtime:check",
    "pretest:wallpaper:desktop": "npm run runtime:check",
    "pretest:tab-handoff": "npm run runtime:check",
    "pretest:packaged:tab-handoff-protocol": "npm run runtime:check",
    "pretest:cold-launch": "npm run runtime:check",
    "pretest:external-links": "npm run runtime:check",
    "pretest:startup-layout": "npm run runtime:check",
    "pretest:window-state": "npm run runtime:check",
    "pretest:recovery-reopen": "npm run runtime:check",
    "pretest:recovery-lifecycle": "npm run runtime:check",
    "pretest:window-close-quit": "npm run runtime:check",
    "pretest:packaged:external-links": "npm run runtime:check",
    "pretest:packaged:first-run": "npm run runtime:check",
    "pretest:packaged:migration": "npm run runtime:check",
    "pretest:packaged:workspaces": "npm run runtime:check",
    "pretest:packaged:regressions": "npm run runtime:check",
    "pretest:packaged:native-media": "npm run runtime:check",
    "pretest:packaged:native-camera": "npm run runtime:check",
    "pretest:packaged:favicons-live": "npm run runtime:check",
    "pretest:packaged:update-staging": "npm run runtime:check",
    "pretest:packaged:update-staging:linux": "npm run runtime:check",
    "pretest:browser-shortcuts:desktop": "npm run runtime:check",
    "pretest:web-store": "npm run runtime:check",
    "pretest:web-store:runtime": "npm run runtime:check",
    "test:packaged:browser-compatibility": "node test/desktop/packaged-browser-compatibility-smoke.mjs",
    "pretest:packaged:browser-compatibility": "npm run runtime:check"
  },
  "author": "",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@electron/asar": "4.3.0",
    "@eslint/js": "10.0.1",
    "@ghostery/adblocker": "^2.18.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@1password/sdk": "0.5.0",
    "@ghostery/adblocker-electron": "^2.18.2",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "me.bnfy.bowser",
    "productName": "Blanc",
    "publish": {
      "provider": "github",
      "owner": "bnfy",
      "repo": "blanc",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "protocols": [
      {
        "name": "Web URL",
        "schemes": [
          "http",
          "https"
        ],
        "role": "Viewer"
      },
      {
        "name": "Blanc Tab Handoff",
        "schemes": [
          "blanc-import"
        ],
        "role": "Viewer"
      }
    ],
    "files": [
      "src/**/*",
      "!src/renderer/pages/icon.svg",
      "!src/renderer/pages/icon-{paper,ink,graphite,default,midnight,cream,forest,sage,ember,plum,gold}.png",
      "adblock/sources/**/*",
      "ublock/**/*",
      "scripts/check-ublock-package.cjs",
      "scripts/build-ublock-adaptation.cjs",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "ASSET-LICENSE.md"
    ],
    "afterPack": "scripts/after-pack-app-icons.js",
    "beforePack": "scripts/before-pack.js",
    "afterSign": "scripts/after-sign-verify.js",
    "mac": {
      "bundleVersion": "1274",
      "category": "public.app-category.productivity",
      "icon": "build/app-icons/Icon.icon",
      "hardenedRuntime": true,
      "sign": "scripts/sign-mac.js",
      "identity": "55283A84D3706D5A22386D5F002A0CD4845ECFD4",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "provisioningProfile": "build/embedded.provisionprofile",
      "extendInfo": {
        "CFBundleDisplayName": "Blanc Browser",
        "NSMicrophoneUsageDescription": "Blanc allows websites you approve to use your microphone.",
        "NSCameraUsageDescription": "Blanc allows websites you approve to use your camera.",
        "NSAudioCaptureUsageDescription": "Blanc lets you share this Mac’s screen and system audio with a website after you choose a source.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.html"
            ]
          },
          {
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.xhtml"
            ]
          }
        ]
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/windows-icons/icon-sunrise.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "appImage": {
      "executableArgs": []
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Network;WebBrowser"
    }
  }
}
