import("//build/config/android/rules.gni")

# The Island's rules, ported from Blanc for iPhone (ios/Blanc/Blanc/Island*.swift):
# plain Java with no views, so they test without a device.
android_library("island_java") {
  sources = [
    "java/src/org/chromium/blanc/address/AddressInput.java",
    "java/src/org/chromium/blanc/island/IslandMenu.java",
    "java/src/org/chromium/blanc/island/IslandPosition.java",
    "java/src/org/chromium/blanc/island/IslandStyle.java",
    "java/src/org/chromium/blanc/island/IslandSwipe.java",
    "java/src/org/chromium/blanc/island/IslandTitle.java",
    "java/src/org/chromium/blanc/island/IslandTuck.java",
    "java/src/org/chromium/blanc/island/IslandVisibility.java",
  ]
  deps = [ "//build/android:build_java" ]
}

# Blanc's tab rules, ported from Blanc for iPhone (TabGroups, TabSections,
# QuickSwitcher, SlashCommand) and checked against desktop's JavaScript
# (A2 plan, Task 2): plain Java with no views.
android_library("tabs_java") {
  sources = [
    "java/src/org/chromium/blanc/tabs/BlancTabState.java",
    "java/src/org/chromium/blanc/tabs/BlancTabs.java",
    "java/src/org/chromium/blanc/tabs/CardSwipe.java",
    "java/src/org/chromium/blanc/tabs/GroupColors.java",
    "java/src/org/chromium/blanc/tabs/GroupNames.java",
    "java/src/org/chromium/blanc/tabs/QuickSwitcher.java",
    "java/src/org/chromium/blanc/tabs/QuietTabs.java",
    "java/src/org/chromium/blanc/tabs/SlashCommands.java",
    "java/src/org/chromium/blanc/tabs/TabSections.java",
    "java/src/org/chromium/blanc/tabs/TabStore.java",
  ]
  deps = [
    ":island_java",
    "//build/android:build_java",
  ]
}

# BlancTabs' store over Chromium's tab model.
android_library("tabs_ui_java") {
  sources = [
    "java/src/org/chromium/blanc/tabs/chromium/BlancTabKeeper.java",
    "java/src/org/chromium/blanc/tabs/chromium/ChromiumTabStore.java",
  ]
  deps = [
    ":tabs_java",
    "//base:base_java",
    "//build/android:build_java",
    "//chrome/browser/tab:java",
    "//chrome/browser/tabmodel:java",
    "//components/tab_groups:tab_groups_java",
    "//content/public/android:content_java",
    "//url:url_java",
  ]
}

