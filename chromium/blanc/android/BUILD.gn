import("//build/config/android/rules.gni")

# The Island's rules, ported from Blanc for iPhone (ios/Blanc/Blanc/Island*.swift):
# plain Java with no views, so they test without a device.
android_library("island_java") {
  sources = [
    "java/src/org/chromium/blanc/address/AddressInput.java",
    "java/src/org/chromium/blanc/island/IslandMenu.java",
    "java/src/org/chromium/blanc/island/IslandPosition.java",
    "java/src/org/chromium/blanc/island/IslandStyle.java",
    "java/src/org/chromium/blanc/island/IslandSwipe.java",
    "java/src/org/chromium/blanc/island/IslandTitle.java",
    "java/src/org/chromium/blanc/island/IslandTuck.java",
    "java/src/org/chromium/blanc/island/IslandVisibility.java",
  ]
  deps = [ "//build/android:build_java" ]
}

# The Island's pill: an Android view with no Chromium dependencies. Strings come
# from copy/messages through chromium/tools/android-strings.mjs; the mark from
# scripts/android-app-icons.js.
android_resources("island_view_resources") {
  sources = [
    "island/res/drawable-mdpi/blanc_island_mark.png",
    "island/res/drawable-hdpi/blanc_island_mark.png",
    "island/res/drawable-xhdpi/blanc_island_mark.png",
    "island/res/drawable-xxhdpi/blanc_island_mark.png",
    "island/res/drawable-xxxhdpi/blanc_island_mark.png",
    "island/res/drawable/blanc_island_plus.xml",
    "island/res/drawable/blanc_island_reload.xml",
    "island/res/drawable/blanc_island_stop.xml",
    "island/res/layout/blanc_island.xml",
    "island/res/values/blanc_island_dimens.xml",
    "island/res/values/blanc_strings.xml",
    "island/res/values-de/blanc_strings.xml",
    "island/res/values-es/blanc_strings.xml",
    "island/res/values-fr/blanc_strings.xml",
    "island/res/values-it/blanc_strings.xml",
    "island/res/values-pt-rBR/blanc_strings.xml",
  ]
}

android_library("island_view_java") {
  resources_package = "org.chromium.blanc.island"
  sources = [
    "java/src/org/chromium/blanc/address/AddressSheet.java",
    "java/src/org/chromium/blanc/island/IslandMenuPopup.java",
    "java/src/org/chromium/blanc/island/IslandView.java",
  ]
  deps = [
    ":island_java",
    ":island_view_resources",
    "//build/android:build_java",
  ]
}

# Puts the Island over the page and wires it to Chromium's tabs, scrolling and
# insets. chrome_java depends on it (patch 0104), so it uses Chromium's smaller
# targets, never chrome_java itself.
android_library("island_ui_java") {
  sources = [ "java/src/org/chromium/blanc/island/IslandCoordinator.java" ]
  deps = [
    ":island_java",
    ":island_view_java",
    "//base:base_java",
    "//base:callback_java",
    "//base:supplier_java",
    "//build/android:build_java",
    "//cc/mojom:mojom_java",
    "//chrome/browser/tab:java",
    "//chrome/browser/tabmodel:java",
    "//components/url_formatter/android:url_formatter_java",
    "//content/public/android:content_java",
    "//third_party/androidx:androidx_core_core_java",
    "//ui/android:ui_no_recycler_view_java",
    "//url:gurl_java",
  ]
}

# Blanc's own Robolectric binary: run with
# out/<dir>/bin/run_blanc_android_junit_tests.
robolectric_binary("blanc_android_junit_tests") {
  resources_package = "org.chromium.blanc.island"
  testonly = true
  sources = [
    "junit/src/org/chromium/blanc/address/AddressFixtures.java",
    "junit/src/org/chromium/blanc/address/AddressInputTest.java",
    "junit/src/org/chromium/blanc/address/AddressSheetTest.java",
    "junit/src/org/chromium/blanc/island/IslandMenuPopupTest.java",
    "junit/src/org/chromium/blanc/island/IslandMenuTest.java",
    "junit/src/org/chromium/blanc/island/IslandPositionTest.java",
    "junit/src/org/chromium/blanc/island/IslandStyleTest.java",
    "junit/src/org/chromium/blanc/island/IslandSwipeGestureTest.java",
    "junit/src/org/chromium/blanc/island/IslandSwipeTest.java",
    "junit/src/org/chromium/blanc/island/IslandTitleTest.java",
    "junit/src/org/chromium/blanc/island/IslandTuckTest.java",
    "junit/src/org/chromium/blanc/island/IslandViewTest.java",
    "junit/src/org/chromium/blanc/island/IslandVisibilityTest.java",
  ]
  deps = [
    ":island_java",
    ":island_view_java",
    "//base:base_java_test_support",
    "//base:base_junit_test_support",
    "//third_party/junit",
  ]
}
