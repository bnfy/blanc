import("//blanc/config.gni")
import("//build/config/android/rules.gni")
import("//third_party/jni_zero/jni_zero.gni")

# The Island's rules, ported from Blanc for iPhone (ios/Blanc/Blanc/Island*.swift):
# plain Java with no views, so they test without a device.
android_library("island_java") {
  sources = [
    "java/src/org/chromium/blanc/address/AddressInput.java",
    "java/src/org/chromium/blanc/island/IslandMenu.java",
    "java/src/org/chromium/blanc/island/IslandPosition.java",
    "java/src/org/chromium/blanc/island/IslandStyle.java",
    "java/src/org/chromium/blanc/island/IslandSwipe.java",
    "java/src/org/chromium/blanc/island/IslandTitle.java",
    "java/src/org/chromium/blanc/island/IslandTuck.java",
    "java/src/org/chromium/blanc/island/IslandVisibility.java",
  ]
  deps = [ "//build/android:build_java" ]
}

