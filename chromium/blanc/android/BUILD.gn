# BlancTabs' store over Chromium's tab model.
generate_jni("blocking_jni") {
  sources = [ "java/src/org/chromium/blanc/blocking/BlockerBridge.java" ]
}

# The Island's way to the blocker. //chrome/browser depends on this (patch 0106).
source_set("blocker_bridge") {
  sources = [ "browser/blocker_bridge.cc" ]
  deps = [
    ":blocking_jni",
    "//base",
    "//blanc/services/blocker:browser",
    "//content/public/browser",
    "//url",
  ]
}

generate_jni("sync_jni") {
  sources = [ "java/src/org/chromium/blanc/sync/SyncBridge.java" ]
}

# Keys, files and network for the sync runner. //chrome/browser depends on this (patch 0107).
source_set("sync_bridge") {
  if (blanc_enable_test_hooks) {
    defines = [ "BLANC_SYNC_TEST_HOOKS" ]
  }
  sources = [ "browser/sync_bridge.cc", "browser/sync_start_data.h" ]
  deps = [
    ":sync_jni",
    "//base",
    "//blanc/services/blocker:browser",
    "//blanc/services/sync_runner:browser",
    "//components/bookmarks/browser",
    "//components/version_info",
    "//services/network/public/cpp",
  ]
}

# A build without test hooks gets the empty driver: no exported receiver exists at all.
if (blanc_enable_test_hooks) {
  blanc_sync_test_driver = "java/src/org/chromium/blanc/sync/SyncTestDriver.java"
} else {
  blanc_sync_test_driver = "java/stub/org/chromium/blanc/sync/SyncTestDriver.java"
}

android_library("sync_java") {
  srcjar_deps = [ ":sync_jni" ]
  sources = [
    "java/src/org/chromium/blanc/sync/BlancKeyStore.java",
    "java/src/org/chromium/blanc/sync/BlancSyncTask.java",
    "java/src/org/chromium/blanc/sync/OtherDevices.java",
    "java/src/org/chromium/blanc/sync/PairLink.java",
    "java/src/org/chromium/blanc/sync/ProfileSync.java",
    "java/src/org/chromium/blanc/sync/QrDecoder.java",
    "java/src/org/chromium/blanc/sync/SyncBridge.java",
    "java/src/org/chromium/blanc/sync/SyncCode.java",
    "java/src/org/chromium/blanc/sync/SyncSchedule.java",
    "java/src/org/chromium/blanc/sync/SyncSheetModel.java",
    "java/src/org/chromium/blanc/sync/SyncedFavorites.java",
    "java/src/org/chromium/blanc/sync/SyncedSettings.java",
    "java/src/org/chromium/blanc/sync/SyncedClosed.java",
    "java/src/org/chromium/blanc/sync/SyncedSpaces.java",
    "java/src/org/chromium/blanc/sync/SyncedTabs.java",
    blanc_sync_test_driver,
  ]
  deps = [
    ":tabs_java",
    ":zxing_java",
    "//base:base_java",
    "//components/background_task_scheduler:background_task_scheduler_task_ids_java",
    "//components/background_task_scheduler:factory_java",
    "//components/background_task_scheduler:public_java",
    "//build/android:build_java",
    "//third_party/jni_zero:jni_zero_java",
  ]
}

# The pairing scanner's QR decoder: ZXing core 3.5.3 (Apache-2.0) from Maven Central, sha256
# 8d8064c1636fdaef7189dd9055c7d59950a8940a12f2293956446ec3c109fd82. Like the blocker bundle it isn't
# in git; it's copied here from the server's assets.
android_java_prebuilt("zxing_java") {
  jar_path = "zxing/core-3.5.3.jar"
}

# Shipping's sync, bundled by chromium/tools/build-sync-bundle.mjs. The runner refuses any bytes
# but the pinned hash.
android_assets("sync_assets") {
  renaming_sources = [ "//blanc/services/sync_runner/generated/sync-bundle.js" ]
  renaming_destinations = [ "blanc_sync/sync-bundle.js" ]
  disable_compression = true
}

android_library("tabs_ui_java") {
  srcjar_deps = [ ":blocking_jni" ]
  sources = [
    "java/src/org/chromium/blanc/blocking/BlockerBridge.java",
    "java/src/org/chromium/blanc/tabs/chromium/BlancTabKeeper.java",
    "java/src/org/chromium/blanc/tabs/chromium/ChromiumSpaces.java",
    "java/src/org/chromium/blanc/tabs/chromium/ChromiumBlocking.java",
    "java/src/org/chromium/blanc/tabs/chromium/ChromiumTabStore.java",
  ]
  deps = [
    ":sync_java",
    ":tabs_java",
    "//base:base_java",
    "//build/android:build_java",
    "//third_party/jni_zero:jni_zero_java",
    "//chrome/browser/android/crypto:java",
    "//chrome/browser/profiles/android:java",
    "//chrome/browser/tab:java",
    "//chrome/browser/tabmodel:java",
    "//chrome/browser/tabpersistence:java",
    "//components/tab_groups:tab_groups_java",
    "//content/public/android:content_java",
    "//url:url_java",
  ]
}

