# The blocker's engine bundle (Ghostery over the pinned lists), uncompressed so native code can read
# it from the APK. blocker_proxy.cc refuses any bytes but the pinned hash. It isn't in git; it's
# generated by experiments/chromium-extension-spike/native/blocker/bundle.mjs.
android_assets("blocker_assets") {
  renaming_sources = [ "blocker_assets/engine.js" ]
  renaming_destinations = [ "blanc_blocker/engine.js" ]
  disable_compression = true
}

android_library("island_view_java") {
  resources_package = "org.chromium.blanc.island"
  sources = [
    "java/src/org/chromium/blanc/island/IslandMenuPopup.java",
    "java/src/org/chromium/blanc/island/IslandView.java",
    "java/src/org/chromium/blanc/find/FindCapsule.java",
    "java/src/org/chromium/blanc/grid/GroupNameDialog.java",
    "java/src/org/chromium/blanc/grid/TabGrid.java",
    "java/src/org/chromium/blanc/palette/PaletteSheet.java",
  ]
  deps = [
    ":blocker_assets",
    ":island_java",
    ":island_view_resources",
    ":tabs_java",
    "//build/android:build_java",
  ]
}

# Puts the Island over the page and wires it to Chromium's tabs, scrolling and
# insets. chrome_java depends on it (patch 0104), so it uses Chromium's smaller
# targets, never chrome_java itself.
android_library("island_ui_java") {
  sources = [ "java/src/org/chromium/blanc/island/IslandCoordinator.java" ]
  deps = [
    ":island_java",
    ":island_view_java",
    "//base:base_java",
    "//base:callback_java",
    "//base:supplier_java",
    "//build/android:build_java",
    "//cc/mojom:mojom_java",
    "//chrome/browser/tab:java",
    "//chrome/browser/tabmodel:java",
    "//components/url_formatter/android:url_formatter_java",
    "//content/public/android:content_java",
    "//third_party/androidx:androidx_core_core_java",
    "//ui/android:ui_no_recycler_view_java",
    "//url:gurl_java",
  ]
}

