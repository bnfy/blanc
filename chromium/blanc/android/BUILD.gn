# The blocker's engine bundle (Ghostery over the pinned lists), uncompressed so native code can read
# it from the APK. blocker_proxy.cc refuses any bytes but the pinned hash. It isn't in git; it's
# generated by experiments/chromium-extension-spike/native/blocker/bundle.mjs.
android_assets("blocker_assets") {
  renaming_sources = [ "blocker_assets/engine.js" ]
  renaming_destinations = [ "blanc_blocker/engine.js" ]
  disable_compression = true
}

