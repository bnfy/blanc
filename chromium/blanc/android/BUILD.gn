    ":blocking_jni",
    "//base",
    "//blanc/services/blocker:browser",
    "//content/public/browser",
    "//url",
  ]
}

# The Island's two bridges: one target, since each generated srcjar brings its own GEN_JNI.
generate_jni("island_jni") {
  sources = [
    "java/src/org/chromium/blanc/island/PagePinchBridge.java",
    "java/src/org/chromium/blanc/island/TopColorBridge.java",
  ]
}

