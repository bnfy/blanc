<?xml version="1.0" encoding="utf-8"?>
<!-- Copyright 2026 Bananify Creative. MIT; see LICENSE.
     The Island, left to right as Blanc for iPhone's (ContentView.addressPill, #1682): Back,
     Forward while there's somewhere to go, the page menu (the site's icon, the Sunrise on Blanc's
     pages), the site, and New tab, which Stop replaces in the same place while a page loads. No
     dividers and no Private chip. It is 44 tall with 17 corners and only as wide as what it holds;
     IslandView sets the colors, the site's weight, the labels and the widths. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:id="@+id/blanc_island_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/blanc_island_back"
            android:layout_width="44dp"
            android:layout_height="@dimen/blanc_island_height"
            android:background="@null"
            android:contentDescription="@string/blanc_pill_back"
            android:scaleType="center"
            android:src="@drawable/blanc_island_chevron_left" />

        <ImageButton
            android:id="@+id/blanc_island_forward"
            android:layout_width="44dp"
            android:layout_height="@dimen/blanc_island_height"
            android:background="@null"
            android:contentDescription="@string/blanc_pill_forward"
            android:scaleType="center"
            android:src="@drawable/blanc_island_chevron_right"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/blanc_island_menu"
            android:contentDescription="@string/blanc_ios_island_page_actions"
            android:layout_width="36dp"
            android:layout_height="@dimen/blanc_island_height"
            android:background="@null"
            android:scaleType="center"
            android:src="@drawable/blanc_island_mark" />

        <TextView
            android:id="@+id/blanc_island_domain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:gravity="center_vertical"
            android:minWidth="44dp"
            android:minHeight="@dimen/blanc_island_height"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/blanc_island_new_tab"
            android:contentDescription="@string/blanc_tab_new"
            android:layout_width="44dp"
            android:layout_height="@dimen/blanc_island_height"
            android:background="@null"
            android:scaleType="center"
            android:src="@drawable/blanc_island_plus" />

        <ImageButton
            android:id="@+id/blanc_island_stop"
            android:layout_width="44dp"
            android:layout_height="@dimen/blanc_island_height"
            android:background="@null"
            android:contentDescription="@string/blanc_ios_island_stop"
            android:scaleType="center"
            android:src="@drawable/blanc_island_stop"
            android:visibility="gone" />
    </LinearLayout>
</merge>
