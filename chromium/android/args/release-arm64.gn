# Blanc for Android, release channel (arm64). The release builder copies this
# to out/AndroidRelease/args.gn and appends the version for that build. Check
# every name against `gn args <out> --list` at the pinned milestone; drop one
# it doesn't define, with a comment saying why.
target_os = "android"
# Only arm64-v8a is uploaded to Play.
target_cpu = "arm64"
# Optimized native code, with official-build checks and no test hooks.
is_debug = false
is_official_build = true
# This checkout fetches no PGO profiles, so release builds do not use PGO.
chrome_pgo_phase = 0
# No Java debugging or run-as. Chromium still reads the command-line file when the app is chosen as
# Android's debug app, so release builds also compile out every Blanc test switch (test-hook-guards).
is_java_debug = false
# Ship one native library with no debugging symbols.
is_component_build = false
symbol_level = 0
# Run lint, Error Prone and bytecode checks, including lint's release checks.
# "build_server" needs Chromium's autoninja; build.mjs calls Siso directly.
android_static_analysis = "on"
# Chromium's stable-channel manifest and packaging rules.
android_channel = "stable"
# Permanent release identity, separate from the debug app.
chrome_public_manifest_package = "me.bnfy.blanc"
# No Google API keys: features that need them stay off (design §2).
use_official_google_api_keys = false
# Blanc test hooks and disk assets are absent from release builds.
blanc_channel = "release"
