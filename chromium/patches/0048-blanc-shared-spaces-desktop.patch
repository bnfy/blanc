+    this.busy_ = true;
+    try {
+      const preview = await blancSync.call<SpacesPreview>('desktop.spaces.preview');
+      if (!preview.ok) {this.notice_ = 'Spaces sync is unavailable. Favorites, settings, open tabs and Send to device still work.'; return;}
+      this.choices_ = preview.choices ?? [];
