diff --git a/chrome/browser/resources/settings/blanc_settings_proxy.ts b/chrome/browser/resources/settings/blanc_settings_proxy.ts
index 1b765f818d3992c0f0d814cf7712aed440af92f6..5068e4206cf348009e07b33fd7df47a7ab66a6fc 100644
--- a/chrome/browser/resources/settings/blanc_settings_proxy.ts
+++ b/chrome/browser/resources/settings/blanc_settings_proxy.ts
@@ -185,6 +185,28 @@ function blancTokens(p: BlancPalette): Record<string, string> {
     // Shipping's sheet cards: a hairline border, 14px corners, a faint lift.
     '--cr-card-shadow': `0 0 0 1px ${p.border}, 0 1px 2px rgba(18, 16, 11, 0.04)`,
     '--cr-card-border-radius': '14px',
+    // Buttons and fields in the palette, not Chromium's blue.
+    '--color-button-foreground': p.text,
+    '--color-button-border': p.border,
+    '--color-button-background-prominent': p.accent,
+    '--color-button-foreground-prominent': p.onAccent,
+    '--color-button-background-tonal': p.accentDim,
+    '--color-button-foreground-tonal': p.text,
+    '--color-textfield-filled-background': p.surface,
+    '--color-textfield-filled-underline': p.border,
+    '--color-textfield-filled-underline-focused': p.accent,
+    // The navigation and the search field.
+    '--color-nav-menu-item': p.dim,
+    '--color-nav-menu-item-selected': p.text,
+    '--color-nav-menu-item-background-hover':
+        `color-mix(in srgb, ${p.text} 5%, transparent)`,
+    '--color-nav-menu-item-background-selected':
+        `color-mix(in srgb, ${p.text} 9%, transparent)`,
+    '--color-toolbar-search-field-background': p.surface,
+    '--color-toolbar-search-field-background-hover': p.surface,
+    '--color-toolbar-search-field-foreground': p.text,
+    '--color-toolbar-search-field-foreground-placeholder': p.dim,
+    '--color-toolbar-search-field-icon': p.dim,
   };
 }
 
