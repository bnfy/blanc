@@ -237,25 +237,41 @@ WebUIDataSourceImpl::WebUIDataSourceImpl(const std::string& source_name)
 
 WebUIDataSourceImpl::~WebUIDataSourceImpl() = default;
 
+// Blanc (S3, owner): Settings names Blanc, not Chromium. A string that links
+// to the Chromium project or credits its authors stays as written.
+static std::string BlancProductName(const std::string& source_name,
+                                    std::string text) {
+  if (source_name == "settings" &&
+      text.find("chromium.org") == std::string::npos &&
+      text.find("Chromium Authors") == std::string::npos) {
+    base::ReplaceSubstringsAfterOffset(&text, 0, "Chromium", "Blanc");
+  }
+  return text;
+}
+
 void WebUIDataSourceImpl::AddString(std::string_view name,
                                     std::u16string_view value) {
   CHECK(!resources_frozen_);
   // TODO(dschuyler): Share only one copy of these strings.
-  localized_strings_.Set(name, value);
-  replacements_[std::string(name)] = base::UTF16ToUTF8(value);
+  std::string utf8_str =
+      BlancProductName(source_name_, base::UTF16ToUTF8(value));
+  localized_strings_.Set(name, utf8_str);
+  replacements_[std::string(name)] = utf8_str;
 }
 
 void WebUIDataSourceImpl::AddString(std::string_view name,
                                     std::string_view value) {
   CHECK(!resources_frozen_);
-  localized_strings_.Set(name, value);
-  replacements_[std::string(name)] = value;
+  std::string utf8_str = BlancProductName(source_name_, std::string(value));
+  localized_strings_.Set(name, utf8_str);
+  replacements_[std::string(name)] = utf8_str;
 }
 
 void WebUIDataSourceImpl::AddLocalizedString(std::string_view name, int ids) {
   CHECK(!resources_frozen_);
   std::string utf8_str =
       base::UTF16ToUTF8(GetContentClient()->GetLocalizedString(ids));
+  utf8_str = BlancProductName(source_name_, std::move(utf8_str));
   localized_strings_.Set(name, utf8_str);
   replacements_[std::string(name)] = utf8_str;
 }
