+std::string TabRestoreServiceHelper::EntryBatchId(const Entry& entry) {
+  std::vector<const Tab*> tabs;
+  if (entry.type == tab_restore::TAB) tabs.push_back(static_cast<const Tab*>(&entry));
+  else if (entry.type == tab_restore::GROUP) for (const auto& tab : static_cast<const Group&>(entry).tabs) tabs.push_back(tab.get());
+  else if (entry.type == tab_restore::SPLIT) for (const auto& tab : static_cast<const Split&>(entry).tabs) tabs.push_back(tab.get());
+  std::string batch;
+  for (const auto* tab : tabs) {
+    const auto value = tab->extra_data.find("blanc.closed.batch.v1");
+    if (value == tab->extra_data.end() || !base::Uuid::ParseLowercase(value->second).is_valid() ||
+        (!batch.empty() && batch != value->second)) return "";
+    batch = value->second;
+  }
+  return batch;
+}
+size_t TabRestoreServiceHelper::EntrySlotCount(const Entries& entries) {
+  base::flat_set<std::string> batches;
+  size_t count = 0;
+  for (const auto& entry : entries) {
+    const auto batch = EntryBatchId(*entry);
+    if (batch.empty() || batches.insert(batch).second) ++count;
+  }
+  return count;
+}
