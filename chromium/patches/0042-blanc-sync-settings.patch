+      if (state.error) {
+        this.notice_ = this.errorText_(state.error);
+      }
+    } catch {
+      if (this.isConnected && lifetime === this.lifetime_) {
+        this.notice_ = blancString('blancSyncCheckFailed');
+      }
+    }
+  }
+
+  protected statusText_(): string {
+    if (!this.state_) {
+      return blancString('blancSyncChecking');
+    }
+    if (!this.state_.available) {
+      return blancString('blancSyncUnavailable');
+    }
+    const status = this.state_.status;
+    if (!status) {
+      return blancString('blancSyncCheckFailed');
+    }
+    if (!status.enabled) {
+      return blancString('blancSyncOff');
+    }
+    const last = status.lastSyncedAt ?
+        blancString('blancSyncLastSynced', {
+          when: new Date(status.lastSyncedAt).toLocaleString(),
+        }) : blancString('blancSyncNotSynced');
+    return `${blancString('blancSyncOn')} ${last}`;
+  }
+
+  protected firstUploadText_(): string {
+    return blancString('blancSyncFirstUploadBody', {
+      count: String(this.state_?.pendingFirstUpload ?? 0),
+    });
+  }
+
+  protected errorText_(error: string): string {
+    const names: Record<string, string> = {
+      'pair-invalid': 'PairInvalid',
+      'pair-not-found': 'PairNotFound',
+      'pair-unavailable': 'PairUnavailable',
+      'offline': 'Offline',
+      'rate-limited': 'RateLimited',
+      'bad-passphrase': 'BadPassphrase',
+      'name-too-short': 'NameTooShort',
+      'weak-passphrase': 'WeakPassphrase',
+      'key-protect-failed': 'KeyProtect',
+      'credentials-save-failed': 'CredentialsSave',
+      'local-key-unlock': 'LocalKeyUnlock',
+      'server': 'Server',
+      'unavailable': 'Unavailable',
+    };
+    return blancString('blancSync' + (names[error] ?? 'CheckFailed'));
+  }
+
+  protected onChooseCodeClick_() {
+    this.choose_('code');
+  }
+
+  protected onChoosePassphraseClick_() {
+    this.choose_('passphrase');
+  }
+
+  protected onChooseStartClick_() {
+    this.choose_('start');
+  }
+
+  protected onBackClick_() {
+    this.choose_('');
+  }
+
+  private choose_(path: ''|'code'|'passphrase'|'start') {
+    if (this.busy_) {
+      return;
+    }
+    this.clearCredentials_();
+    this.path_ = path;
+    this.notice_ = '';
+    void this.updateComplete.then(() => {
+      if (path === 'code') {
+        this.$.syncCode.focus();
+      } else if ((path === 'passphrase' || path === 'start')) {
+        this.$.syncHandle.focus();
+      }
+    });
+  }
+
+  protected onCodeInput_() {
+    const raw = this.$.syncCode.value.trim();
+    const normalized = raw.toUpperCase().replace(/[-\s]/g, '');
+    this.codeValid_ = /^[ABCDEFGHJKMNPQRSTVWXYZ23456789]{8}$/.test(normalized) ||
+        raw.startsWith('blanc-sync:');
+    this.notice_ = raw && !this.codeValid_ ?
+        blancString('blancSyncPairInvalid') : '';
+  }
+
+  protected onCredentialsInput_() {
+    const passphrase = this.$.syncPassphrase.value;
+    const strong = passphrase.length >= 16 ||
+        (passphrase.length >= 10 &&
+         [/[a-z]/, /[A-Z]/, /[0-9]/, /[^a-zA-Z0-9]/]
+             .filter(pattern => pattern.test(passphrase)).length >= 2);
+    this.credentialsValid_ = this.$.syncHandle.value.trim().length >= 2 && strong;
+    this.notice_ = '';
+  }
+
+  // Effects only run in action handlers, never in render or state observers.
+  private async act_(effect: () => Promise<BlancSyncResult>) {
+    if (this.busy_ || !this.state_?.available || !this.state_.status) {
+      return;
+    }
+    this.busy_ = true;
+    this.notice_ = '';
+    const lifetime = this.lifetime_;
+    try {
+      const result = await effect();
+      if (!this.isConnected || lifetime !== this.lifetime_) {
+        return;
+      }
+      if (result.status) {
+        this.state_ = {...this.state_, status: result.status};
+      }
+      if (!result.ok) {
+        this.notice_ = result.outcome === 'notFound' ?
+            blancString('blancSyncNotFound') :
+            this.errorText_(result.error ?? 'unknown');
+      }
+      if (result.status?.enabled) {
+        this.path_ = '';
+      }
+      await this.refresh_();
+    } catch (error) {
+      if (this.isConnected && lifetime === this.lifetime_) {
+        this.notice_ = this.errorText_(
+            error instanceof Error ? error.message : 'unknown');
+      }
+    } finally {
+      if (this.isConnected && lifetime === this.lifetime_) {
+        this.clearCredentials_();
+        this.busy_ = false;
+      }
+    }
+  }
+
+  protected onTurnOnClick_() {
+    void this.act_(() => blancSync.call('sync.startNew', [
+      {handle: blancString('blancSyncDefaultName')},
+    ]));
+  }
+
+  protected onSetupSubmit_(event: Event) {
+    event.preventDefault();
+    if (this.path_ === 'code' && this.codeValid_) {
+      const code = this.$.syncCode.value.trim();
+      void this.act_(() => blancSync.call('sync.joinWithCode', [code]));
+    } else if ((this.path_ === 'passphrase' || this.path_ === 'start') && this.credentialsValid_) {
+      const credentials = {
+        handle: this.$.syncHandle.value.trim(),
+        passphrase: this.$.syncPassphrase.value,
+      };
+      const lifetime = this.lifetime_;
+      const starting = this.path_ === 'start';
+      void this.act_(async () => {
+        try {
+          if (starting) {
+            return await blancSync.call('sync.enable', [credentials]);
+          }
+          const probe = await blancSync.call('sync.preflight', [credentials]);
+          if (!this.isConnected || lifetime !== this.lifetime_) {
+            return {ok: false};
+          }
+          if (!probe.ok || probe.outcome !== 'found') {
+            return {...probe, ok: false};
+          }
+          return await blancSync.call('sync.enable', [credentials]);
+        } finally {
+          credentials.passphrase = '';
+        }
+      });
+    }
+  }
+
+  protected onSyncNowClick_() {
+    this.run_('sync.syncNow');
+  }
+
+  protected onTurnOffClick_() {
+    this.run_('sync.disable');
+  }
+
+  private run_(method: BlancSyncMethod) {
+    void this.act_(() => blancSync.call(method));
+  }
+
+  protected onAcceptUploadClick_() {
+    void this.confirm_(true);
+  }
+
+  protected onDeclineUploadClick_() {
+    void this.confirm_(false);
+  }
+
+  private async confirm_(accept: boolean) {
+    if (this.busy_ || this.confirming_ || !this.state_?.pendingFirstUpload) {
+      return;
+    }
+    this.confirming_ = true;
+    const lifetime = this.lifetime_;
+    try {
+      await blancSync.confirmFirstUpload(accept);
+      // Consent persists asynchronously. Only the service's next inventory
+      // event removes the prompt or re-enables it for a changed inventory.
+    } catch (error) {
+      if (this.isConnected && lifetime === this.lifetime_) {
+        this.confirming_ = false;
+        this.notice_ = this.errorText_(
+            error instanceof Error ? error.message : 'unknown');
+      }
+    }
+  }
+}
