+
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import '../settings_page/settings_section.js';
+
+import {getCss as getCrSharedStyle} from 'chrome://resources/cr_elements/cr_shared_style_lit.css.js';
+import type {WebUiListener} from 'chrome://resources/js/cr.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {blancString, blancSync} from '../blanc_settings_proxy.js';
+import type {BlancSyncEvent, BlancSyncMethod, BlancSyncResult, BlancSyncState, BlancSyncStatus} from '../blanc_settings_proxy.js';
+import {getSearchManager} from '../search_settings.js';
+import type {SettingsPlugin} from '../settings_main/settings_plugin.js';
+import {getCss as getSettingsSharedLit} from '../settings_shared_lit.css.js';
+
+import {getCss} from './blanc_sync_page.css.js';
+import {getHtml} from './blanc_sync_page.html.js';
+
+export interface BlancSyncPageElement {
+  $: {
+    syncCode: HTMLInputElement,
+    syncHandle: HTMLInputElement,
+    syncPassphrase: HTMLInputElement,
+  };
+}
+
+export class BlancSyncPageElement extends CrLitElement implements
+    SettingsPlugin {
+  static get is() {
+    return 'settings-blanc-sync-page';
+  }
+
+  static override get styles() {
+    return [getCrSharedStyle(), getSettingsSharedLit(), getCss()];
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      state_: {type: Object},
+      path_: {type: String},
+      busy_: {type: Boolean},
+      notice_: {type: String},
+      codeValid_: {type: Boolean},
+      credentialsValid_: {type: Boolean},
+      confirming_: {type: Boolean},
+    };
+  }
+
+  protected accessor state_: BlancSyncState|null = null;
+  protected accessor path_: ''|'code'|'passphrase'|'start' = '';
+  protected accessor busy_: boolean = false;
+  protected accessor notice_: string = '';
+  protected accessor codeValid_: boolean = false;
+  protected accessor credentialsValid_: boolean = false;
+  protected accessor confirming_: boolean = false;
+  private listener_: WebUiListener|null = null;
+  private lifetime_: number = 0;
+  private revision_: number = 0;
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.busy_ = false;
+    this.confirming_ = false;
+    this.listener_ = blancSync.listen(event => this.onSyncChanged_(event));
+    void this.refresh_();
+  }
+
+  override disconnectedCallback() {
+    super.disconnectedCallback();
+    ++this.lifetime_;
+    if (this.listener_) {
+      blancSync.stopListening(this.listener_);
+      this.listener_ = null;
+    }
+    this.clearCredentials_();
+  }
+
+  async searchContents(query: string) {
+    const request = await getSearchManager().search(query, this);
+    return request.getSearchResult();
+  }
+
+  private clearCredentials_() {
+    // These fields are always stamped, including when their form is hidden.
+    if (this.hasUpdated) {
+      this.$.syncCode.value = '';
+      this.$.syncPassphrase.value = '';
+    }
+    this.codeValid_ = false;
+    this.credentialsValid_ = false;
+  }
+
+  private onSyncChanged_(event: BlancSyncEvent) {
+    ++this.revision_;
+    const status = event.event === 'status' ? event.value as BlancSyncStatus :
+                                            this.state_?.status ?? null;
+    this.state_ = {available: true, status,
+      pendingFirstUpload: event.pendingFirstUpload};
+    if (event.event === 'first-upload') {
+      this.confirming_ = false;
+    }
+    if (event.event === 'desktop-error') {
+      this.notice_ = this.errorText_(String(event.value));
+      this.confirming_ = false;
+    }
+    if (status?.enabled) {
+      this.path_ = '';
+      this.clearCredentials_();
+    }
+  }
