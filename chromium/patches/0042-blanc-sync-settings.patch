+// Desktop Sync has its own allowlisted native boundary. Credentials are sent
+// once, never retained in a shared proxy or returned in status/listener data.
+export interface BlancSyncStatus {
+  enabled: boolean;
+  handle: string;
+  lastSyncedAt: number;
+  lastError: string|null;
+  origin: string;
+  recoveryPromptDismissed: boolean;
+}
+
+export interface BlancSyncState {
+  available: boolean;
+  status: BlancSyncStatus|null;
+  pendingFirstUpload: number;
+  error?: string;
+}
+
+export interface BlancSyncResult {
+  ok: boolean;
+  error?: string;
+  outcome?: string;
+  status?: BlancSyncStatus;
+}
+
+export interface BlancSyncEvent {
+  event: 'status'|'first-upload'|'desktop-error';
+  value: BlancSyncStatus|{count: number}|string;
+  pendingFirstUpload: number;
+}
+
+export type BlancSyncMethod = 'sync.startNew'|'sync.joinWithCode'|
+    'sync.preflight'|'sync.enable'|'sync.syncNow'|'sync.disable'|'sync.status';
+
+interface BlancSyncReply<T> {
+  ok: boolean;
+  value?: T;
+  error?: string;
+}
+
+export const blancSync = {
+  state: () => sendWithPromise<BlancSyncState>('blancSyncState'),
+  async call<T = BlancSyncResult>(method: BlancSyncMethod, args: unknown[] = []):
+      Promise<T> {
+    const reply = await sendWithPromise<BlancSyncReply<T>>(
+        'blancSyncCall', method, JSON.stringify(args));
+    if (!reply.ok) {
+      throw new Error(reply.error || 'sync-call-failed');
+    }
+    return reply.value as T;
+  },
+  async confirmFirstUpload(accept: boolean): Promise<void> {
+    const reply = await sendWithPromise<BlancSyncReply<never>>(
+        'blancSyncConfirmFirstUpload', accept);
+    if (!reply.ok) {
+      throw new Error(reply.error || 'sync-confirm-failed');
+    }
+  },
+  listen: (callback: (event: BlancSyncEvent) => void): WebUiListener =>
+      addWebUiListener('blanc-sync-changed', callback),
+  stopListening: (listener: WebUiListener) => removeWebUiListener(listener),
+};
