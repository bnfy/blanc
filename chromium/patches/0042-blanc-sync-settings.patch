+    const revision = this.revision_;
+    try {
+      const state = await blancSync.state();
+      if (!this.isConnected || lifetime !== this.lifetime_) {
+        return;
+      }
+      // Don't overwrite a newer listener event with an earlier status read.
+      if (revision === this.revision_) {
+        this.state_ = state;
+      } else if (this.state_ && !this.state_.status && state.status) {
+        this.state_ = {...this.state_, status: state.status};
+      }
