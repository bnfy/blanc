 # Runs the version processing script over the given template file to produce
@@ -97,6 +98,13 @@ template("process_version") {
       }
     }
 
+    # Blanc: a Windows beta's version PATCH is its build number, wherever
+    # chrome/VERSION is read (//blanc/config.gni blanc_win_version_patch).
+    if (blanc_win_version_patch != "" && defined(invoker.sources) &&
+        filter_include(invoker.sources, [ "//chrome/VERSION" ]) != []) {
+      args += [ "-e", "PATCH=$blanc_win_version_patch" ]
