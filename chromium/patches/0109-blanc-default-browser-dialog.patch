diff --git a/chrome/browser/resources/default_browser/default_browser_modal/app.css b/chrome/browser/resources/default_browser/default_browser_modal/app.css
index 3a0d360..60b38ef 100644
--- a/chrome/browser/resources/default_browser/default_browser_modal/app.css
+++ b/chrome/browser/resources/default_browser/default_browser_modal/app.css
@@ -91,7 +91,8 @@
   justify-content: center;
   align-items: center;
   overflow: hidden;
-  background-color: var(--color-sys-base-tonal-container);
+  /* Blanc: the Sunrise surface, set below. */
+  background-color: var(--blanc-illustration-background);
   border-radius: 8px;
 }
 
@@ -127,3 +128,23 @@
 cr-button {
   font-weight: 500;
 }
+
+/* Blanc: the Sunrise palette (the fork's Settings palette), not Chromium's
+ * blue, for the buttons and the panel behind the Settings picture. */
+:host {
+  --blanc-illustration-background: #f2eade;
+  --color-button-foreground: #12100b;
+  --color-button-border: #e1d7c9;
+  --color-button-background-prominent: #805d28;
+  --color-button-foreground-prominent: #fff;
+}
+
+@media (prefers-color-scheme: dark) {
+  :host {
+    --blanc-illustration-background: #2d251d;
+    --color-button-foreground: #f7f0e5;
+    --color-button-border: #4a3e31;
+    --color-button-background-prominent: #d4ad66;
+    --color-button-foreground-prominent: #17130f;
+  }
+}
