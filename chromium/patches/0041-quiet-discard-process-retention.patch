+
+void TransientKeepAlivePolicy::OnAboutToBeDiscarded(
+    const PageNode* page_node, const PageNode* new_page_node) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  for (const FrameNode* main_frame : page_node->GetMainFrameNodes()) {
+    const ProcessNode* process = main_frame->GetProcessNode();
+    bool shared = false;
+    for (const FrameNode* frame : process->GetFrameNodes()) {
+      shared |= frame->GetPageNode() != page_node;
+    }
+    if (shared || !tracked_processes_with_frames_.erase(process)) {
+      continue;
+    }
+    // Release only this policy's reference. Native discard still protects
+    // unload handlers, workers, keep-alive requests and other pending reuse.
+    // Defer to avoid graph re-entrancy, as ReleaseKeepAlive does.
+    content::GetUIThreadTaskRunner({})->PostTask(
+        FROM_HERE, base::BindOnce(&DecrementPendingReuseRefCountById,
+            process->GetRenderProcessHostProxy().Get()->GetID()));
+  }
