+    // Set before native code or the feature list reads the command line; added to any
+    // --disable-features already given.
+    private static void disableBlancBackgroundServices(CommandLine commandLine) {
+        commandLine.appendSwitch(BLANC_DISABLE_SWITCH);
+        List<String> features = new ArrayList<>();
+        String given = commandLine.getSwitchValue("disable-features");
+        if (given != null && !given.isEmpty()) features.addAll(Arrays.asList(given.split(",")));
+        for (String feature : BLANC_DISABLED_FEATURES) {
+            if (!features.contains(feature)) features.add(feature);
+        }
+        commandLine.appendSwitchWithValue("disable-features", String.join(",", features));
