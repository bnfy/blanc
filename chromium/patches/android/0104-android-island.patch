+    // The Island's address sheet (A1 Task 5): Blanc's own pages open it empty, as the iPhone's
+    // palette does; an app link goes to Android, whose chooser asks which app.
+    private void showBlancAddressSheet() {
+        Tab tab = mActivityTabProvider.get();
+        String scheme = tab == null ? "" : tab.getUrl().getScheme();
+        String current =
+                tab == null || scheme.equals("chrome") || scheme.equals("chrome-native")
+                        ? ""
+                        : tab.getUrl().getSpec();
+        if (mBlancIsland != null) mBlancIsland.setSheetOpen(true);
+        org.chromium.blanc.address.AddressSheet sheet =
+                org.chromium.blanc.address.AddressSheet.show(
+                        mActivity,
+                        current,
+                        url -> {
+                            if (org.chromium.blanc.address.AddressInput.interpret(url).kind
+                                    == org.chromium.blanc.address.AddressInput.Kind.HANDOFF) {
+                                try {
+                                    mActivity.startActivity(
+                                            new android.content.Intent(
+                                                    android.content.Intent.ACTION_VIEW,
+                                                    android.net.Uri.parse(url)));
+                                } catch (android.content.ActivityNotFoundException e) {
+                                    // No app handles it: nothing opens, as on the iPhone.
+                                }
+                            } else if (tab != null) {
+                                tab.loadUrl(
+                                        new org.chromium.content_public.browser.LoadUrlParams(url));
+                            }
+                        });
+        sheet.setOnDismissListener(
+                d -> {
+                    if (mBlancIsland != null) mBlancIsland.setSheetOpen(false);
+                });
+    }
