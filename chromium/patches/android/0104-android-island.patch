+    // Favorites for the palette's Quick Switcher: every bookmarked address, from Chromium's model.
+    private java.util.List<org.chromium.blanc.tabs.QuickSwitcher.Page> blancFavorites() {
+        java.util.List<org.chromium.blanc.tabs.QuickSwitcher.Page> out = new java.util.ArrayList<>();
+        Tab tab = mActivityTabProvider.get();
+        if (tab == null) return out;
+        BookmarkModel model = BookmarkModel.getForProfile(tab.getProfile().getOriginalProfile());
+        if (!model.isBookmarkModelLoaded()) return out;
+        java.util.ArrayDeque<org.chromium.components.bookmarks.BookmarkId> folders =
+                new java.util.ArrayDeque<>();
+        org.chromium.components.bookmarks.BookmarkId root = model.getRootFolderId();
+        if (root != null) folders.add(root);
+        while (!folders.isEmpty() && out.size() < 2000) {
+            for (org.chromium.components.bookmarks.BookmarkId id : model.getChildIds(folders.poll())) {
+                org.chromium.components.bookmarks.BookmarkItem item = model.getBookmarkById(id);
+                if (item == null) continue;
+                if (item.isFolder()) {
+                    folders.add(id);
+                } else {
+                    out.add(
+                            new org.chromium.blanc.tabs.QuickSwitcher.Page(
+                                    String.valueOf(id.getId()),
+                                    item.getTitle(),
+                                    item.getUrl().getSpec()));
+                }
+            }
+        }
+        return out;
+    }
