+    // Find in page (A2 Task 6): Blanc's bar over Chromium's find, with Chromium's match counts.
+    private void showBlancFind() {
+        Tab tab = mActivityTabProvider.get();
+        org.chromium.content_public.browser.WebContents contents =
+                tab == null ? null : tab.getWebContents();
+        if (tab == null || contents == null) return;
+        org.chromium.components.find_in_page.FindInPageBridge bridge =
+                new org.chromium.components.find_in_page.FindInPageBridge(contents);
+        org.chromium.blanc.find.FindCapsule capsule =
+                org.chromium.blanc.find.FindCapsule.show(
+                        mActivity,
+                        new org.chromium.blanc.find.FindCapsule.Finder() {
+                            @Override
+                            public void find(String text, boolean forward) {
+                                bridge.startFinding(text, forward, /* caseSensitive= */ false);
+                            }
+
+                            @Override
+                            public void stop() {
+                                bridge.stopFinding(/* clearSelection= */ true);
+                            }
+                        },
+                        tab.isIncognito());
+        org.chromium.chrome.browser.tab.TabObserver results =
+                new org.chromium.chrome.browser.tab.TabObserver() {
+                    @Override
+                    public void onFindResultAvailable(
+                            org.chromium.components.find_in_page.FindNotificationDetails details) {
+                        capsule.setResult(details.activeMatchOrdinal, details.numberOfMatches);
+                    }
+
+                    // The bar belongs to this page: it goes when the tab leaves the screen.
+                    @Override
+                    public void onHidden(Tab hidden, @org.chromium.chrome.browser.tab.TabHidingType int reason) {
+                        capsule.dismiss();
+                    }
+
+                    @Override
+                    public void onDestroyed(Tab destroyed) {
+                        capsule.dismiss();
+                    }
+                };
+        tab.addObserver(results);
+        capsule.setOnDismissListener(
+                d -> {
+                    tab.removeObserver(results);
+                    bridge.destroy();
+                });
+    }
