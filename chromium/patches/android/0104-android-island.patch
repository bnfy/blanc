+    // The Sunrise menu (A1 Task 7): Favorites, Share and New Private Tab, as on the iPhone.
+    private void showBlancMenu(View anchor, Tab tab) {
+        GURL url = tab.getUrl();
+        BookmarkModel bookmarks = BookmarkModel.getForProfile(tab.getProfile().getOriginalProfile());
+        org.chromium.blanc.island.IslandMenu.Context context =
+                new org.chromium.blanc.island.IslandMenu.Context();
+        context.startPage = url.getSpec().startsWith("chrome://blanc/newtab.html");
+        context.blockableSite = UrlUtilities.isHttpOrHttps(url);
+        context.privateTab = tab.isIncognito();
+        context.canFavorite = bookmarks.isBookmarkModelLoaded();
+        context.favorite = context.canFavorite && bookmarks.isBookmarked(url);
+        org.chromium.blanc.island.IslandMenuPopup.show(
+                anchor,
+                context,
+                new org.chromium.blanc.island.IslandMenuPopup.Actions() {
+                    @Override
+                    public void toggleFavorite() {
+                        org.chromium.components.bookmarks.BookmarkId saved =
+                                bookmarks.getMostRecentlyAddedUserBookmarkIdForUrl(url);
+                        if (saved != null) {
+                            bookmarks.deleteBookmark(saved);
+                            return;
+                        }
+                        org.chromium.components.bookmarks.BookmarkId folder =
+                                bookmarks.getMobileFolderId();
+                        if (folder == null) return;
+                        bookmarks.addBookmark(
+                                folder, bookmarks.getChildCount(folder), tab.getTitle(), url);
+                    }
+
+                    @Override
+                    public void share() {
+                        Intent send =
+                                new Intent(Intent.ACTION_SEND)
+                                        .setType("text/plain")
+                                        .putExtra(Intent.EXTRA_TEXT, url.getSpec());
+                        mActivity.startActivity(Intent.createChooser(send, null));
+                    }
+
+                    @Override
+                    public void newPrivateTab() {
+                        mTabCreatorManagerSupplier
+                                .asNonNull()
+                                .get()
+                                .getTabCreator(true)
+                                .launchNtp(TabLaunchType.FROM_CHROME_UI);
+                    }
+                });
+    }
