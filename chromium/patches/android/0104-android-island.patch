+                            @Override
+                            public void onTabs() {
+                                showBlancTabGrid();
+                            }
+
+                            @Override
+                            public void onNewTab() {
+                                if (selector.isIncognitoSelected()) {
+                                    tabs.newPrivateTab();
+                                } else {
+                                    tabs.newTab();
+                                }
+                            }
+
+                            @Override
+                            public void onClosePrivateTab(Tab tab) {
+                                // Leaving private mode closes the private tab, as on the iPhone.
+                                tabs.close(String.valueOf(tab.getId()));
+                            }
+
+                            @Override
+                            public @Nullable View pageView() {
+                                return mCompositorViewHolderSupplier.get();
+                            }
+                        });
+    }
