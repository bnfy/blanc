+    private void createBlancIsland() {
+        TabModelSelector selector = mTabModelSelectorSupplier.asNonNull().get();
+        // Blanc's tab operations over Chromium's tab model (A2 Task 3).
+        org.chromium.blanc.tabs.BlancTabs tabs =
+                new org.chromium.blanc.tabs.BlancTabs(
+                        new org.chromium.blanc.tabs.chromium.ChromiumTabStore(
+                                selector, mTabCreatorManagerSupplier.asNonNull().get()),
+                        android.os.SystemClock::uptimeMillis,
+                        new android.os.Handler(android.os.Looper.getMainLooper())::postDelayed);
+        mBlancTabs = tabs;
+        mBlancIsland =
+                new IslandCoordinator(
+                        mActivity,
+                        mActivityTabProvider.asObservable(),
+                        selector,
+                        mWindowAndroid.getInsetObserver(),
+                        new IslandCoordinator.Callbacks() {
+                            @Override
+                            public void onMenu(View anchor) {
+                                Tab tab = mActivityTabProvider.get();
