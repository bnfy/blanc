diff -ruN a/build/config/android/config.gni b/build/config/android/config.gni
--- a/build/config/android/config.gni
+++ b/build/config/android/config.gni
@@ -264,6 +264,11 @@
     # The password for the keystore to use for signing builds.
     android_keystore_password = default_android_keystore_password
 
+    # Blanc (patch 0126): forced versionCode and versionName, as before Chromium 159, so a
+    # release build carries Blanc's own version (chromium/android/release/record.mjs).
+    android_override_version_code = ""
+    android_override_version_name = ""
+
     # Mark APKs as android:debuggable="true". Needed for debuggers and
     # "adb shell run-as" on non-rooted devices, and for wrap.sh. Off by default
     # because it makes ART slower and skips install-time dexopt.
diff -ruN a/build/config/android/rules.gni b/build/config/android/rules.gni
