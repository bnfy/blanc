     /**
+     * Blanc (patch 0122): the deferred startup task that clears the notifications left from the
+     * last run. A page opened at a cold start can already have one by then, so a notification this
+     * run posted stays, with its saved id; only the ones left from the last run go.
+     */
+    private void cancelLastRunWebRtcNotifications() {
+        Set<String> notificationIds =
+                mSharedPreferences.readStringSet(
+                        ChromePreferenceKeys.MEDIA_WEBRTC_NOTIFICATION_IDS, null);
+        if (notificationIds == null) return;
+        Set<String> live = new HashSet<>();
+        for (String id : notificationIds) {
+            int notificationId = Integer.parseInt(id);
+            if (mNotificationsType.containsKey(notificationId)) {
+                live.add(id);
+                continue;
+            }
+            mNotificationManager.cancel(NOTIFICATION_NAMESPACE, notificationId);
+        }
+        if (live.isEmpty()) {
+            mSharedPreferences.removeKey(ChromePreferenceKeys.MEDIA_WEBRTC_NOTIFICATION_IDS);
+        } else {
+            mSharedPreferences.writeStringSet(
+                    ChromePreferenceKeys.MEDIA_WEBRTC_NOTIFICATION_IDS, live);
+        }
+    }
