diff -ruN a/base/version_info/version_info.cc b/base/version_info/version_info.cc
--- a/base/version_info/version_info.cc
+++ b/base/version_info/version_info.cc
@@ -11,15 +11,14 @@
 #include "base/strings/string_number_conversions.h"
 #include "base/version.h"
 
-#if BUILDFLAG(IS_ANDROID)
-#include "base/android/apk_info.h"
-#endif
-
 namespace version_info {
 
 #if BUILDFLAG(IS_ANDROID)
 std::string_view GetVersionNumber() {
-  return base::android::apk_info::package_version_name();
+  // Blanc (patch 0117): Chromium's own version, as on desktop. The package's version name is
