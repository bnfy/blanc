+    // Blanc (patch 0110): the Settings root is Blanc's, laid over Chromium's rows. Run after every
+    // update of the root, so a row Chromium re-adds is hidden again.
+    private void blancSettings() {
+        org.chromium.blanc.settings.chromium.BlancSettingsHook.apply(
+                this,
+                mWindowAndroidSupplier,
+                () ->
+                        SettingsNavigationFactory.createSettingsNavigation()
+                                .startSettings(
+                                        getContext(),
+                                        org.chromium.components.browser_ui.settings.SettingsNavigation
+                                                .SettingsFragment.LEGAL_INFORMATION));
+    }
+
     @Override
     public void onCreate(@Nullable Bundle savedInstanceState) {
         super.onCreate(savedInstanceState);
