+bool ShouldUsePlatformAutofill(PrefService& prefs) {
+#if BUILDFLAG(IS_ANDROID)
+  // Earlier versions saved service availability as the user's preference.
+  if (!prefs.GetBoolean(prefs::kAutofillPlatformDefaultApplied)) {
+    prefs.ClearPref(prefs::kAutofillUsingPlatformAutofill);
+    prefs.SetBoolean(prefs::kAutofillPlatformDefaultApplied, true);
+  }
+#endif  // BUILDFLAG(IS_ANDROID)
+  return UsesVirtualViewStructureForAutofill(prefs);
+}
