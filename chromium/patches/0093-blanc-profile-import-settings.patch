--- a/chrome/browser/resources/settings/about_page/about_page.ts
+++ b/chrome/browser/resources/settings/about_page/about_page.ts
@@ -82,6 +82,9 @@
     return {
       currentUpdateStatusEvent_: {type: Object},
       betaUpdateState_: {type: Object},
+      blancImportStatus_: {type: String},
+      blancImportBusy_: {type: Boolean},
+      blancImportButton_: {type: String},
       blancTrust_: {type: Array},
       blancTrustStatus_: {type: String},
       blancCrashDumps_: {type: Number},
@@ -335,7 +338,45 @@
       this.blancDiagnosticsSummary_ = this.blancText_('blancDiagnosticsReadFailed');
     }
   }
+
+  // Blanc: the Electron profile importer. The reply is counts and codes.
+  protected accessor blancImportStatus_: string = loadTimeData.getString('blancProfileImportHint');
+  protected accessor blancImportBusy_: boolean = false;
+  protected accessor blancImportButton_: string = loadTimeData.getString('blancProfileImportStart');
 
+  protected async onBlancImportClick_() {
+    if (this.blancImportBusy_) return;
+    const t = (name: string) => loadTimeData.getString(name);
+    this.blancImportBusy_ = true;
+    this.blancImportStatus_ = t('blancProfileImportWorking');
+    let retry = true;
+    try {
+      const result = await sendWithPromise<{ok: boolean, error?: string, imported?: number, failed?: number,
+                                            already?: number, sync?: string}>('blancProfileImport');
+      if (!result.ok) {
+        this.blancImportStatus_ = t(({
+          'source-running': 'blancProfileImportRunning',
+          'no-source': 'blancProfileImportNoSource',
+          'unknown-version': 'blancProfileImportNoSource',
+          'unsupported-version': 'blancProfileImportOld',
+        } as Record<string, string>)[result.error ?? ''] ?? 'blancProfileImportFailed');
+      } else if ((result.failed ?? 0) > 0) {
+        this.blancImportStatus_ = t('blancProfileImportPartial');
+      } else if ((result.imported ?? 0) === 0) {
+        this.blancImportStatus_ = t('blancProfileImportAlready');
+        retry = false;
+      } else {
+        this.blancImportStatus_ = t(result.sync === 'kept' ? 'blancProfileImportDoneRestart'
+            : result.sync === 'unavailable' ? 'blancProfileImportDoneSyncOff' : 'blancProfileImportDone');
+        retry = false;
+      }
+    } catch {
+      this.blancImportStatus_ = t('blancProfileImportFailed');
+    }
+    this.blancImportButton_ = t(retry ? 'blancProfileImportRetry' : 'blancProfileImportStart');
+    this.blancImportBusy_ = false;
+  }
+
   protected onBlancCrashDumpsClick_() {
     BlancOpenWindow.getInstance().openUrl('chrome://crashes');
   }
