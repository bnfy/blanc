+  // Blanc (N16): the trust receipt and Diagnostics.
+  protected accessor blancTrust_: Array<{id: string, label: string, value: string}> = [];
+  protected accessor blancTrustStatus_: string = loadTimeData.getString('blancTrustChecking');
+  protected accessor blancCrashDumps_: number = 0;
+  protected accessor blancDiagnosticsSummary_: string = loadTimeData.getString('blancDiagnosticsChecking');
+  protected accessor blancDiagnosticsStatus_: string = '';
+  private blancClearArmed_: boolean = false;
+
+  // Shipping's messages carry {name} placeholders, and one plural.
+  private blancText_(name: string, values: Record<string, string|number> = {}): string {
+    let text = loadTimeData.getString(name);
+    const plural = /^\{(\w+), plural, (.*)\}$/s.exec(text);
+    if (plural) {
+      const count = Number(values[plural[1]]);
+      const forms = new Map([...plural[2].matchAll(/(\w+) \{([^{}]*)\}/g)].map(m => [m[1], m[2]]));
+      const form = new Intl.PluralRules(document.documentElement.lang || 'en').select(count);
+      text = (forms.get(form) ?? forms.get('other') ?? '').replaceAll('#', String(count));
+    }
+    for (const [key, value] of Object.entries(values)) text = text.replaceAll('{' + key + '}', String(value));
+    return text;
   }
 
+  private blancDiagnosticsCount_(count: number) {
+    this.blancDiagnosticsSummary_ = count === 0 ? this.blancText_('blancDiagnosticsNone')
+        : this.blancText_('blancDiagnosticsCount', {count});
+  }
+
+  private async loadBlancTrust_() {
+    try {
+      const receipt = await blancSettings.trustReceipt();
+      // Sync's own state, as its Settings section reads it; unknown reads as off.
+      const sync = await sendWithPromise<{status: {enabled?: boolean, syncTabs?: boolean}|null}>('blancSyncState')
+          .catch(() => ({status: null}));
+      const t = (name: string, values = {}) => this.blancText_(name, values);
+      const onOff = (on: boolean) => t(on ? 'blancTrustOn' : 'blancTrustOff');
+      const app = receipt.app, signature = receipt.signature, choices = receipt.choices;
+      const publisher = ({
+        verified: () => t('blancTrustSignatureVerified', {publisher: signature.observed ?? ''}),
+        mismatch: () => t('blancTrustSignatureMismatch', {expected: signature.expected,
+          observed: signature.observed || t('blancTrustSignatureUnknownPublisher')}),
+        unavailable: () => t('blancTrustSignatureUnavailable', {expected: signature.expected}),
+        development: () => t('blancTrustSignatureDevelopment'),
+      } as Record<string, () => string>)[signature.status]?.() ?? t('blancTrustSignatureUnknown');
+      const dns = ({auto: t('blancTrustDnsAuto'), off: t('blancTrustOff'), custom: t('blancTrustDnsCustom')} as
+          Record<string, string>)[choices.secureDns] ?? choices.secureDns;
+      const syncOn = sync.status?.enabled === true;
+      this.blancTrust_ = [
+        {id: 'build', label: t('blancTrustFactBuild'), value: t(app.packaged ? 'blancTrustBuildPackaged'
+            : 'blancTrustBuildDevelopment', {version: app.version, build: app.build})},
+        {id: 'runtime', label: t('blancTrustFactRuntime'), value: 'Chromium ' + app.chromium},
+        {id: 'platform', label: t('blancTrustFactPlatform'), value: app.platform + ' · ' + app.architecture},
+        {id: 'publisher', label: t('blancTrustFactPublisher'), value: publisher},
+        {id: 'blocker', label: t('blancTrustFactBlockerDigest'), value: receipt.blocker.combinedSha256},
+        {id: 'sync', label: t('blancTrustFactSync'), value: syncOn ? t('blancTrustSyncScope') : t('blancTrustOff')},
+        {id: 'openTabs', label: t('blancTrustFactOpenTabs'), value: onOff(syncOn && sync.status?.syncTabs === true)},
+        {id: 'usage', label: t('blancTrustFactUsage'), value: onOff(choices.usageMeasurement)},
+        {id: 'suggestions', label: t('blancTrustFactSuggestions'), value: onOff(choices.searchSuggestions)},
+        {id: 'secureDns', label: t('blancTrustFactSecureDns'), value: dns},
+        {id: 'crashLedger', label: t('blancTrustFactCrashLedger'), value: t('blancTrustCrashLedger',
+            {count: choices.crashLedger.eventCount, limit: choices.crashLedger.eventLimit})},
+      ];
+      this.blancCrashDumps_ = receipt.crashDumps;
+      this.blancDiagnosticsCount_(choices.crashLedger.eventCount);
+      this.blancTrustStatus_ = t('blancTrustChecked');
+    } catch {
+      this.blancTrustStatus_ = this.blancText_('blancTrustFailed');
+      this.blancDiagnosticsSummary_ = this.blancText_('blancDiagnosticsReadFailed');
+    }
+  }
+
+  protected onBlancCrashDumpsClick_() {
+    BlancOpenWindow.getInstance().openUrl('chrome://crashes');
+  }
+
+  // The report is this build's facts and the ledger: saved as a file the
+  // usual way, with nothing of a page in it.
+  protected async onBlancDiagnosticsExportClick_() {
+    this.blancClearArmed_ = false;
+    try {
+      const report = await blancSettings.diagnosticsReport();
+      const link = document.createElement('a');
+      link.href = URL.createObjectURL(new Blob([report], {type: 'application/json'}));
+      link.download = 'blanc-diagnostics.json';
+      link.click();
+      URL.revokeObjectURL(link.href);
+      this.blancDiagnosticsStatus_ = this.blancText_('blancDiagnosticsSaved');
+    } catch {
+      this.blancDiagnosticsStatus_ = this.blancText_('blancDiagnosticsSaveFailed');
+    }
+  }
+
+  // The first click asks, in shipping's words; the second clears the ledger
+  // and Chromium's dump files.
+  protected async onBlancDiagnosticsClearClick_() {
+    if (!this.blancClearArmed_) {
+      this.blancClearArmed_ = true;
+      this.blancDiagnosticsStatus_ = this.blancText_('blancDiagnosticsClearConfirm');
+      return;
+    }
+    this.blancClearArmed_ = false;
+    try {
+      await blancSettings.diagnosticsClear();
+      this.blancDiagnosticsStatus_ = this.blancText_('blancDiagnosticsCleared');
+      await this.loadBlancTrust_();
+    } catch {
+      this.blancDiagnosticsStatus_ = this.blancText_('blancDiagnosticsClearFailed');
+    }
+  }
+
   protected onBlancWelcomeTourClick_() {
     blancSettings.openWelcomeTour();
   }
