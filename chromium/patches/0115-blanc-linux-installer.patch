diff --git a/chrome/installer/linux/common/variables.include b/chrome/installer/linux/common/variables.include
--- a/chrome/installer/linux/common/variables.include
+++ b/chrome/installer/linux/common/variables.include
@@ -1,2 +1,19 @@
 # System-wide package configuration.
 DEFAULTS_FILE="/etc/default/@@PACKAGE"
+
+load_repo_defaults() {
+  if [ ! -e "$DEFAULTS_FILE" ]; then
+    echo 'repo_add_once="true"' > "$DEFAULTS_FILE"
+  fi
+  . "$DEFAULTS_FILE"
+}
+
+# Only successful enrollment gives the package ownership of the repository
+# files. A preseeded opt-out and a completed enrollment both say add_once=false.
+mark_repo_managed() {
+  config=$(mktemp "$DEFAULTS_FILE.XXXXXX") || return 1
+  cp -p "$DEFAULTS_FILE" "$config" &&
+    sed '/^[[:space:]]*repo_add_once=/d; /^[[:space:]]*repo_managed=/d' "$DEFAULTS_FILE" > "$config" &&
+    printf '%s\n' 'repo_add_once="false"' 'repo_managed="true"' >> "$config" &&
+    mv -f "$config" "$DEFAULTS_FILE"
+}
