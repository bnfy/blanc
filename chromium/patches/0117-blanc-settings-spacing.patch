diff --git a/chrome/browser/resources/settings/blanc_sync_page/blanc_sync_page.css b/chrome/browser/resources/settings/blanc_sync_page/blanc_sync_page.css
index 4c34598..d57d79e 100644
--- a/chrome/browser/resources/settings/blanc_sync_page/blanc_sync_page.css
+++ b/chrome/browser/resources/settings/blanc_sync_page/blanc_sync_page.css
@@ -33,8 +33,14 @@ form,
   padding-top: 16px;
 }
 
+/* Other ways opens with the chevron every other Settings row uses, not
+ * the system's filled triangle (polish, 2026-11-25). */
 summary {
+  align-items: center;
   cursor: pointer;
+  display: inline-flex;
+  gap: 6px;
+  list-style: none;
   margin-bottom: 12px;
 }
 
@@ -159,3 +165,41 @@ input[type='checkbox'] {
   .sync-turn-off { align-items: flex-start;
  flex-direction: column; }
 }
+
+/* Polish (2026-11-25): each question sits a step above its buttons, and
+ * the next one starts clear of the buttons before it. */
+#syncPaths > h2 {
+  margin: 0 0 10px;
+}
+
+#syncPaths > p {
+  margin: 12px 0 10px;
+}
+
+summary::-webkit-details-marker {
+  display: none;
+}
+
+summary::before {
+  background-color: currentColor;
+  content: '';
+  height: 16px;
+  mask: url(//resources/images/chevron_down.svg) center / 16px no-repeat;
+  transform: rotate(-90deg);
+  transition: transform 120ms ease-out;
+  width: 16px;
+}
+
+:host-context([dir=rtl]) summary::before {
+  transform: rotate(90deg);
+}
+
+details[open] > summary::before {
+  transform: none;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  summary::before {
+    transition: none;
+  }
+}
