+    let d = '';
+    matrix.modules.forEach((row, r) => row.forEach((dark, c) => { if (dark) d += `M${c + QUIET} ${r + QUIET}h1v1h-1z`; }));
+    return d;
+  }
+
+  return { encode, svgPath, viewBoxSize };
+})();
