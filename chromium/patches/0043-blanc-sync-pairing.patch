+  function switchView(state) {
+    return {
+      open: state.open,
+      codeValue: state.code,
+      wipeRemote: state.wipeRemote,
+      submitDisabled: !state.open || state.phase === 'pending' || !codeAcceptable(state.code),
+      noticeText: state.notice ?? '',
+    };
+  }
