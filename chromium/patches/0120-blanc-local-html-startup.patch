   return browser;
 }
 
+#if !BUILDFLAG(IS_MAC)
+namespace {
+// Local HTML files (N15) on Windows and Linux: a file the system asks Blanc to
+// open (Open With, a file manager, a second launch) goes through Blanc's own
+// grant path, as the Mac's app controller hands it over (patch 0066). Left as
+// a Chromium startup tab, Blanc's local file gate refuses it and the tab stays
+// blank. Returns whether every given tab was such a file.
+bool HandOffLocalFiles(StartupTabs& tabs) {
+  const size_t given = tabs.size();
+  std::erase_if(tabs, [](const StartupTab& tab) {
+    return tab.url.SchemeIsFile() && blanc_prototype::OpenExternalLink(tab.url);
+  });
+  return given > 0 && tabs.empty();
+}
+}  // namespace
+#endif
