+
+// Keep Chromium's certificate/error matching and persisted proceed decisions
+// (V8), with a per-profile bound of 64 decisions. The OTR delegate and its
+// non-inheriting content settings keep their own bound. Never change the SSL
+// state stored on a committed NavigationEntry when an allowance is evicted.
+void StatefulSSLHostStateDelegate::LoadCertificateChoices() {
+  if (certificate_choices_loaded_) return;
+  certificate_choices_loaded_ = true;
+  auto rows = host_content_settings_map_->GetSettingsForOneType(
+      ContentSettingsType::SSL_CERT_DECISIONS);
+  std::stable_sort(rows.begin(), rows.end(), [](const auto& a, const auto& b) {
+    return a.metadata.last_modified() < b.metadata.last_modified();
+  });
+  for (auto& row : rows) {
+    if (!row.setting_value.is_dict()) continue;
+    const auto* decisions = GetValidCertDecisionsDict(
+        DO_NOT_CREATE_DICTIONARY_ENTRIES, row.setting_value.GetDict());
+    const GURL url(row.primary_pattern.ToString());
+    if (!decisions || !url.is_valid()) continue;
+    for (auto [key, value] : *decisions)
+      if (value.is_int() && value.GetInt() == ALLOWED)
+        certificate_choices_.emplace_back(url.host(), std::string(key), base::FilePath());
+  }
+  EnforceCertificateExceptionCap();
+}
+
+void StatefulSSLHostStateDelegate::RememberCertificateChoice(
+    const std::string& host, const std::string& key, const base::FilePath& partition) {
+  const CertificateChoice choice(host, key, partition);
+  std::erase(certificate_choices_, choice);
+  certificate_choices_.push_back(choice);
+  EnforceCertificateExceptionCap();
+}
+
+void StatefulSSLHostStateDelegate::EnforceCertificateExceptionCap() {
+  bool evicted = false;
+  while (certificate_choices_.size() > certificate_exception_cap_) {
+    const auto [host, key, partition] = certificate_choices_.front();
+    certificate_choices_.pop_front();
+    if (!partition.empty()) {
+      auto found = allowed_certs_for_non_default_storage_partitions_.find(host);
+      if (found != allowed_certs_for_non_default_storage_partitions_.end()) {
+        found->second.erase(AllowedCert(key, partition));
+        if (found->second.empty()) allowed_certs_for_non_default_storage_partitions_.erase(found);
+      }
+    } else {
+      const GURL url = GetSecureGURLForHost(host);
+      auto value = host_content_settings_map_->GetWebsiteSetting(
+          url, url, ContentSettingsType::SSL_CERT_DECISIONS, nullptr);
+      if (value.is_dict()) {
+        auto* decisions = GetValidCertDecisionsDict(DO_NOT_CREATE_DICTIONARY_ENTRIES, value.GetDict());
+        if (decisions) {
+          decisions->Remove(key);
+          if (decisions->empty()) value = base::Value();
+          host_content_settings_map_->SetWebsiteSettingDefaultScope(
+              url, GURL(), ContentSettingsType::SSL_CERT_DECISIONS, std::move(value));
+        }
+      }
+    }
+    evicted = true;
+  }
+  // As with Chromium's Stop allowing, clear pooled idle connections so a
+  // subsequent navigation cannot reuse a cached SSLConfig allowance.
+  if (evicted) browser_context_->ForEachLoadedStoragePartition([](content::StoragePartition* partition) {
+    partition->GetNetworkContext()->CloseIdleConnections(base::NullCallback());
+  });
+}
+
+void StatefulSSLHostStateDelegate::SetCertificateExceptionCapForTesting(size_t cap) {
+  if (!blanc::IslandMode()) return;
+  certificate_exception_cap_ = std::min<size_t>(cap, 64);
+  LoadCertificateChoices();
+  EnforceCertificateExceptionCap();
 }
 
