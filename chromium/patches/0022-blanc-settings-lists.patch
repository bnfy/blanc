+  // Shipping's languageRow and needsRelaunch (settings-language-model.js).
+  private blancShow_(state: BlancSettingsState) {
+    const codes = state.uiLanguages.map(language => language.code);
+    if (codes.length < 2) {
+      this.blancLanguage_ = null;
+      return;
+    }
+    const endonym = new Map(
+        state.uiLanguages.map(language => [language.code, language.endonym]));
+    const system = blancSystemLanguage(
+        codes, navigator.languages.length ? navigator.languages :
+                                            [navigator.language]);
+    const active = state.launchUiLanguage ?? system;
+    const selected = state.uiLanguage === 'system' ||
+            endonym.has(state.uiLanguage) ?
+        state.uiLanguage :
+        'en';
+    const resolved = selected === 'system' ? system : selected;
+    this.blancLanguage_ = {
+      selected,
+      options: [
+        {
+          value: 'system',
+          label: blancString(
+              'blancLanguageSystem',
+              {language: endonym.get(system) ?? endonym.get('en') ?? ''}),
+        },
+        ...state.uiLanguages.map(
+            language => ({value: language.code, label: language.endonym})),
+      ],
+      relaunch: resolved !== active,
+    };
+  }
+
+  protected async onBlancLanguageChange_(event: Event) {
+    const value = (event.target as HTMLSelectElement).value;
+    this.blancShow_((await blancSettings.setUiLanguage(value)).state);
+  }
+
+  protected onBlancRelaunchClick_() {
+    blancSettings.relaunch();
+  }
