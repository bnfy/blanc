new file mode 100644
index 0000000..e482623
--- /dev/null
+++ b/chrome/browser/resources/settings/blanc_settings_proxy.ts
@@ -0,0 +1,81 @@
+// Copyright 2026 Bananify Creative. MIT; see the Blanc repository LICENSE.
+
+// Blanc's lists and language in chrome://settings (S1.7), answered by
+// ChromiumSettingsHandler (blanc/browser/ui/chromium_settings_handler.inc),
+// which validates every change as shipping's settings do.
+
+import {addWebUiListener, removeWebUiListener, sendWithPromise} from 'chrome://resources/js/cr.js';
+import type {WebUiListener} from 'chrome://resources/js/cr.js';
+
+import {loadTimeData} from './i18n_setup.js';
+
+export interface BlancBang {
+  code: string;
+  name: string;
+  template: string;
+  host: string;
+}
+
+export interface BlancLanguage {
+  code: string;
+  endonym: string;
+}
+
+export interface BlancSettingsState {
+  customBangs: BlancBang[];
+  exceptions: string[];
+  blockingEnabled: boolean;
+  blockingHealth: string;
+  uiLanguage: string;
+  uiLanguages: BlancLanguage[];
+  launchUiLanguage: string|null;
+}
+
+export interface BlancResult {
+  result: string;
+  code?: string;
+  site?: string;
+  state: BlancSettingsState;
+}
+
+export const blancSettings = {
+  get: () => sendWithPromise<BlancSettingsState>('blancSettingsGet'),
+  addBang: (code: string, name: string, template: string) =>
+      sendWithPromise<BlancResult>('blancSettingsAddBang', code, name, template),
+  removeBang: (code: string) =>
+      sendWithPromise<BlancResult>('blancSettingsRemoveBang', code),
+  addException: (site: string) =>
+      sendWithPromise<BlancResult>('blancSettingsAddException', site),
+  removeException: (site: string) =>
+      sendWithPromise<BlancResult>('blancSettingsRemoveException', site),
+  setUiLanguage: (code: string) =>
+      sendWithPromise<BlancResult>('blancSettingsSetUiLanguage', code),
+  relaunch: () => sendWithPromise<boolean>('blancSettingsRelaunch'),
+  listen: (callback: (state: BlancSettingsState) => void): WebUiListener =>
+      addWebUiListener('blanc-settings-changed', callback),
+  stopListening: (listener: WebUiListener) => removeWebUiListener(listener),
+};
+
+// Shipping's messages name their placeholders: {code}, {site}, {language}.
+export function blancString(
+    name: string, values: Record<string, string> = {}): string {
+  return loadTimeData.getString(name).replace(
+      /\{(\w+)\}/g, (_, key: string) => values[key] ?? '');
+}
+
+// Shipping's resolveLocale for "system": each preferred language's exact
+// catalog, its language, else the same language's regional catalog.
+export function blancSystemLanguage(
+    codes: string[], preferred: readonly string[]): string {
+  const primaryOf = (code: string) => code.toLowerCase().split('-')[0];
+  for (const tag of preferred) {
+    const wanted = tag.replace(/_/g, '-').toLowerCase();
+    const match = codes.find(code => code.toLowerCase() === wanted) ??
+        codes.find(code => code === primaryOf(wanted)) ??
+        codes.find(code => primaryOf(code) === primaryOf(wanted));
+    if (match) {
+      return match;
+    }
+  }
+  return 'en';
+}
