+
+// Shipping's Settings sheet look (S1.7, owner): Sunrise, or Neutral when
+// Surface style says so, in light or dark, mapped onto Chromium's own color
+// and type tokens. Set on the document element, so every shadow tree
+// inherits them; Chromium's layout stays its own.
+interface BlancPalette {
+  bg: string;
+  surface: string;
+  raised: string;
+  border: string;
+  text: string;
+  dim: string;
+  accent: string;
+  accentDim: string;
+  onAccent: string;
+}
+const PALETTES: Record<string, {light: BlancPalette, dark: BlancPalette}> = {
+  sunrise: {
+    light: {
+      bg: '#f8f2e8',
+      surface: '#f2eade',
+      raised: '#ffffff',
+      border: '#e1d7c9',
+      text: '#12100b',
+      dim: '#6b6257',
+      accent: '#805d28',
+      accentDim: 'rgba(128, 93, 40, 0.16)',
+      onAccent: '#ffffff',
+    },
+    dark: {
+      bg: '#17130f',
+      surface: '#2d251d',
+      raised: '#221d17',
+      border: '#4a3e31',
+      text: '#f7f0e5',
+      dim: '#b8aa98',
+      accent: '#d4ad66',
+      accentDim: 'rgba(212, 173, 102, 0.2)',
+      onAccent: '#17130f',
+    },
+  },
+  neutral: {
+    light: {
+      bg: '#fbfaf6',
+      surface: '#f3f1eb',
+      raised: '#ffffff',
+      border: '#e5e2da',
+      text: '#14130f',
+      dim: '#6a665e',
+      accent: '#1f1e1b',
+      accentDim: 'rgba(20, 19, 15, 0.08)',
+      onAccent: '#ffffff',
+    },
+    dark: {
+      bg: '#1b1b1b',
+      surface: '#262625',
+      raised: '#202020',
+      border: '#3a3a38',
+      text: '#f3f1ec',
+      dim: '#a9a69e',
+      accent: '#f3f1ec',
+      accentDim: 'rgba(243, 241, 236, 0.14)',
+      onAccent: '#1b1b1b',
+    },
+  },
+};
+
+function blancTokens(p: BlancPalette): Record<string, string> {
+  return {
+    '--color-sys-base': p.raised,
+    '--color-sys-surface': p.raised,
+    '--color-sys-base-container': p.surface,
+    '--color-sys-base-container-elevated': p.raised,
+    '--cr-card-background-color': p.raised,
+    '--color-sys-on-surface': p.text,
+    '--cr-primary-text-color': p.text,
+    '--color-sys-on-surface-subtle': p.dim,
+    '--cr-secondary-text-color': p.dim,
+    '--color-sys-primary': p.accent,
+    '--cr-checked-color': p.accent,
+    '--cr-link-color': p.accent,
+    '--cr-focus-outline-color': p.accent,
+    '--color-toggle-button-track-on': p.accent,
+    '--cr-toggle-checked-bar-color': p.accent,
+    '--color-sys-on-primary': p.onAccent,
+    '--color-toggle-button-thumb-on': p.onAccent,
+    '--color-sys-tonal-container': p.accentDim,
+    '--color-sys-on-tonal-container': p.text,
+    '--cr-hover-background-color': p.accentDim,
+    '--color-sys-divider': p.border,
+    '--color-sys-neutral-outline': p.border,
+    '--color-sys-tonal-outline': p.border,
+    '--cr-separator-line': `1px solid ${p.border}`,
+    '--blanc-separator-color': p.border,
+    // Shipping's sheet cards: a hairline border, 14px corners, a faint lift.
+    '--cr-card-shadow': `0 0 0 1px ${p.border}, 0 1px 2px rgba(18, 16, 11, 0.04)`,
+    '--cr-card-border-radius': '14px',
+  };
+}
+
+let blancSurface = 'sunrise';
+const darkQuery = window.matchMedia('(prefers-color-scheme: dark)');
+
+function applyBlancTheme() {
+  const palettes = PALETTES[blancSurface] ?? PALETTES['sunrise'];
+  const palette = darkQuery.matches ? palettes.dark : palettes.light;
+  const root = document.documentElement;
+  for (const [name, value] of Object.entries(blancTokens(palette))) {
+    root.style.setProperty(name, value);
+  }
+  root.style.backgroundColor = palette.bg;
+  // Shipping's UI type: Instrument Sans at width 98, +0.01em.
+  root.style.fontFamily =
+      '"Instrument Sans", "Inter", -apple-system, system-ui, sans-serif';
+  root.style.setProperty('font-variation-settings', '"wdth" 98');
+  root.style.letterSpacing = '0.01em';
+}
+
+async function loadBlancFont() {
+  const base64 = await blancSettings.font();
+  if (!base64) {
+    return;
+  }
+  const bytes = Uint8Array.from(atob(base64), c => c.charCodeAt(0));
+  const face = new FontFace('Instrument Sans', bytes.buffer, {weight: '400 700'});
+  document.fonts.add(await face.load());
+}
+
+applyBlancTheme();
+darkQuery.addEventListener('change', applyBlancTheme);
+blancSettings.get().then(state => {
+  blancSurface = state.surfaceStyle;
+  applyBlancTheme();
+});
+blancSettings.listen(state => {
+  if (state.surfaceStyle !== blancSurface) {
+    blancSurface = state.surfaceStyle;
+    applyBlancTheme();
+  }
+});
+loadBlancFont().catch(() => {});
