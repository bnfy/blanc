 # found in the LICENSE file.
 
+import("//blanc/config.gni")
 import("//build/buildflag_header.gni")
 import("//build/config/chrome_build.gni")
 import("//testing/test.gni")
@@ -16,11 +17,20 @@ buildflag_header("buildflags") {
 }
 
 if (is_win) {
+  # Blanc: each channel keeps its own folder under %LOCALAPPDATA% and its own
+  # registry key, named as on the Mac (//blanc/config.gni), so a Blanc build
+  # never shares Chromium's "Chromium\User Data" or another channel's data.
+  config("blanc_product_path") {
+    defines = [ "BLANC_PRODUCT_PATH_NAME=L\"$blanc_product_dir_name\"" ]
+  }
+
   # This file contains utility functions that only depend on kernel32.
   # Please don't add dependencies on other system libraries.
   static_library("install_static_util") {
     deps = [ "//base/version_info:generate_version_info" ]
 
+    public_configs = [ ":blanc_product_path" ]
+
     public_deps = [
       ":buildflags",
       "//base",
