 // BrowserFrameViewWin, public:
 
+namespace {
+
+// Blanc: an Island window is laid out as a tabbed window is. Its strip sits
+// where the tab strip would, at the top of the client area and under the
+// caption buttons, so no title bar is drawn above it.
+bool HasTopStrip(const BrowserView* browser_view) {
+  return browser_view->GetTabStripVisible() ||
+         blanc_prototype::IsIslandWindow(browser_view->browser());
+}
