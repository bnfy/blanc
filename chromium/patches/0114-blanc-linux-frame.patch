 }
 
 BrowserFrameViewLinux::~BrowserFrameViewLinux() = default;
+
+#if BUILDFLAG(IS_LINUX)
+void BrowserFrameViewLinux::Layout(PassKey) {
+  LayoutSuperclass<OpaqueBrowserFrameView>(this);
+  if (HasIslandStrip(GetBrowserView())) {
+    blanc_prototype::LinuxWindowButtonsChanged(GetBrowserView());
+  }
+}
+
+void BrowserFrameViewLinux::OnDeviceScaleFactorChanged(float old_scale,
+                                                       float new_scale) {
+  OpaqueBrowserFrameView::OnDeviceScaleFactorChanged(old_scale, new_scale);
+  if (HasIslandStrip(GetBrowserView())) {
+    InvalidateLayout();
+  }
+}
+
+bool BrowserFrameViewLinux::IsTabStripVisible() const {
+  return OpaqueBrowserFrameView::IsTabStripVisible() ||
+         (HasIslandStrip(GetBrowserView()) && ShouldShowCaptionButtons());
+}
+
+bool BrowserFrameViewLinux::ShouldShowWindowTitle() const {
+  return !HasIslandStrip(GetBrowserView()) &&
+         OpaqueBrowserFrameView::ShouldShowWindowTitle();
+}
+
+bool BrowserFrameViewLinux::ShouldShowWindowIcon() const {
+  return !HasIslandStrip(GetBrowserView()) &&
+         OpaqueBrowserFrameView::ShouldShowWindowIcon();
+}
+#endif  // BUILDFLAG(IS_LINUX)
 
 gfx::Insets BrowserFrameViewLinux::RestoredMirroredFrameBorderInsets() const {
   return layout_->RestoredMirroredFrameBorderInsets();
