diff --git a/chrome/browser/prefs/browser_prefs.cc b/chrome/browser/prefs/browser_prefs.cc
--- a/chrome/browser/prefs/browser_prefs.cc
+++ b/chrome/browser/prefs/browser_prefs.cc
@@ -1741,6 +1741,9 @@
   // Start Page Patron callout snooze (F35-11): 0 until closed once, then the
   // close time in ms since the epoch, as in shipping's patronCalloutDismissedAt.
   registry->RegisterInt64Pref("blanc.start.patron_callout_dismissed_at", 0);
+  // Default page zoom (F62), in percent: device-wide as shipping keeps it;
+  // every profile follows it.
+  registry->RegisterIntegerPref("blanc.page_zoom", 100);
   // Play the Sunrise when Blanc opens (F35-19), device-local as in shipping.
   registry->RegisterBooleanPref("blanc.start.launch_sunrise", false);
 #endif
