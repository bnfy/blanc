---
// Real Blanc Mail screenshots from preview builds running with sample mail.
// One caption labels the screenshots together per docs/marketing-claims.md.
// Each screenshot has a smaller copy from site/scripts/build-display-images.mjs.
interface Shot {
  name: string;
  alt: string;
  width: number;
  height: number;
  displayWidth?: number;
  class: string;
  priority?: boolean;
  sizes: string;
}
interface Props { shots: Shot[] }
const { shots } = Astro.props;
---
<figure id="iphone" class="mail-shot">
  <div class="offer-devices">
    {shots.map(({ name, alt, width, height, displayWidth = 1100, class: className, priority, sizes }) => (
      <div class={className}>
        <img
          src={`/mail/screens/${name}.webp`}
          srcset={`/mail/screens/${name}-${displayWidth}.webp ${displayWidth}w, /mail/screens/${name}.webp ${width}w`}
          sizes={sizes}
          alt={alt}
          width={width}
          height={height}
          loading="eager"
          fetchpriority={priority ? 'high' : undefined}
          decoding="async"
        />
      </div>
    ))}
  </div>
  <figcaption>Preview builds</figcaption>
</figure>
