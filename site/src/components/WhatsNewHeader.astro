---
// The What's New pages' slim header, after Chrome's: the small Blanc lockup,
// a divider, "What's new", and the release on the right
// (docs/superpowers/specs/2026-10-19-whats-new-page-design.md).
import SiteLockup from './SiteLockup.astro';

interface Props {
  version: string;   // the feature release, e.g. '1.38'
  humanDate: string; // from releases.json, e.g. 'October 18, 2026'
}
const { version, humanDate } = Astro.props;
const shortDate = humanDate.replace(/,\s*\d{4}$/, '');
---
<header class="wn-header">
  <a class="wn-brand" href="/" aria-label="Blanc Browser home"><SiteLockup /></a>
  <span class="wn-divider" aria-hidden="true"></span>
  <span class="wn-heading">What’s new</span>
  <span class="wn-version">Version {version} · {shortDate}</span>
</header>
