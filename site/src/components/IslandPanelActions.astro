---
// The open Island's back, forward, reload, favorite and collapse buttons,
// trailing the address field as in the app (src/renderer/overlay.html
// .panel-actions; the reload glyph is overlay.js ICONS.reload). Figures are
// decorative, so spans stand in for the buttons and .off for :disabled.
---
<span class="panel-actions">
  <span class="abtn"><svg viewBox="0 0 16 16"><path d="M9.75 3.5 5.25 8l4.5 4.5"/></svg></span>
  <span class="abtn off"><svg viewBox="0 0 16 16"><path d="M6.25 3.5 10.75 8l-4.5 4.5"/></svg></span>
  <span class="abtn"><svg viewBox="0 0 16 16"><path d="M12.42 10.35a5 5 0 1 1-4.42-7.35c1.4 0 2.74.56 3.74 1.53L13 5.78"/><path d="M13 3v2.78h-2.78"/></svg></span>
  <span class="abtn"><svg viewBox="0 0 16 16"><path d="M8 13.25C4.6 11 2.75 8.9 2.75 6.6a2.85 2.85 0 0 1 5.25-1.54A2.85 2.85 0 0 1 13.25 6.6c0 2.3-1.85 4.4-5.25 6.65z"/></svg></span>
  <span class="abtn"><svg viewBox="0 0 16 16"><path d="M4.5 10.25 8 6.75l3.5 3.5"/></svg></span>
</span>
