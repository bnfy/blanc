---
import topics from "../data/guide-topics.json";
import TrustIcon from "./TrustIcon.astro";
const components = import.meta.glob("./guides/*.astro", { eager: true });
// icons: optional { topicId: TrustIcon name } drawn before each label.
const { page, icons = {} } = Astro.props;
---

{
  topics
    .filter((topic) => topic.page === page)
    .map((topic) => {
      const Guide = components[`./guides/${topic.id}.astro`].default;
      return (
        <details class="answer-topic" id={topic.id} data-search-topic>
          <>
            <summary>
              {icons[topic.id] && <TrustIcon name={icons[topic.id]} />}
              {topic.label}
              <span aria-hidden="true">+</span>
            </summary>
            <div class="answer-body">
              <Guide />
              <p><a href={`/features/${topic.id}`}>Read the full guide →</a></p>
            </div>
          </>
        </details>
      );
    })
}
