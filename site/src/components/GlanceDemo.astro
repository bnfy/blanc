---
import GlanceCard from './GlanceCard.astro';
import GlanceIsland from './GlanceIsland.astro';

interface Props {
  // compact: the window alone, for a homepage tool card that carries its own
  // copy; moving the card is the one control.
  compact?: boolean;
}
const { compact = false } = Astro.props;
---
<div class="tool-feature" id="glance" aria-labelledby={compact ? undefined : 'glance-title'}>
  {!compact && <h3 id="glance-title">Look at another tab with Glance.</h3>}
  <figure class="glance-demo" id="glance-demo" aria-label="Glance demo">
    <p class="sr-only" id="glance-hint">Drag the card’s header to move it. Arrow keys move it too, and Enter puts it back.</p>
    <div class="glance-viewport" id="glance-viewport">
      <div class="glance-window" id="glance-window">
        <section class="glance-pane glance-main" aria-label="Main page illustration">
          <div class="glance-chrome">
            <GlanceIsland page="copenhagen" />
          </div>
          <div class="glance-document">
            <div class="glance-site glance-copenhagen" data-page="copenhagen">
              <div class="glance-site-nav" aria-hidden="true">
                <svg viewBox="0 0 24 24"><circle cx="10" cy="10" r="6" /><path d="m15 15 5 5" /></svg>
                <span class="copenhagen-wordmark">visit<br />copenhagen</span>
                <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
              </div>
              <div class="copenhagen-photo">
                <picture><source media="(max-width: 760px)" srcset="/revamp/glance-nyhavn-800.webp" width="800" height="364" /><img src="/revamp/glance-nyhavn.webp" width="1600" height="727" alt="Brightly colored waterfront houses at Nyhavn in Copenhagen" loading="lazy" decoding="async" draggable="false" /></picture>
              </div>
              <div class="copenhagen-title">
                <h4>Nyhavn</h4>
                <p>Copenhagen’s Colourful Harbour</p>
              </div>
            </div>
          </div>
        </section>
        <div class="glance-card-frame" id="glance-card">
          <GlanceCard host="louisiana.dk" icon="/revamp/louisiana-favicon.ico">
            <div class="glance-site glance-louisiana" data-page="louisiana">
              <img class="louisiana-photo" src="/revamp/glance-kusama.jpg" width="640" height="959" alt="Colored lights reflected in Yayoi Kusama’s Gleaming Lights of the Souls installation" loading="lazy" decoding="async" draggable="false" />
              <div class="glance-site-nav" aria-hidden="true">
                <span class="louisiana-wordmark">LOUISIANA</span>
                <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
              </div>
              <div class="louisiana-title">
                <h4>Kusama<br />installation</h4>
                <p>Gleaming Lights of the Souls</p>
              </div>
            </div>
          </GlanceCard>
          <div class="glance-card-handle" id="glance-handle" role="button" tabindex="0" aria-label="Move the Glance card" aria-describedby="glance-hint"></div>
        </div>
      </div>
    </div>
    <p class="sr-only" id="glance-status" aria-live="polite"></p>
  </figure>
</div>
