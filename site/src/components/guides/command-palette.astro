---
import slashCommandCopy from "../../../../copy/slash-commands.json";

const slashCommands = slashCommandCopy.commands.map((entry) => ({
  ...(entry.doc ?? entry),
  platforms: entry.platforms,
}));
const paletteCommands = slashCommandCopy.commands.map(({ command, hint }) => ({
  command,
  hint,
}));
---

<span id="command-title" class="anchor-alias" aria-hidden="true"></span><span
  id="command-close-title"
  class="anchor-alias"
  aria-hidden="true"></span>
<section
  class="feature-copy-grid feature-copy-grid--top"
  aria-labelledby="jump-title"
>
  <div>
    <p class="section-kicker">jump, don't hunt</p><h2 id="jump-title">
      The same input gets you to the next thing.
    </h2>
  </div>
  <div class="feature-copy-list">
    <article>
      <h3>Find a tab with a few letters.</h3><p>
        The Quick Switcher matches across open tabs, favorites, browsing
        history, and named groups. Choose a result to focus it without sorting
        through a tab strip.
      </p>
    </article>
    <article>
      <h3>Search with the engine you chose.</h3><p>
        Live provider suggestions appear alongside local matches when enabled.
        For search text, Enter opens the highlighted result. A strong match from
        your tabs, Favorites, history or groups can come first. Choose the
        search result showing your exact text to search the web. Provider
        suggestions can be turned off before first use or later in Settings.
      </p>
    </article>
    <article>
      <h3>Run a browser action with /.</h3><p>
        Type <code>/</code> to see commands for everyday browser work, including
        <code>/private</code>, <code>/find</code>, <code>/group work</code>, and <code
          >/allow-ads</code
        >.
      </p>
    </article>
    <article>
      <h3>Keep the page where it is.</h3><p>
        The command palette floats over the page instead of moving content to
        make room. Dismiss it with Escape when you are done.
      </p>
    </article>
    <article>
      <h3>Reach the tab you just closed or the set you saved.</h3><p>
        Use <a
          href="/support#reopen-closed-tabs"
          data-track="feature_cta_click"
          data-feature="reopen-closed-tabs"
          data-cta-position="related-feature">Recently Closed</a
        > to pick a tab or group, or <a
          href="/support#workspaces"
          data-track="feature_cta_click"
          data-feature="named-workspaces"
          data-cta-position="related-feature">Named Workspaces</a
        > to switch saved sets.
      </p>
    </article>
    <details class="feature-command-directory">
      <summary>
        <span>See all shipped slash commands</span>
        <span class="feature-command-directory-icon" aria-hidden="true">+</span>
      </summary>
      <dl>
        {
          slashCommands.map((entry) => (
            <div>
              <dt>
                <code>{entry.command}</code>
              </dt>
              <dd>
                {entry.hint}
                {entry.platforms?.includes("macos") ? " · macOS only" : ""}
              </dd>
            </div>
          ))
        }
      </dl>
    </details>
  </div>
</section>
<aside class="truth-note" aria-labelledby="command-note-title">
  <p class="section-kicker">one place for the little chores</p><h2
    id="command-note-title"
  >
    Switch the session. Change the browser. Stay in context.
  </h2><p>
    The command palette brings search, tab switching, and browser actions into
    one repeatable gesture. It is designed to shorten the trip between what you
    are reading and what you need to do next.
  </p><a
    class="text-link"
    href="/support#tab-groups"
    data-track="feature_cta_click"
    data-feature="command-palette"
    data-cta-position="related-feature"
    >See how commands work with tab groups <span aria-hidden="true">↗</span
    ></a>
</aside>
