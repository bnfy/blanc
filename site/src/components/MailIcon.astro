---
const { class: className = '', decorative = false } = Astro.props;
---
<span class={`mail-icon ${className}`} role={decorative ? undefined : 'img'} aria-label={decorative ? undefined : 'Blanc Mail ivory envelope with the gold Sunrise mark'} aria-hidden={decorative ? 'true' : undefined}>
  <img src="/blanc-mail-icon-art.png?v=f152d8ad" alt="" width="1024" height="1024" />
</span>
