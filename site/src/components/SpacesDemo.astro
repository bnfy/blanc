---
// Blanc Spaces on the homepage: the open Island in a space, with its Spaces
// menu open below the footer's Spaces button, which shows the current space's
// tile (the resting Island carries no Space mark), drawn from the app's own markup, CSS, palette and symbols
// (site/src/lib/native-island-art.mjs), with four sample spaces.
// spaces-demo.js switches between them: the panel lists the chosen space's tabs.
import styles from '../../../src/renderer/styles.css?raw';
import overlay from '../../../src/renderer/overlay.html?raw';
import overlayScript from '../../../src/renderer/overlay.js?raw';
import workspaceUi from '../../../src/renderer/workspace-ui.js?raw';
import identitySource from '../../../src/renderer/space-identity.js?raw';
import messages from '../../../copy/messages/en.json';
import nativeFont from '../../../src/renderer/pages/inter-latin.woff2?url';
import nativeTextFont from '../../../src/renderer/pages/instrument-sans-latin-wdth-normal.woff2?url';
import { loadSpaceIdentity, nativeSpacesArt, namespaceNativeArt } from '../lib/native-island-art.mjs';
import { fitSpacesDemo } from '../scripts/spaces-demo.js';

// Preset colours and symbols from space-identity.js; favicons are bundled.
// Each space's tabs are what the panel lists while it is current.
const spaces = [
  { name: 'Work', color: '#376694', symbol: 'briefcase', pages: [
    { title: 'Pull requests', url: 'https://github.com/pulls', favicon: '/favicons/github.com.ico' },
    { title: 'Array.prototype.at()', url: 'https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/at', favicon: '/favicons/developer.mozilla.org.ico' },
    { title: 'Hacker News', url: 'https://news.ycombinator.com/', favicon: '/favicons/news.ycombinator.com.ico' },
    { title: 'Inbox', url: 'https://mail.google.com/mail/u/0/#inbox', favicon: '/favicons/gmail.com.ico' },
  ] },
  { name: 'Home', color: '#426c4c', symbol: 'house', pages: [
    { title: 'Home projects', url: 'https://www.notion.so/', favicon: '/favicons/notion.so.ico' },
    { title: 'Watch later', url: 'https://www.youtube.com/playlist?list=WL', favicon: '/favicons/youtube.com.ico' },
    { title: 'r/HomeImprovement', url: 'https://www.reddit.com/r/HomeImprovement/', favicon: '/favicons/reddit.com.ico' },
  ] },
  { name: 'Reading', color: '#6757a3', symbol: 'book', pages: [
    { title: 'Today’s Paper', url: 'https://www.nytimes.com/section/todayspaper', favicon: '/favicons/nytimes.com.ico' },
    { title: 'Reviews', url: 'https://www.theverge.com/reviews', favicon: '/favicons/theverge.com.ico' },
    { title: '9to5Mac', url: 'https://9to5mac.com/', favicon: '/favicons/9to5mac.com.ico' },
  ] },
  { name: 'Weekend', color: '#974f2a', symbol: 'coffee', pages: [
    { title: 'Netflix', url: 'https://www.netflix.com/browse', favicon: '/favicons/netflix.com.ico' },
    { title: 'Nintendo', url: 'https://www.nintendo.com/', favicon: '/favicons/nintendo.com.ico' },
  ] },
].map(space => ({ ...space, tabs: space.pages.length }));
const identity = loadSpaceIdentity(identitySource);
const art = nativeSpacesArt({
  styles, overlay, overlayScript, workspaceUi, identity, spaces,
  newSpaceLabel: messages['ws.new'].message,
  triggerLabel: messages['ws.trigger.current'].message,
});
// The panel keeps room for the longest space's tabs, so switching never moves
// the menu. The menu hangs below the panel, lined up as the app lines it up
// with the footer's Spaces button (its transform origin, 85% across, sits
// under the button); the script measures that into --menu-x.
const rows = Math.max(...spaces.map(space => space.pages.length));
const presentation = `
  :host {display:block; --demo-width:620px; font-family:var(--font-text); letter-spacing:var(--text-tracking);word-spacing:var(--text-word-spacing); font-size:13px; color:var(--text);}
  [hidden] {display:none!important;}
  .native-stage {width:var(--demo-width); zoom:var(--demo-scale, 1); padding:0 0 28px;}
  #islandPanel {width:auto; max-width:none; max-height:none;}
  #islandList {min-height:calc(${rows} * 40px); overflow:visible;}
  #addressInput {pointer-events:none;}
  .native-menu-row {margin-top:8px; padding-left:var(--menu-x, 300px);}
  #workspaceSwitcher.ws-switcher {position:relative; inset:auto; max-width:none; max-height:none;}
  /* The app's list scrolls and contains its overscroll; the demo's four
     spaces never overflow, and a page scroll over it must reach the page. */
  #workspaceSwitcherList {overflow:visible; overscroll-behavior:auto;}
  .ws-cmd {cursor:default;}
`;
const raw = `<div class="native-stage"><div class="native-panel-row" aria-hidden="true" inert>${art.panel}</div><div class="native-menu-row">${art.menu}</div></div>`;
// Namespace extracted IDs: the hero draws its own Island on the same page.
const { html, css } = namespaceNativeArt({ html: raw, css: art.css + presentation }, 'spaces-demo-');
---
<style is:inline set:html={`@font-face {font-family:Inter;src:url('${nativeFont}') format('woff2');font-style:normal;font-weight:100 900;font-display:swap;}@font-face {font-family:"Instrument Sans";src:url('${nativeTextFont}') format('woff2');font-style:normal;font-weight:400 700;font-stretch:75% 100%;font-display:swap;}`} />
<blanc-spaces-demo class="spaces-native-demo" data-appearance="light" data-trigger-label={messages['ws.trigger.current'].message}>
  <template shadowrootmode="open">
    <style is:inline set:html={css} />
    <Fragment set:html={html} />
  </template>
</blanc-spaces-demo>
<script is:inline set:html={`(() => { const host = document.currentScript.previousElementSibling; (${fitSpacesDemo.toString()})(host, window); })();`} />
<script src="../scripts/spaces-demo.js"></script>
