---
// Blanc Spaces on the homepage: the resting Island in a space with its Spaces
// menu open below the mark, drawn from the app's own markup, CSS, palette and
// symbols (site/src/lib/native-island-art.mjs), with four sample spaces.
// spaces-demo.js switches between them as renderer.js does in the app.
import styles from '../../../src/renderer/styles.css?raw';
import islandDocument from '../../../src/renderer/index.html?raw';
import renderer from '../../../src/renderer/renderer.js?raw';
import overlay from '../../../src/renderer/overlay.html?raw';
import workspaceUi from '../../../src/renderer/workspace-ui.js?raw';
import identitySource from '../../../src/renderer/space-identity.js?raw';
import messages from '../../../copy/messages/en.json';
import nativeFont from '../../../src/renderer/pages/inter-latin.woff2?url';
import nativeTextFont from '../../../src/renderer/pages/instrument-sans-latin-wdth-normal.woff2?url';
import { loadSpaceIdentity, nativeSpacesArt, namespaceNativeArt } from '../lib/native-island-art.mjs';
import { fitSpacesDemo } from '../scripts/spaces-demo.js';

// Preset colours and symbols from space-identity.js; favicons are bundled.
const spaces = [
  { name: 'Work', color: '#376694', symbol: 'briefcase', tabs: 6, domain: 'github.com', favicon: '/favicons/github.com.ico' },
  { name: 'Home', color: '#426c4c', symbol: 'house', tabs: 4, domain: 'notion.so', favicon: '/favicons/notion.so.ico' },
  { name: 'Reading', color: '#6757a3', symbol: 'book', tabs: 5, domain: 'nytimes.com', favicon: '/favicons/nytimes.com.ico' },
  { name: 'Weekend', color: '#974f2a', symbol: 'coffee', tabs: 3, domain: 'netflix.com', favicon: '/favicons/netflix.com.ico' },
];
const identity = loadSpaceIdentity(identitySource);
const art = nativeSpacesArt({
  styles, document: islandDocument, renderer, overlay, workspaceUi, identity, spaces,
  newSpaceLabel: messages['ws.new'].message,
});
// A detail of the Island: the stage is about the menu's width, so the pill
// runs past its right edge and fades out there (the hero above shows it
// whole). The menu hangs 6px below the Island, lined up with the mark's left
// edge (chrome-layout.js SPACES_MENU_GAP, renderer.js spacesAnchor); the
// script measures that edge into --menu-x. The stage keeps one width for
// every space so switching never rescales the demo.
const presentation = `
  :host {display:block; --demo-width:400px; font-family:var(--font-text); letter-spacing:var(--text-tracking);word-spacing:var(--text-word-spacing); font-size:13px; color:var(--text);}
  @media (max-width: 760px) {:host {--demo-width:340px;}}
  [hidden] {display:none!important;}
  .native-stage {width:var(--demo-width); zoom:var(--demo-scale, 1); padding-bottom:28px;}
  .native-pill-row {display:flex; overflow:hidden; padding:16px 0 18px 16px; margin:-16px 0 -18px -16px;
    mask-image:linear-gradient(to right, #000 calc(100% - 96px), transparent);}
  #islandPill {margin:0; flex:none; width:max-content; max-width:none;}
  .native-menu-row {margin-top:6px; padding-left:var(--menu-x, 9px);}
  #workspaceSwitcher.ws-switcher {position:relative; inset:auto; max-width:none; max-height:none;}
  .ws-cmd {cursor:default;}
`;
const raw = `<div class="native-stage"><div class="native-pill-row" aria-hidden="true" inert>${art.pill}</div><div class="native-menu-row">${art.menu}</div></div>`;
// Namespace extracted IDs: the hero draws its own Island on the same page.
const { html, css } = namespaceNativeArt({ html: raw, css: art.css + presentation }, 'spaces-demo-');
---
<style is:inline set:html={`@font-face {font-family:Inter;src:url('${nativeFont}') format('woff2');font-style:normal;font-weight:100 900;font-display:swap;}@font-face {font-family:"Instrument Sans";src:url('${nativeTextFont}') format('woff2');font-style:normal;font-weight:400 700;font-stretch:75% 100%;font-display:swap;}`} />
<blanc-spaces-demo class="spaces-native-demo" data-appearance="light">
  <template shadowrootmode="open">
    <style is:inline set:html={css} />
    <Fragment set:html={html} />
  </template>
</blanc-spaces-demo>
<script is:inline set:html={`(() => { const host = document.currentScript.previousElementSibling; host.dataset.appearance = document.documentElement.dataset.homeAppearance === 'dark' ? 'dark' : 'light'; (${fitSpacesDemo.toString()})(host, window); })();`} />
<script src="../scripts/spaces-demo.js"></script>
