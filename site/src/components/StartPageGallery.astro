---
// The Start Page hero: customized Billboard Start Pages from public v1.41.0
// (docs/website-captures-v1.41.0.json) as a fan of overlapping cards that
// drifts sideways on its own. The card nearest the middle comes forward and
// the rest recede by distance, so the row needs no numbers or controls.
// Drag, swipe or a sideways trackpad/wheel scroll moves it 1:1; a released
// drag carries its momentum. Pointing at it, moving it or keyboard focus holds
// the drift. Reduced motion gets a still, scrollable row. The set is rendered
// twice so the loop never shows an edge: the first copy only fills the left of
// the row, so it is hidden from assistive tech and the tab order, and the
// second copy is the real one.
import designs from '../data/start-page-designs.json';
const passes = [0, 1];
const { variant = '' } = Astro.props;
const total = designs.length;
---
<section class="design-fan" aria-label="Customized Start Pages" data-design-fan data-variant={variant || undefined}>
  <div class="design-fan-glow" data-fan-glow aria-hidden="true"></div>
  <div class="design-fan-viewport" data-fan-viewport>
    <ul class="design-fan-track" data-fan-track>
      {passes.map((pass) => designs.map((design, index) => (
        <li class="design-fan-card" data-fan-card data-tint={design.tint} data-caption={design.credit ? `${design.style} · ${design.credit}` : design.style} aria-hidden={pass ? undefined : 'true'}>
          <a href={`/feature-captures/clock-${design.name}-v1.41.0.png`} tabindex={pass ? undefined : -1} draggable="false">
            <img src={`/feature-captures/clock-${design.name}-v1.41.0.webp`} width="1440" height="900" loading={(pass === 1 && index < 4) || (pass === 0 && index >= total - 2) ? 'eager' : 'lazy'} decoding="async" draggable="false" alt={pass ? `${design.alt} ${design.credit ? `(${design.credit})` : ''}`.trim() : ''} />
          </a>
        </li>
      )))}
    </ul>
  </div>
  <p class="design-fan-caption" data-fan-caption aria-hidden="true">{designs[0].credit ? `${designs[0].style} · ${designs[0].credit}` : designs[0].style}</p>
</section>

<script>
  // Drift speed, and Apple's scroll deceleration for a released drag
  // (projection d / (1 − d) per ms; see Designing Fluid Interfaces).
  const DRIFT = 28; // px/s
  const DECAY = 0.998;
  const DRAG_SLOP = 8; // px before a press becomes a drag
  const WHEEL_IDLE = 160; // ms without wheel events before the drift resumes

  for (const root of document.querySelectorAll<HTMLElement>('[data-design-fan]')) {
    const viewport = root.querySelector<HTMLElement>('[data-fan-viewport]')!;
    const track = root.querySelector<HTMLElement>('[data-fan-track]')!;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-fan-card]')];
    const caption = root.querySelector<HTMLElement>('[data-fan-caption]')!;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    if (reduceMotion.matches) continue; // the CSS still row scrolls natively

    root.dataset.live = 'true';
    let x = 0; // track offset, px (negative moves left)
    let velocity = -DRIFT; // px/s; eases back toward -DRIFT after a fling
    let held = false; // pointed at, or keyboard focus inside
    let drag: { id: number; startX: number; lastX: number; lastT: number; v: number; moved: boolean } | null = null;
    let wheeling = 0; // timer while a sideways scroll is moving the fan
    let last = 0;
    let loopWidth = 0;
    let lead = 0; // keeps the wrap off screen: x stays in (-loopWidth - lead, -lead]
    let centered = -1;
    let onScreen = true;
    let running = false;
    let stopped = false;
    // Card geometry changes only with the layout, so it is measured once per
    // resize rather than read back (and forced) on every frame.
    let centers: number[] = [];
    let widths: number[] = [];

    const measure = () => {
      centers = cards.map((card) => card.offsetLeft + card.offsetWidth / 2);
      widths = cards.map((card) => card.offsetWidth);
      loopWidth = cards[cards.length / 2].offsetLeft - cards[0].offsetLeft;
      // The first copy must always reach past the viewport's left edge, so
      // the jump by one loop happens where both copies look the same.
      lead = cards[0].offsetLeft + viewport.clientWidth;
    };
    const wrap = () => {
      if (!loopWidth) return;
      while (x <= -loopWidth - lead) x += loopWidth;
      while (x > -lead) x -= loopWidth;
    };
    const paint = () => {
      track.style.transform = `translate3d(${x}px, 0, 0)`;
      const mid = viewport.clientWidth / 2;
      let best = Infinity;
      let bestIndex = 0;
      for (let i = 0; i < cards.length; i++) {
        const distance = (centers[i] + x - mid) / widths[i]; // in card widths
        const away = Math.abs(distance);
        const style = cards[i].style;
        style.setProperty('--depth', Math.min(1, away).toFixed(3));
        style.setProperty('--offset', Math.max(-1, Math.min(1, distance)).toFixed(3));
        style.zIndex = String(1000 - Math.round(away * 100));
        if (away < best) { best = away; bestIndex = i; }
      }
      const index = bestIndex % (cards.length / 2);
      if (index !== centered) {
        centered = index;
        caption.classList.remove('is-shown');
        void caption.offsetWidth; // restart the fade
        caption.textContent = cards[bestIndex].dataset.caption ?? '';
        root.style.setProperty('--fan-tint', cards[bestIndex].dataset.tint ?? '');
        caption.classList.add('is-shown');
        // Warm the captures on both sides before they arrive.
        for (const k of [-2, -1, 1, 2, 3]) {
          const img = cards[(bestIndex + k + cards.length) % cards.length].querySelector('img');
          if (img) img.loading = 'eager';
        }
      }
    };
    const frame = (now: number) => {
      if (stopped || !onScreen) { running = false; return; }
      const dt = Math.min(64, now - last);
      last = now;
      if (!drag && !wheeling) {
        const target = held ? 0 : -DRIFT;
        // Momentum decays like a scroll view, then blends into the drift.
        const away = velocity - target;
        velocity = target + away * Math.pow(DECAY, dt);
        x += velocity * (dt / 1000);
        wrap();
      }
      paint();
      requestAnimationFrame(frame);
    };
    const start = () => {
      if (running || stopped || !onScreen) return;
      running = true;
      requestAnimationFrame((now) => { last = now; frame(now); });
    };

    viewport.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      drag = { id: event.pointerId, startX: event.clientX, lastX: event.clientX, lastT: event.timeStamp, v: 0, moved: false };
    });
    viewport.addEventListener('pointermove', (event) => {
      if (!drag || event.pointerId !== drag.id) return;
      if (!drag.moved && Math.abs(event.clientX - drag.startX) < DRAG_SLOP) return;
      if (!drag.moved) { drag.moved = true; viewport.setPointerCapture(event.pointerId); root.dataset.dragging = 'true'; }
      const dx = event.clientX - drag.lastX;
      const dt = Math.max(1, event.timeStamp - drag.lastT);
      x += dx; // 1:1 with the pointer, from wherever it was grabbed
      wrap();
      drag.v = 0.6 * (dx / dt) * 1000 + 0.4 * drag.v; // smoothed px/s
      drag.lastX = event.clientX;
      drag.lastT = event.timeStamp;
    });
    // A drag's own click (fired right after pointerup) must not open a card;
    // the guard lives only until the next task, so it never eats a later click.
    const swallowClick = (event: Event) => { event.preventDefault(); event.stopPropagation(); };
    const release = (event: PointerEvent) => {
      if (!drag || event.pointerId !== drag.id) return;
      // Hand the finger's speed to the momentum, so there is no seam.
      if (drag.moved) velocity = event.timeStamp - drag.lastT > 80 ? 0 : drag.v;
      delete root.dataset.dragging;
      const moved = drag.moved;
      drag = null;
      if (moved) {
        root.addEventListener('click', swallowClick, { capture: true, once: true });
        setTimeout(() => root.removeEventListener('click', swallowClick, { capture: true }), 0);
      }
    };
    viewport.addEventListener('pointerup', release);
    viewport.addEventListener('pointercancel', release);

    // A sideways trackpad swipe or wheel moves the fan 1:1. The system already
    // supplies the momentum of a trackpad flick as more wheel events, so none
    // is added here; once they stop, the drift resumes from rest. Vertical
    // scrolling is left to the page.
    viewport.addEventListener('wheel', (event) => {
      if (Math.abs(event.deltaX) <= Math.abs(event.deltaY)) return;
      event.preventDefault();
      const scale = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? viewport.clientWidth : 1;
      x -= event.deltaX * scale;
      wrap();
      velocity = 0;
      clearTimeout(wheeling);
      wheeling = window.setTimeout(() => { wheeling = 0; }, WHEEL_IDLE);
    }, { passive: false });

    // Keyboard focus holds the drift; a mouse click's focus does not.
    const keyboardFocusInside = () => !!root.querySelector(':focus-visible');
    root.addEventListener('pointerenter', (event) => { if (event.pointerType === 'mouse') held = true; });
    root.addEventListener('pointerleave', () => { held = keyboardFocusInside(); });
    // A focused card glides to the middle and the fan holds still.
    root.addEventListener('focusin', (event) => {
      const target = event.target as HTMLElement;
      if (!target.matches(':focus-visible')) return;
      held = true;
      const card = target.closest<HTMLElement>('[data-fan-card]');
      if (!card) return;
      const offset = viewport.clientWidth / 2 - centers[cards.indexOf(card)] - x;
      velocity = (offset * (1 - DECAY)) / DECAY * 1000; // projects exactly onto the card
    });
    root.addEventListener('focusout', (event) => {
      if (!root.contains(event.relatedTarget as Node | null)) held = root.matches(':hover');
    });
    // The track moves by transform alone; focusing a card may still make the
    // browser scroll the clipped viewport, so that scroll is always undone.
    viewport.addEventListener('scroll', () => { if (viewport.scrollLeft) viewport.scrollLeft = 0; });
    // Turning on reduced motion stops the fan where it is, as a still row.
    reduceMotion.addEventListener('change', () => {
      if (!reduceMotion.matches) return;
      stopped = true;
      delete root.dataset.live;
      track.style.transform = '';
      for (const card of cards) { card.style.removeProperty('--depth'); card.style.removeProperty('--offset'); card.style.zIndex = ''; }
    });
    addEventListener('resize', () => { measure(); wrap(); });
    // Off screen, the fan does no work at all.
    new IntersectionObserver((entries) => {
      onScreen = entries.some((entry) => entry.isIntersecting);
      start();
    }).observe(root);

    measure();
    // Start with the real (second) copy's first card in the middle; the first
    // copy fills the row to its left.
    x = viewport.clientWidth / 2 - centers[cards.length / 2];
    wrap();
    paint();
    start();
  }
</script>
