<div id="consent" class="consent" role="dialog" aria-modal="false" aria-labelledby="consentTitle" aria-describedby="consentDescription" hidden>
  <h2 id="consentTitle">Privacy choices</h2>
  <p id="consentDescription" class="consent-copy">Google analytics and limited Google and OpenAI ad measurement require your choice in the EEA, UK and Switzerland, and are on by default elsewhere. You can turn them off here. Cloudflare counts page views without cookies.</p>
  <p id="consentStatus" class="consent-copy" role="status"></p>
  <div class="consent-actions">
    <button id="consentAllow" type="button">Turn on</button>
    <button id="consentDeny" class="ghost" type="button">Turn off</button>
    <button id="consentClose" class="ghost" type="button">Close</button>
    <a href="/privacy">Privacy details</a>
  </div>
</div>
