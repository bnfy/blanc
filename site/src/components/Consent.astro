<div id="consent" class="consent" role="dialog" aria-modal="false" aria-labelledby="consentTitle" aria-describedby="consentDescription" hidden>
  <h2 id="consentTitle">Privacy choices</h2>
  <p id="consentDescription" class="consent-copy">Optional Google analytics and limited ad measurement stay off until you allow them. Cloudflare counts page views without cookies.</p>
  <p id="consentStatus" class="consent-copy" role="status"></p>
  <div class="consent-actions">
    <button id="consentAllow" type="button">Allow</button>
    <button id="consentDeny" class="ghost" type="button">No thanks</button>
    <button id="consentClose" class="ghost" type="button">Close</button>
    <a href="/privacy">Privacy details</a>
  </div>
</div>
