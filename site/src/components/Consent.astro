<div
  id="consent"
  class="consent"
  role="dialog"
  aria-modal="false"
  aria-labelledby="consentTitle"
  aria-describedby="consentDescription"
  hidden
>
  <h2 id="consentTitle">Help improve Blanc</h2>
  <p id="consentDescription" class="consent-copy">
    Allow analytics and limited ad measurement to see what visitors explore.
  </p>
  <div class="consent-actions">
    <button id="consentAllow" type="button">Allow</button>
    <button id="consentDeny" class="ghost" type="button">No thanks</button>
    <a href="/privacy">Privacy details</a>
  </div>
</div>
