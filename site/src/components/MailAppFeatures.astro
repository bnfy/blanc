---
const features = [
  { title: 'Every account together', text: 'Up to five Gmail accounts in one unified inbox, each with its own color. One search covers all of them.',
    glyph: '<rect x="2.5" y="7.5" width="15" height="11" rx="2" /><path d="m3 9 7 4.8L17 9" /><path d="M6.5 4.5h12a3 3 0 0 1 3 3v8" />' },
  { title: 'Groups', text: 'Move conversations into a named group, like “Read on the flight”, and they leave your Inbox to wait there until you’re ready.',
    glyph: '<path d="M7 3.5h10a1.5 1.5 0 0 1 1.5 1.5v15.5L12 16.5l-6.5 4V5A1.5 1.5 0 0 1 7 3.5Z" />' },
  { title: 'Read with scripts blocked', text: 'Blanc Mail removes scripts and embedded forms before displaying an email. Opening a message can’t run the sender’s JavaScript on your Mac.',
    glyph: '<path d="M12 3 5 6v5c0 4.4 3 8.3 7 10 4-1.7 7-5.6 7-10V6z" /><path d="m9 12 2 2 4-4" />' },
  { title: 'Gmail and Proton Mail', text: 'Connect a Google account directly, or a Proton account through Proton Mail Bridge on your Mac. Mail is stored locally for reading and draft recovery.',
    glyph: '<rect x="3" y="5.5" width="18" height="13" rx="2.5" /><path d="m3.5 7 8.5 6 8.5-6" />' },
  { title: 'Send without tracking', text: 'Blanc Mail sends your message without adding tracking pixels, rewriting links to count clicks, or asking the recipient for a read receipt.',
    glyph: '<path d="m3 10 17-7-6 17-3.5-7L3 10Z" /><path d="M10.5 13 20 3" />' },
  { title: 'Later, on your terms', text: 'Snooze a conversation until you need it, or write now and send later. Scheduled mail goes out the next time Blanc Mail is running and online on your Mac.',
    glyph: '<circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" />' },
  { title: 'Ghost Mode', text: 'Hide a conversation or a whole Gmail label from view, then unlock it with Touch ID or your password. It locks again on a timer. Ghost Mode keeps things off your screen; it isn’t encryption.',
    glyph: '<path d="M8 10.5V8a4 4 0 0 1 8 0v2.5" /><rect x="5.5" y="10.5" width="13" height="10" rx="2.5" />' },
  { title: 'Share photos without geotags', text: 'When you attach a JPEG or HEIC photo, Blanc Mail removes its GPS location and camera details on your Mac. Forwarded attachments keep their original metadata.',
    glyph: '<rect x="3" y="4" width="18" height="16" rx="2.5" /><circle cx="8.5" cy="9" r="1.5" /><path d="m4 18 5-5 3 3 4.5-6 4.5 6" />' },
  { title: 'Drafts that keep up', text: 'Move a draft to another account without losing a word. If anything interrupts you, your draft picks up right where you left off.',
    glyph: '<path d="M4 20h4L19 9l-4-4L4 16v4Z" /><path d="m13.5 6.5 4 4" />' },
];
---
<section id="features" class="overview-section mail-features" aria-labelledby="mail-features-title">
  <h2 id="mail-features-title"><span class="mail-gold-text">Every account, one calm inbox.</span></h2>
  <svg width="0" height="0" aria-hidden="true" focusable="false" class="mail-glyph-defs">
    <defs>
      <linearGradient id="mail-gilt-stroke" gradientUnits="userSpaceOnUse" x1="0" y1="2" x2="0" y2="22">
        <stop offset="0" stop-color="#f6e7bd" />
        <stop offset=".45" stop-color="#e0c084" />
        <stop offset=".75" stop-color="#b48c4a" />
        <stop offset="1" stop-color="#e8cf96" />
      </linearGradient>
    </defs>
  </svg>
  <ul class="mail-feature-grid" role="list">
    {features.map(feature => (
      <li class="mail-feature">
        <span class="mail-feature-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" stroke="url(#mail-gilt-stroke) #e0c084" set:html={feature.glyph} />
        </span>
        <h3>{feature.title}</h3>
        <p>{feature.text}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .mail-features h2 {
    max-width: 20ch;
    margin: 0 auto;
    font-size: clamp(34px, 4.6vw, 60px);
    line-height: 1.05;
    text-align: center;
  }
  .mail-glyph-defs { position: absolute; }
  .mail-feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin: 52px 0 0;
    padding: 0;
    list-style: none;
  }
  .mail-feature {
    padding: 28px 26px 30px;
    border-radius: 22px;
    background: linear-gradient(180deg, #15110b, #0b0906);
    box-shadow: inset 0 0 0 1px #f2ead81a, inset 0 1px 0 #fff3d614;
    transition: box-shadow 240ms ease;
  }
  .mail-feature-badge {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 22px;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 30%, #e0c0842e, #e0c08400 72%);
    box-shadow: inset 0 0 0 1px #e0c08459;
  }
  .mail-feature-badge svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .mail-feature h3 {
    margin: 0 0 8px;
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: .02em;
    text-wrap: wrap;
  }
  .mail-feature p {
    margin: 0;
    color: var(--mail-band-muted);
    font-size: 15.5px;
    line-height: 1.6;
    letter-spacing: .025em;
    text-wrap: pretty;
  }
  @media (hover: hover) {
    .mail-feature:hover { box-shadow: inset 0 0 0 1px #e0c08459, inset 0 1px 0 #fff3d626, 0 24px 48px -28px #e0c08433; }
  }
  @media (max-width: 900px) {
    .mail-feature-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .mail-feature-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .mail-feature {
        animation: mail-feature-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }
      @keyframes mail-feature-rise { from { opacity: 0; translate: 0 10px; } }
    }
  }
  @media (prefers-contrast: more) {
    .mail-feature { box-shadow: inset 0 0 0 1px #f2ead899; }
    .mail-feature p { color: #e6dccb; }
  }
  @media (forced-colors: active) {
    .mail-feature, .mail-feature-badge { outline: 1px solid CanvasText; }
    .mail-feature-badge svg { stroke: CanvasText; }
  }
</style>
