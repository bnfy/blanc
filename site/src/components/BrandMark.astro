---
const { class: className, ariaLabel, small = false } = Astro.props;
---
<span class:list={['blanc-mark', { 'blanc-mark--small': small }, className]} role={ariaLabel ? 'img' : undefined} aria-label={ariaLabel} aria-hidden={ariaLabel ? undefined : 'true'}></span>
<style>
  .blanc-mark {
    display: block;
    background: currentColor;
    -webkit-mask: url("data:image/png;base64,") center / contain no-repeat;
    mask: url("data:image/png;base64,") center / contain no-repeat;
  }
  .blanc-mark--small {
    -webkit-mask-image: url("data:image/png;base64,");
    mask-image: url("data:image/png;base64,");
  }
</style>
