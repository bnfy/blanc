---
import { directLinks, pagePath } from "../data/navigation.mjs";
const { current = null } = Astro.props;
const onHome = pagePath(Astro.url.pathname) === "/";
const mailPath = pagePath(Astro.url.pathname);
const onMail = mailPath === "/mail" || mailPath.startsWith("/mail/");
const isCurrent = (link) => current === link.key || (link.key === "mail" && onMail);
const hrefFor = (href) =>
  onHome && href.startsWith("/#") ? href.slice(1) : href;
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header revamp-header">
  <nav class="site-nav revamp-nav" aria-label="Primary navigation">
    <a class="site-brand" href="/" aria-label="Blanc Browser home"
      ><span class="site-lockup site-lockup--small" aria-hidden="true"
        ><img
          class="site-lockup-mark"
          src="/lockup/sunrise-mark-256.webp"
          width="256"
          height="256"
          alt=""
        /><img
          class="site-lockup-word"
          src="/lockup/blanc-word-small-white.svg"
          width="2466"
          height="762"
          alt=""
        /></span
      ></a
    >
    <div class="site-nav-links" id="site-menu">
      {
        directLinks.map((link) => (
          <a
            class="revamp-nav-link"
            href={hrefFor(link.href)}
            aria-current={isCurrent(link) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </div>
    <a
      class="site-nav-cta"
      href={current === "download" ? "#download-options" : "/download"}
      >{
        onMail ? (
          <>
            <span class="cta-wide">Browser download</span><span class="cta-narrow"
              >Download</span
            >
          </>
        ) : (
          "Download"
        )
      }</a
    >
    <button
      class="site-menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      hidden>Menu</button
    >
  </nav>
  {onHome && <div class="site-progress" aria-hidden="true" />}
</header>
<script is:inline>
  // Runs right after the bar, before first paint, so a phone never flashes the
  // full link row. Without scripting the links wrap onto a second row instead.
  (() => {
    const header = document.querySelector(".revamp-header");
    const toggle = header?.querySelector(".site-menu-toggle");
    if (!header || !toggle) return;
    const setOpen = (open) => {
      header.dataset.menu = open ? "open" : "closed";
      toggle.setAttribute("aria-expanded", String(open));
      toggle.textContent = open ? "Close" : "Menu";
    };
    setOpen(false);
    toggle.hidden = false;
    toggle.addEventListener("click", () => setOpen(header.dataset.menu !== "open"));
    header.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || header.dataset.menu !== "open") return;
      setOpen(false);
      toggle.focus();
    });
    header.querySelectorAll("#site-menu a").forEach((link) =>
      link.addEventListener("click", () => setOpen(false)),
    );
    // Widening past the phone layout puts the links back in the bar.
    matchMedia("(min-width: 921px)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
    addEventListener("pageshow", () => setOpen(false));
  })();
</script>
