---
import { directLinks, pagePath } from "../data/navigation.mjs";
const { current = null } = Astro.props;
const onHome = pagePath(Astro.url.pathname) === "/";
const mailPath = pagePath(Astro.url.pathname);
const onMail = mailPath === "/mail" || mailPath.startsWith("/mail/");
const isCurrent = (link) => current === link.key || (link.key === "mail" && onMail);
const hrefFor = (href) =>
  onHome && href.startsWith("/#") ? href.slice(1) : href;
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header revamp-header">
  <nav class="site-nav revamp-nav" aria-label="Primary navigation">
    <a class="site-brand" href="/" aria-label="Blanc Browser home"
      ><img
        class="site-brand-mark"
        src="/sunrise-hero-mark.png"
        width="23"
        height="23"
        alt=""
      /></a
    >
    {
      directLinks.map((link) => (
        <a
          class:list={[
            "revamp-nav-link",
            {
              "nav-secondary": ["mail", "privacy", "patron", "about"].includes(
                link.key,
              ),
              "nav-mail": link.key === "mail",
            },
          ]}
          href={hrefFor(link.href)}
          aria-current={isCurrent(link) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
    <a
      class="site-nav-cta"
      href={current === "download" ? "#download-options" : "/download"}
      >{
        onMail ? (
          <>
            <span class="cta-wide">Browser download</span><span class="cta-narrow"
              >Download</span
            >
          </>
        ) : (
          "Download"
        )
      }</a
    >
    {
      onHome && (
        <button
          class="site-appearance"
          id="home-appearance"
          type="button"
          aria-label="Dark mode"
          aria-pressed="false"
          title="Dark mode"
          hidden
        >
          <svg class="appearance-moon" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M15.6 12.6A6.6 6.6 0 0 1 7.4 4.4a6.6 6.6 0 1 0 8.2 8.2Z" />
          </svg>
          <svg class="appearance-sun" viewBox="0 0 20 20" aria-hidden="true">
            <circle cx="10" cy="10" r="3.4" />
            <path d="M10 2.5v1.8M10 15.7v1.8M2.5 10h1.8M15.7 10h1.8M4.7 4.7l1.3 1.3M14 14l1.3 1.3M4.7 15.3 6 14M14 6l1.3-1.3" />
          </svg>
        </button>
      )
    }
  </nav>
</header>
<script>
  const header = document.querySelector<HTMLElement>(".revamp-header");
  if (header) {
    let previousY = window.scrollY;
    let direction = 0;
    let travel = 0;
    let frame = 0;
    function update() {
      frame = 0;
      const limit = Math.max(
        0,
        document.documentElement.scrollHeight - innerHeight,
      );
      const y = Math.max(0, Math.min(scrollY, limit));
      const delta = y - previousY;
      previousY = y;
      if (!header) return;
      if (y <= header.offsetHeight) {
        header.classList.remove("is-scroll-hidden");
        travel = 0;
        direction = 0;
        return;
      }
      if (!delta) return;
      const nextDirection = delta > 0 ? 1 : -1;
      if (nextDirection !== direction) {
        direction = nextDirection;
        travel = 0;
      }
      travel += Math.abs(delta);
      const active = document.activeElement;
      if (active && header.contains(active) && active.matches(":focus-visible"))
        return;
      if (travel >= 8)
        header.classList.toggle("is-scroll-hidden", direction > 0);
    }
    window.addEventListener(
      "scroll",
      () => {
        if (!frame) frame = requestAnimationFrame(update);
      },
      { passive: true },
    );
    header.addEventListener("focusin", () => {
      header.classList.remove("is-scroll-hidden");
      previousY = scrollY;
      travel = 0;
    });
    window.addEventListener("pageshow", () => {
      header.classList.remove("is-scroll-hidden");
      previousY = scrollY;
    });
  }
</script>
