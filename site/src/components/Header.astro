---
import { browserMenu, directLinks, pagePath } from "../data/navigation.mjs";
const { current = null } = Astro.props;
const onHome = pagePath(Astro.url.pathname) === "/";
const mailPath = pagePath(Astro.url.pathname);
const onMail = mailPath === "/mail" || mailPath.startsWith("/mail/");
const isCurrent = (link) => current === link.key || (link.key === "mail" && onMail);
const hrefFor = (href) =>
  onHome && href.startsWith("/#") ? href.slice(1) : href;
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header revamp-header">
  <nav class="site-nav revamp-nav" aria-label="Primary navigation">
    <a class="site-brand" href="/" aria-label="Blanc Browser home"
      ><span class="site-lockup site-lockup--small" aria-hidden="true"
        ><img
          class="site-lockup-mark"
          src="/lockup/sunrise-mark-256.webp"
          width="256"
          height="256"
          alt=""
        /><img
          class="site-lockup-word"
          src="/lockup/blanc-word-small-ink.svg"
          width="2466"
          height="762"
          alt=""
        /></span
      ></a
    >
    <div class="site-nav-links" id="site-menu">
      <div class="site-browser-menu" data-browser-menu>
        <a
          class="revamp-nav-link site-browser-trigger"
          href={browserMenu.href}
          aria-current={isCurrent(browserMenu) ? "page" : undefined}
          data-browser-trigger
          >{browserMenu.label}<svg
            class="site-browser-caret"
            viewBox="0 0 10 10"
            aria-hidden="true"><path d="M2.5 3.75 5 6.25l2.5-2.5"></path></svg
          ></a
        >
        <div class="site-browser-panel" id="site-browser-panel" hidden>
          <div class="site-browser-column">
            <p class="site-browser-label" id="site-browser-downloads">Download</p>
            <ul aria-labelledby="site-browser-downloads">
              {
                browserMenu.downloads.map((link) => (
                  <li>
                    <a href={link.href}>
                      {link.label}
                      <svg class="site-browser-download" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M8 2.5v7M5 7l3 3 3-3M3 12.5h10" />
                      </svg>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="site-browser-column">
            <p class="site-browser-label" id="site-browser-features">Features</p>
            <ul aria-labelledby="site-browser-features">
              {browserMenu.features.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
              {
                browserMenu.more.map((link, index) => (
                  <li class={index === 0 ? "site-browser-more" : undefined}>
                    <a href={hrefFor(link.href)}>{link.label}</a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
      {
        directLinks.map((link) => (
          <a
            class="revamp-nav-link"
            href={hrefFor(link.href)}
            aria-current={isCurrent(link) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </div>
    <a
      class="site-nav-cta"
      href={current === "download" ? "#download-options" : "/download"}
      >{
        onMail ? (
          <>
            <span class="cta-wide">Browser download</span><span class="cta-narrow"
              >Download</span
            >
          </>
        ) : (
          "Download"
        )
      }</a
    >
    <button
      class="site-menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      hidden>Menu</button
    >
  </nav>
  {onHome && <div class="site-progress" aria-hidden="true" />}
</header>
<script is:inline>
  // Runs right after the bar, before first paint, so a phone never flashes the
  // full link row. Without scripting the links wrap onto a second row instead.
  (() => {
    const header = document.querySelector(".revamp-header");
    const toggle = header?.querySelector(".site-menu-toggle");
    if (!header || !toggle) return;
    const setOpen = (open) => {
      header.dataset.menu = open ? "open" : "closed";
      toggle.setAttribute("aria-expanded", String(open));
      toggle.textContent = open ? "Close" : "Menu";
    };
    setOpen(false);
    toggle.hidden = false;
    toggle.addEventListener("click", () => setOpen(header.dataset.menu !== "open"));
    header.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || header.dataset.menu !== "open") return;
      setOpen(false);
      toggle.focus();
    });
    header.querySelectorAll("#site-menu a:not([data-browser-trigger])").forEach((link) =>
      link.addEventListener("click", () => setOpen(false)),
    );
    // Widening past the phone layout puts the links back in the bar.
    matchMedia("(min-width: 921px)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
    addEventListener("pageshow", () => setOpen(false));
  })();
  // The Browser menu opens on click, tap or Enter, never on hover. Without
  // scripting its trigger stays a link to /features.
  (() => {
    const menu = document.querySelector("[data-browser-menu]");
    const trigger = menu?.querySelector("[data-browser-trigger]");
    const panel = menu?.querySelector(".site-browser-panel");
    if (!menu || !trigger || !panel) return;
    trigger.setAttribute("role", "button");
    trigger.setAttribute("aria-controls", panel.id);
    const setOpen = (open) => {
      panel.hidden = !open;
      menu.dataset.open = String(open);
      trigger.setAttribute("aria-expanded", String(open));
    };
    setOpen(false);
    trigger.addEventListener("click", (event) => {
      event.preventDefault();
      setOpen(panel.hidden);
    });
    trigger.addEventListener("keydown", (event) => {
      if (event.key !== " ") return;
      event.preventDefault();
      setOpen(panel.hidden);
    });
    menu.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || panel.hidden) return;
      event.stopPropagation();
      setOpen(false);
      trigger.focus();
    });
    menu.addEventListener("focusout", (event) => {
      if (!menu.contains(event.relatedTarget)) setOpen(false);
    });
    document.addEventListener("click", (event) => {
      if (!menu.contains(event.target)) setOpen(false);
    });
    panel.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
    addEventListener("pageshow", () => setOpen(false));
  })();
</script>
