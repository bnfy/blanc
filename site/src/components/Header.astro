---
import BrandMark from './BrandMark.astro';
import { directLinks } from '../data/navigation.mjs';
const { variant = 'solid', current = null } = Astro.props;
const pathname = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '');
const downloadHref = current === 'download' ? '#download-options' : '/download';
const isCurrent = link => current === link.key || pathname === link.href || (link.key === 'features' && pathname.startsWith('/features/') && pathname !== '/features/security') || (link.key === 'mail' && pathname.startsWith('/mail/'));
---
{variant === 'legal' ? (
  <header class="legal-top"><a class="legal-home" href="/" aria-label="Blanc home"><BrandMark class="mark" /><span class="wordmark">Blanc</span></a></header>
) : (
  <header class:list={['site-header', `site-header--${variant}`, { 'is-raised': variant === 'solid' }]}>
    <nav class="site-nav" aria-label="Primary navigation">
      <a class="site-brand" href="/" aria-label="Blanc Browser home"><BrandMark class="site-brand-mark" /></a>
      <div class="site-nav-links">{directLinks.map(link => <a href={link.href} aria-current={isCurrent(link) ? 'page' : undefined}>{link.label}</a>)}</div>
      <a class={current === 'download' ? 'site-nav-cta is-current' : 'site-nav-cta'} href={downloadHref}>{pathname.startsWith('/mail') ? 'Browser download' : 'Download'}</a>
      <button class="site-menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="siteMobileMenu" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path class="site-menu-open-icon" d="M4 6h16M4 12h16M4 18h16" /><path class="site-menu-close-icon" d="m6 6 12 12M18 6 6 18" /></svg>
      </button>
      <div class="site-mobile-menu" id="siteMobileMenu" hidden>
        {directLinks.map(link => <a class="site-mobile-plain" href={link.href} aria-current={isCurrent(link) ? 'page' : undefined}>{link.label}</a>)}
        <a class="site-mobile-download" href={downloadHref}>{pathname.startsWith('/mail') ? 'Download Blanc Browser' : 'Download on desktop'}</a>
      </div>
    </nav>
  </header>
)}
<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const toggle = header.querySelector<HTMLButtonElement>('.site-menu-toggle');
    const panel = header.querySelector<HTMLElement>('.site-mobile-menu');
    const desktop = matchMedia('(min-width: 901px)');
    const seamless = header.classList.contains('site-header--island');
    function updateRaised() {
      if (seamless) header?.classList.toggle('is-raised', window.scrollY > 12);
    }
    updateRaised();
    window.addEventListener('scroll', updateRaised, { passive: true });
    function setOpen(open: boolean, restoreFocus = false) {
      if (!toggle || !panel) return;
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (restoreFocus) toggle.focus({ preventScroll: true });
    }
    header.dataset.enhanced = 'true';
    if (toggle) toggle.hidden = false;
    toggle?.addEventListener('click', () => { if (!desktop.matches && panel) setOpen(panel.hidden); });
    panel?.addEventListener('click', event => { if (event.target instanceof Element && event.target.closest('a')) setOpen(false); });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && panel && !panel.hidden) { event.preventDefault(); setOpen(false, true); }
    });
    document.addEventListener('pointerdown', event => { if (event.target instanceof Node && !header.contains(event.target)) setOpen(false); });
    document.addEventListener('focusin', event => { if (event.target instanceof Node && !header.contains(event.target)) setOpen(false); });
    desktop.addEventListener('change', () => setOpen(false));
    window.addEventListener('pageshow', () => { setOpen(false); updateRaised(); });
  }
</script>
