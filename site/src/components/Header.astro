---
import SiteSearch from "./SiteSearch.astro";
import MailReserveBanner from "./MailReserveBanner.astro";
import { browserMenu, directLinks, pagePath } from "../data/navigation.mjs";
// variant "minimal" (the What's New pages) keeps only the lockup: the page
// Blanc opens after an update has its own way forward and needs no site nav.
const { current = null, variant = "solid" } = Astro.props;
const minimal = variant === "minimal";
const onHome = pagePath(Astro.url.pathname) === "/";
// Pages whose first screen sits under a clear bar: the homepage's sunrise
// (dark ink) and the night heroes of Privacy & Security and Support (light
// ink, wide windows only; revamp.css).
const overlayTone = onHome
  ? "light"
  : ["/trust", "/support"].includes(pagePath(Astro.url.pathname))
    ? "dark"
    : undefined;
const mailPath = pagePath(Astro.url.pathname);
const onMail = mailPath === "/mail" || mailPath.startsWith("/mail/");
// The reservation banner shows on the full header only, and not on the Mail
// pages, which already lead to the reserve form.
const showReserveBanner = (variant === "solid" || variant === "island") && !onMail;
const isCurrent = (link) => current === link.key || (link.key === "mail" && onMail);
const hrefFor = (href) =>
  onHome && href.startsWith("/#") ? href.slice(1) : href;
---

<a class="skip-link" href="#main-content">Skip to content</a>
{showReserveBanner && <MailReserveBanner />}
<header class="site-header revamp-header" data-overlay-tone={overlayTone}>
  <nav class="site-nav revamp-nav" aria-label="Primary navigation">
    <div class="site-brand-group">
      <a class="site-brand" href="/" aria-label="Blanc Browser home">
        <span class="site-lockup site-lockup--small" aria-hidden="true">
          <img
            class="site-lockup-mark"
            src="/lockup/sunrise-mark-256.webp"
            width="256"
            height="256"
            alt=""
          />
          <img
            class="site-lockup-word"
            src="/lockup/blanc-word-small-ink.svg"
            width="2466"
            height="762"
            alt=""
          />
        </span>
      </a>
      {!minimal && (
        <>
          <button class="site-pronunciation" type="button" aria-label="Hear how to pronounce Blanc" title="Hear Blanc" hidden>
            <span class="site-pronunciation-icon" aria-hidden="true">
              <svg class="site-pronunciation-speaker" viewBox="0 0 20 20">
                <path d="M3.5 8h3l4-3.5v11l-4-3.5h-3zM13 8a3 3 0 0 1 0 4m2-6a5.5 5.5 0 0 1 0 8" />
              </svg>
              <span class="site-pronunciation-wave"><i></i><i></i><i></i></span>
            </span>
            <span class="site-pronunciation-caption" aria-hidden="true">blonk</span>
          </button>
          <audio id="blanc-pronunciation" src="/audio/we-say-blanc.mp3" preload="none" hidden></audio>
          <span class="sr-only" id="blanc-pronunciation-status" role="status"></span>
        </>
      )}
    </div>
    {!minimal && (<>
    <div class="site-nav-links" id="site-menu">
      <div class="site-browser-menu" data-browser-menu>
        <a
          class="revamp-nav-link site-browser-trigger"
          href={browserMenu.href}
          aria-current={isCurrent(browserMenu) ? "page" : undefined}
          data-browser-trigger
          >{browserMenu.label}<svg
            class="site-browser-caret"
            viewBox="0 0 10 10"
            aria-hidden="true"><path d="M2.5 3.75 5 6.25l2.5-2.5"></path></svg
          ></a
        >
        <div class="site-browser-panel" id="site-browser-panel" hidden>
          <div class="site-browser-column">
            <p class="site-browser-label" id="site-browser-downloads">Download</p>
            <ul class="site-browser-downloads" aria-labelledby="site-browser-downloads">
              {
                browserMenu.downloads.map((link) => (
                  <li>
                    <a href={link.href}>
                      {link.label}
                      {link.beta ? (
                        <span class="site-browser-beta">Beta</span>
                      ) : (
                        <svg class="site-browser-download" viewBox="0 0 16 16" aria-hidden="true">
                          <path d="M8 2.5v7M5 7l3 3 3-3M3 12.5h10" />
                        </svg>
                      )}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="site-browser-column">
            <p class="site-browser-label" id="site-browser-features">Features</p>
            <ul aria-labelledby="site-browser-features">
              {browserMenu.features.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
              {
                browserMenu.more.map((link, index) => (
                  <li class={index === 0 ? "site-browser-more" : undefined}>
                    {link.primary ? (
                      <a class="site-browser-cta" href={hrefFor(link.href)}>
                        {link.label}
                        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8h9M9 4.5 12.5 8 9 11.5" /></svg>
                      </a>
                    ) : (
                      <a href={hrefFor(link.href)}>{link.label}</a>
                    )}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
      {
        directLinks.map((link) => (
          <a
            class="revamp-nav-link"
            href={hrefFor(link.href)}
            aria-current={isCurrent(link) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </div>
    <div class="site-nav-actions">
    <button class="site-search-trigger" type="button" data-site-search aria-label="Search Blanc" aria-keyshortcuts="Meta+K Control+K" aria-haspopup="dialog" aria-controls="site-search" aria-expanded="false" title="Search Blanc (⌘K / Ctrl+K)" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
    </button>
    <a
      class="site-nav-cta"
      href={current === "download" ? "#download-options" : "/download"}
      >{
        onMail ? (
          <>
            <span class="cta-wide">Browser download</span><span class="cta-narrow"
              >Download</span
            >
          </>
        ) : (
          "Download"
        )
      }</a
    >
    <button
      class="site-menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      hidden>Menu</button
    >
    </div>
    </>)}
  </nav>
</header>
{!minimal && <SiteSearch />}
<script>
  const trigger = document.querySelector<HTMLButtonElement>(".site-pronunciation");
  const audio = document.querySelector<HTMLAudioElement>("#blanc-pronunciation");
  const caption = trigger?.querySelector(".site-pronunciation-caption");
  const status = document.getElementById("blanc-pronunciation-status");

  if (trigger && audio && caption && status && audio.canPlayType("audio/mpeg")) {
    const pronunciation = caption.textContent;
    let resetCaption: number;
    trigger.hidden = false;

    const settle = () => {
      if (!trigger.hasAttribute("data-playing")) return;
      trigger.removeAttribute("data-playing");
      resetCaption = window.setTimeout(() => trigger.removeAttribute("data-feedback"), 900);
    };
    const showFailure = () => {
      if (!trigger.hasAttribute("data-playing")) return;
      caption.textContent = "Audio unavailable";
      status.textContent = "Pronunciation audio unavailable. Try again.";
      trigger.setAttribute("data-feedback", "");
      settle();
    };
    audio.addEventListener("pause", settle);
    audio.addEventListener("ended", settle);
    audio.addEventListener("error", showFailure);

    trigger.addEventListener("click", async () => {
      if (!audio.paused || trigger.hasAttribute("data-playing")) return;
      window.clearTimeout(resetCaption);
      status.textContent = "";
      caption.textContent = pronunciation;
      trigger.removeAttribute("data-feedback");
      trigger.setAttribute("data-playing", "");
      try {
        if (audio.error) audio.load();
        audio.currentTime = 0;
        await audio.play();
        trigger.setAttribute("data-feedback", "");
      } catch {
        showFailure();
      }
    });
  }
</script>
<script is:inline>
  // On the homepage (owner, November 19, 2026) and Privacy & Security (owner,
  // November 23, 2026) the bar starts clear over the first screen and turns
  // solid once the page scrolls. Set here, before first paint, so without
  // scripting the bar simply stays solid.
  (() => {
    const header = document.querySelector(".revamp-header[data-overlay-tone]");
    if (!header) return;
    header.dataset.overlay = "";
    let queued = false;
    const update = () => {
      queued = false;
      header.toggleAttribute("data-scrolled", scrollY > 8);
    };
    update();
    addEventListener("scroll", () => {
      if (!queued) { queued = true; requestAnimationFrame(update); }
    }, { passive: true });
  })();
  // Runs right after the bar, before first paint, so a phone never flashes the
  // full link row. Without scripting the links wrap onto a second row instead.
  (() => {
    const header = document.querySelector(".revamp-header");
    const toggle = header?.querySelector(".site-menu-toggle");
    if (!header || !toggle) return;
    const setOpen = (open) => {
      header.dataset.menu = open ? "open" : "closed";
      toggle.setAttribute("aria-expanded", String(open));
      toggle.textContent = open ? "Close" : "Menu";
    };
    setOpen(false);
    toggle.hidden = false;
    toggle.addEventListener("click", () => setOpen(header.dataset.menu !== "open"));
    header.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || header.dataset.menu !== "open") return;
      setOpen(false);
      toggle.focus();
    });
    header.querySelectorAll("#site-menu a:not([data-browser-trigger])").forEach((link) =>
      link.addEventListener("click", () => setOpen(false)),
    );
    // Widening past the phone layout puts the links back in the bar.
    matchMedia("(min-width: 921px)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
    addEventListener("pageshow", () => setOpen(false));
  })();
  // The Browser menu opens on click, tap or Enter, never on hover. Without
  // scripting its trigger stays a link to /features.
  (() => {
    const menu = document.querySelector("[data-browser-menu]");
    const trigger = menu?.querySelector("[data-browser-trigger]");
    const panel = menu?.querySelector(".site-browser-panel");
    if (!menu || !trigger || !panel) return;
    trigger.setAttribute("role", "button");
    trigger.setAttribute("aria-controls", panel.id);
    const setOpen = (open) => {
      panel.hidden = !open;
      menu.dataset.open = String(open);
      trigger.setAttribute("aria-expanded", String(open));
    };
    setOpen(false);
    trigger.addEventListener("click", (event) => {
      event.preventDefault();
      setOpen(panel.hidden);
    });
    trigger.addEventListener("keydown", (event) => {
      if (event.key !== " ") return;
      event.preventDefault();
      setOpen(panel.hidden);
    });
    menu.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || panel.hidden) return;
      event.stopPropagation();
      setOpen(false);
      trigger.focus();
    });
    menu.addEventListener("focusout", (event) => {
      if (!menu.contains(event.relatedTarget)) setOpen(false);
    });
    document.addEventListener("click", (event) => {
      if (!menu.contains(event.target)) setOpen(false);
    });
    panel.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
    addEventListener("pageshow", () => setOpen(false));
  })();
</script>
