---
import { directLinks } from "../data/navigation.mjs";
const { current = null } = Astro.props;
const path =
  Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
const onHome = path === "/";
const hrefFor = (href) =>
  onHome && href.startsWith("/#") ? href.slice(1) : href;
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header revamp-header">
  <nav class="site-nav revamp-nav" aria-label="Primary navigation">
    <a class="site-brand" href="/" aria-label="Blanc Browser home"
      ><img
        class="site-brand-mark"
        src="/sunrise-hero-mark.png"
        width="23"
        height="23"
        alt=""
      /></a
    >
    {
      directLinks.map((link) => (
        <a
          class:list={[
            "revamp-nav-link",
            {
              "nav-secondary": ["privacy", "patron", "about"].includes(
                link.key,
              ),
            },
          ]}
          href={hrefFor(link.href)}
          aria-current={current === link.key ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
    <a
      class="site-nav-cta"
      href={current === "download" ? "#download-options" : "/download"}
      >Download</a
    >
  </nav>
</header>
<script>
  const header = document.querySelector<HTMLElement>(".revamp-header");
  if (header) {
    let previousY = window.scrollY;
    let direction = 0;
    let travel = 0;
    let frame = 0;
    function update() {
      frame = 0;
      const limit = Math.max(
        0,
        document.documentElement.scrollHeight - innerHeight,
      );
      const y = Math.max(0, Math.min(scrollY, limit));
      const delta = y - previousY;
      previousY = y;
      if (!header) return;
      if (y <= header.offsetHeight) {
        header.classList.remove("is-scroll-hidden");
        travel = 0;
        direction = 0;
        return;
      }
      if (!delta) return;
      const nextDirection = delta > 0 ? 1 : -1;
      if (nextDirection !== direction) {
        direction = nextDirection;
        travel = 0;
      }
      travel += Math.abs(delta);
      const active = document.activeElement;
      if (active && header.contains(active) && active.matches(":focus-visible"))
        return;
      if (travel >= 8)
        header.classList.toggle("is-scroll-hidden", direction > 0);
    }
    window.addEventListener(
      "scroll",
      () => {
        if (!frame) frame = requestAnimationFrame(update);
      },
      { passive: true },
    );
    header.addEventListener("focusin", () => {
      header.classList.remove("is-scroll-hidden");
      previousY = scrollY;
      travel = 0;
    });
    window.addEventListener("pageshow", () => {
      header.classList.remove("is-scroll-hidden");
      previousY = scrollY;
    });
  }
</script>
