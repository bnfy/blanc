---
// Unified site footer — a flush-left stack: identity breadcrumb, full nav with
// the current page highlighted, newsletter signup, legal block, social row.
import BrandMark from './BrandMark.astro';
import NewsletterForm from './NewsletterForm.astro';

const LINKS = [
  { href: '/', label: 'Overview' },
  { href: '/features', label: 'Features' },
  { href: '/about', label: 'About' },
  { href: '/changelog', label: 'Changelog' },
  { href: '/download', label: 'Download' },
  { href: '/press', label: 'Press' },
  { href: '/ambassadors', label: 'Ambassadors' },
  { href: '/faq', label: 'FAQ' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
];

// build.format 'file' leaves .html on Astro.url.pathname at build time.
let path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/+$/, '');
if (path === '' || path === '/index') path = '/';
const isCurrent = (href) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---
<footer>
  <a class="foot-brand" href="/" aria-label="Blanc Browser home">
    <BrandMark class="foot-mark" small />
    <span class="foot-crumb" aria-hidden="true">›</span>
    <span>Blanc Browser</span>
  </a>
  <nav class="foot-nav" aria-label="Footer">
    {LINKS.map(({ href, label }) => (
      <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
    ))}
  </nav>
  <NewsletterForm />
  <div class="foot-legal">
    <span>© 2026 <a href="https://bnfy.me" target="_blank" rel="noopener">Bananify</a></span>
    <span>built independently · no investors</span>
  </div>
  <div class="foot-social">
    <!--email_off--><a class="foot-ic mail" href="mailto:support@blancbrowser.com" aria-label="Email Blanc support" title="Email"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4.5" width="20" height="15" rx="3"/><path d="m3.5 7.5 8.5 6 8.5-6"/></svg></a><!--/email_off-->
    <a class="foot-ic ss" href="https://blancbrowser.substack.com/" target="_blank" rel="noopener" aria-label="Blanc on Substack" title="Substack"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3.25h18v2.5H3zm0 4.5h18v2.5H3zm0 4.5h18V21l-9-5.1L3 21z"/></svg></a>
