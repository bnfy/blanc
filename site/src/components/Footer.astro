---
import NewsletterForm from "./NewsletterForm.astro";
// notes: the page passes numbered notes (its footnotes slot) to show above the links.
const { measurementControls = true, notes = false } = Astro.props;
---

<footer
  class="website-footer"
  id="site-footer"
  aria-label="Blanc website footer"
>
  <div class="website-footer-inner">
    {
      notes && (
        <div class="website-footer-notes">
          <slot name="notes" />
        </div>
      )
    }
    <div class="website-footer-grid">
      <div class="website-footer-identity">
        <a class="website-footer-brand" href="/#opening" aria-label="Blanc home"
          ><span class="site-lockup site-lockup--display" aria-hidden="true"
            ><img
              class="site-lockup-mark"
              src="/lockup/sunrise-mark-256.webp"
              width="256"
              height="256"
              alt=""
            /><img
              class="site-lockup-word"
              src="/lockup/blanc-word-display-white.svg"
              width="2217"
              height="742"
              alt=""
            /></span
          ></a
        ><p>A little less browser.</p><NewsletterForm />
      </div>
      <nav aria-label="Explore Blanc">
        <h2>Explore</h2><a href="/features">Feature guides</a><a href="/download"
          >Download</a
        ><a href="/changelog">What’s new</a><a href="/roadmap">Feature roadmap</a><a href="/#patron">Blanc Patron</a
        ><a href="/arc-alternative">Switching from Arc</a><a href="/mail">Blanc Mail</a>
      </nav>
      <nav aria-label="Blanc resources">
        <h2>Resources</h2><a href="/support">Support</a><a href="/features/security"
          >Security guide</a
        ><a href="/trust"
          >Privacy &amp; Security</a
        ><a href="https://github.com/bnfy/blanc">Source code</a><!--email_off-->
        <a href="mailto:support@blanc.day">Contact</a><!--/email_off-->
      </nav>
      <nav aria-label="About Blanc">
        <h2>Blanc</h2><a href="/about">About</a><a href="/media">Media</a><a
          href="/ambassadors">Ambassadors</a>
      </nav>
    </div>
    <div class="website-footer-bottom">
      <p>© 2026 <a href="https://bnfy.me">Bananify</a></p><nav
        aria-label="Legal"
      >
        <a href="/privacy">Privacy Policy</a><a href="/terms">Terms</a>{
          measurementControls && (
            <button
              class="footer-privacy-choice"
              type="button"
              data-consent-open
            >
              Privacy choices
            </button>
          )
        }
      </nav><nav class="footer-social" aria-label="Follow Blanc">
        <a href="https://blancbrowser.substack.com/">Substack</a><a
          href="https://www.instagram.com/blancbrowser/">Instagram</a
        ><a href="https://www.threads.net/@blancbrowser">Threads</a><a
          href="https://www.facebook.com/blancbrowser/">Facebook</a
        ><a href="https://www.tiktok.com/@blancbrowser">TikTok</a>
      </nav>
    </div>
  </div>
</footer>
