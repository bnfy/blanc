---
import NewsletterForm from "./NewsletterForm.astro";
const { measurementControls = true } = Astro.props;
---

<footer
  class="website-footer"
  id="site-footer"
  aria-label="Blanc website footer"
>
  <div class="website-footer-inner">
    <div class="website-footer-grid">
      <div class="website-footer-identity">
        <a href="/#opening" aria-label="Blanc home"
          ><img
            src="/sunrise-hero-mark.png"
            alt="Blanc Sunrise mark"
          /></a
        ><p>A little less browser.</p><NewsletterForm />
      </div>
      <nav aria-label="Explore Blanc">
        <h2>Explore</h2><a href="/features">Feature guides</a><a href="/download"
          >Download</a
        ><a href="/changelog">What’s new</a><a href="/#patron">Blanc Patron</a>
      </nav>
      <nav aria-label="Blanc resources">
        <h2>Resources</h2><a href="/support">Support</a><a href="/features/security"
          >Security guide</a
        ><a href="/trust"
          >Privacy &amp; Security</a
        ><a href="https://github.com/bnfy/blanc">Source code</a><!--email_off-->
        <a href="mailto:support@blancbrowser.com">Contact</a><!--/email_off-->
      </nav>
      <nav aria-label="About Blanc">
        <h2>Blanc</h2><a href="/about">About</a><a href="/press">Press</a><a
          href="/ambassadors">Ambassadors</a>
      </nav>
    </div>
    <div class="website-footer-bottom">
      <p>© 2026 <a href="https://bnfy.me">Bananify</a></p><nav
        aria-label="Legal"
      >
        <a href="/privacy">Privacy Policy</a><a href="/terms">Terms</a>{
          measurementControls && (
            <button
              class="footer-privacy-choice"
              type="button"
              data-consent-open
            >
              Privacy choices
            </button>
          )
        }
      </nav><nav class="footer-social" aria-label="Follow Blanc">
        <a href="https://blancbrowser.substack.com/">Substack</a><a
          href="https://www.instagram.com/blancbrowser/">Instagram</a
        ><a href="https://www.threads.net/@blancbrowser">Threads</a><a
          href="https://www.facebook.com/blancbrowser/">Facebook</a
        ><a href="https://www.tiktok.com/@blancbrowser">TikTok</a>
      </nav>
    </div>
  </div>
</footer>
