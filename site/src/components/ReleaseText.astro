---
import { currentWebsiteLink } from '../lib/website-routes.mjs';
// Renders one run of release-note text from the typed inline spans produced by
// scripts/generate-site-changelog.mjs. Each span becomes a real element and its
// value goes through Astro's auto-escaping, so release-note text — including
// contributor-supplied PR titles — can never introduce markup of its own.
const { spans = [] } = Astro.props;
const EMAIL_ADDRESS = /[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/i;
const containsEmail = (span) =>
  EMAIL_ADDRESS.test(String(span.value ?? '')) || String(span.url ?? '').startsWith('mailto:');
// A bang to type (`!yt lofi`, `lofi !yt`, `!`) is the app's chip, as it is
// everywhere else on the site; other code stays code.
const BANG = /(?:^|\s)![a-z0-9_.-]*(?:\s|$)/i;
---
{spans.map((span) => (
  <Fragment>
    {containsEmail(span) && <Fragment set:html={'<!--email_off-->'} />}
    {span.type === 'strong' ? <strong>{span.value}</strong>
    : span.type === 'code' && BANG.test(span.value) ? <kbd class="bang-chip">{span.value}</kbd>
    : span.type === 'code' ? <code>{span.value}</code>
    : span.type === 'link' ? (
        span.url.startsWith('https:')
          ? <a href={currentWebsiteLink(span.url)} target="_blank" rel="noopener">{span.value}</a>
          : <a href={currentWebsiteLink(span.url)}>{span.value}</a>
      )
    : <Fragment>{span.value}</Fragment>}
    {containsEmail(span) && <Fragment set:html={'<!--/email_off-->'} />}
  </Fragment>
))}
