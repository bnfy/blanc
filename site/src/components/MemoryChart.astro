---
/**
 * Measured browser memory, six ad-heavy sites open in each (five news sites
 * and Speedtest; bench/memory/workloads.json).
 *
 * Source of truth: bench/memory/results/memory-2026-10-15T06-03-46-052Z.md —
 * a single-session run, three repetitions per browser, on one Mac. Every figure
 * here is the median of that run. If these numbers change, re-run the harness
 * and update BOTH this component and docs/press/fact-sheet.md; the
 * public-truth unit test pins them together on purpose.
 *
 * Rendered as a table rather than divs so the numbers are reachable without
 * seeing the bars: the bar IS the table cell, so the chart and its accessible
 * twin are the same markup rather than two things that can drift apart.
 */
const SCALE_GB = 8;

const rows = [
  { name: 'Brave', gb: 1.5 },
  { name: 'Blanc', gb: 1.7, blanc: true },
  { name: 'Zen', gb: 4.0 },
  { name: 'Chrome', gb: 5.7 },
  { name: 'Vivaldi', gb: 7.4 },
];

interface Props {
  headingId?: string;
  heading?: string;
  intro?: string;
}

const {
  headingId = 'memory-title',
  heading = 'Under a third of Chrome’s memory.',
  intro = 'Six ad-heavy sites open in every browser, on the same Mac, in the same sitting.',
} = Astro.props;
---

<section class="memchart-section" aria-labelledby={headingId}>
  <div class="memchart-heading">
    <h2 id={headingId}>{heading}</h2>
    <p>{intro}</p>
  </div>

  <figure class="memchart">
    <table class="memchart-table">
      <caption class="sr-only">
        Memory used by each browser with six ad-heavy sites open, in gibibytes
      </caption>
      <thead>
        <tr>
          <th scope="col">Browser</th>
          <th scope="col">Memory used</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr class={row.blanc ? 'is-blanc' : undefined}>
            <th scope="row">{row.name}</th>
            <td>
              <span class="memchart-track" aria-hidden="true">
                <span class="memchart-bar" style={`--fill:${(row.gb / SCALE_GB) * 100}%`}></span>
              </span>
              <span class="memchart-val">{row.gb.toFixed(1)} GB</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    <figcaption class="memchart-note">
      Measured 15 October 2026 with Blanc 1.34.0, on fresh profiles with
      no extensions. Brave also blocks by default, and it used a little less.
      With Blanc’s blocker turned off, the same pages used 5.4 GB, about the
      same as Chrome, so the saving comes from blocking. Method and raw data are in
      <a href="https://github.com/bnfy/blanc/tree/main/bench/memory">our repository</a>.
    </figcaption>
  </figure>
</section>
