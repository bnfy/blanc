---
// The tab groups drag figure: the Island panel with named groups, looping a
// tab being dragged into a new place in its group (CSS in site.css; pause it
// offscreen with scripts/drag-figure.js). Used on /features/tab-groups and in
// the Features page's drag-to-reorder popover.
---
<div class="demo-stage island-figure island-figure--panel island-figure--drag" role="img" aria-label="Blanc's island panel open, with tabs organized into named groups: pinned tabs, a 'social' group, and a 'watch' group holding YouTube and Netflix. Tabs and whole groups can be dragged into a new order.">
  <div class="demo-page" aria-hidden="true"><div class="bar w1"></div><div class="bar w2"></div><div class="bar w3"></div><div class="bar w4"></div></div>
  <picture>
    <source media="(max-width: 560px)" srcset="/shots/mobile/netflix.jpg">
    <img class="demo-shot show" src="/shots/desktop/netflix.jpg" loading="lazy" alt="" aria-hidden="true">
  </picture>
  <div class="demo-island open" aria-hidden="true">
    <div class="panel">
      <div class="panel-row"><div class="field"><span class="typed"></span><span class="caret"></span></div></div>
      <div class="list">
        <div class="sec-head"><span>pinned</span><span class="count">2</span></div>
        <div class="trow"><span class="fav fav--gmail"></span><span class="title">Gmail</span></div>
        <div class="trow"><span class="fav fav--notion"></span><span class="title">Notion</span></div>
        <div class="group-band">
          <div class="sec-head"><svg class="caret" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 2 L7 5 L3.5 8"/></svg><span>social</span><span class="count">1</span><span class="kbd">⌘2</span></div>
          <div class="trow in-group"><span class="fav fav--threads"></span><span class="title">Threads</span></div>
        </div>
        <div class="group-band">
          <div class="sec-head"><svg class="caret" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 2 L7 5 L3.5 8"/></svg><span>watch</span><span class="count">2</span><span class="kbd">⌘3</span></div>
          <div class="drag-demo">
            <div class="trow hl in-group drag-row drag-row--first"><span class="fav fav--youtube"></span><span class="title">YouTube</span></div>
            <div class="trow in-group drag-row drag-row--second"><span class="fav fav--netflix"></span><span class="title">Netflix</span></div>
            <div class="trow in-group drag-ghost drag-ghost--second"><span class="fav fav--netflix"></span><span class="title">Netflix</span></div>
            <div class="trow hl in-group drag-ghost drag-ghost--first"><span class="fav fav--youtube"></span><span class="title">YouTube</span></div>
            <span class="drag-line"></span>
            <span class="drag-cursor"><span class="demo-cursor-shape"></span></span>
          </div>
        </div>
      </div>
      <div class="foot">esc to dismiss · /group moves this tab · ⌘1–9 jumps groups</div>
    </div>
  </div>
</div>
