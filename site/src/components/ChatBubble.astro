---
import { CRISP_WEBSITE_ID } from "../lib/crisp.mjs";

const href = `mailto:support@blanc.day?subject=${encodeURIComponent("Blanc support")}&body=${encodeURIComponent("Blanc version:\nOperating system:\nWhat happened:\n")}`;
---
{CRISP_WEBSITE_ID && (
  <>
    <!--email_off-->
    <a
      class="chat-bubble"
      href={href}
      data-live-chat={CRISP_WEBSITE_ID}
      data-live-chat-bubble
      aria-label="Live chat with a real person"
      title="Live chat"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 5h14v10h-8l-4 4v-4H5z" />
        <path d="M9 10h.01M12 10h.01M15 10h.01" />
      </svg>
    </a>
    <!--/email_off-->
    <script src="../scripts/live-chat.js"></script>
  </>
)}

<style>
  .chat-bubble {
    position: fixed;
    left: max(20px, env(safe-area-inset-left, 0px));
    bottom: max(20px, env(safe-area-inset-bottom, 0px));
    z-index: 90;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    box-shadow: 0 6px 20px rgb(29 26 22 / 22%);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .chat-bubble:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 26px rgb(29 26 22 / 28%);
  }
  .chat-bubble:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }
  .chat-bubble svg {
    width: 24px;
    height: 24px;
  }
  @media (max-width: 760px) {
    .chat-bubble {
      left: max(12px, env(safe-area-inset-left, 0px));
      bottom: max(12px, env(safe-area-inset-bottom, 0px));
      width: 48px;
      height: 48px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .chat-bubble {
      transition: none;
    }
    .chat-bubble:hover {
      transform: none;
    }
  }
</style>
