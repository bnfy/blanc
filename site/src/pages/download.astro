---
import PlatformLogo from '../components/PlatformLogo.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import releases from '../data/releases.json';
import ios from '../data/ios-availability.json';
import beta from '../data/blanc-beta.json';
import pkg from '../../../package.json';

const latest = releases[0];
---
<BaseLayout
  title={"Download Blanc Browser for macOS, Windows, and Linux"}
  description={"Download the free Blanc desktop browser for macOS, Windows, or Linux. Built-in ad and tracker blocking, private tabs, and a minimal island interface."}
  path="/download"
  page="download"
  current="download"
  ogDescription={"A minimal desktop browser with built-in ad and tracker blocking, private tabs, and a floating island interface."}
>
<script
  type="application/ld+json"
  is:inline
  slot="head"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": "https://blanc.day/#software",
    name: "Blanc Browser",
    alternateName: "Blanc",
    url: "https://blanc.day/",
    applicationCategory: "BrowserApplication",
    operatingSystem: "macOS, Windows, Linux",
    softwareVersion: pkg.version,
    downloadUrl: "https://github.com/bnfy/blanc/releases/latest",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    publisher: { "@id": "https://blanc.day/#organization" },
  })}
/>
<script type="application/ld+json" is:inline slot="head">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://blanc.day/" },
    { "@type": "ListItem", "position": 2, "name": "Download", "item": "https://blanc.day/download" }
  ]
}
</script>

<main id="main-content" class="dl">
  <!-- The Download page, reimagined on 2026-11-14 (owner: far fewer words, Blanc
       Beta up front, no full stops after large headings). One button for your
       system; a segmented control swaps it in place; everything else is a tile
       or one line. Works without scripting: the Mac panel shows by default and
       the radios switch panels in CSS; download-switcher.js only preselects the
       visitor's system. -->
  <section class="dl-hero" aria-labelledby="download-title">
    <img class="dl-icon" src="/lockup/sunrise-mark-256.webp" srcset="/lockup/sunrise-mark-256.webp 1x, /lockup/sunrise-mark-2048.webp 2x" width="132" height="132" alt="" decoding="async" fetchpriority="high" />
    <h1 id="download-title">Download Blanc</h1>
    <p class="dl-lede">Free for Mac, Windows, Linux, iPhone and iPad.</p>

    <div class="dl-chooser" id="download-options" data-download-chooser>
      <input class="dl-radio" type="radio" name="dl-os" id="dl-os-mac" value="mac" checked />
      <input class="dl-radio" type="radio" name="dl-os" id="dl-os-win" value="win" />
      <input class="dl-radio" type="radio" name="dl-os" id="dl-os-linux" value="linux" />
      <input class="dl-radio" type="radio" name="dl-os" id="dl-os-iphone" value="iphone" />
      <input class="dl-radio" type="radio" name="dl-os" id="dl-os-android" value="android" />
      <div class="dl-switch" role="presentation">
        <span class="dl-switch-pill" aria-hidden="true"></span>
        <label for="dl-os-mac"><PlatformLogo platform="apple" />Mac</label>
        <label for="dl-os-win"><PlatformLogo platform="windows" />Windows</label>
        <label for="dl-os-linux"><PlatformLogo platform="linux" />Linux</label>
        <label for="dl-os-iphone"><PlatformLogo platform="apple" />iPhone</label>
        <label for="dl-os-android"><PlatformLogo platform="android" />Android</label>
      </div>

      <div class="dl-panels">
        <div class="dl-panel" data-os="mac">
          <div class="dl-actions" data-download-options>
            <a class="dl-button" id="dl-mac-arm64" data-download-link data-platform="mac-arm64" data-track="download_click" data-cta-position="download-hero" href="/dl/mac-arm64">Download for Mac</a>
            <a class="dl-alt" id="dl-mac-x64" data-download-link data-platform="mac-x64" data-track="download_click" data-cta-position="download-hero" href="/dl/mac-x64" hidden>Intel Mac</a>
          </div>
          <p class="dl-meta">Apple Silicon · macOS 13 or later</p>
          <p class="dl-hint">Open the DMG and drag Blanc to Applications.</p>
        </div>
        <div class="dl-panel" data-os="win">
          <div class="dl-actions">
            <a class="dl-button" id="dl-win" data-download-link data-platform="win" data-track="download_click" data-cta-position="download-hero" href="/dl/win">Download for Windows</a>
          </div>
          <p class="dl-meta">Windows 10 or later, 64-bit</p>
          <p class="dl-hint">Run the installer. Windows should name the publisher shown on the release.</p>
        </div>
        <div class="dl-panel" data-os="linux">
          <div class="dl-actions">
            <a class="dl-button" id="dl-linux" data-download-link data-platform="linux" data-track="download_click" data-cta-position="download-hero" href="/dl/linux">Download for Linux</a>
          </div>
          <p class="dl-meta">AppImage, 64-bit</p>
          <p class="dl-hint"><code>chmod +x Blanc-*.AppImage</code>, then run it.</p>
        </div>
        <div class="dl-panel" data-os="iphone">
          <div class="dl-actions">
            <a class="dl-button" href={ios.storeUrl} target="_blank" rel="noopener">Get it on the App Store</a>
          </div>
          <p class="dl-meta">iOS and iPadOS 18.4 or later</p>
          <p class="dl-hint"><a href={ios.joinUrl} target="_blank" rel="noopener">Join the beta on TestFlight <span aria-hidden="true">↗</span></a></p>
        </div>
        <!-- Blanc for Android isn't released: this panel only leads to the beta
             signup (CLAUDE.md, Blanc for Android). -->
        <div class="dl-panel" data-os="android">
          <div class="dl-actions">
            <a class="dl-button" href="/android-beta">Join the Android beta</a>
          </div>
          <p class="dl-meta">Blanc for Android isn’t released yet.</p>
          <p class="dl-hint">You can sign up to test it on Google Play.</p>
        </div>
      </div>
    </div>

    <p class="dl-version">Blanc {latest.version} · <a href="/changelog" data-track="feature_cta_click" data-feature="changelog" data-cta-position="download-options">What’s new</a></p>
  </section>

  <section class="dl-more" id="download-more" aria-label="More ways to get Blanc">
    <!-- Blanc Beta (owner, 2026-11-14): never a platform choice, so the regular
         Blanc stays the download, but first among the tiles. Every sentence is in
         docs/website-blanc-beta-<version>-claims.json for the version in
         src/data/blanc-beta.json. -->
    <article class="dl-tile dl-tile--beta" id="beta" aria-labelledby="beta-title">
      <p class="dl-tile-label">Preview</p>
      <h2 id="beta-title">Blanc Beta</h2>
      <p>Blanc built directly on Chromium. It installs beside Blanc and never replaces it.</p>
      <p class="dl-tile-meta">{beta.requirement} · {beta.version}</p>
      <a class="dl-tile-button" href="/dl/beta" data-download-link data-track="download_click" data-platform="beta" data-cta-position="beta">Download Blanc Beta</a>
      <details class="dl-notyet">
        <summary>Not in this beta yet</summary>
        <ul>
          <li>Protected video, such as Netflix or Spotify.</li>
          <li>Sync checked against the live Sync service.</li>
          <li>Intel Macs, Windows and Linux.</li>
        </ul>
        <a href={beta.releaseUrl} target="_blank" rel="noopener">Release notes <span aria-hidden="true">↗</span></a>
      </details>
    </article>

    <article class="dl-tile dl-tile--iphone" id="iphone" aria-labelledby="iphone-title">
      <p class="dl-tile-label">iPhone and iPad</p>
      <h2 id="iphone-title">Blanc for iPhone and iPad</h2>
      <p>Free on the App Store. With Sync, your Favorites and your other devices’ tabs come with you.</p>
      <a class="dl-tile-link" href={ios.storeUrl} target="_blank" rel="noopener">App Store <span aria-hidden="true">↗</span></a>
      <figure class="dl-tile-phone"><img src="/iphone/blanc-day-on-iphone.webp" width="921" height="2000" alt="Blanc for iPhone showing blanc.day" loading="lazy" decoding="async" /></figure>
    </article>

    <article class="dl-tile dl-tile--brew" aria-labelledby="terminal-title">
      <p class="dl-tile-label">Mac, from the terminal</p>
      <h2 id="terminal-title">Homebrew</h2>
      <p>The same signed and notarized build.</p>
      <figure class="terminal-window" aria-labelledby="terminal-title">
        <div class="terminal-body">
          <pre><code><span class="terminal-prompt" aria-hidden="true">% </span>brew install --cask bnfy/tap/blanc</code></pre>
          <button type="button" class="terminal-copy" data-terminal-copy="brew install --cask bnfy/tap/blanc" data-track="feature_cta_click" data-feature="homebrew" data-cta-position="install-terminal" hidden>Copy</button>
        </div>
        <p class="sr-only" role="status" aria-live="polite" data-terminal-status></p>
      </figure>
    </article>
  </section>

  <section class="dl-facts" aria-label="Good to know">
    <ul>
      <li>Signed and notarized</li>
      <li>Updates itself</li>
      <li>Free, with no account</li>
      <li><a href="https://github.com/bnfy/blanc/blob/main/docs/release-verification.md" target="_blank" rel="noopener">Verify a release <span aria-hidden="true">↗</span></a></li>
    </ul>
    <p>Blanc 1.49 has no general extension support, and doesn’t support synced provider passkeys such as iCloud Keychain.</p>
    <p>Download didn’t start? <a href="https://github.com/bnfy/blanc/releases/latest" target="_blank" rel="noopener">Open the release page</a> · <!--email_off--><a href="mailto:support@blanc.day">support@blanc.day</a><!--/email_off--></p>
  </section>

  <!-- Disclaimers sit just above the footer, never in the hero (owner,
       November 14, 2026). -->
  <aside class="download-measurement" aria-label="Optional website measurement">
    <p>Google analytics and ad measurement are on by default outside the EEA, UK and Switzerland.</p>
    <button type="button" data-consent-open aria-controls="consent">Measurement choices</button>
  </aside>
</main>
<script>
  import { initTerminalCopy } from '../scripts/terminal-copy.js';
  import { initDownloadSwitcher } from '../scripts/download-switcher.js';
  initTerminalCopy();
  initDownloadSwitcher();
</script>
</BaseLayout>
