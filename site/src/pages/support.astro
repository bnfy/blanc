---
import BaseLayout from "../layouts/BaseLayout.astro";
import GuideTopics from "../components/GuideTopics.astro";
import questions from "../data/support-questions.json";
import "../styles/reference.css";

const supportEmail = "support@blanc.day";
// Crisp website ID (Crisp → Settings → Workspace Settings → Setup &
// Integrations). The Live chat card stays hidden while this is empty.
const crispWebsiteId = "564456ef-d242-4d04-af66-65e881e31fe2";
const mailto = (subject, body) =>
  `mailto:${supportEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
const supportMail = mailto("Blanc support", "Blanc version:\nOperating system:\nWhat happened:\n");
const contactGroups = [
  {
    title: "Talk to us",
    items: [
      crispWebsiteId && {
        title: "Live chat",
        icon: ["M5 5h14v10h-8l-4 4v-4H5z", "M9 10h.01M12 10h.01M15 10h.01"],
        hint: "Crisp",
        href: supportMail,
        chat: true,
      },
      {
        title: "Email Support",
        icon: ["M4 6h16v12H4z", "m4 7 8 6 8-6"],
        hint: "Private",
        href: supportMail,
      },
      {
        title: "Ask the community",
        icon: ["M4 5h11v8H9l-3 3v-3H4z", "M18 9h2v8h-2v3l-3-3h-4v-2"],
        hint: "Reddit",
        href: "https://www.reddit.com/r/blancbrowser/",
      },
    ].filter(Boolean),
  },
  {
    title: "Report something",
    items: [
      {
        title: "Report a bug",
        icon: ["M10 6.5a2 2 0 0 1 4 0", "M8 10a4 4 0 0 1 8 0v4a4 4 0 0 1-8 0z", "M12 10v8M8 11H5M16 11h3M8 15H5.5M16 15h2.5"],
        hint: "GitHub",
        href: "https://github.com/bnfy/blanc/issues/new?template=bug_report.yml",
      },
      {
        title: "Request a feature",
        icon: ["M9 18h6M10 21h4", "M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z"],
        hint: "GitHub",
        href: "https://github.com/bnfy/blanc/issues/new?template=feature_request.yml",
      },
      {
        title: "Security issue",
        icon: ["M12 3 5 6v5c0 4.5 3 8.2 7 10 4-1.8 7-5.5 7-10V6z", "m9 12 2 2 4-4"],
        hint: "Private",
        href: mailto(
          "Security report",
          "Blanc version:\nOperating system:\nWhat you found and how to reproduce it:\n",
        ),
      },
    ],
  },
];
---

<BaseLayout
  title="Blanc Support — Setup, everyday tools and answers"
  description="Find your way around Blanc: import bookmarks, manage tabs, set up 1Password, activate Patron, and get straightforward answers about the browser."
  path="/support"
  page="support"
  current="support"
>
  <main id="main-content" class="reference-page">
    <header class="reference-heading">
      <p class="section-kicker">Blanc Support</p><h1>
        A little help<br />goes a long way.
      </h1><p>Find an answer. Get back to what you were doing.</p>
    </header>
    <div class="support-search" hidden data-search-ui>
      <label for="answer-search">Search Support</label><div>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
          ><circle cx="10" cy="10" r="6.5"></circle><path d="m15 15 6 6"
          ></path></svg
        ><input
          id="answer-search"
          type="search"
          placeholder="Try bookmarks, tabs or 1Password"
          autocomplete="off"
          aria-describedby="search-count"
        /><button type="button" id="clear-search" hidden>Clear</button>
      </div><p id="search-count" role="status" aria-live="polite"></p>
    </div>
    <nav class="support-shortcuts" aria-label="Common questions">
      <a href="#bookmark-import">Bring your bookmarks <span>↗</span></a><a
        href="#updates">Update Blanc <span>↗</span></a
      ><a href="#1password">Set up 1Password <span>↗</span></a><a
        href="#patron">Activate Patron <span>↗</span></a>
    </nav>
    <section class="reference-contact" id="contact" aria-labelledby="contact-title">
      <h2 id="contact-title">Get in touch</h2><p>
        Include your Blanc version and operating system. Keep passwords and
        private browsing information out of your message.
      </p><!--email_off-->
      <div class="contact-groups">{
        contactGroups.map(({ title, items }) => (
          <div>
            <h3>{title}</h3>
            <ul>
              {items.map(({ title, icon, hint, href, chat }) => (
                <li>
                  <a
                    href={href}
                    data-live-chat={chat ? crispWebsiteId : undefined}
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      {icon.map((d) => <path d={d} />)}
                    </svg>
                    {title}
                    <small>{hint}</small>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }</div><!--/email_off-->
    </section>
    <section class="answer-group">
      <h2>Using Blanc</h2><GuideTopics page="support" />
    </section>
    <section class="answer-group">
      <h2>Straight answers</h2>{
        questions.map(({ id, q, a }) => (
          <details
            class="answer-topic"
            id={id === "1password" ? "1password-faq" : id}
            data-search-topic
          >
            <>
              <summary>
                {q}
                <span aria-hidden="true">+</span>
              </summary>
              <div class="answer-body">
                {a.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
                {id === "bookmark-import" && (
                  <p>
                    <a href="/arc-alternative">
                      Moving from Arc? See what transfers and how to bring your Spaces into Blanc.
                    </a>
                  </p>
                )}
                {id === "independent-audit" && (
                  <p>
                    <a href="/trust#security-audit-title">
                      Audit status and known limitations →
                    </a>
                  </p>
                )}
                {id === "electron" && (
                  <p>
                    <a href="/trust#blocking-memory-title">
                      Read the dated benchmark and its method →
                    </a>
                  </p>
                )}
                {id === "open-source" && (
                  <p>
                    <a href="https://github.com/bnfy/blanc/tree/v1.26.0">
                      Source, license and third-party notices →
                    </a>
                  </p>
                )}
                {id === "patron" && (
                  <p>
                    <a href="https://buy.polar.sh/polar_cl_auwRq39Q2hIVLJwANEqFWgWuZ8DGjdJmEI4mE0JaNDf">
                      Become a Patron →
                    </a>
                  </p>
                )}
              </div>
            </>
          </details>
        ))
      }
    </section>
    <p class="search-empty" id="search-empty" hidden>
      No matching answers. Try a different word, or get in touch above.
    </p>
  </main>
  <script src="../scripts/answers.js"></script>
  <script src="../scripts/support-chat.js"></script>
</BaseLayout>
