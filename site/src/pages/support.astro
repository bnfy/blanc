---
// Support (redesign of November 23, 2026,
// docs/superpowers/specs/2026-11-23-support-page-redesign-design.md): one
// page for all of Blanc. Product tabs are radios that switch their panels in
// CSS (support.css), so the page works without scripting; answers.js adds
// search across every tab, deep links that open the right tab, ?product= and
// an iPhone & iPad preselect. Every <details id> is a deep link that other
// pages, the site search and the build's fragment check rely on: never drop
// or rename one.
import BaseLayout from "../layouts/BaseLayout.astro";
import GuideTopics from "../components/GuideTopics.astro";
import questions from "../data/support-questions.json";
import products from "../data/support-products.json";
import { mailQuestions, mailSupportTopics } from "../data/mail-questions.mjs";
import "../styles/reference.css";
import "../styles/support.css";
import { CRISP_WEBSITE_ID } from "../lib/crisp.mjs";

const answers = new Map(questions.map((question) => [question.id, question]));
const mail = new Map([...mailQuestions, ...mailSupportTopics].map((item) => [item.id, item]));
// The 1Password guide already uses id="1password", so its answer takes another.
const answerId = (id) => (id === "1password" ? "1password-faq" : id);

const productIcons = {
  desktop: ["M3 5h18v11H3z", "M9 20h6M12 16v4"],
  iphone: ["M8 3h8a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z", "M11 18h2"],
  beta: ["M10 3h4M11 3v6l-5 9a2 2 0 0 0 1.7 3h8.6a2 2 0 0 0 1.7-3l-5-9V3", "M8 15h8"],
  mail: ["M4 6h16v12H4z", "m4 7 8 6 8-6"],
};

const supportEmail = "support@blanc.day";
const crispWebsiteId = CRISP_WEBSITE_ID;
const mailto = (subject, body) =>
  `mailto:${supportEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
const supportMail = mailto("Blanc support", "Blanc version:\nOperating system:\nWhat happened:\n");
const contactGroups = [
  {
    title: "Talk to us",
    items: [
      crispWebsiteId && {
        title: "Live chat",
        icon: ["M5 5h14v10h-8l-4 4v-4H5z", "M9 10h.01M12 10h.01M15 10h.01"],
        hint: "A real person",
        href: supportMail,
        chat: true,
      },
      {
        title: "Email Support",
        icon: ["M4 6h16v12H4z", "m4 7 8 6 8-6"],
        hint: "Private",
        href: supportMail,
      },
      {
        title: "Ask the community",
        icon: ["M4 5h11v8H9l-3 3v-3H4z", "M18 9h2v8h-2v3l-3-3h-4v-2"],
        hint: "Reddit",
        href: "https://www.reddit.com/r/blancbrowser/",
      },
    ].filter(Boolean),
  },
  {
    title: "Report something",
    items: [
      {
        title: "Report a bug",
        icon: ["M10 6.5a2 2 0 0 1 4 0", "M8 10a4 4 0 0 1 8 0v4a4 4 0 0 1-8 0z", "M12 10v8M8 11H5M16 11h3M8 15H5.5M16 15h2.5"],
        hint: "GitHub",
        href: "https://github.com/bnfy/blanc/issues/new?template=bug_report.yml",
      },
      {
        title: "Request a feature",
        icon: ["M9 18h6M10 21h4", "M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z"],
        hint: "GitHub",
        href: "https://github.com/bnfy/blanc/issues/new?template=feature_request.yml",
      },
      {
        title: "Security issue",
        icon: ["M12 3 5 6v5c0 4.5 3 8.2 7 10 4-1.8 7-5.5 7-10V6z", "m9 12 2 2 4-4"],
        hint: "Private",
        href: mailto(
          "Security report",
          "Blanc version:\nOperating system:\nWhat you found and how to reproduce it:\n",
        ),
      },
    ],
  },
];
const popular = [
  { href: "#bookmark-import", text: "Bring your bookmarks" },
  { href: "#updates", text: "Update Blanc" },
  { href: "#iphone-pair", text: "Pair your iPhone" },
  { href: "#1password", text: "Set up 1Password" },
  { href: "#patron", text: "Activate Patron" },
  { href: "#contact", text: "Contact us" },
];
---

<BaseLayout
  title="Blanc Support — Help for Blanc on every device"
  description="Answers for Blanc on Mac, Windows and Linux, Blanc for iPhone and iPad, Blanc Beta and Blanc Mail: import bookmarks, pair your iPhone, set up 1Password, and get in touch."
  path="/support"
  page="support"
  current="support"
>
  <main id="main-content" class="support-page">
    <header class="support-hero">
      <div class="support-hero-inner">
      <div class="support-hero-text">
        <p class="section-kicker">Blanc Support</p><h1>
          A little help<br />goes a long way.
        </h1><p class="support-lede">
          Answers for Blanc on your computer, iPhone and iPad, Blanc Beta and Blanc Mail.
        </p>
      </div>
      <div class="support-hero-tools">
        <div class="support-search" hidden data-search-ui>
          <label for="answer-search">Search Support</label><div>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
              ><circle cx="10" cy="10" r="6.5"></circle><path d="m15 15 6 6"
              ></path></svg
            ><input
              id="answer-search"
              type="search"
              placeholder="Try bookmarks, pairing or 1Password"
              autocomplete="off"
              aria-describedby="search-count"
            /><button type="button" id="clear-search" hidden>Clear</button>
          </div><p id="search-count" role="status" aria-live="polite"></p>
        </div>
        <nav class="support-shortcuts" aria-label="Popular answers">
          <p>Popular</p>
          <ul>
            {popular.map(({ href, text }) => (
              <li><a href={href}>{text}</a></li>
            ))}
          </ul>
        </nav>
      </div>
      <img
        class="support-hero-mark"
        src="/lockup/sunrise-mark-2048.webp"
        srcset="/lockup/sunrise-mark-256.webp 256w, /lockup/sunrise-mark-2048.webp 2048w"
        sizes="(max-width: 900px) 140px, 380px"
        width="2048"
        height="2048"
        alt=""
        decoding="async"
      />
      </div>
    </header>
    <div class="support-body">

    <div class="support-products" data-support-products>
      <div class="support-tabs" role="radiogroup" aria-label="Choose a product">
        {products.map(({ id, label }, index) => (
          <label data-product={id}>
            <input
              class="support-product-radio"
              type="radio"
              name="support-product"
              id={`support-product-${id}`}
              value={id}
              checked={index === 0}
            />
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              {productIcons[id].map((d) => <path d={d} />)}
            </svg>
            {label}
          </label>
        ))}
      </div>
      {products.map(({ id, label, groups }) => (
        <div
          class="support-panel"
          data-panel={id}
          data-panel-radio={`support-product-${id}`}
          data-search-panel
        >
          <p class="support-panel-label">{label}</p>
          {groups.map(({ title, rows }) => (
            <section class="answer-group support-group">
              <h2>{title}</h2>
              {rows.map((row) => {
                if (row.guide) return <GuideTopics page="support" ids={[row.guide]} />;
                if (row.mail) {
                  const item = mail.get(row.mail);
                  return (
                    <details class="answer-topic" id={item.id} data-search-topic>
                      <summary>
                        {item.title}
                        <span aria-hidden="true">+</span>
                      </summary>
                      <div class="answer-body">
                        {item.html ? <p set:html={item.html} /> : <p>{item.answer}</p>}
                      </div>
                    </details>
                  );
                }
                const { id: dataId, q, a, links = [] } = answers.get(row.answer);
                return (
                  <details class="answer-topic" id={answerId(dataId)} data-search-topic>
                    <summary>
                      {q}
                      <span aria-hidden="true">+</span>
                    </summary>
                    <div class="answer-body">
                      {a.map((paragraph) => <p>{paragraph}</p>)}
                      {/* Two of these sentences are pinned by claims ledgers
                          (v1.27, Arc switching v1.38); keep them word for word. */}
                      {dataId === "bookmark-import" && (
                        <p>
                          <a href="/arc-alternative">
                            Moving from Arc? See what transfers and how to bring your Spaces into Blanc.
                          </a>
                        </p>
                      )}
                      {dataId === "independent-audit" && (
                        <p>
                          <a href="/trust#security-audit-title">
                            Audit status and known limitations →
                          </a>
                        </p>
                      )}
                      {dataId === "electron" && (
                        <p>
                          <a href="/trust#blocking-memory-title">
                            Read the dated benchmark and its method →
                          </a>
                        </p>
                      )}
                      {dataId === "open-source" && (
                        <p>
                          <a href="https://github.com/bnfy/blanc/tree/v1.26.0">
                            Source, license and third-party notices →
                          </a>
                        </p>
                      )}
                      {dataId === "patron" && (
                        <p>
                          <a href="https://buy.polar.sh/polar_cl_auwRq39Q2hIVLJwANEqFWgWuZ8DGjdJmEI4mE0JaNDf">
                            Become a Patron →
                          </a>
                        </p>
                      )}
                      {links.map((link) => (
                        <p>
                          <a href={link.href}>{link.text}</a>
                        </p>
                      ))}
                    </div>
                  </details>
                );
              })}
            </section>
          ))}
        </div>
      ))}
    </div>
    <p class="search-empty" id="search-empty" hidden>
      No matching answers. Try a different word, or get in touch below.
    </p>

    <section class="support-contact" id="contact" aria-labelledby="contact-title">
      <h2 id="contact-title">Still need help?</h2><p>
        Include your Blanc version and operating system. Keep passwords and
        private browsing information out of your message.
      </p><!--email_off-->
      <div class="contact-groups">{
        contactGroups.map(({ title, items }) => (
          <div>
            <h3>{title}</h3>
            <ul>
              {items.map(({ title, icon, hint, href, chat }) => (
                <li>
                  <a
                    href={href}
                    data-live-chat={chat ? crispWebsiteId : undefined}
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      {icon.map((d) => <path d={d} />)}
                    </svg>
                    {title}
                    <small>{hint}</small>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }</div><!--/email_off-->
    </section>
    </div>
  </main>
  <script src="../scripts/answers.js"></script>
</BaseLayout>
