---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/media.css';
import BrandMark from '../components/BrandMark.astro';
import releaseData from '../data/releases.json';
import { version } from '../../../package.json';

const VERSION = version;
const TAG = `v${VERSION}`;
/* Wherever this page states a version and a date together, the date is that
   version's own ship date — read from the generated changelog data rather than
   typed in. Hardcoding it means the pair silently goes wrong the moment the
   version pin moves: the fact sheet read "Blanc 1.1.0, released August 2, 2026"
   for exactly that reason, August 2 being 1.0's launch. The dateline on the
   announcement below is a different thing — it dates the 1.0 announcement
   itself, and stays put. */
const ALL_RELEASES = releaseData.releases ?? releaseData;
/* Between the version bump and publication there is deliberately no entry for
   TAG: releases.json is generated from the published GitHub release, which does
   not exist until the release script has run — and the release script cannot
   run until this page builds. Throwing here therefore made every release
   impossible, so the shipping-release facts fall back to the newest PUBLISHED
   entry instead, and take their version from that same entry. Pairing them is
   the point: a fallback that kept printing VERSION would state the new version
   beside the old one's ship date, which is the exact fault the hard failure was
   added to prevent. */
const CURRENT_RELEASE = ALL_RELEASES.find((entry) => entry.tag === TAG) ?? ALL_RELEASES[0];
if (!CURRENT_RELEASE) {
  throw new Error(
    'media.astro: releases.json is empty. Run "npm run site:changelog" before building — ' +
    'a blank date on the fact sheet is worse than a loud failure here.'
  );
}
const RELEASE_VERSION = CURRENT_RELEASE.tag.replace(/^v/, '');
const RELEASED_HUMAN = CURRENT_RELEASE.humanDate;
const RELEASED_MACHINE = CURRENT_RELEASE.machineDate;
const RELEASE_BASE = 'https://github.com/bnfy/blanc/releases';
const RELEASE_URL = `${RELEASE_BASE}/tag/${TAG}`;
const CHECKSUM_URL = `${RELEASE_BASE}/download/${TAG}/SHA256SUMS`;
const MEDIA_EMAIL = 'support@blancbrowser.com';
const MEDIA_REQUEST_URL = `mailto:${MEDIA_EMAIL}?subject=Blanc%20media%20request`;

/* The island index: each dot is a section of this page, the way each dot in
   Blanc's resting island is a tab. Order follows the page. */
const sections = [
  { id: 'kit', label: 'Media kit', icon: 'image' },
  { id: 'describe', label: 'Description', icon: 'text' },
  { id: 'facts', label: 'Key facts', icon: 'list' },
  { id: 'in-the-news', label: 'In the news', icon: 'news' },
  { id: 'contact', label: 'Contact', icon: 'mail' },
];

/* Ready-to-paste descriptions. Each sentence restates a key fact below, so a
   reporter can quote either length without re-checking it. */
const shortDescription = 'Blanc is a free independent browser from Bananify that replaces the permanent tab strip and toolbar with one expandable island, leaving the page at center stage.';
const longDescription = `${shortDescription} It blocks ads, trackers, and fingerprinting requests at the network layer, with no extension required. There is no required account and no built-in AI agent, and sync is optional and end-to-end encrypted. Blanc runs on macOS, Windows, and Linux. An optional Blanc Patron subscription supports development and adds creation of device-local Named Workspaces.`;
const descriptions = [
  { id: 'short', label: 'Short', text: shortDescription },
  { id: 'long', label: 'Long', text: longDescription },
].map((entry) => ({ ...entry, words: entry.text.split(/\s+/).length }));

const ANNOUNCEMENT_URL = 'https://github.com/bnfy/blanc/blob/main/docs/press/press-release.md';
---
<BaseLayout
  title="Blanc Browser Media Kit — Images, Facts, and Press Contact"
  description="Download Blanc Browser product images and the Blanc mark, copy a ready-made description, check the current release facts, and contact the team behind Blanc."
  path="/media"
  page="media"
  header="legal"
  analytics={false}
  ogTitle="Blanc replaces browser clutter with one small island"
  ogDescription="No permanent tab row, no required account, and no built-in AI agent. Blanc is free for macOS, Windows, and Linux."
  ogImage="/press/blanc-press-card.png"
  ogImageAlt="Blanc media kit: the browser in one small island."
>
<main id="main-content" class="media-page">
  <section class="media-hero" aria-labelledby="media-title">
    <p class="section-kicker">Media</p>
    <h1 id="media-title">Blanc, for the record.</h1>
    <p class="media-hero-lead">Product images, checked facts, and a direct line to the team behind Blanc, for anyone writing, filming, or talking about it.</p>

    <ul class="media-paths" aria-label="Start here">
      <li>
        <a class="media-path" href="#kit">
          <span class="media-path-title">Media kit</span>
          <span class="media-path-body">Native captures of the current release and the Sunrise mark, ready to download.</span>
          <span class="media-path-go" aria-hidden="true">↓</span>
        </a>
      </li>
      <li>
        <div class="media-path media-path--email">
          <span class="media-path-title">Email</span>
          <span class="media-path-body">Interviews, fact checks, and custom captures.</span>
          <span class="media-path-address">
            <!--email_off--><a href={MEDIA_REQUEST_URL}>{MEDIA_EMAIL}</a><!--/email_off-->
            <button class="media-copy media-copy--quiet" type="button" data-copy={MEDIA_EMAIL} data-copied-label="Email address copied">Copy</button>
          </span>
        </div>
      </li>
      <li>
        <a class="media-path" href="#facts">
          <span class="media-path-title">Key facts</span>
          <dl class="media-path-facts">
            <div><dt>current release</dt><dd>Blanc {RELEASE_VERSION}</dd></div>
            <div><dt>date</dt><dd><time datetime={RELEASED_MACHINE}>{RELEASED_HUMAN}</time></dd></div>
          </dl>
          <span class="media-path-go" aria-hidden="true">↓</span>
        </a>
      </li>
    </ul>
  </section>

  <nav class="media-index" aria-label="On this page" data-media-index>
    <div class="media-index-pill">
      <a class="media-index-top" href="#main-content" aria-label="Back to the top">
        <BrandMark class="media-index-mark" />
      </a>
      <ol class="media-index-dots">
        {sections.map((section) => (
          <li>
            <a href={`#${section.id}`} data-section={section.id}>
              <span class="media-index-dot" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                  {section.icon === 'image' && <><rect x="3.5" y="5" width="17" height="14" rx="2" /><circle cx="9" cy="10" r="1.6" /><path d="m20.5 16-4.5-4.5L7 19" /></>}
                  {section.icon === 'text' && <path d="M5 7h14M5 11h14M5 15h10M5 19h7" />}
                  {section.icon === 'list' && <><path d="M9 7h11M9 12h11M9 17h11" /><circle cx="5" cy="7" r="1" /><circle cx="5" cy="12" r="1" /><circle cx="5" cy="17" r="1" /></>}
                  {section.icon === 'news' && <><rect x="3.5" y="5" width="17" height="14" rx="2" /><path d="M7 9h6M7 12.5h10M7 16h10" /></>}
                  {section.icon === 'mail' && <><rect x="3.5" y="5.5" width="17" height="13" rx="2" /><path d="m4 7 8 6 8-6" /></>}
                </svg>
              </span>
              <span class="sr-only">{section.label}</span>
            </a>
          </li>
        ))}
      </ol>
      <span class="media-index-now" aria-hidden="true"><span data-media-index-now>{sections[0].label}</span></span>
      <!--email_off--><a class="media-index-action" href={MEDIA_REQUEST_URL}>Email</a><!--/email_off-->
    </div>
  </nav>

  <section class="media-section media-kit" id="kit" aria-labelledby="media-kit-title">
    <header class="media-section-head">
      <h2 id="media-kit-title">Make the island the lead image.</h2>
      <p>Native captures of public Blanc 1.30.1 with a sample profile. The page shown is The Met’s public-domain collection.</p>
    </header>

    <figure class="media-lead">
      <a href="/press/blanc-island-resting-v1.30.1.png" download>
        <img src="/press/blanc-island-resting-v1.30.1.webp" width="2560" height="1600" alt="A Blanc window with the resting island above The Met’s page for Van Gogh’s Wheat Field with Cypresses." />
      </a>
      <figcaption>
        <span><strong>The island at rest.</strong> Back, forward, the current group’s tabs as dots, and the page’s domain, in one pill above the page.</span>
        <a href="/press/blanc-island-resting-v1.30.1.png" download>Download PNG · 2560&nbsp;×&nbsp;1600</a>
      </figcaption>
    </figure>

    <div class="media-kit-row">
      <figure class="media-tile">
        <a href="/press/blanc-island-expanded-v1.30.1.png" download>
          <img src="/press/blanc-island-expanded-v1.30.1.webp" width="2560" height="1600" loading="lazy" decoding="async" alt="The expanded Blanc island listing tabs under the named groups inspiration and reading, open over the page." />
        </a>
        <figcaption>
          <span><strong>The island expanded.</strong> Search, tabs, and named groups in one panel.</span>
          <a href="/press/blanc-island-expanded-v1.30.1.png" download>Download PNG · 2560&nbsp;×&nbsp;1600</a>
        </figcaption>
      </figure>
      <figure class="media-tile media-tile--mark">
        <a href="/press/blanc-sunrise-mark-4096.png" download>
          <img src="/press/blanc-sunrise-mark-4096.webp" width="4096" height="4096" loading="lazy" decoding="async" alt="The Sunrise mark in full color: a gold half-sun with rays over stepped water lines, on ivory." />
        </a>
        <figcaption>
          <span><strong>Sunrise mark, full color.</strong> Gold on ivory.</span>
          <a href="/press/blanc-sunrise-mark-4096.png" download>Download PNG · 4096&nbsp;×&nbsp;4096</a>
        </figcaption>
      </figure>
      <figure class="media-tile media-tile--mark">
        <a href="/press/blanc-sunrise-mark-black-4096.png" download>
          <img src="/press/blanc-sunrise-mark-black-4096.webp" width="4096" height="4096" loading="lazy" decoding="async" alt="The Sunrise mark in black on white." />
        </a>
        <figcaption>
          <span><strong>Sunrise mark, black.</strong> On white.</span>
          <a href="/press/blanc-sunrise-mark-black-4096.png" download>Download PNG · 4096&nbsp;×&nbsp;4096</a>
        </figcaption>
      </figure>
    </div>

    <ul class="media-kit-links">
      <li><a href={CHECKSUM_URL}>Verify with SHA-256</a></li>
      <li><a href={ANNOUNCEMENT_URL}>Read the 1.0 announcement</a></li>
    </ul>
  </section>

  <section class="media-section media-describe" id="describe" aria-labelledby="media-describe-title">
    <header class="media-section-head">
      <h2 id="media-describe-title">Copy the official description.</h2>
      <p>Short or long, every sentence matches the key facts below, so it can run as written.</p>
    </header>

    <div class="media-describe-card">
      <div class="media-describe-bar">
        <fieldset class="media-segments">
          <legend class="sr-only">Description length</legend>
          {descriptions.map((entry, index) => (
            <label>
              <input type="radio" name="media-description" value={entry.id} checked={index === 0} />
              <span>{entry.label}</span>
            </label>
          ))}
          <span class="media-segments-thumb" aria-hidden="true"></span>
        </fieldset>
        {descriptions.map((entry) => (
          <button class="media-copy" type="button" data-copy={entry.text} data-description={entry.id} data-copied-label={`${entry.label} description copied`}>Copy</button>
        ))}
      </div>
      {descriptions.map((entry) => (
        <div class="media-description" data-description={entry.id}>
          <p>{entry.text}</p>
          <p class="media-description-count">{entry.label} · {entry.words} words</p>
        </div>
      ))}
    </div>
  </section>

  <section class="media-section media-facts" id="facts" aria-labelledby="media-facts-title">
    <header class="media-section-head">
      <h2 id="media-facts-title">Blanc, at a glance.</h2>
      <p>Version and date follow the current public release.</p>
    </header>
    <!-- Six tiles, two rows: the release and what it costs, then what Blanc
         does by default. Values lead; notes qualify them. -->
    <dl class="media-fact-grid">
      <div><dt>version</dt><dd>Blanc {RELEASE_VERSION}<span class="media-fact-note">Released <time datetime={RELEASED_MACHINE}>{RELEASED_HUMAN}</time></span></dd></div>
      <div><dt>platforms</dt><dd>macOS · Windows · Linux<span class="media-fact-note">Chromium through Electron</span></dd></div>
      <div><dt>price</dt><dd>Free<span class="media-fact-note">Optional Blanc Patron: US$30/year or $4/month, plus tax; adds named workspaces on every platform</span></dd></div>
      <div><dt>blocking</dt><dd>Built in<span class="media-fact-note">At the network layer; no extension required</span></dd></div>
      <div><dt>account</dt><dd>Not required</dd></div>
      <div><dt>built-in AI agent</dt><dd>None</dd></div>
    </dl>
  </section>

  <section class="media-section media-news" id="in-the-news" aria-labelledby="media-news-title">
    <header class="media-section-head">
      <h2 id="media-news-title">In the news</h2>
    </header>
    <ul class="media-news-list">
      <li>
        <article aria-labelledby="justgeek-title">
          <p class="media-news-meta">JustGeek <span aria-hidden="true">·</span> <time datetime="2026-10-07">October 7, 2026</time> <span aria-hidden="true">·</span> In French</p>
          <h3 id="justgeek-title"><a href="https://www.justgeek.fr/blanc-navigateur-open-source-159317/" hreflang="fr" lang="fr">Blanc : un navigateur open source qui ne ressemble à aucun autre</a></h3>
          <p>“Blanc: an open-source browser unlike any other.” A hands-on tour on Windows 11 of the Island, Glance, Quiet Tabs, private tabs, and the built-in blocker.</p>
        </article>
      </li>
      <li>
        <article aria-labelledby="omg-ubuntu-title">
          <p class="media-news-meta">OMG! Ubuntu <span aria-hidden="true">·</span> <time datetime="2026-09-30">September 30, 2026</time></p>
          <h3 id="omg-ubuntu-title"><a href="https://www.omgubuntu.co.uk/2026/09/blanc-web-browser-new">New FOSS web browser Blanc opts for a different kind of UI</a></h3>
          <p>A look at Blanc’s floating Island interface and how it approaches everyday browsing.</p>
        </article>
      </li>
    </ul>
  </section>

  <section class="media-contact" id="contact" aria-labelledby="media-contact-title">
    <h2 id="media-contact-title">Write to the team behind Blanc.</h2>
    <p>Request an interview, fact-check a claim, or ask for a custom product capture. One inbox, read by the people who make Blanc.</p>
    <p class="media-contact-address">
      <!--email_off--><a href={MEDIA_REQUEST_URL}>{MEDIA_EMAIL}</a><!--/email_off-->
      <button class="media-copy media-copy--on-dark" type="button" data-copy={MEDIA_EMAIL} data-copied-label="Email address copied">Copy</button>
    </p>
    <p class="media-contact-org">Bananify · Publisher of Blanc Browser</p>
    <ul class="media-contact-links">
      <li><a href={RELEASE_URL}>Release notes</a></li>
      <li><a href={CHECKSUM_URL}>SHA-256 manifest</a></li>
    </ul>
  </section>

  <p class="sr-only" role="status" aria-live="polite" data-media-status></p>
</main>
<script src="../scripts/media.js"></script>
</BaseLayout>
