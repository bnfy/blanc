---
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../data/bangs.json';
import { directoryRows, featuredCards, iconTile, iconUrl } from '../scripts/bangs-directory.mjs';
import '../styles/bangs.css';

// The data is pinned to one release (site/scripts/build-bangs-data.mjs). The
// cards are the app's own popular bangs and the list holds every bang, so the
// page reads right without JavaScript. Icons come from the icon server
// (cloudflare/bang-icons-worker) at /bang-icons/<host>, over a lettered tile
// that shows while one loads and stays when a site has none; list rows get
// theirs from the script as they are shown.
const rows = directoryRows(data);
const cards = featuredCards(data);
const countText = data.count.toLocaleString('en-US');
const moreText = (data.count - cards.length).toLocaleString('en-US');
const versionText = data.release ? `Blanc ${data.release.replace(/^v/, '')}` : 'this build of Blanc';
const SHOWN_ALIASES = 3;
const shownAliases = (aliases) => aliases.slice(0, SHOWN_ALIASES).map((alias) => `!${alias}`);
const moreAliases = (aliases) => (aliases.length > SHOWN_ALIASES ? `+${aliases.length - SHOWN_ALIASES}` : '');
---
<BaseLayout
  title={"Bangs: Search Any Site From the Address Bar | Blanc Browser"}
  description={"Type !yt lofi in Blanc to search YouTube directly, with any search engine. Find the code for any site in Blanc's built-in list."}
  path="/bangs"
  page="bangs"
  current="features"
  ogDescription={"Type a site's code before your search and Blanc opens its results directly, with any search engine."}
  ogImage="/feature-bangs.png"
  ogImageAlt={"Blanc's Island with !yt lofi typed and the hint row reading Search YouTube for lofi."}
>
  <script type="application/ld+json" is:inline slot="head">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://blanc.day/"},{"@type":"ListItem","position":2,"name":"Features","item":"https://blanc.day/features"},{"@type":"ListItem","position":3,"name":"Bangs","item":"https://blanc.day/bangs"}]}
</script>

<main id="main-content" class="feature-page feature-detail-page bangs-page">
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">home</a><span aria-hidden="true">/</span><a href="/features">features</a><span aria-hidden="true">/</span><span aria-current="page">bangs</span></nav>

  <section class="feature-hero feature-hero--detail feature-hero--text bangs-hero" aria-labelledby="bangs-title">
    <h1 id="bangs-title">Search the site. Skip the engine.</h1>
    <p>Type a site’s code before your search, like <kbd class="bang-chip">!yt lofi</kbd>, to go straight to its results. Works with any search engine.</p>
  </section>

  <div class="bangs-search">
    <label for="bangs-search" class="sr-only">Search bangs</label>
    <input id="bangs-search" type="search" placeholder="Search bangs: youtube, yt, wikipedia…" autocomplete="off" spellcheck="false" />
    <span id="bangs-count" aria-live="polite">{`${countText} bangs`}</span>
  </div>

  <ul class="bangs-cards" id="bangs-cards" aria-label="Popular bangs">
    {cards.map((card) => {
      const tile = iconTile(card.host, card.name);
      return (
        <li class="bangs-card" data-code={card.code}><span class={`bangs-icon t${tile.tone}`} aria-hidden="true">{tile.letter}<img src={iconUrl(card.host)} alt="" width="32" height="32" loading="lazy" decoding="async" /></span><span class="bangs-card-host">{card.host.replace(/^www\./, '')}</span><span class="bangs-card-name">{card.name}</span><span class="bangs-card-codes">{card.codes.map((code) => <kbd class="bang-chip">{`!${code}`}</kbd>)}</span></li>
      );
    })}
  </ul>

  <div class="bangs-fold" id="bangs-fold">
    <p>{`And ${moreText} more.`}</p>
    <div class="bangs-fold-actions">
      <button type="button" id="bangs-search-them">Search them</button>
      <button type="button" id="bangs-browse">Browse all</button>
    </div>
  </div>

  <section class="bangs-list" id="bangs-list" aria-labelledby="bangs-dir-title">
    <h2 id="bangs-dir-title" class="sr-only">Every bang in Blanc</h2>
    <ol class="bangs-rows" id="bangs-rows">
      {rows.map((row) => {
        const tile = iconTile(row.host, row.name);
        return (
          <li data-code={row.code}><span class={`bangs-icon t${tile.tone}`}>{tile.letter}</span><b>{`!${row.code}`}</b><span>{row.name}</span><small>{shownAliases(row.aliases).map((code) => <><kbd>{code}</kbd> </>)}{moreAliases(row.aliases)}</small><em>{row.host}</em>{row.via && <i data-via>{`via ${row.via}`}</i>}</li>
        );
      })}
    </ol>
    <div class="bangs-more">
      <button type="button" id="bangs-more" hidden>Show more</button>
      <p id="bangs-showing" class="bangs-showing" aria-live="polite">{`Showing all ${countText}`}</p>
    </div>
  </section>

  <div class="bangs-facts">
    <p class="bangs-dir-sub">{`${countText} bangs, exactly the list in ${versionText}. Search by site or by code.`}</p>
    <p class="bangs-credit">The bang list comes from <a href="https://github.com/kagisearch/bangs" rel="noopener">Kagi’s open-source bang collection</a> (<a href="/licenses/kagi-bangs-MIT.txt">MIT</a>), checked and bundled with each Blanc release.</p>
  </div>

  <section class="bangs-how" aria-labelledby="bangs-how-title">
    <h2 id="bangs-how-title">How bangs work</h2>
    <ul>
      <li><strong>First or last.</strong> <kbd class="bang-chip">!yt lofi</kbd> and <kbd class="bang-chip">lofi !yt</kbd> do the same thing, and a code on its own, like <kbd class="bang-chip">!yt</kbd>, opens the site’s home page.</li>
      <li><strong>Don’t know the code? Type <kbd class="bang-chip">!</kbd>.</strong> The Island lists the bangs you used recently and a set of popular ones.</li>
      <li><strong>Your words skip your search engine.</strong> A bang opens the address it names, and Blanc sends your words only there, never to your own search engine first. A few bangs send your words through Google or DuckDuckGo to search one site; the list marks them.</li>
      <li><strong>Add your own.</strong> Settings, General, Your bangs: pick a code, a name, and the site’s search address with <kbd class="bang-chip">%s</kbd> where your words go. With Sync on, your bangs follow you to your other computers.</li>
    </ul>
    <p class="bangs-how-note">The list ships inside Blanc and changes only with a Blanc update. Blanc doesn’t ask your search engine for suggestions while a bang is in the box. A bang typed at the end is different: the words before it may already have gone to your search engine as suggestions, unless suggestions are off in Settings.</p>
  </section>

  <section class="feature-close" aria-labelledby="bangs-close-title"><h2 id="bangs-close-title">Try bangs in Blanc.</h2><a class="cta" href="/download" data-track="feature_cta_click" data-feature="bangs" data-cta-position="feature-close">download blanc</a></section>
</main>

<script src="../scripts/bangs-page.js"></script>
</BaseLayout>
