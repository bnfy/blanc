---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandMark from '../components/BrandMark.astro';
import MailBar from '../components/MailBar.astro';
import MailWaitlistForm from '../components/MailWaitlistForm.astro';
import '../styles/mail.css';
---
<BaseLayout title="Blanc Mail — A little less inbox" description="Blanc Mail is a native Gmail client for macOS, coming soon from the makers of Blanc Browser." path="/mail" header="solid" ogImageAlt="The Blanc Sunrise mark on a warm ivory background">
  <MailBar />
  <!-- Until Mail launches, the overview is one gold envelope standing under a
       lamp on a dark stage (docs/superpowers/specs/2026-10-21-mail-gold-envelope-design.md).
       Every sentence here was already on the Mail pages and is recorded in
       docs/website-mail-claims-2026-10-12.md. -->
  <main id="main-content" class="mail-stage">
    <section class="mail-soon" aria-labelledby="mail-soon-title">
      <p class="mail-eyebrow">Blanc Mail · for Mac · Coming soon</p>
      <h1 id="mail-soon-title"><span class="mail-gold-text">A little less inbox.</span></h1>
      <!-- The Mail icon as an object: a gold envelope, its flap and folds
           engraved, the Sunrise stamped where the flap meets. Decorative. -->
      <div class="mail-envelope" data-mail-envelope aria-hidden="true">
        <div class="mail-envelope-face">
          <svg class="mail-envelope-folds" viewBox="0 0 800 500" preserveAspectRatio="none">
            <path class="mail-groove" d="M0 0 L400 290 L800 0" />
            <path class="mail-groove-lip" d="M0 2 L400 292 L800 2" />
            <path class="mail-groove" d="M0 500 L330 248 M800 500 L470 248" />
            <path class="mail-groove-lip" d="M0 502 L330 250 M800 502 L470 250" />
          </svg>
          <span class="mail-hallmark"><BrandMark class="mail-hallmark-lip" /><BrandMark class="mail-hallmark-cut" /></span>
        </div>
      </div>
      <p class="mail-soon-lead">Blanc Mail brings a careful, native Gmail experience to your Mac.</p>
      <MailWaitlistForm />
    </section>
    <div class="mail-stage-notes">
      <p>Blanc Mail remains in development. The download and checkout will appear after its macOS release checks are complete.</p>
      <p><a href="/download">Blanc Browser</a> is available now on macOS, Windows, and Linux.</p>
    </div>
  </main>
</BaseLayout>
<script>
  // The envelope catches the lamp: its sheen follows the pointer and it leans
  // a degree or two toward it, so the reflections move the way metal's do.
  // Only for a mouse with motion allowed; otherwise it holds its resting
  // light, which is the finished design.
  const envelope = document.querySelector<HTMLElement>('[data-mail-envelope]');
  const still = matchMedia('(prefers-reduced-motion: reduce), (pointer: coarse)');
  if (envelope) {
    let frame = 0;
    const settle = () => { envelope.style.removeProperty('--mx'); envelope.style.removeProperty('--my'); };
    document.addEventListener('pointermove', (event) => {
      if (still.matches || event.pointerType !== 'mouse') return;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        // Measured against the viewport, so the light moves across the whole
        // stage rather than only while the pointer is over the envelope.
        envelope.style.setProperty('--mx', (event.clientX / innerWidth).toFixed(3));
        envelope.style.setProperty('--my', (event.clientY / innerHeight).toFixed(3));
      });
    });
    document.documentElement.addEventListener('pointerleave', settle);
    still.addEventListener('change', settle);
  }
</script>
