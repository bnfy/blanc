---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandMark from '../components/BrandMark.astro';
import MailBar from '../components/MailBar.astro';
import MailIcon from '../components/MailIcon.astro';
import MailShot from '../components/MailShot.astro';
import MailWaitlistForm from '../components/MailWaitlistForm.astro';
import '../styles/mail.css';
---
<BaseLayout title="Blanc Mail — A little less inbox" description="Blanc Mail is a native Gmail client for macOS, coming soon from the makers of Blanc Browser." path="/mail" header="solid" ogImageAlt="The Blanc Sunrise mark on a warm ivory background">
  <MailBar />
  <main id="main-content" class="mail-page mail-home">
    <section class="mail-home-hero" aria-labelledby="mail-home-title">
      <MailIcon class="mail-home-icon" />
      <p class="mail-home-badge"><span class="mail-home-badge-dot" aria-hidden="true"></span>Coming soon for macOS</p>
      <h1 id="mail-home-title">A little less inbox.</h1>
      <p class="mail-lead">Blanc Mail brings a careful, native Gmail experience to your Mac. Your mail stays between your Mac and Google.</p>
      <MailWaitlistForm />
    </section>

    <!-- The real window, from the preview build's demo inbox, wider than the
         text column and unframed. MailShot always carries the preview label. -->
    <MailShot name="main" class="mail-wide mail-hero-shot mail-crop-phone" eager sizes="(max-width: 1392px) 100vw, 1360px" width={2200} height={1342} alt="Blanc Mail's main window in the preview build: the sidebar, the inbox, and a photo newsletter open in the reader." />

    <!-- An open row, not cards: a quick overview before the feature bento. -->
    <section class="mail-home-section mail-strip-section" aria-labelledby="mail-home-mac">
      <h2 id="mail-home-mac">One place to read, reply, and move on.</h2>
      <div class="mail-strip">
        <article>
          <svg class="mail-glyph" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4.5" width="18" height="15" rx="3" /><path d="M3 9h18M9 9v10.5" /></svg>
          <h3>A native window</h3>
          <p>Three familiar panes, keyboard friendly navigation, and a macOS app built with SwiftUI.</p>
        </article>
        <article>
          <svg class="mail-glyph" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2.5" /><path d="m3.5 7 8.5 6 8.5-6" /></svg>
          <h3>Gmail first</h3>
          <p>Connect your Google account directly. Mail is stored locally for reading and draft recovery.</p>
        </article>
        <article>
          <svg class="mail-glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5 5 6v5.5c0 4.2 2.9 7.6 7 9 4.1-1.4 7-4.8 7-9V6l-7-2.5Z" /><path d="m9 12 2.2 2.2L15.5 10" /></svg>
          <h3>Privacy choices</h3>
          <p>Turn off automatic remote content in Settings. An optional Private Push relay sends refresh signals without receiving mail content.</p>
        </article>
      </div>
    </section>

    <!-- Every claim below is recorded with its evidence and limits in
         docs/website-mail-claims-2026-10-12.md; recheck it against the signed
         Mail build before this page deploys. The vignettes are textless and
         decorative: each shows only what its tile's copy says. -->
    <section class="mail-home-section" aria-labelledby="mail-home-features">
      <h2 id="mail-home-features">Every account, one calm inbox.</h2>
      <div class="mail-feature-head">
        <h3>Every account together</h3>
        <p>Up to five Gmail accounts in one unified inbox, each with its own color. One search covers all of them.</p>
      </div>
      <MailShot name="island" class="mail-wide mail-crop-phone" sizes="(max-width: 1392px) 100vw, 1360px" width={2200} height={1342} alt="The Island searching “trip” in the preview build, listing a matching mailbox and conversations over the inbox." />
      <div class="mail-bento" data-mail-bento>
        <article class="mail-bento-tile is-wide">
          <div class="mail-vignette vg-undo" aria-hidden="true">
            <span class="vg-list"><span class="vg-row"><b></b><s></s></span><span class="vg-row is-archived"><b></b><s></s></span><span class="vg-row"><b></b><s></s></span></span>
            <span class="vg-undo-side">
              <span class="vg-archive"><svg viewBox="0 0 24 24"><rect x="3.5" y="4.5" width="17" height="4" rx="1.2" /><path d="M5 8.5v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-9M10 12.5h4" /></svg></span>
              <span class="vg-chip"><svg class="vg-ring" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" pathLength="1" /></svg><svg class="vg-undo-glyph" viewBox="0 0 24 24"><path d="M9 7.5 5.5 11 9 14.5" /><path d="M5.5 11H14a4.5 4.5 0 0 1 0 9h-1.5" /></svg></span>
            </span>
          </div>
          <div class="mail-bento-copy">
            <h3>A moment to change your mind</h3>
            <p>Archiving takes effect at once, with five seconds to undo it.</p>
          </div>
        </article>
        <article class="mail-bento-tile is-wide">
          <div class="mail-vignette vg-later" aria-hidden="true">
            <span class="vg-clock"><i class="vg-hand-hour"></i><i class="vg-hand-minute"></i></span>
            <span class="vg-track"><i class="vg-mark"></i><span class="vg-envelope"><svg viewBox="0 0 24 24"><rect x="3" y="5.5" width="18" height="13" rx="2.5" /><path d="m3.5 7 8.5 6 8.5-6" /></svg></span></span>
          </div>
          <div class="mail-bento-copy">
            <h3>Later, on your terms</h3>
            <p>Snooze a conversation until you need it, or write now and send later. Scheduled mail goes out the next time Blanc Mail is running and online on your Mac.</p>
          </div>
        </article>
        <article class="mail-bento-tile is-wide">
          <div class="mail-vignette vg-ghost" aria-hidden="true">
            <span class="vg-list"><span class="vg-row"><b></b><s></s></span><span class="vg-row"><b></b><s></s></span><span class="vg-row"><b></b><s></s></span></span>
            <span class="vg-lock"><svg viewBox="0 0 24 24"><path class="vg-shackle" d="M8 10.5V8a4 4 0 0 1 8 0v2.5" /><rect x="5.5" y="10.5" width="13" height="10" rx="2.5" /></svg></span>
          </div>
          <div class="mail-bento-copy">
            <h3>Ghost Mode</h3>
            <p>Hide a conversation or a whole Gmail label from view, then unlock it with Touch ID or your password. It locks again on a timer. Ghost Mode keeps things off your screen; it isn’t encryption.</p>
          </div>
        </article>
        <article class="mail-bento-tile">
          <svg class="mail-glyph" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3.5" width="14" height="17" rx="2.5" /><path d="M8.5 8h7M8.5 12h7M8.5 16h4" /></svg>
          <div class="mail-bento-copy">
            <h3>Replies you type often</h3>
            <p>Save templates for the answers you give again and again; they stay on your Mac. Gmail’s vacation responder is in Settings too.</p>
          </div>
        </article>
        <article class="mail-bento-tile">
          <svg class="mail-glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4Z" /><path d="m13.5 6.5 4 4" /></svg>
          <div class="mail-bento-copy">
            <h3>Drafts that keep up</h3>
            <p>Move a draft to another account without losing a word. If anything interrupts you, your draft picks up right where you left off.</p>
          </div>
        </article>
      </div>
    </section>

    <!-- New copy, checked against the Mail source and recorded in
         docs/website-mail-claims-2026-10-12.md; it needs the owner's approval
         before this page deploys. -->
    <section class="mail-home-section mail-showcase" aria-labelledby="mail-home-clear">
      <h2 id="mail-home-clear">An empty inbox, kept that way.</h2>
      <div class="mail-feature-head">
        <h3>Inbox Zero</h3>
        <p>When your inbox is empty, Blanc Mail clears the list and reader for a quiet Sunrise view and one line: “Nothing here needs you right now.” Small chips show when your next snoozed conversation returns and when a set you put aside is due, and one click opens it.</p>
        <p class="mail-feature-note">Turn on “Change wallpapers with the time of day” in Settings › Appearance and the art follows your Mac’s clock, from dawn to night.</p>
        <fieldset class="mail-segmented">
          <legend class="mail-visually-hidden">Wallpaper</legend>
          <label><input type="radio" name="mail-zero-phase" value="dawn" checked /><span>Dawn</span></label>
          <label><input type="radio" name="mail-zero-phase" value="night" /><span>Night</span></label>
        </fieldset>
      </div>
      <div class="mail-zero mail-wide">
        <MailShot name="zero" class="mail-zero-dawn mail-crop-phone" sizes="(max-width: 1392px) 100vw, 1360px" width={2200} height={1342} alt="Inbox Zero in the preview build: the Sunrise art at dawn and “Nothing here needs you right now.”" />
        <MailShot name="zero-night" class="mail-zero-night mail-crop-phone" sizes="(max-width: 1392px) 100vw, 1360px" width={2200} height={1342} alt="The same Inbox Zero screen with the night art." />
      </div>
      <div class="mail-feature-head">
        <h3>Rules that read like sentences</h3>
        <p>Your Gmail filters, written out in plain words. Rules run in Gmail, so new mail keeps getting sorted even while Blanc Mail is closed, and rules you made in Gmail on the web appear too.</p>
      </div>
      <MailShot name="rules" class="mail-rules-shot" sizes="(max-width: 1100px) 100vw, 1060px" width={2200} height={1964} alt="Settings › Rules in the preview build: three Gmail rules written as sentences, such as “When a message is from trailclub.example, label it Trips.”" />
    </section>

    <!-- Drag (or use the arrow keys) to wipe between the two appearances. -->
    <section class="mail-home-section mail-modes" aria-labelledby="mail-home-modes">
      <h2 id="mail-home-modes">At home in light and dark.</h2>
      <div class="mail-compare mail-wide" data-mail-compare>
        <MailShot name="main" class="mail-compare-light" sizes="(max-width: 1392px) 100vw, 1360px" width={2200} height={1342} alt="Blanc Mail's main window in the light appearance, from the preview build." />
        <MailShot name="dark" class="mail-compare-dark" sizes="(max-width: 1392px) 100vw, 1360px" width={2200} height={1342} alt="The same window in the dark appearance." />
        <span class="mail-compare-handle" aria-hidden="true"></span>
        <input class="mail-compare-range" type="range" min="0" max="100" value="50" aria-label="Compare the light and dark appearance" />
      </div>
    </section>

    <!-- A dark band: the change of material marks the move from features to trust. -->
    <section class="mail-home-section mail-trust" aria-labelledby="mail-home-careful">
      <h2 id="mail-home-careful">Careful in what it sends, generous in what it accepts.</h2>
      <div class="mail-strip">
        <article>
          <svg class="mail-glyph" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3" /><path d="m8.5 12 2.5 2.5 4.5-5" /></svg>
          <h3>Mail that opens</h3>
          <p>Messages are sanitized before they’re shown, and scripts in them never run. Malformed mail still renders rather than leaving a blank pane.</p>
        </article>
        <article>
          <svg class="mail-glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="m21 3-7 18-4-7-7-4 18-7Z" /><path d="M21 3 10 14" /></svg>
          <h3>No accidental double sends</h3>
          <p>If a send fails and Gmail’s answer is unclear, Blanc Mail never retries it on its own.</p>
        </article>
        <article>
          <svg class="mail-glyph" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2.5" /><path d="m3.5 7 8.5 6 8.5-6" /><path d="m4 20 16-16" /></svg>
          <h3>Nothing added to your mail</h3>
          <p>Blanc Mail adds no read receipts and no open or click tracking to the mail you send.</p>
        </article>
      </div>
    </section>

    <!-- The form's own label is the heading here, so no new copy is needed. -->
    <section class="mail-home-section mail-closing">
      <MailIcon class="mail-closing-icon" decorative />
      <MailWaitlistForm id="closing-waitlist" />
    </section>

    <section class="mail-home-section" aria-labelledby="mail-home-family">
      <h2 id="mail-home-family">One Blanc family.</h2>
      <div class="mail-home-family">
        <a class="mail-home-app" href="/download">
          <span class="mail-home-app-icon is-browser"><BrandMark /></span>
          <span class="mail-home-app-text">
            <strong>Blanc Browser</strong>
            <span>Available now on macOS, Windows, and Linux.</span>
          </span>
          <span class="mail-home-app-chevron" aria-hidden="true">›</span>
        </a>
        <a class="mail-home-app" href="/mail/download">
          <MailIcon class="mail-home-app-icon" decorative />
          <span class="mail-home-app-text">
            <strong>Blanc Mail</strong>
            <span>A separate macOS app, coming soon.</span>
          </span>
          <span class="mail-home-app-chevron" aria-hidden="true">›</span>
        </a>
      </div>
      <p class="mail-home-suite">At launch, a Blanc Suite subscription will include Browser Patron benefits on Browser's supported platforms and Mail on macOS.</p>
      <p class="mail-muted mail-home-suite">Blanc Mail remains in development. The download and checkout will appear after its macOS release checks are complete.</p>
    </section>
  </main>
</BaseLayout>
<script>
  // Each vignette plays once when its tile first comes into view (touch has
  // no hover), and again when a pointer enters the tile. Every animation ends
  // on the tile's still frame, which is all reduced motion ever shows.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const play = (tile: Element) => {
    if (reduce.matches || tile.classList.contains('is-playing')) return;
    tile.classList.add('is-playing');
    Promise.allSettled(tile.getAnimations({ subtree: true }).map((a) => a.finished))
      .then(() => tile.classList.remove('is-playing'));
  };
  const tiles = document.querySelectorAll('[data-mail-bento] .mail-bento-tile:has(.mail-vignette)');
  const seen = new IntersectionObserver((entries) => {
    for (const entry of entries) if (entry.isIntersecting) { play(entry.target); seen.unobserve(entry.target); }
  }, { threshold: 0.6 });
  tiles.forEach((tile) => {
    seen.observe(tile);
    tile.addEventListener('pointerenter', () => play(tile));
  });

  // The light/dark compare: the slider's value is where the dark window
  // starts, so the divider follows the pointer exactly.
  document.querySelectorAll<HTMLElement>('[data-mail-compare]').forEach((compare) => {
    const range = compare.querySelector<HTMLInputElement>('input[type=range]');
    if (!range) return;
    const sync = () => compare.style.setProperty('--split', `${range.value}%`);
    range.addEventListener('input', sync);
    sync();
  });
</script>
