---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandMark from '../components/BrandMark.astro';
import BentoIcon from '../components/bento/BentoIcon.astro';
import MailBar from '../components/MailBar.astro';
import MailShot from '../components/MailShot.astro';
import MailTeaser from '../components/MailTeaser.astro';
import MailWaitlistForm from '../components/MailWaitlistForm.astro';
import survey from '../data/mail-survey.json';
import reservations from '../data/mail-reservations.json';
import MailSurveyInvite from '../components/MailSurveyInvite.astro';
import { checkoutHrefFor, priceFor, productFor } from '../data/mail-commerce.mjs';
import '../styles/mail.css';
import '../styles/mail-overview.css';

const addressSteps = [
  { value: 'offer', label: 'Get started', name: 'island-offer',
    alt: 'Design preview: a dialog over the inbox with the gold Blanc Mail icon, reading “Your plan includes a Blanc Mail address. A private mailbox of your own.”, with mailbox storage of 15 GB and the buttons Choose Your Address and Not Now.' },
  { value: 'choose', label: 'Pick a name', name: 'island-address',
    alt: 'Design preview: the “Choose your address” form, filled in with the name mira at blnc.day, the display name Mira Hall, a password entered twice and a backup email, with Cancel and Continue.' },
  { value: 'ready', label: 'Open inbox', name: 'island-arrival',
    alt: 'Design preview: a dialog with the gold Blanc Mail icon reading “mira@blnc.day. Your mailbox is ready in Blanc Mail.”, and an Open Inbox button.' },
];
const islandCommands = [
  ['snooze', 'Snooze…'], ['set-aside', 'Move to Group…'], ['label', 'Labels'], ['move', 'Move To…'],
  ['archive', 'Archive'], ['trash', 'Trash'], ['compose', 'New Message'], ['rule', 'New Rule…'],
];

const { open: reservationsOpen, endings } = reservations;
const exampleAddress = `mira@${endings[0]}`;
const addressPremium = (productFor('mail-address-annual').amount - productFor('mail-annual').amount) / 100;
const plans = [
  { key: 'mail', name: 'Blanc Mail', mark: 'rail', description: 'The Mac app for your existing email accounts.', periods: ['monthly', 'annual'] },
  { key: 'mail-address', name: 'Blanc Mail + Address', mark: 'address', description: 'The Mac app and a Blanc address with 15 GB for mail and attachments.', periods: ['annual'] },
  { key: 'suite', name: 'Blanc Bundle', mark: 'box', description: 'The Mac app and a 15 GB Blanc mailbox, plus two more Blanc products.', periods: ['monthly', 'annual'] },
] as const;
const questions = [
  { title: 'Do I need a new email address?', answer: 'You can keep your current address. Connect a Google account directly, or a Proton account through Proton Mail Bridge on your Mac. You can also use a Blanc address on its own.' },
  { title: 'Which tools help me keep up with mail?', answer: 'Bring up to five Gmail accounts into one inbox. Snooze a conversation, reuse a reply template, or schedule a message to go out when Blanc Mail is running and online on your Mac.' },
  { title: 'How can I keep conversations off my screen?', answer: 'Ghost Mode hides a conversation or Gmail label and locks it again on a timer. Touch ID or your password brings it back into view. Ghost Mode controls what appears on screen.' },
  { title: 'What does reserving a name get me?', answer: 'A confirmed reservation holds your name across the Blanc endings until 30 days after addresses open. Use the email you reserved with to claim it. The mailbox starts when you claim the address with an eligible paid plan.' },
  { title: 'Can I try the Mac app first?', answer: 'At launch the Mac app will have a 14-day local trial. You can start it without a payment card.' },
  { title: 'What is encrypted in a Blanc mailbox?', answer: 'Messages and attachments in your Blanc mailbox are encrypted where they are stored, with a key made on your Mac. Blanc keeps only a copy of the key locked with your password, which stays on your Mac. Senders, recipients, subjects and dates remain visible. The server can read mail as it arrives and as it is sent.' },
  { title: 'What if I forget my mailbox password?', answer: 'A code sent to your backup email gets you back into your account. On a new Mac, a forgotten password means you cannot open mail you received before recovery.' },
  { title: 'What happens if my subscription ends?', answer: 'In the Mac app you can still read, search and export mail. Composing and sending resume when you renew. A Blanc mailbox keeps receiving mail for 30 days after your subscription lapses. Before deleting a mailbox, Blanc emails you instructions for exporting your mail.' },
  { title: 'I’m a Browser Patron. How will the Bundle work?', answer: 'At launch, you can upgrade through Polar on the same billing period. Your existing Browser key keeps working. Patron and founding benefits apply to Browser, and its free features stay free.' },
];
const support = [
  { title: 'Accounts and data', html: 'Blanc Mail connects to Gmail with Google Sign-In. Removing an account clears its local cache after any pending draft recovery is resolved. You can also revoke the app’s access from your <a href="https://myaccount.google.com/permissions">Google Account permissions</a>.' },
  { title: 'Uninstalling', html: 'Quit the app and move Blanc Mail to the Trash. To erase local settings and recovery data too, first resolve any drafts you need, then remove the app’s data under your Mac’s Application Support folder. Renaming the app does not erase an existing test install’s local data or Keychain credentials.' },
  { title: 'Updates and licensing', html: 'After launch, Check for Updates in the app will use its signed Sparkle feed. New subscriptions will be handled by Polar. Existing beta keys will continue to work. To have a previous key sent again, email <!--email_off--><a href="mailto:support@blanc.day">support@blanc.day</a><!--/email_off--> from the address you bought it with.' },
];
---
<BaseLayout title="Blanc Mail — A little less inbox" description="A mail app for Mac, coming soon. Bring your Gmail or Proton Mail account, or add a Blanc address of your own. Compare Blanc Mail, Mail + Address, and Blanc Bundle." path="/mail" header="solid">
  <MailBar />
  <main id="main-content" class="mail-overview">
    <section class="offer-hero" aria-labelledby="offer-title">
      <div class="offer-opening">
        <p class="mail-eyebrow">Blanc Mail · for Mac · Coming soon</p>
        <h1 id="offer-title"><span class="mail-gold-text">A little less inbox.</span></h1>
        <p class="offer-intro">A mail app for Mac. Bring your Gmail or Proton Mail account, or add a Blanc address of your own.</p>
        <div class="envelope-stage" aria-hidden="true">
          <!-- The Mail icon as an object: a gold envelope, its flap and folds
               engraved, the Sunrise stamped where the flap meets. Decorative. -->
          <div class="mail-envelope" data-mail-envelope>
            <div class="mail-envelope-face">
              <svg class="mail-envelope-folds" viewBox="0 0 800 500" preserveAspectRatio="none">
                <path class="mail-groove" d="M0 0 L400 290 L800 0" />
                <path class="mail-groove-lip" d="M0 2 L400 292 L800 2" />
                <path class="mail-groove" d="M0 500 L330 248 M800 500 L470 248" />
                <path class="mail-groove-lip" d="M0 502 L330 250 M800 502 L470 250" />
              </svg>
              <span class="mail-hallmark"><BrandMark class="mail-hallmark-lip" /><BrandMark class="mail-hallmark-cut" /></span>
            </div>
          </div>
        </div>
      </div>
      <div class="offer-paths">
        <div class="offer-path">
          <h2>Keep your email address</h2>
          <p>Connect Gmail directly, or use your Proton Mail account through Proton Mail Bridge on your Mac.</p>
          <details class="offer-signup">
            <summary class="offer-action">Join the app waitlist</summary>
            <MailWaitlistForm />
          </details>
        </div>
        <div class="offer-path">
          <h2>Get a Blanc address</h2>
          <p>{reservationsOpen ? 'Reserve a name like ' : 'Choose an address like '}<strong class="mail-shimmer"><!--email_off-->{exampleAddress}<!--/email_off--></strong>{reservationsOpen ? ' for free. ' : '. '}The 15 GB mailbox comes with a paid plan at launch.</p>
          <a class="offer-action" href={reservationsOpen ? '/mail/reserve' : '#address'}>{reservationsOpen ? 'Reserve your address' : 'Explore Blanc addresses'}</a>
        </div>
      </div>
      <a class="offer-jump" href="#pricing">Compare plans <span aria-hidden="true">↓</span></a>
      {survey.open && <p class="mail-survey-link"><a href="/mail/survey">Help shape Blanc Mail: tell us what you’d want, anonymously.</a></p>}
    </section>

    <section id="design" class="overview-preview" aria-labelledby="preview-title">
      <h2 id="preview-title">Inside Blanc Mail</h2>
      <MailShot name="classic-dark" width={2200} height={1352} alt="Blanc Mail in Classic dark mode. A mailbox sidebar and conversation list sit beside a sample Northlight Journal email, “Last light over the valley,” with three landscape photographs." />
      <p class="preview-note">Classic layout in dark mode, with fictional mail.</p>
    </section>

    <section id="pricing" class="overview-section" aria-labelledby="plans-title">
      <h2 id="plans-title"><span class="mail-gold-text">Compare plans</span></h2>
      <p class="section-intro">Planned pricing at launch. Purchases are not open yet.</p>
      <ul class="offer-plans">
        {plans.map(plan => (
          <li class="offer-plan">
            <div class="plan-heading">
              <span class="plan-mark" aria-hidden="true">
                {plan.mark === 'address' ? '@' : <BentoIcon name={plan.mark} />}
              </span>
              <h3>{plan.name}</h3>
            </div>
            <p>{plan.description}</p>
            <div class="offer-prices">
              <p><strong>{priceFor(`${plan.key}-annual`)}</strong> / year</p>
              <p>{plan.periods.length === 2 ? `or ${priceFor(`${plan.key}-monthly`)} / month` : 'Annual billing only'}</p>
            </div>
            <p class="plan-detail">
              {plan.key === 'mail' && '14-day local app trial. No payment card needed.'}
              {plan.key === 'mail-address' && `Adds one Blanc mailbox for $${addressPremium} more per year than the app alone.`}
              {plan.key === 'suite' && <>Adds Blanc Browser Patron on desktop and <a href="https://noddingoffapp.com/">Nodding Off</a>, bedtime stories for iPhone.</>}
            </p>
            {plan.periods.map(period => {
              const href = checkoutHrefFor(`${plan.key}-${period}`);
              return href && <a href={href}>Choose {plan.name} — {period}</a>;
            })}
          </li>
        ))}
      </ul>
    </section>

    <section id="island" class="overview-section feature-spread" aria-labelledby="search-title">
      <div class="feature-copy">
        <h2 id="search-title">Search across your accounts.</h2>
        <p>Press <kbd>⌘L</kbd> to open the Island. Find a person, mailbox or conversation across the accounts you’re viewing, or type a slash to act on a message.</p>
        <h3>Set a conversation aside</h3>
        <p>Move it to a Group like “Read on the flight.” It leaves your Inbox and waits in the Group until you’re ready.</p>
      </div>
      <figure class="mail-island-figure">
        <div class="mail-island-panel" role="img" aria-label="The Island open in Blanc Mail, listing its slash commands: Snooze, Move to Group, Labels, Move To, Archive, Trash, New Message and New Rule.">
          <div class="mip-field" aria-hidden="true">
            <svg class="mip-chevron" viewBox="0 0 24 24"><path d="m6 6 6 6-6 6M12 6l6 6-6 6" /></svg>
            <span class="mip-input">/<i class="mip-caret"></i></span>
            <svg class="mip-clear" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="m9 9 6 6M15 9l-6 6" /></svg>
          </div>
          <div class="mip-results" aria-hidden="true">
            <p class="mip-header">commands</p>
            {islandCommands.map(([keyword, title], index) => (
              <p class:list={['mip-row', { 'is-highlighted': index === 0 }]}><b>/{keyword}</b>{title}</p>
            ))}
          </div>
          <div class="mip-footer" aria-hidden="true">
            <span class="mip-chips">{['snooze', 'set-aside', 'label', 'rule'].map(k => <span>/{k}</span>)}</span>
            <span class="mip-hint">↑↓ to move, ↵ to open, ⇧↵ to search all mail</span>
          </div>
        </div>
      </figure>

    </section>

    <section id="features" class="overview-section feature-spread rules-spread" aria-labelledby="rules-title">
      <div class="feature-copy">
        <h2 id="rules-title">Sort Gmail as it arrives.</h2>
        <p>Build a rule from a sentence. For example, send mail from your trail club to a Trips label. Gmail runs the rule even when Blanc Mail is closed.</p>
      </div>
      <MailShot name="rule-editor" class="mail-rules-shot" sizes="(max-width: 760px) 100vw, 700px" width={1400} height={744} alt="Editing a rule in the preview build, in the dark appearance: “When a message is from trailclub.example, label it Trips”, with its Gmail search, the one conversation it already matches, and Save Rule." />

    </section>

    <section id="address" class="overview-section address-spread mail-teaser-set" aria-labelledby="address-title">
      <div class="feature-copy">
        <h2 id="address-title"><span class="mail-gold-text">A private mailbox of your own.</span></h2>
        <p>Choose an address like <strong class="mail-shimmer"><!--email_off-->{exampleAddress}<!--/email_off--></strong> when addresses open. One address and 15 GB of storage come with Blanc Mail + Address and Blanc Bundle.</p>
        <ul class="address-endings" aria-label="Available address endings">{endings.map(ending => <li>@{ending}</li>)}</ul>
        {reservationsOpen && <a class="offer-action" href="/mail/reserve">Reserve your address</a>}
      </div>
      <div class="address-preview">
        <fieldset class="mail-segments">
          <legend class="sr-only">Address setup preview</legend>
          {addressSteps.map((step, index) => (
            <label><input type="radio" name="mail-address-step" value={step.value} checked={index === 0} /><span>{step.label}</span></label>
          ))}
        </fieldset>
        {addressSteps.map(step => <MailTeaser name={step.name} alt={step.alt} data-teaser={step.value} sizes="(max-width: 760px) 100vw, 620px" />)}
      </div>
    </section>

    <section id="support" class="overview-section faq-spread" aria-labelledby="faq-title">
      <div>
        <h2 id="faq-title">Questions about Mail</h2>
        <p>For help, email <!--email_off--><a href="mailto:support@blanc.day">support@blanc.day</a><!--/email_off-->.</p>
      </div>
      <div class="mail-questions">
        {questions.map(question => <details><summary>{question.title}</summary><p>{question.answer}</p></details>)}
        {support.map(topic => <details><summary>{topic.title}</summary><p set:html={topic.html} /></details>)}
      </div>
    </section>

    <section id="download" class="overview-section signup-spread" aria-labelledby="download-title">
      <div>
        <h2 id="download-title"><span class="mail-gold-text">Get Blanc Mail at launch.</span></h2>
        <p>For macOS 14 or later on an Apple Silicon or Intel Mac. Join the waitlist for an email when the Mac app is ready to download.</p>
        <p class="mail-legal"><a href="/mail/privacy">Privacy</a> · <a href="/mail/terms">Terms</a></p>
      </div>
      <MailWaitlistForm id="closing-waitlist" />
    </section>
  </main>
  {survey.open && <MailSurveyInvite />}
</BaseLayout>
<script>
  // The envelope catches the lamp: its sheen follows the pointer and it leans
  // a degree or two toward it, so the reflections move the way metal's do.
  // Only for a mouse with motion allowed; otherwise it holds its resting
  // light, which is the finished design.
  const envelope = document.querySelector<HTMLElement>('[data-mail-envelope]');
  const still = matchMedia('(prefers-reduced-motion: reduce), (pointer: coarse)');
  if (envelope) {
    let frame = 0;
    let inView = true;
    // Cancelling the queued frame matters: one already scheduled by the last
    // move would otherwise lean the envelope again after it settled.
    const settle = () => {
      cancelAnimationFrame(frame);
      envelope.style.removeProperty('--mx');
      envelope.style.removeProperty('--my');
    };
    // Off screen, the envelope needs no light: skip the work and let it rest.
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      if (!inView) settle();
    }).observe(envelope);
    document.addEventListener('pointermove', (event) => {
      if (still.matches || !inView || event.pointerType !== 'mouse') return;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        // Measured against the viewport, so the light moves across the whole
        // stage rather than only while the pointer is over the envelope.
        envelope.style.setProperty('--mx', (event.clientX / innerWidth).toFixed(3));
        envelope.style.setProperty('--my', (event.clientY / innerHeight).toFixed(3));
      });
    });
    document.documentElement.addEventListener('pointerleave', settle);
    still.addEventListener('change', settle);
  }
</script>
