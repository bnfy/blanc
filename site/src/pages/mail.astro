---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandMark from '../components/BrandMark.astro';
import MailIcon from '../components/MailIcon.astro';
import MailNav from '../components/MailNav.astro';
import MailWaitlistForm from '../components/MailWaitlistForm.astro';
import '../styles/mail.css';
---
<BaseLayout title="Blanc Mail — Email that minds its own business" description="Blanc Mail is a native Gmail client for macOS, coming soon from the makers of Blanc Browser." path="/mail" header="solid" ogImageAlt="The Blanc Sunrise mark on a warm ivory background">
  <main id="main-content" class="mail-page mail-home">
    <section class="mail-home-hero" aria-labelledby="mail-home-title">
      <MailIcon class="mail-home-icon" />
      <p class="mail-home-badge"><span class="mail-home-badge-dot" aria-hidden="true"></span>Coming soon for macOS</p>
      <h1 id="mail-home-title">Email that minds<br />its own business.</h1>
      <p class="mail-lead">Blanc Mail brings a careful, native Gmail experience to your Mac. Your mail stays between your Mac and Google.</p>
      <MailWaitlistForm />
      <div class="mail-actions">
        <a href="/mail/pricing">See planned pricing <span aria-hidden="true">›</span></a>
        <a href="/mail/download">Release status <span aria-hidden="true">›</span></a>
      </div>
    </section>

    <!-- A stylized wireframe of the three-pane window, not a screenshot: no
         text, no data, nothing that reads as a shipped feature. -->
    <div class="mail-home-stage" aria-hidden="true">
      <div class="mail-home-window">
        <span class="mail-home-lights"><i></i><i></i><i></i></span>
        <div class="mail-home-sidebar">
          <span class="mail-home-bar is-strong"></span>
          <span class="mail-home-bar"></span>
          <span class="mail-home-bar"></span>
          <span class="mail-home-bar is-short"></span>
        </div>
        <div class="mail-home-list">
          <!-- Placeholder for Blanc Browser's resting Island, which Mail's
               window chrome will adopt; centered on the list column. -->
          <span class="mail-home-island">
            <i class="is-glyph"></i><i class="is-glyph"></i>
            <span class="mail-home-island-pips"><i></i><i class="is-on"></i><i></i><i></i></span>
            <b></b>
            <i class="is-glyph"></i><i class="is-glyph"></i>
          </span>
          <span class="mail-home-row is-selected"><b></b><i></i><i class="is-short"></i></span>
          <span class="mail-home-row"><b></b><i></i><i class="is-short"></i></span>
          <span class="mail-home-row"><b></b><i></i><i class="is-short"></i></span>
          <span class="mail-home-row"><b></b><i></i><i class="is-short"></i></span>
          <span class="mail-home-row"><b></b><i></i><i class="is-short"></i></span>
        </div>
        <div class="mail-home-reader">
          <span class="mail-home-bar is-title"></span>
          <span class="mail-home-bar is-meta"></span>
          <span class="mail-home-line"></span>
          <span class="mail-home-line"></span>
          <span class="mail-home-line is-short"></span>
          <span class="mail-home-line"></span>
          <span class="mail-home-line is-short"></span>
        </div>
      </div>
    </div>

    <div class="mail-home-nav"><MailNav /></div>

    <section class="mail-home-section" aria-labelledby="mail-home-mac">
      <h2 id="mail-home-mac">One place to read, reply, and move on.</h2>
      <div class="mail-home-tiles">
        <article class="mail-home-tile">
          <svg class="mail-home-glyph" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4.5" width="18" height="15" rx="3" /><path d="M3 9h18M9 9v10.5" /></svg>
          <h3>A native window</h3>
          <p>Three familiar panes, keyboard friendly navigation, and a macOS app built with SwiftUI.</p>
        </article>
        <article class="mail-home-tile">
          <svg class="mail-home-glyph" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2.5" /><path d="m3.5 7 8.5 6 8.5-6" /></svg>
          <h3>Gmail first</h3>
          <p>Connect your Google account directly. Mail is stored locally for reading and draft recovery.</p>
        </article>
        <article class="mail-home-tile">
          <svg class="mail-home-glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5 5 6v5.5c0 4.2 2.9 7.6 7 9 4.1-1.4 7-4.8 7-9V6l-7-2.5Z" /><path d="m9 12 2.2 2.2L15.5 10" /></svg>
          <h3>Privacy choices</h3>
          <p>Turn off automatic remote content in Settings. An optional Private Push relay sends refresh signals without receiving mail content.</p>
        </article>
      </div>
    </section>

    <!-- Every claim below is recorded with its evidence and limits in
         docs/website-mail-claims-2026-10-12.md; recheck it against the signed
         Mail build before this page deploys. -->
    <section class="mail-home-section" aria-labelledby="mail-home-features">
      <h2 id="mail-home-features">Every account, one calm inbox.</h2>
      <div class="mail-home-tiles">
        <article class="mail-home-tile">
          <svg class="mail-home-glyph" viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="9" r="3" /><circle cx="16" cy="9" r="3" /><path d="M3 19c.8-2.8 2.7-4 5-4s4.2 1.2 5 4M11 19c.8-2.8 2.7-4 5-4s4.2 1.2 5 4" /></svg>
          <h3>Every account together</h3>
          <p>Up to five Gmail accounts in one unified inbox, each with its own colour. One search covers all of them.</p>
        </article>
        <article class="mail-home-tile">
          <svg class="mail-home-glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6.5 5 10.5l4 4" /><path d="M5 10.5h9a5 5 0 0 1 0 10h-2" /></svg>
          <h3>A moment to change your mind</h3>
          <p>Archiving takes effect at once, with five seconds to undo it.</p>
        </article>
        <article class="mail-home-tile">
          <svg class="mail-home-glyph" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></svg>
          <h3>Later, on your terms</h3>
          <p>Snooze a conversation until you need it, or write now and send later. Scheduled mail goes out the next time Blanc Mail is running and online on your Mac.</p>
        </article>
        <article class="mail-home-tile">
          <svg class="mail-home-glyph" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3.5" width="14" height="17" rx="2.5" /><path d="M8.5 8h7M8.5 12h7M8.5 16h4" /></svg>
          <h3>Replies you type often</h3>
          <p>Save templates for the answers you give again and again; they stay on your Mac. Gmail’s vacation responder is in Settings too.</p>
        </article>
        <article class="mail-home-tile">
          <svg class="mail-home-glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12s3.5-6 9-6 9 6 9 6-3.5 6-9 6-9-6-9-6Z" /><circle cx="12" cy="12" r="2.5" /><path d="m4 4 16 16" /></svg>
          <h3>Ghost Mode</h3>
          <p>Hide a conversation or a whole Gmail label from view, then unlock it with Touch ID or your password. It locks again on a timer. Ghost Mode keeps things off your screen; it isn’t encryption.</p>
        </article>
        <article class="mail-home-tile">
          <svg class="mail-home-glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4Z" /><path d="m13.5 6.5 4 4" /></svg>
          <h3>Drafts that keep up</h3>
          <p>Move a draft to another account without losing a word. If anything interrupts you, your draft picks up right where you left off.</p>
        </article>
      </div>
    </section>

    <section class="mail-home-section" aria-labelledby="mail-home-careful">
      <h2 id="mail-home-careful">Careful in what it sends, generous in what it accepts.</h2>
      <div class="mail-home-tiles">
        <article class="mail-home-tile">
          <svg class="mail-home-glyph" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3" /><path d="m8.5 12 2.5 2.5 4.5-5" /></svg>
          <h3>Mail that opens</h3>
          <p>Messages are sanitized before they’re shown, and scripts in them never run. Malformed mail still renders rather than leaving a blank pane.</p>
        </article>
        <article class="mail-home-tile">
          <svg class="mail-home-glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="m21 3-7 18-4-7-7-4 18-7Z" /><path d="M21 3 10 14" /></svg>
          <h3>No accidental double sends</h3>
          <p>If a send fails and Gmail’s answer is unclear, Blanc Mail never retries it on its own.</p>
        </article>
        <article class="mail-home-tile">
          <svg class="mail-home-glyph" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2.5" /><path d="m3.5 7 8.5 6 8.5-6" /><path d="m4 20 16-16" /></svg>
          <h3>Nothing added to your mail</h3>
          <p>Blanc Mail adds no read receipts and no open or click tracking to the mail you send.</p>
        </article>
      </div>
    </section>

    <section class="mail-home-section" aria-labelledby="mail-home-family">
      <h2 id="mail-home-family">One Blanc family.</h2>
      <div class="mail-home-family">
        <a class="mail-home-app" href="/download">
          <span class="mail-home-app-icon is-browser"><BrandMark /></span>
          <span class="mail-home-app-text">
            <strong>Blanc Browser</strong>
            <span>Available now on macOS, Windows, and Linux.</span>
          </span>
          <span class="mail-home-app-chevron" aria-hidden="true">›</span>
        </a>
        <a class="mail-home-app" href="/mail/download">
          <MailIcon class="mail-home-app-icon" decorative />
          <span class="mail-home-app-text">
            <strong>Blanc Mail</strong>
            <span>A separate macOS app, coming soon.</span>
          </span>
          <span class="mail-home-app-chevron" aria-hidden="true">›</span>
        </a>
      </div>
      <p class="mail-home-suite">At launch, a Blanc Suite subscription will include Browser Patron benefits on Browser's supported platforms and Mail on macOS.</p>
      <p class="mail-muted mail-home-suite">Blanc Mail remains in development. The download and checkout will appear after its macOS release checks are complete.</p>
    </section>
  </main>
</BaseLayout>
