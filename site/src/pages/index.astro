---
import PlatformLogo from "../components/PlatformLogo.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/home.css";
import pkg from "../../../package.json";
import chromiumMark from "../assets/summary-icons/chromium.svg?raw";
import electronMark from "../assets/summary-icons/electron.svg?raw";
import codeMark from "../assets/summary-icons/code-xml.svg?raw";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://blancbrowser.com/#organization",
      name: "Blanc",
      url: "https://blancbrowser.com/",
      logo: "https://blancbrowser.com/logo.png",
      sameAs: [
        "https://github.com/bnfy/blanc",
        "https://www.facebook.com/blancbrowser/",
        "https://www.threads.net/@blancbrowser",
        "https://www.instagram.com/blancbrowser/",
      ],
    },
    {
      "@type": "WebSite",
      "@id": "https://blancbrowser.com/#website",
      url: "https://blancbrowser.com/",
      name: "Blanc Browser",
      alternateName: "Blanc",
      description:
        "A minimal desktop browser for macOS, Windows, and Linux with built-in ad and tracker blocking, private tabs, tab groups, and keyboard-first commands.",
      publisher: {
        "@id": "https://blancbrowser.com/#organization",
      },
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://blancbrowser.com/#software",
      name: "Blanc Browser",
      alternateName: "Blanc",
      url: "https://blancbrowser.com/",
      description:
        "Blanc is a minimal desktop browser for macOS, Windows, and Linux with built-in ad and tracker blocking, private tabs, tab groups, and keyboard-first commands.",
      applicationCategory: "BrowserApplication",
      operatingSystem: "macOS, Windows, Linux",
      softwareVersion: pkg.version,
      downloadUrl: "https://github.com/bnfy/blanc/releases/latest",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      publisher: {
        "@id": "https://blancbrowser.com/#organization",
      },
    },
  ],
};
---

<BaseLayout
  title="Blanc Browser — A little less browser."
  description="A minimal desktop browser with one compact Island for tabs, navigation and commands. Free for macOS, Windows and Linux, with built-in ad and tracker blocking."
  path="/"
  page="home"
  current="home"
  social="rich"
  ogImageAlt="Blanc’s compact Island and a Sunrise Start Page inside a desktop browser."
>
  <script
    type="application/ld+json"
    is:inline
    slot="head"
    set:html={JSON.stringify(structuredData)}
  />
  <main class="home-revamp" id="main-content">
    <section class="beat" id="opening" aria-labelledby="opening-title">
      <div class="frame">
        <div class="hero-copy">
          <img src="/sunrise-hero-mark.png" alt="" /><p class="frame-kicker">
            Blanc Browser
          </p><h1 id="opening-title">A little less browser.</h1><p class="lead">
            Tabs, navigation and page controls come together in one compact
            Island in a slim band above the page. A desktop browser for macOS,
            Windows and Linux.
          </p><div class="actions">
            <a class="planned-action" href="/download">Download Blanc</a><a
              class="planned-link"
              href="#island">See the Island in action</a>
          </div><p class="hero-offer">
            Free browser. Patron adds saved Named Workspaces.
          </p>
        </div><figure
          class="hero-product"
          id="hero-daylight"
          data-phase="dawn"
          data-appearance="light"
        >
          <div class="daylight-aura" aria-hidden="true">
            <span data-aura="dawn" class="is-current"></span><span
              data-aura="day"></span><span data-aura="dusk"></span><span
              data-aura="night"></span>
          </div><div class="device-composition device-laptop">
            <img
              class="device-shell"
              fetchpriority="high"
              src="/revamp/space-black-laptop-v2.webp"
              width="1536"
              height="1024"
              alt=""
              aria-hidden="true"
            /><div
              class="device-aperture"
              id="hero-daylight-screen"
              role="img"
              aria-label="Blanc v1.25.0 Billboard Start Page with dawn wallpaper in light appearance"
            >
              <div
                class="hero-wallpaper-scene is-current"
                data-hero-scene="dawn"
                style="background:#f8f1e7"
              >
                <img
                  class="device-screen"
                  src="/feature-captures/home-wallpaper-dawn-v1.25.0.webp"
                  width="1440"
                  height="900"
                  alt=""
                  aria-hidden="true"
                  decoding="async"
                />
              </div><div
                class="hero-wallpaper-scene"
                data-hero-scene="dawn-dark"
                style="background:#37342f"
              >
                <img
                  class="device-screen"
                  src="/feature-captures/home-wallpaper-dawn-dark-v1.25.0.webp"
                  width="1440"
                  height="900"
                  alt=""
                  aria-hidden="true"
                  decoding="async"
                />
              </div><div
                class="hero-wallpaper-scene"
                data-hero-scene="day"
                style="background:#e3e8e9"
              >
                <img
                  class="device-screen"
                  src="/feature-captures/home-wallpaper-day-v1.25.0.webp"
                  width="1440"
                  height="900"
                  alt=""
                  aria-hidden="true"
                  decoding="async"
                />
              </div><div
                class="hero-wallpaper-scene"
                data-hero-scene="day-dark"
                style="background:#292d31"
              >
                <img
                  class="device-screen"
                  src="/feature-captures/home-wallpaper-day-dark-v1.25.0.webp"
                  width="1440"
                  height="900"
                  alt=""
                  aria-hidden="true"
                  decoding="async"
                />
              </div><div
                class="hero-wallpaper-scene"
                data-hero-scene="dusk"
                style="background:#f0e7df"
              >
                <img
                  class="device-screen"
                  src="/feature-captures/home-wallpaper-dusk-v1.25.0.webp"
                  width="1440"
                  height="900"
                  alt=""
                  aria-hidden="true"
                  decoding="async"
                />
              </div><div
                class="hero-wallpaper-scene"
                data-hero-scene="dusk-dark"
                style="background:#251e1f"
              >
                <img
                  class="device-screen"
                  src="/feature-captures/home-wallpaper-dusk-dark-v1.25.0.webp"
                  width="1440"
                  height="900"
                  alt=""
                  aria-hidden="true"
                  decoding="async"
                />
              </div><div
                class="hero-wallpaper-scene"
                data-hero-scene="night"
                style="background:#e9e4db"
              >
                <img
                  class="device-screen"
                  src="/feature-captures/home-wallpaper-night-v1.25.0.webp"
                  width="1440"
                  height="900"
                  alt=""
                  aria-hidden="true"
                  decoding="async"
                />
              </div><div
                class="hero-wallpaper-scene"
                data-hero-scene="night-dark"
                style="background:#111114"
              >
                <img
                  class="device-screen"
                  src="/feature-captures/home-wallpaper-night-dark-v1.25.0.webp"
                  width="1440"
                  height="900"
                  alt=""
                  aria-hidden="true"
                  decoding="async"
                />
              </div>
            </div>
          </div><figcaption class="daylight-caption">
            <div class="daylight-heading">
              <label for="hero-time">A day in Blanc.</label><div
                class="daylight-actions"
              >
                <button
                  type="button"
                  id="hero-appearance"
                  aria-label="Show dark appearance"
                  aria-pressed="false"
                  ><span aria-hidden="true">◐</span><span
                    class="appearance-label">Light</span
                  ></button
                ><button
                  type="button"
                  id="hero-daylight-play"
                  aria-label="Play the wallpaper day"
                  ><span aria-hidden="true" class="daylight-play-icon">▶</span
                  ></button>
              </div>
            </div><div class="daylight-track">
              <input
                type="range"
                id="hero-time"
                min="0"
                max="3"
                step="1"
                value="0"
                aria-label="Preview the time of day"
                aria-valuetext="Dawn, 6 am"
                aria-describedby="hero-wallpaper-note"
              /><div class="daylight-ticks" aria-hidden="true">
                <span class="is-current">Dawn</span><span>Day</span><span
                  >Dusk</span
                ><span>Night</span>
              </div>
            </div><p id="hero-wallpaper-note">
              Optional wallpaper follows your local clock. Blanc v1.25.0 on
              macOS; preview cycles faster.
            </p>
          </figcaption>
        </figure>
      </div>
    </section>
    <nav id="features" class="tour-nav" aria-label="Explore Blanc">
      <a href="#island">The Island</a><a href="#tabs">Your tabs</a><a
        href="#privacy">Privacy</a
      ><a href="#start">Start Page</a><a href="#tools">Everyday tools</a>
    </nav>
    <section class="home-foundations" aria-label="About the browser">
      <div>
        <span class="foundation-icons" aria-hidden="true"
          ><Fragment set:html={chromiumMark} /><Fragment
            set:html={electronMark}
          /></span
        ><span>Built on</span><strong>Chromium + Electron</strong><a
          href="/trust#engine">How they fit together ↗</a>
      </div><div>
        <span class="foundation-icons" aria-hidden="true"
          ><Fragment set:html={codeMark} /></span
        ><span>Open source</span><strong>MIT for Blanc’s own code</strong><a
          href="/support#open-source">Licensing and exceptions ↗</a>
      </div><div>
        <span class="foundation-icons" aria-hidden="true"
          ><img
            src="/sunrise-hero-mark.png"
            width="24"
            height="24"
            alt=""
            loading="lazy"
            decoding="async"
          /></span
        ><span>Official downloads</span><strong
          >Release evidence, in public</strong
        ><a href="/trust#release-verification-title">Check your download ↗</a>
      </div>
    </section><section class="beat" id="island" aria-labelledby="island-title">
      <div class="frame">
        <div class="frame-inner">
          <div class="split-title">
            <div>
              <p class="frame-kicker">The Island</p><h2 id="island-title">
                One place to<br />get around.
              </h2>
            </div><p class="lead">
              Open the Island to choose a tab, find a page or use a command.
              Close it to return to the page in front of you.
            </p>
          </div><figure
            class="island-demo"
            id="island-demo"
            aria-describedby="demoTabDiscovery"
          >
            <div class="island-cinema" id="island-stage" data-state="resting">
              <div
                class="island-pixels"
                role="img"
                aria-label="Blanc v1.26.0: the resting Island above a Scandinavian design article"
              >
                <img
                  class="island-native island-base"
                  src="/revamp/rest.png"
                  width="2560"
                  height="1600"
                  alt=""
                  draggable="false"
                  loading="lazy"
                  decoding="async"
                />
                <div class="island-page-haze" aria-hidden="true"></div><div
                  class="island-layer"
                  data-layer="tabs"
                >
                  <img
                    class="island-native"
                    src="/revamp/tabs.png"
                    width="2560"
                    height="1600"
                    alt=""
                    draggable="false"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="island-layer" data-layer="commands">
                  <img
                    class="island-native"
                    src="/revamp/command-filtered.png"
                    width="2560"
                    height="1600"
                    alt=""
                    draggable="false"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
              <button
                class="island-hotspot"
                type="button"
                aria-label="Open the Island preview"
                aria-expanded="false"></button>
            </div>
            <div class="island-demo-controls">
              <div
                class="gallery-controls island-selector"
                role="group"
                aria-label="Explore the Island"
              >
                <button type="button" data-island="resting" aria-pressed="true"
                  >At rest</button
                ><button type="button" data-island="tabs" aria-pressed="false"
                  >Open the Island</button
                ><button
                  type="button"
                  data-island="commands"
                  aria-pressed="false">Find a command</button>
              </div><button
                id="island-play"
                class="demo-play"
                type="button"
                aria-label="Play the Island sequence"
                ><span class="play-glyph" aria-hidden="true">▶</span><span
                  class="play-label">Play sequence</span
                ></button>
            </div>
            <p class="sr-only" id="demoTabDiscovery">
              Each dot is a tab. Hover to see its icon and title. Keyboard focus
              shows the icon; a screen reader announces the tab title. Click or
              press Enter to switch. +N opens the full list. Use Cmd+L on Mac or
              Ctrl+L on Windows and Linux to search tabs by name.
            </p>
            <figcaption id="island-caption" class="caption" aria-live="polite">
              Each dot is a tab. Hover or focus a dot in Blanc to preview it;
              select it to switch. Open the Island for the full list.
            </figcaption>
          <p class="capture-note">Blanc v1.26.0. Sample page: <a href="https://en.wikipedia.org/wiki/Scandinavian_design">Wikipedia</a> · <a href="/revamp/credits.txt">Image credits</a>.</p>
          </figure>
        </div>
      </div>
    </section>
    <section class="beat" id="tabs" aria-labelledby="tabs-title">
      <div class="frame">
        <div class="frame-inner">
          <p class="frame-kicker">Tabs and sessions</p><h2 id="tabs-title">
            Keep your place.<br />Choose what stays in view.
          </h2><p class="lead">
            Name your groups, switch between them, or use a vertical tab list
            when you want to see more of the session.
          </p><div class="asymmetry">
            <figure class="primary-visual">
              <div
                class="group-study"
                aria-label="Interactive illustration of named tab groups"
              >
                <div class="group-field" aria-hidden="true">
                  Search or type a URL <span>⌘ L</span>
                </div>
                <div class="group-demo-row">
                  <img
                    src="/favicons/github.com.ico"
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />Blanc on GitHub
                </div>
                <div class="group-demo-section">
                  <button
                    type="button"
                    data-group-toggle
                    aria-expanded="true"
                    aria-controls="demo-group-reading"
                    ><span class="group-chevron" aria-hidden="true">⌄</span
                    >Reading <span class="group-count">2</span></button
                  ><div class="group-fold" id="demo-group-reading">
                    <div>
                      <div class="group-demo-row">
                        <span class="letter-favicon" aria-hidden="true">K</span
                        >Kinfolk — a slower perspective
                      </div><div class="group-demo-row">
                        <span class="letter-favicon" aria-hidden="true">M</span
                        >Monocle — design &amp; culture
                      </div>
                    </div>
                  </div>
                </div>
                <div class="group-demo-section">
                  <button
                    type="button"
                    data-group-toggle
                    aria-expanded="true"
                    aria-controls="demo-group-making"
                    ><span class="group-chevron" aria-hidden="true">⌄</span
                    >Making <span class="group-count">2</span></button
                  ><div class="group-fold" id="demo-group-making">
                    <div>
                      <div class="group-demo-row">
                        <img
                          src="/favicons/notion.so.ico"
                          alt=""
                          loading="lazy"
                          decoding="async"
                        />Notes &amp; ideas
                      </div><div class="group-demo-row">
                        <span class="letter-favicon" aria-hidden="true">A</span
                        >Are.na — collected references
                      </div>
                    </div>
                  </div>
                </div>
                <div class="group-footer">/group names the group</div>
              </div><figcaption class="caption">
                Try folding a group. You choose the names and the tabs that
                belong together. Illustration with sample pages.
              </figcaption>
            </figure><article class="side-story">
              <h3>Closed it<br />too soon?</h3><p>
                Recently Closed gives ordinary tabs a way back while they remain
                in the undo buffer.
              </p><div class="reopen-study">
                <p class="reopen-label">
                  Recently Closed <span id="reopen-count">1</span>
                </p><div class="reopen-example" id="reopen-example">
                  <img
                    src="/favicons/github.com.ico"
                    width="16"
                    height="16"
                    alt=""
                    loading="lazy"
                    decoding="async"
                  /><span>Blanc on GitHub</span><button
                    type="button"
                    id="reopen-preview"
                    aria-label="Reopen the example tab">↶</button>
                </div><p
                  class="reopen-result"
                  id="reopen-result"
                  role="status"
                  hidden
                >
                  Back in your tabs. <button type="button" id="reopen-reset"
                    >Replay</button>
                </p>
              </div><p class="caption">
                Illustration. Recovery is limited; private tabs are excluded. <a
                  href="/support#reopen-closed-tabs">How it works →</a>
              </p>
            </article>
          </div><p class="material-limit">
            Tab groups are free. Named Workspaces add saved window sets with
            active Blanc Patron support.
          </p><div class="session-bridge">
            <h3>Keep work and<br />personal apart.</h3><div>
              <p>
                Use local profiles for separate logins, Favorites and history.
                Optional Sync carries your Personal profile’s Favorites and
                selected settings between devices.
              </p><p class="material-limit">
                Named profiles stay on this device. Sync is off by default and
                available only to Personal.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="beat" id="privacy" aria-labelledby="privacy-title">
      <div class="frame">
        <div class="frame-inner">
          <p class="frame-kicker">Privacy and control</p><h2 id="privacy-title">
            See the controls.<br />Make the choice.
          </h2><p class="lead">
            Ad and tracker blocking is built into Blanc. Open the shield to
            inspect the current site and change its blocking setting.
          </p><div class="privacy-layout">
            <figure>
              <div class="privacy-study" data-blocking="on">
                <div class="privacy-orbit" aria-hidden="true">
                  <svg
                    viewBox="0 0 80 80"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    ><path
                      d="M40 8 65 18v20c0 17-12 28-25 35C27 66 15 55 15 38V18Z"
                    ></path><path d="m23 56 34-36"></path></svg>
                </div><div class="blocking-panel">
                  <div class="blocking-panel-head">
                    <div>
                      <strong>example.com</strong><p>
                        Ad &amp; tracker blocking <b id="blocking-label">on</b>
                      </p>
                    </div><button
                      type="button"
                      role="switch"
                      aria-checked="true"
                      aria-label="Preview blocking for example.com"
                      id="blocking-preview"><span></span></button>
                  </div><p class="connection-state">
                    <span aria-hidden="true">⌑</span> Uses HTTPS
                  </p><p id="blocking-count">3 requests blocked</p><small
                    >Changing this reloads the page in Blanc.</small
                  ><a href="/trust#ad-blocking">Blocking details →</a>
                </div>
              </div><figcaption class="caption">
                Try the site switch. An illustration with a sample count; it
                doesn’t change this website.
              </figcaption>
            </figure><div class="privacy-copy">
              <article>
                <h3>Direct site controls.</h3><p>
                  Check the connection, blocking state and per-page count in one
                  place.
                </p>
              </article><article>
                <h3>Clear privacy choices.</h3><p>
                  Open a private tab when you choose. Optional connections start
                  only after you save your setup choices. Enabled usage
                  measurement sends pseudonymous launch and fixed feature-use
                  events to Blanc’s collector, with an optional Google Analytics
                  mirror; no URLs, searches or page contents.
                </p>
              </article>
            </div>
          </div><p class="material-limit">
            Blocking reduces known ads and tracking; coverage is not universal.
            Fresh setup preselects search suggestions and usage measurement.
            Both can be turned off before saving or later in Settings. <a
              href="/trust#connections"
              >Connections, defaults and security evidence →</a>
          </p>
        </div>
      </div>
    </section>
    <section class="beat" id="start" aria-labelledby="start-title">
      <div class="frame start-frame">
        <div class="frame-inner">
          <div class="split-title">
            <div>
              <p class="frame-kicker">Your starting point</p><h2
                id="start-title"
              >
                Start with a view<br />that suits you.
              </h2>
            </div><p class="lead">
              Choose Ledger, Billboard, Shelf or Tally. Keep a simple list, a
              large clock, a shelf of favorites or a view of blocking activity.
            </p>
          </div><div
            class="gallery-controls"
            role="group"
            aria-label="Choose a Start Page layout"
          >
            <button type="button" data-layout="ledger" aria-pressed="true"
              >Ledger</button
            ><button type="button" data-layout="billboard" aria-pressed="false"
              >Billboard</button
            ><button type="button" data-layout="shelf" aria-pressed="false"
              >Shelf</button
            ><button type="button" data-layout="tally" aria-pressed="false"
              >Tally</button>
          </div>
        </div><figure>
          <div class="device-composition device-desktop">
            <img
              class="device-shell"
              src="/revamp/champagne-desktop-v2.webp"
              width="1374"
              height="1145"
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
            /><div class="device-aperture">
              <img
                id="layout-image"
                class="layout-shot device-screen"
                src="/feature-captures/ledger-v1.21.0.png"
                width="1440"
                height="900"
                alt="Blanc v1.21.0 Ledger Start Page capture"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div><figcaption class="layout-meta">
            <p id="layout-caption" class="caption" aria-live="polite">
              Ledger — a simple list of Favorites.
            </p><p class="capture-note">
              Layout and game previews captured in Blanc v1.21.0 on macOS.
            </p>
          </figcaption><div class="start-discovery">
            <button
              type="button"
              id="mahjong-peek"
              aria-expanded="false"
              aria-controls="layout-image"
              ><span class="tile-pair" aria-hidden="true"
                ><span
                  ><img
                    src="/sunrise-hero-mark.png"
                    alt=""
                    loading="lazy"
                    decoding="async"
                  /></span
                ><span
                  ><img
                    src="/sunrise-hero-mark.png"
                    alt=""
                    loading="lazy"
                    decoding="async"
                  /></span
                ></span
              ><span class="break-label">A little break.</span><span
                class="break-arrow"
                aria-hidden="true">↗</span
              ></button
            ><button type="button" id="mahjong-back" hidden
              >Back to Ledger <span aria-hidden="true">↩</span></button>
          </div>
        </figure>
      </div>
    </section>
    <section class="beat" id="tools" aria-labelledby="tools-title">
      <div class="frame">
        <div class="frame-inner">
          <p class="frame-kicker">Everyday tools</p><h2 id="tools-title">
            Small conveniences.<br />Useful every day.
          </h2><div class="tool-feature">
            <h3>Keep a reference beside your page.</h3><p class="lead">
              Keep two of your open pages in view. Adjust the split, swap them,
              or close the reference when you’re done.
            </p><figure class="glance-demo" id="glance-demo">
              <div class="glance-viewport" id="glance-viewport">
                <div
                  class="glance-window"
                  id="glance-window"
                  style="--split:62%"
                >
                  <section
                    class="glance-pane glance-main"
                    aria-label="Main page illustration"
                  >
                    <div class="glance-chrome">
                      <div class="glance-pill-crop">
                        <img
                          src="/feature-captures/glance.png"
                          alt=""
                          aria-hidden="true"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    </div>
                    <div class="glance-document" id="glance-main-document">
                      <div class="sample-page" data-page="answers">
                        <p class="sample-kicker">The hard questions</p><h4>
                          Straight<br />answers.
                        </h4><p>The questions worth asking about Blanc.</p><div
                          class="sample-answer"
                        >
