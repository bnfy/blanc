---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandMark from '../components/BrandMark.astro';
import { version } from '../../../package.json';

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://blancbrowser.com/#organization',
      name: 'Blanc',
      url: 'https://blancbrowser.com/',
      logo: 'https://blancbrowser.com/logo.png',
      sameAs: [
        'https://github.com/bnfy/blanc',
        'https://www.facebook.com/blancbrowser/',
        'https://www.threads.net/@blancbrowser',
        'https://www.instagram.com/blancbrowser/',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://blancbrowser.com/#website',
      url: 'https://blancbrowser.com/',
      name: 'Blanc Browser',
      alternateName: 'Blanc',
      description: 'A minimal desktop browser for macOS, Windows, and Linux with built-in ad and tracker blocking, private tabs, tab groups, and keyboard-first commands.',
      publisher: {
        '@id': 'https://blancbrowser.com/#organization',
      },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://blancbrowser.com/#software',
      name: 'Blanc Browser',
      alternateName: 'Blanc',
      url: 'https://blancbrowser.com/',
      description: 'Blanc is a minimal desktop browser for macOS, Windows, and Linux with built-in ad and tracker blocking, private tabs, tab groups, and keyboard-first commands.',
      applicationCategory: 'BrowserApplication',
      operatingSystem: 'macOS, Windows, Linux',
      softwareVersion: version,
      downloadUrl: 'https://github.com/bnfy/blanc/releases/latest',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      publisher: {
        '@id': 'https://blancbrowser.com/#organization',
      },
    },
  ],
};
---
<BaseLayout
  title="Blanc Browser — Minimal Desktop Browser with Ad Blocking"
  description="Blanc is a minimal desktop browser for macOS, Windows, and Linux with built-in ad and tracker blocking, private tabs, tab groups, and keyboard-first commands."
  path="/"
  page="home"
  header="island"
  social="rich"
  ogTitle="Blanc Browser — Minimal Desktop Browser with Ad Blocking"
  ogDescription="A minimal desktop browser for macOS, Windows, and Linux with built-in ad and tracker blocking, private tabs, tab groups, and keyboard-first commands."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} slot="head" />

  <Fragment slot="before-header">
    <aside
      class="product-hunt-launch"
      id="productHuntLaunch"
      data-expires-at="2026-09-18T07:00:00Z"
      aria-label="Blanc launched on Product Hunt today"
      hidden
    >
      <a
        href="https://www.producthunt.com/products/blanc-3?launch=blanc-3"
        target="_blank"
        rel="noopener noreferrer"
        data-track="product_hunt_launch_click"
        data-cta-position="homepage-launch-banner"
      >
        <span class="product-hunt-launch-badge" aria-hidden="true">
          <span class="product-hunt-launch-mark">P</span>
        </span>
        <span class="product-hunt-launch-message">Blanc is live on Product Hunt<span class="product-hunt-launch-today"> today</span>.</span>
        <span class="product-hunt-launch-cta"><span class="product-hunt-launch-cta-long">See the launch</span><span class="product-hunt-launch-cta-short">View</span> <span aria-hidden="true">↗</span></span>
      </a>
    </aside>
    <script is:inline>
      (() => {
        const banner = document.getElementById('productHuntLaunch');
        if (!banner) return;

        const expiresAt = Date.parse(banner.dataset.expiresAt || '');
        if (!Number.isFinite(expiresAt) || Date.now() >= expiresAt) return;

        banner.hidden = false;
        window.setTimeout(() => {
          banner.hidden = true;
        }, expiresAt - Date.now());
      })();
    </script>
  </Fragment>

<header class="trust-hero">
  <div class="trust-hero-copy">
    <img class="trust-hero-mark" src="/sunrise-hero-mark.png" width="66" height="66" alt="" />
    <p class="section-kicker">An independent desktop browser</p>
    <h1>A little less browser.<br />More room for the web.</h1>
    <p>Blanc brings tabs, search and commands into one floating island, with built-in blocking for known ads and trackers.</p>
    <div class="trust-hero-actions">
      <a class="cta" href="/download" data-download-cta data-track="download_click" data-cta-position="hero">Download Blanc</a>
      <button class="cta trust-demo-button" id="watchDemo" type="button" aria-controls="demoShowcase" aria-expanded="false" hidden>Watch demo <span aria-hidden="true">↗</span></button>
    </div>
    <p class="trust-hero-note">Free for macOS, Windows and Linux. Patron is optional.</p>
  </div>
  <figure class="trust-product-shot">
    <img src="/feature-captures/home-v1.25.0.webp" width="1440" height="900" fetchpriority="high" alt="Blanc v1.25.0 on macOS, with the floating command island above the Ledger start page and four sample Favorites." />
    <figcaption>Blanc v1.25.0 on macOS. A real release capture with sample Favorites.</figcaption>
  </figure>
</header>

<dialog class="demo-viewer" id="demoViewer" aria-labelledby="demoViewerTitle">
  <div class="demo-viewer-header">
    <span id="demoViewerTitle">Desktop demo</span>
    <button class="demo-viewer-close" id="demoViewerClose" type="button" autofocus>Close <span aria-hidden="true">×</span></button>
  </div>
  <div class="demo-viewer-message">
    <h2 id="demoViewerHeadline"></h2>
  </div>
  <div class="demo-viewer-canvas" id="demoViewerCanvas" tabindex="0" role="region" aria-label="Desktop scene. Scroll to explore in Actual size mode."></div>
  <div class="demo-viewer-footer">
    <div class="demo-viewer-sizing" role="group" aria-label="Demo size">
      <button id="demoViewerFit" type="button" aria-pressed="true">Fit</button>
      <button id="demoViewerActual" type="button" aria-pressed="false">Actual size</button>
    </div>
    <div id="demoViewerControls"></div>
  </div>
</dialog>

<main class="home-main trust-home">
  <section class="trust-facts" aria-label="Blanc at a glance">
    <div><span>Built on</span><strong>Chromium + Electron</strong><a href="/how-it-works#engine">How they fit together ↗</a></div>
    <div><span>Available for</span><strong>macOS · Windows · Linux</strong><a href="/download">Choose your download ↗</a></div>
    <div><span>Open source</span><strong>MIT for Blanc’s own code</strong><a href="/faq#open-source">Licensing and exceptions ↗</a></div>
    <div><span>Free to browse</span><strong>Optional Patron support</strong><a href="#home-patron-title">What Patron adds ↗</a></div>
  </section>
  <section class="demo-showcase" id="demoShowcase" hidden aria-labelledby="demoHeadline">
  <div class="hero-message" id="demoHeroMessage">
    <h2 id="demoHeadline">One floating island holds your tabs, search and browser commands, so the page stays in front.</h2>
  </div>

  <div class="demo-mount" id="demoMount">
  <div class="demo-frame" id="demoFrame">
  <div class="demo-stage" id="demoStage" inert>
    <div class="demo-page">
      <div class="bar w1"></div>
      <div class="bar w2"></div>
      <div class="bar w3"></div>
      <div class="bar w4"></div>
    </div>
    <img class="demo-shot" id="demoShot" alt="" aria-hidden="true" fetchpriority="high">
    <div class="demo-glance" id="demoGlance" hidden aria-hidden="true">
      <div class="demo-glance-header" id="demoGlanceHeader">
        <div class="demo-glance-copy">
          <span class="demo-glance-eyebrow">GLANCE</span>
          <span class="demo-glance-tab-identity">
            <span class="demo-glance-favicon" id="demoGlanceFavicon" style="background-image:url('/favicons/notion.so.ico')"></span>
            <span id="demoGlanceTitle">Notion</span>
          </span>
        </div>
        <div class="demo-glance-actions">
          <button class="demo-glance-action demo-glance-promote demo-glance-make-main" id="demoGlanceMakeMain" type="button" tabindex="-1">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.25 3.5 10.75 8l-4.5 4.5"/></svg>
            <span>Make main</span>
          </button>
          <button class="demo-glance-action" type="button" tabindex="-1">Change</button>
          <button class="demo-glance-close" type="button" tabindex="-1"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.75 4.75l6.5 6.5M11.25 4.75l-6.5 6.5"/></svg></button>
        </div>
      </div>
      <div class="demo-glance-divider" id="demoGlanceDivider"><span></span></div>
      <img class="demo-glance-shot" id="demoGlanceShot" alt="">
    </div>
    <div class="demo-newtab" id="demoNewtab" hidden aria-hidden="true">
      <span class="demo-bb-date" id="demoBbDate"></span>
      <div class="demo-bb-clock-row">
        <span class="demo-bb-clock" id="demoBbClock"></span>
        <span class="demo-bb-meridiem" id="demoBbMeridiem"></span>
      </div>
      <span class="demo-bb-blocked" id="demoBbBlocked"></span>
      <div class="demo-bb-favs">
        <span class="demo-bb-fav"><span class="tile" style="background-image:url('/favicons/gmail.com.ico')"></span><span class="label">gmail</span></span>
        <span class="demo-bb-fav"><span class="tile" style="background-image:url('/favicons/notion.so.ico')"></span><span class="label">notion</span></span>
        <span class="demo-bb-fav"><span class="tile" style="background-image:url('/favicons/github.com.ico')"></span><span class="label">github</span></span>
        <span class="demo-bb-fav"><span class="tile" style="background-image:url('/favicons/netflix.com.ico')"></span><span class="label">netflix</span></span>
      </div>
    </div>
    <div class="demo-island" id="demoIsland" aria-hidden="true">
      <div class="pill">
        <div class="pnav">
          <button class="pbtn" tabindex="-1" aria-label="Back"><svg viewBox="0 0 16 16"><path d="M9.75 3.5 5.25 8l4.5 4.5"/></svg></button>
          <button class="pbtn" tabindex="-1" disabled aria-label="Forward"><svg viewBox="0 0 16 16"><path d="M6.25 3.5 10.75 8l-4.5 4.5"/></svg></button>
        </div>
        <div class="dots" id="demoDots"></div>
        <span class="pill-fav" id="demoFav"></span>
        <span class="domain" id="demoDomain"></span>
        <span class="pill-shortcuts">
          <span class="pill-slash" id="demoSlash" hidden>/</span>
          <span class="pill-shortcut" title="New tab (⌘T)"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3.25v9.5M3.25 8h9.5"/></svg></span>
        </span>
        <span class="shield" id="demoShield"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.8l5 1.9v3.8c0 3.1-2.1 5.3-5 6.7-2.9-1.4-5-3.6-5-6.7V3.7z"/><path d="M4.4 11.47 12.61 3.55"/></svg><span class="shield-count" id="demoShieldCount"></span></span>
        <span class="psep"></span>
        <div class="pacts">
          <button class="pbtn" tabindex="-1" aria-label="Reload"><svg viewBox="0 0 16 16"><path d="M12.42 10.35a5 5 0 1 1-4.42-7.35c1.4 0 2.74.56 3.74 1.53L13 5.78"/><path d="M13 3v2.78h-2.78"/></svg></button>
          <button class="pbtn heart" id="demoHeart" tabindex="-1" aria-label="Favorite this page"><svg viewBox="0 0 16 16"><path d="M8 13.25C4.6 11 2.75 8.9 2.75 6.6a2.85 2.85 0 0 1 5.25-1.54A2.85 2.85 0 0 1 13.25 6.6c0 2.3-1.85 4.4-5.25 6.65z"/></svg></button>
          <button class="pbtn" tabindex="-1" aria-label="Close tab"><svg viewBox="0 0 16 16"><path d="M4.75 4.75l6.5 6.5M11.25 4.75l-6.5 6.5"/></svg></button>
        </div>
      </div>

      <div class="demo-shield-popover" id="demoShieldPopover" aria-hidden="true">
        <div class="demo-shield-popover-head">
          <div><strong id="demoShieldHost"></strong><span>Ad &amp; tracker blocking <b id="demoShieldState">on</b></span></div>
          <span class="demo-shield-switch" id="demoShieldSwitch"><i></i></span>
        </div>
        <p id="demoShieldConnection">Uses HTTPS</p>
        <p id="demoShieldBlocked"></p>
        <small>Changing this reloads the page.</small>
        <span class="demo-shield-settings">blocking settings →</span>
      </div>

      <div class="panel">
        <div class="panel-row">
          <div class="field"><span class="typed" id="demoTyped"></span><span class="caret"></span></div>
          <div class="pacts-row">
            <button class="abtn" tabindex="-1" disabled aria-label="Back"><svg viewBox="0 0 16 16"><path d="M9.75 3.5 5.25 8l4.5 4.5"/></svg></button>
            <button class="abtn" tabindex="-1" disabled aria-label="Forward"><svg viewBox="0 0 16 16"><path d="M6.25 3.5 10.75 8l-4.5 4.5"/></svg></button>
            <button class="abtn" tabindex="-1" aria-label="Reload"><svg viewBox="0 0 16 16"><path d="M12.42 10.35a5 5 0 1 1-4.42-7.35c1.4 0 2.74.56 3.74 1.53L13 5.78"/><path d="M13 3v2.78h-2.78"/></svg></button>
            <button class="abtn heart" tabindex="-1" aria-label="Favorite this page"><svg viewBox="0 0 16 16"><path d="M8 13.25C4.6 11 2.75 8.9 2.75 6.6a2.85 2.85 0 0 1 5.25-1.54A2.85 2.85 0 0 1 13.25 6.6c0 2.3-1.85 4.4-5.25 6.65z"/></svg></button>
            <button class="abtn" tabindex="-1" aria-label="Collapse island"><svg viewBox="0 0 16 16"><path d="M4.5 10.25 8 6.75l3.5 3.5"/></svg></button>
          </div>
        </div>
        <div class="list" id="demoList"></div>
        <div class="foot-bar">
          <button class="foot-new" tabindex="-1" aria-label="New tab"><svg viewBox="0 0 16 16"><path d="M8 3.25v9.5M3.25 8h9.5"/></svg><span>new tab</span><span class="foot-kbd">⌘T</span></button>
          <button class="foot-new private" tabindex="-1" aria-label="New private tab"><svg viewBox="0 0 16 16"><path d="M8 3.25v9.5M3.25 8h9.5"/></svg><span>private</span><span class="foot-kbd">⌘⇧N</span></button>
          <span class="foot-spacer"></span>
          <button class="foot-act ws bound" id="demoWorkspace" tabindex="-1" aria-label="Workspace research" aria-expanded="false">
            <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2.5" y="4.75" width="8.75" height="8.5" rx="1.5"/><path d="M5.25 4.75V3.25a1 1 0 0 1 1-1h7a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1h-1.5"/></svg>
            <span id="demoWorkspaceLabel">research</span>
          </button>
          <button class="foot-act" tabindex="-1" aria-label="Favorites"><svg viewBox="0 0 16 16"><path d="M4.25 2.75h7.5v10.5L8 10.5l-3.75 2.75z"/></svg></button>
          <button class="foot-act" tabindex="-1" aria-label="History"><svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="5.75"/><path d="M8 4.75V8l2.25 1.5"/></svg></button>
          <button class="foot-act" tabindex="-1" aria-label="Downloads"><svg viewBox="0 0 16 16"><path d="M8 2.5v6.5M5.3 6.3 8 9l2.7-2.7M3.5 12.5h9"/></svg></button>
          <button class="foot-act" tabindex="-1" aria-label="Vertical tabs"><svg viewBox="0 0 16 16"><rect x="2.5" y="2.75" width="11" height="10.5" rx="1.5"/><path d="M6 2.75v10.5"/></svg></button>
          <button class="foot-act" tabindex="-1" aria-label="Settings"><svg viewBox="0 0 16 16"><path d="M2.5 4.75h6M12 4.75h1.5M2.5 11.25h1.5M7.5 11.25h6"/><circle cx="10.25" cy="4.75" r="1.75"/><circle cx="5.75" cy="11.25" r="1.75"/></svg></button>
        </div>
        <div class="demo-workspace-switcher" id="demoWorkspaceSwitcher" hidden>
          <div class="demo-ws-row on"><span class="demo-ws-tick">✓</span><span>research</span><span class="demo-ws-count">8</span></div>
          <div class="demo-ws-row"><span class="demo-ws-tick"></span><span>writing</span><span class="demo-ws-count">4</span></div>
          <div class="demo-ws-row"><span class="demo-ws-tick"></span><span>weekend</span><span class="demo-ws-count">6</span></div>
          <div class="demo-ws-sep"></div>
          <div class="demo-ws-command">new…</div>
          <div class="demo-ws-command">save as…</div>
        </div>
        <div class="foot" id="demoFoot">⌘L summons · / for commands</div>
      </div>
    </div>
    <div class="demo-tab-context" id="demoTabContext" hidden aria-hidden="true"></div>
    <div class="demo-cursor" id="demoCursor" hidden aria-hidden="true"><span class="demo-cursor-shape"></span></div>
  </div>
  </div>
  </div>
  <div id="demoControlsMount">
  <div class="demo-scrub" id="demoScrub" role="group" aria-label="Demo chapters">
    <span class="demo-scrub-current" id="demoScrubCurrent">the island</span>
    <select class="demo-chapter-select" id="demoChapterSelect" aria-label="Demo chapter"></select>
    <div class="demo-scrub-track" id="demoScrubTrack">
      <div class="demo-scrub-fill" id="demoScrubFill"></div>
    </div>
    <button class="demo-scrub-toggle" id="demoScrubToggle" type="button" data-paused="false" aria-label="Pause demo" title="Pause demo">
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <g class="demo-pause-icon"><rect x="3.5" y="3" width="3" height="10" rx="0.75"/><rect x="9.5" y="3" width="3" height="10" rx="0.75"/></g>
        <path class="demo-play-icon" d="M5 2.5 13 8l-8 5.5z"/>
      </svg>
    </button>
  </div>
  </div>
  <button class="demo-enlarge" id="demoEnlarge" type="button" aria-haspopup="dialog">View larger <span aria-hidden="true">↗</span></button>
  </section>


  <section class="trust-benefits" aria-labelledby="benefitsTitle">
    <div class="trust-section-head"><p class="section-kicker">A calmer everyday browser</p><h2 id="benefitsTitle">The essentials, within reach.</h2></div>
    <article><span class="trust-number" aria-hidden="true">01</span><h3>Find your way</h3><p>The floating island combines navigation, search and tab switching. Open the Quick Switcher or type a slash command when a keyboard is quicker.</p><a class="text-link" href="/features/island">Explore navigation ↗</a></article>
    <article><span class="trust-number" aria-hidden="true">02</span><h3>Block the known noise</h3><p>Blanc Blocker uses bundled EasyList and EasyPrivacy rules at the network layer. Turn it off for a site when needed. No blocker can stop every tracker.</p><a class="text-link" href="/features/ad-blocking">Explore blocking ↗</a></article>
    <article><span class="trust-number" aria-hidden="true">03</span><h3>Keep tabs manageable</h3><p>Name your groups, reopen recently closed tabs and let inactive tabs go quiet to reclaim memory. Patron adds saved Named Workspaces.</p><a class="text-link" href="/features">Explore tab management ↗</a></article>
  </section>
  <section class="trust-explain" aria-labelledby="trustTitle">
    <div><p class="section-kicker">Know what you’re installing</p><h2 id="trustTitle">Clear about the engine.<br />Clear about the connections.</h2><p>New Blanc releases replace the app, including its bundled Electron and Chromium builds. Optional search suggestions and pseudonymous usage measurement have controls in first-run setup and Settings.</p></div>
    <div class="trust-explain-links"><a href="/how-it-works">How Blanc works <span aria-hidden="true">↗</span></a><a href="/how-it-works#connections">What may leave your device <span aria-hidden="true">↗</span></a><a href="/features/security">Security and release evidence <span aria-hidden="true">↗</span></a><a href="/privacy">Privacy policy <span aria-hidden="true">↗</span></a></div>
  </section>
  <section class="home-faq" aria-labelledby="home-faq-title">
    <div class="home-faq-head"><p class="section-kicker">A few useful answers</p><h2 id="home-faq-title">Before you download.</h2><a class="text-link" href="/faq">Read the full FAQ ↗</a></div>
    <div class="home-faq-list">
      <details><summary>Is Blanc based on Chromium?</summary><p>Yes. Chromium renders websites, Electron bundles the engine and desktop runtime, and Blanc supplies the browser interface and features.</p></details>
      <details><summary>Does Blanc send usage data?</summary><p>If you save Help improve Blanc as on, packaged builds send pseudonymous launch and fixed feature-use events to a Blanc-owned Cloudflare collector, with an optional Google Analytics mirror. No URLs, searches or page contents are in those events. <a href="/how-it-works#connections">See the connections and controls.</a></p></details>
      <details><summary>Is Blanc free and open source?</summary><p>Browsing is free. Blanc’s own code is MIT licensed; names, logos and third-party material have separate terms. Optional Patron supports development and adds Named Workspaces.</p></details>
    </div>
  </section>
  <section class="home-patron" aria-labelledby="home-patron-title">
    <div class="home-patron-copy">
      <BrandMark class="home-patron-mark" />
      <h2 id="home-patron-title"><span class="home-patron-intro">Upgrade to</span>{' '}<span class="home-patron-name">Blanc Patron.</span></h2>
      <p>Keep sets of tabs and groups ready to switch between with Named Workspaces. Your subscription supports Blanc’s development.</p>
      <p class="home-patron-boundary">Creating a named workspace requires an active Patron subscription. Renaming and removing existing workspaces continue to work if it lapses.</p>
      <a class="text-link" href="/features/workspaces" data-track="feature_cta_click" data-feature="named-workspaces" data-cta-position="home-patron">Explore Named Workspaces <span aria-hidden="true">↗</span></a>
    </div>
    <div class="home-patron-offer">
      <p class="home-patron-price"><strong><span class="home-patron-currency">US$</span><span class="home-patron-amount">30</span></strong><span class="home-patron-period"> / year</span></p>
      <p class="home-patron-monthly">or US$4 / month</p>
      <p class="home-patron-tax">Plus applicable tax.</p>
      <a class="cta" href="https://buy.polar.sh/polar_cl_auwRq39Q2hIVLJwANEqFWgWuZ8DGjdJmEI4mE0JaNDf" target="_blank" rel="noopener" data-track="supporter_click" data-feature="patron" data-cta-position="home-patron-close">Upgrade to Blanc Patron</a>
      <p class="home-patron-reassurance">Blanc is free to browse. Patron is optional.</p>
    </div>
  </section>
</main>

  <script src="../scripts/demo.js"></script>
</BaseLayout>
