---
import BaseLayout from '../layouts/BaseLayout.astro';
import { version } from '../../../package.json';

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://blancbrowser.com/#organization',
      name: 'Blanc',
      url: 'https://blancbrowser.com/',
      logo: 'https://blancbrowser.com/logo.png',
      sameAs: [
        'https://github.com/bnfy/blanc',
        'https://www.facebook.com/blancbrowser/',
        'https://www.threads.net/@blancbrowser',
        'https://www.instagram.com/blancbrowser/',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://blancbrowser.com/#website',
      url: 'https://blancbrowser.com/',
      name: 'Blanc Browser',
      alternateName: 'Blanc',
      description: 'A minimal desktop browser built around the Blanc Island.',
      publisher: {
        '@id': 'https://blancbrowser.com/#organization',
      },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://blancbrowser.com/#software',
      name: 'Blanc Browser',
      alternateName: 'Blanc',
      url: 'https://blancbrowser.com/',
      description: 'Blanc is a minimal desktop browser with search built into the Blanc Island, direct site controls for ad and tracker blocking, private tabs, slash commands, and real pages that stay in front.',
      applicationCategory: 'BrowserApplication',
      operatingSystem: 'macOS, Windows, Linux',
      softwareVersion: version,
      downloadUrl: 'https://github.com/bnfy/blanc/releases/latest',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      publisher: {
        '@id': 'https://blancbrowser.com/#organization',
      },
    },
  ],
};
---
<BaseLayout
  title="Blanc — A Minimal, Private Desktop Browser"
  description="Blanc is a minimal desktop browser with search built into one floating Island, direct site controls for ad and tracker blocking, private tabs, and keyboard-first commands for macOS, Windows, and Linux."
  path="/"
  page="home"
  header="island"
  social="rich"
  ogTitle="Blanc Browser — A minimal desktop browser with built-in ad blocking"
  ogDescription="Search, tabs, and browser controls in one floating Island, with direct site controls for ad and tracker blocking and private tabs."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} slot="head" />

<!-- ============ hero: the live island demo IS the hero ============ -->
<header class="hero">
  <svg class="mark" viewBox="0 0 153.09 203.01" aria-label="Blanc"><path fill="currentColor" stroke="currentColor" stroke-width="4" stroke-miterlimit="10" d="M134.38,101.86c24.33,25.19,21.67,65.83-5.32,87.94-8.59,6.51-18.12,11.21-29.4,11.21H2s.05-199,.05-199c0,0,97.65.33,97.65.33,45.48,1.28,58.21,65.28,23.42,90.51,3.88,3.01,7.95,5.58,11.26,9ZM125.36,78.39c20.05-22.83,7.01-66.02-25.23-67.38,0,0-89.13-.21-89.13-.21l.04,134.11c17.74-38.18,51.53-61.94,94.24-58.73,7.99.6,14.76-1.14,20.08-7.79ZM11.31,188.07l95.77-92.67c-52.79-10-98.17,42.23-95.77,92.67ZM118.69,186.27c32.49-18.49,31.57-71.32-2.46-87.28L19.63,192.01c14.1-1.71,88.27,4.83,99.06-5.74Z"></path></svg>

  <p class="eyebrow">zero bloat <span class="k">|</span> fast focus</p>
  <div class="hero-message" id="heroMessage">
    <div class="hero-message-slide is-active" data-hero-message>
      <h1>The browser that gets out of your way.</h1>
      <p class="hero-copy">Blanc Browser is a minimal desktop browser with search built into the Blanc Island, plus ad blocking, private tabs, and slash commands.</p>
    </div>
    <div class="hero-message-slide" data-hero-message aria-hidden="true">
      <h1>Know what a site is doing. Change it in one click.</h1>
      <p class="hero-copy">The shield is a small site control for your connection and for Blanc Blocker — no settings hunt required.</p>
    </div>
    <div class="hero-message-slide" data-hero-message aria-hidden="true">
      <h1>The island comes to meet you.</h1>
      <p class="hero-copy">Move toward it and it leans your way. Open it and the command bar grows out of it, instead of a panel cutting in over your page.</p>
    </div>
  </div>

  <div class="demo-stage" id="demoStage">
    <div class="demo-page">
      <div class="bar w1"></div>
      <div class="bar w2"></div>
      <div class="bar w3"></div>
      <div class="bar w4"></div>
    </div>
    <img class="demo-shot" id="demoShot" alt="" aria-hidden="true">
    <div class="demo-newtab" id="demoNewtab" hidden aria-hidden="true">
      <span class="demo-bb-date" id="demoBbDate"></span>
      <div class="demo-bb-clock-row">
        <span class="demo-bb-clock" id="demoBbClock"></span>
        <span class="demo-bb-meridiem" id="demoBbMeridiem"></span>
      </div>
      <span class="demo-bb-blocked" id="demoBbBlocked"></span>
      <div class="demo-bb-favs">
        <span class="demo-bb-fav"><span class="tile" style="background-image:url('/favicons/gmail.com.ico')"></span><span class="label">gmail</span></span>
        <span class="demo-bb-fav"><span class="tile" style="background-image:url('/favicons/notion.so.ico')"></span><span class="label">notion</span></span>
        <span class="demo-bb-fav"><span class="tile" style="background-image:url('/favicons/github.com.ico')"></span><span class="label">github</span></span>
        <span class="demo-bb-fav"><span class="tile" style="background-image:url('/favicons/netflix.com.ico')"></span><span class="label">netflix</span></span>
      </div>
    </div>
    <div class="demo-island" id="demoIsland">
      <div class="pill">
        <div class="pnav">
          <button class="pbtn" aria-label="Back"><svg viewBox="0 0 16 16"><path d="M9.75 3.5 5.25 8l4.5 4.5"/></svg></button>
          <button class="pbtn" disabled aria-label="Forward"><svg viewBox="0 0 16 16"><path d="M6.25 3.5 10.75 8l-4.5 4.5"/></svg></button>
        </div>
        <div class="dots" id="demoDots"></div>
        <span class="pill-fav" id="demoFav"></span>
        <span class="domain" id="demoDomain"></span>
        <span class="pill-slash" id="demoSlash" hidden>/</span>
        <span class="shield" id="demoShield"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.8l5 1.9v3.8c0 3.1-2.1 5.3-5 6.7-2.9-1.4-5-3.6-5-6.7V3.7z"/><path d="M4.4 11.47 12.61 3.55"/></svg><span class="shield-count" id="demoShieldCount"></span></span>
        <span class="priv-chip">private <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.75 4.75l6.5 6.5M11.25 4.75l-6.5 6.5"/></svg></span>
        <span class="psep"></span>
        <div class="pacts">
          <button class="pbtn" aria-label="Reload"><svg viewBox="0 0 16 16"><path d="M12.42 10.35a5 5 0 1 1-4.42-7.35c1.4 0 2.74.56 3.74 1.53L13 5.78"/><path d="M13 3v2.78h-2.78"/></svg></button>
          <button class="pbtn heart" id="demoHeart" aria-label="Favorite this page"><svg viewBox="0 0 16 16"><path d="M8 13.25C4.6 11 2.75 8.9 2.75 6.6a2.85 2.85 0 0 1 5.25-1.54A2.85 2.85 0 0 1 13.25 6.6c0 2.3-1.85 4.4-5.25 6.65z"/></svg></button>
          <button class="pbtn" aria-label="Close tab"><svg viewBox="0 0 16 16"><path d="M4.75 4.75l6.5 6.5M11.25 4.75l-6.5 6.5"/></svg></button>
        </div>
      </div>

      <div class="demo-shield-popover" id="demoShieldPopover" aria-hidden="true">
        <div class="demo-shield-popover-head">
          <div><strong id="demoShieldHost"></strong><span>Ad &amp; tracker blocking <b>on</b></span></div>
          <span class="demo-shield-switch"><i></i></span>
        </div>
        <p id="demoShieldConnection">Uses HTTPS</p>
        <p id="demoShieldBlocked"></p>
        <small>Changing this reloads the page.</small>
        <span class="demo-shield-settings">blocking settings →</span>
      </div>

      <div class="panel">
        <div class="panel-row">
          <div class="field"><span class="typed" id="demoTyped"></span><span class="caret"></span></div>
          <div class="pacts-row">
            <button class="abtn" disabled aria-label="Back"><svg viewBox="0 0 16 16"><path d="M9.75 3.5 5.25 8l4.5 4.5"/></svg></button>
