---
import GlanceDemo from "../components/GlanceDemo.astro";
import GestureDemo from "../components/GestureDemo.astro";
import HorizonShield from "../components/HorizonShield.astro";
import PlatformLogo from "../components/PlatformLogo.astro";
import BrandMark from "../components/BrandMark.astro";
import NativeIslandHero from "../components/NativeIslandHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/home.css";
import "../styles/home-appearance.css";
import pkg from "../../../package.json";
import chromiumMark from "../assets/summary-icons/chromium.svg?raw";
import electronMark from "../assets/summary-icons/electron.svg?raw";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://blancbrowser.com/#organization",
      name: "Blanc",
      url: "https://blancbrowser.com/",
      logo: "https://blancbrowser.com/logo.png",
      sameAs: [
        "https://github.com/bnfy/blanc",
        "https://www.facebook.com/blancbrowser/",
        "https://www.threads.net/@blancbrowser",
        "https://www.instagram.com/blancbrowser/",
      ],
    },
    {
      "@type": "WebSite",
      "@id": "https://blancbrowser.com/#website",
      url: "https://blancbrowser.com/",
      name: "Blanc Browser",
      alternateName: "Blanc",
      description:
        "A minimal desktop browser for macOS, Windows, and Linux with built-in ad and tracker blocking, private tabs, tab groups, and keyboard-first commands.",
      publisher: {
        "@id": "https://blancbrowser.com/#organization",
      },
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://blancbrowser.com/#software",
      name: "Blanc Browser",
      alternateName: "Blanc",
      url: "https://blancbrowser.com/",
      description:
        "Blanc is a minimal desktop browser for macOS, Windows, and Linux with built-in ad and tracker blocking, private tabs, tab groups, and keyboard-first commands.",
      applicationCategory: "BrowserApplication",
      operatingSystem: "macOS, Windows, Linux",
      softwareVersion: pkg.version,
      downloadUrl: "https://github.com/bnfy/blanc/releases/latest",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      publisher: {
        "@id": "https://blancbrowser.com/#organization",
      },
    },
  ],
};
---

<BaseLayout
  title="Blanc Browser — A little less browser."
  description="A minimal desktop browser with one compact Island for tabs, navigation and commands. Free for macOS, Windows and Linux, with built-in ad and tracker blocking."
  path="/"
  page="home"
  current="home"
  social="rich"
  ogImageAlt="Blanc’s compact Island and a Sunrise Start Page inside a desktop browser."
>
  <script
    type="application/ld+json"
    is:inline
    slot="head"
    set:html={JSON.stringify(structuredData)}
  />
  <main class="home-revamp" id="main-content">
    <section class="beat" id="opening" aria-labelledby="opening-title">
      <div class="frame">
        <div class="hero-copy">
          <img src="/sunrise-hero-mark.png" alt="" /><p class="frame-kicker">
            Blanc Browser
          </p><h1 id="opening-title">A little less browser.</h1><p class="lead">
            Tabs, navigation and page controls come together in one compact
            Island in a slim band above the page. A desktop browser for macOS,
            Windows and Linux.
          </p><div class="actions">
            <a class="planned-action" href="/download" data-download-cta data-track="download_click" data-cta-position="hero">Download Blanc</a><a
              class="planned-link"
              href="#island">See the Island in action</a>
          </div><p class="hero-offer">
            Free browser. Patron adds saved Named Workspaces.
          </p>
        </div>
        <NativeIslandHero />
      </div>
    </section>
    <section class="beat" id="wallpaper" aria-label="Time-of-day wallpaper preview">
      <div class="frame">
        <figure
          class="hero-product"
          id="hero-daylight"
          data-phase="dawn"
          data-appearance="light"
        >
          <div class="daylight-aura" aria-hidden="true">
            <span data-aura="dawn" class="is-current"></span><span
              data-aura="day"></span><span data-aura="dusk"></span><span
              data-aura="night"></span>
          </div><div class="device-composition device-laptop">
            <img
              class="device-shell"
              loading="lazy"
              decoding="async"
              src="/revamp/space-black-laptop-v2.webp"
              width="1536"
              height="1024"
              alt=""
              aria-hidden="true"
            /><div
              class="device-aperture"
              id="hero-daylight-screen"
              role="img"
              aria-label="Blanc v1.25.0 Billboard Start Page with dawn wallpaper in light appearance"
            >
              <div
                class="hero-wallpaper-scene is-current"
                data-hero-scene="dawn"
                style="background:#f8f1e7"
              >
                <img
                  class="device-screen"
                  src="/feature-captures/home-wallpaper-dawn-v1.25.0.webp"
                  width="1440"
                  height="900"
                  alt=""
                  aria-hidden="true"
                  decoding="async"
                />
              </div><div
                class="hero-wallpaper-scene"
                data-hero-scene="dawn-dark"
                style="background:#37342f"
              >
                <img
                  class="device-screen"
                  src="/feature-captures/home-wallpaper-dawn-dark-v1.25.0.webp"
                  width="1440"
                  height="900"
                  alt=""
                  aria-hidden="true"
                  decoding="async"
                />
              </div><div
                class="hero-wallpaper-scene"
                data-hero-scene="day"
                style="background:#e3e8e9"
              >
                <img
                  class="device-screen"
                  src="/feature-captures/home-wallpaper-day-v1.25.0.webp"
                  width="1440"
                  height="900"
                  alt=""
                  aria-hidden="true"
                  decoding="async"
                />
              </div><div
                class="hero-wallpaper-scene"
                data-hero-scene="day-dark"
                style="background:#292d31"
              >
                <img
                  class="device-screen"
                  src="/feature-captures/home-wallpaper-day-dark-v1.25.0.webp"
                  width="1440"
                  height="900"
                  alt=""
                  aria-hidden="true"
                  decoding="async"
                />
              </div><div
                class="hero-wallpaper-scene"
                data-hero-scene="dusk"
                style="background:#f0e7df"
              >
                <img
                  class="device-screen"
                  src="/feature-captures/home-wallpaper-dusk-v1.25.0.webp"
                  width="1440"
                  height="900"
                  alt=""
                  aria-hidden="true"
                  decoding="async"
                />
              </div><div
                class="hero-wallpaper-scene"
                data-hero-scene="dusk-dark"
                style="background:#251e1f"
              >
                <img
                  class="device-screen"
                  src="/feature-captures/home-wallpaper-dusk-dark-v1.25.0.webp"
                  width="1440"
                  height="900"
                  alt=""
                  aria-hidden="true"
                  decoding="async"
                />
              </div><div
                class="hero-wallpaper-scene"
                data-hero-scene="night"
                style="background:#e9e4db"
              >
                <img
                  class="device-screen"
                  src="/feature-captures/home-wallpaper-night-v1.25.0.webp"
                  width="1440"
                  height="900"
                  alt=""
                  aria-hidden="true"
                  decoding="async"
                />
              </div><div
                class="hero-wallpaper-scene"
                data-hero-scene="night-dark"
                style="background:#111114"
              >
                <img
                  class="device-screen"
                  src="/feature-captures/home-wallpaper-night-dark-v1.25.0.webp"
                  width="1440"
                  height="900"
                  alt=""
                  aria-hidden="true"
                  decoding="async"
                />
              </div>
            </div>
          </div><figcaption class="daylight-caption">
            <div class="daylight-heading">
              <div class="daylight-actions">
                <button
                  type="button"
                  id="hero-appearance"
                  aria-label="Switch page to dark mode"
                  aria-pressed="false"
                  ><span aria-hidden="true">◐</span><span
                    class="appearance-label">Light</span
                  ></button
                ><button
                  type="button"
                  id="hero-daylight-play"
                  aria-label="Play the wallpaper day"
                  ><span aria-hidden="true" class="daylight-play-icon">▶</span
                  ></button>
              </div>
            </div><div class="daylight-track">
              <input
                type="range"
                id="hero-time"
                min="0"
                max="3"
                step="1"
                value="0"
                aria-label="Preview the time of day"
                aria-valuetext="Dawn, 6 am"
              /><div class="daylight-ticks" aria-hidden="true">
                <span class="is-current">Dawn</span><span>Day</span><span
                  >Dusk</span
                ><span>Night</span>
              </div>
            </div>
          </figcaption>
        </figure>
      </div>
    </section>
    <section class="beat" id="island" aria-labelledby="island-title">
      <span id="features" class="anchor-alias" aria-hidden="true"></span>
      <div class="frame">
        <div class="frame-inner">
          <div class="split-title">
            <div>
              <p class="frame-kicker">The Island</p><h2 id="island-title">
                Tabs, search<br />and commands.
              </h2>
            </div><p class="lead">
              Open the Island to choose a tab, find a page or use a command.
              Close it to return to the page in front of you.
            </p>
          </div><figure
            class="island-demo"
            id="island-demo"
            aria-describedby="demoTabDiscovery"
          >
            <div class="island-cinema" id="island-stage" data-state="resting">
              <div
                class="island-pixels"
                role="img"
                aria-label="Blanc v1.27.0: the resting Island above NASA’s Adopt a Pixel telescope scene"
              >
                <img
                  class="island-native island-base"
                  src="/revamp/island-roman-rest.webp"
                  width="1400"
                  height="1000"
                  alt=""
                  draggable="false"
                  loading="lazy"
                  decoding="async"
                />
                <div
                  class="island-layer"
                  data-layer="tabs"
                >
                  <img
                    class="island-native"
                    src="/revamp/island-roman-tabs.webp"
                    width="1400"
                    height="1000"
                    alt=""
                    draggable="false"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="island-layer" data-layer="commands">
                  <img
                    class="island-native"
                    src="/revamp/island-roman-command.webp"
                    width="1400"
                    height="1000"
                    alt=""
                    draggable="false"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
              <button
                class="island-hotspot"
                type="button"
                aria-label="Open the Island preview"
                aria-expanded="false"></button>
            </div>
            <div class="island-demo-controls">
              <div
                class="gallery-controls island-selector"
                role="group"
                aria-label="Explore the Island"
              >
                <button type="button" data-island="resting" aria-pressed="true"
                  >At rest</button
                ><button type="button" data-island="tabs" aria-pressed="false"
                  ><span class="island-label-full">Open the Island</span><span
                    class="island-label-compact">Tabs</span></button
                ><button
                  type="button"
                  data-island="commands"
                  aria-pressed="false"><span class="island-label-full"
                    >Find a command</span><span class="island-label-compact"
                    >Commands</span></button>
              </div><button
                id="island-play"
                class="demo-play"
                type="button"
                aria-label="Play the Island sequence"
                ><span class="play-glyph" aria-hidden="true">▶</span><span
                  class="play-label">Play sequence</span
                ></button>
            </div>
            <p class="sr-only" id="demoTabDiscovery">
              Each dot is a tab. Hover to see its icon and title. Keyboard focus
              shows the icon; a screen reader announces the tab title. Click or
              press Enter to switch. +N opens the full list. Use Cmd+L on Mac or
              Ctrl+L on Windows and Linux to search tabs by name.
            </p>
            <figcaption id="island-caption" class="sr-only" aria-live="polite">
              Each dot is a tab. Hover or focus a dot in Blanc to preview it;
              select it to switch. Open the Island for the full list.
            </figcaption>
          </figure>
        </div>
      </div>
    </section>
    <section class="beat" id="tabs" aria-labelledby="tabs-title">
      <div class="frame">
        <div class="frame-inner">
          <div class="split-title tabs-intro">
            <div>
              <p class="frame-kicker">Tabs and sessions</p>
              <h2 id="tabs-title">Organize tabs<br />into groups.</h2>
            </div>
            <p class="lead">Bring related tabs together in named groups. Fold a group away when you want a quieter view. You choose what belongs together.</p>
          </div>
          <figure class="tabs-capture">
              <img src="/revamp/tab-groups-native.webp" width="1240" height="652" loading="lazy" decoding="async" alt="Blanc v1.27.0 on macOS: the Island shows an explore group with two NASA pages and a reading group with Typography and Scandinavian design. Each group has a fold control, tab count and keyboard shortcut." />
            <figcaption class="sr-only">Actual Blanc interface with sample tabs.</figcaption>
          </figure>
          <div class="tabs-followthrough">
            <p>Tab groups are free. <a href="#patron">Patron adds saved Named Workspaces.</a></p>
            <nav aria-label="More about tabs and sessions">
              <a href="/features/tab-groups">Tab groups <span aria-hidden="true">→</span></a>
              <a href="/features/reopen-closed-tabs">Recently Closed <span aria-hidden="true">→</span></a>
              <a href="/features/profiles">Profiles <span aria-hidden="true">→</span></a>
              <a href="/features/sync">Sync <span aria-hidden="true">→</span></a>
            </nav>
          </div>
        </div>
      </div>
    </section>
    <section class="beat privacy-section" id="privacy" aria-labelledby="privacy-title">
      <div class="frame">
        <div class="frame-inner">
          <div class="privacy-intro">
            <header class="privacy-heading">
              <p class="frame-kicker">Privacy and control</p>
              <h2 id="privacy-title">Choose your<br />ad blocker.</h2>
              <p class="lead">Choose how Blanc blocks ads and trackers.</p>
            </header>
            <HorizonShield variant="blocker" />
            <div class="blocking-options">
              <div class="blocking-option">
                <h3>Blanc Blocker</h3>
                <p>Ghostery’s blocking engine with bundled EasyList ad filters, EasyPrivacy tracker filters and scriptlets.</p>
              </div>
              <div class="blocking-option">
                <h3>uBlock Origin</h3>
                <p>Customizable filter lists, advanced settings and a request logger for regular tabs.</p>
              </div>
              <p class="blocking-provider-note">Private tabs use Blanc Blocker. Changing blockers requires a restart. Site settings stay separate.</p>
            </div>
          </div>
          <div class="privacy-disclosure">
            <div>
              <h3>Private tabs and data settings.</h3>
              <p>Open a private tab when you choose. Optional connections start only after you save your setup choices. Enabled usage measurement sends pseudonymous launch and fixed feature-use events to Blanc’s collector, with an optional Google Analytics mirror; no URLs, searches or page contents.</p>
            </div>
            <p class="material-limit">
              Blocking reduces known ads and tracking; coverage is not universal.
              Fresh setup preselects search suggestions and usage measurement.
              Both can be turned off before saving or later in Settings. <a
                href="/trust#connections"
                >Connections, defaults and security evidence →</a>
              <a href="/trust#ad-blocking">Blocking details →</a>
            </p>
          </div>
        </div>
      </div>
    </section>
    <section class="beat" id="start" aria-labelledby="start-title">
      <div class="frame start-frame">
        <div class="frame-inner">
          <div class="split-title">
            <div>
              <p class="frame-kicker">Start Page</p><h2
                id="start-title"
              >
                Choose your<br />Start Page layout.
              </h2>
            </div><p class="lead">
              Choose Ledger, Billboard, Shelf or Tally. Keep a simple list, a
              large clock, a shelf of favorites or a view of blocking activity.
            </p>
          </div><div
            class="gallery-controls"
            role="group"
            aria-label="Choose a Start Page layout"
          >
            <button type="button" data-layout="ledger" aria-pressed="true"
              >Ledger</button
            ><button type="button" data-layout="billboard" aria-pressed="false"
              >Billboard</button
            ><button type="button" data-layout="shelf" aria-pressed="false"
              >Shelf</button
            ><button type="button" data-layout="tally" aria-pressed="false"
              >Tally</button>
          </div>
        </div><figure>
          <div class="device-composition device-desktop">
            <img
              class="device-shell"
              src="/revamp/champagne-desktop-v2.webp"
              width="1374"
              height="1145"
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
            /><div class="device-aperture">
              <img
                id="layout-image"
                class="layout-shot device-screen"
                src="/feature-captures/ledger-v1.21.0.png"
                width="1440"
                height="900"
                alt="Blanc v1.21.0 Ledger Start Page capture"
                loading="lazy"
                decoding="async"
              />
              <video
                id="mahjong-video"
                class="device-screen mahjong-video"
                width="1440"
                height="824"
                muted
                playsinline
                preload="none"
                aria-label="Recorded Blanc v1.27.0 Mahjong gameplay"
                hidden
              ></video>
            </div>
          </div><figcaption id="layout-caption" class="sr-only" aria-live="polite">
            Ledger — a simple list of Favorites.
          </figcaption><div class="start-discovery">
            <button
              type="button"
              id="mahjong-peek"
              aria-expanded="false"
              aria-controls="mahjong-video mahjong-controls"
              ><span class="tile-pair" aria-hidden="true"
                ><span
                  ><img
                    src="/sunrise-hero-mark.png"
                    alt=""
                    loading="lazy"
                    decoding="async"
                  /></span
                ><span
                  ><img
                    src="/sunrise-hero-mark.png"
                    alt=""
                    loading="lazy"
                    decoding="async"
                  /></span
                ></span
              ><span class="break-copy"
                ><span class="break-label">Mahjong.</span
                ><span class="break-description">Preview Blanc’s built-in game.</span
                ></span></button
            ><button type="button" id="mahjong-back" hidden
              >Back to Ledger</button>
          </div>
          <div id="mahjong-controls" class="mahjong-controls" hidden>
            <div class="mahjong-boards" role="group" aria-label="Choose a Mahjong board demo">
              <button type="button" data-mahjong-scene="peaks" aria-pressed="true">Peaks</button>
              <button type="button" data-mahjong-scene="butterfly" aria-pressed="false">Butterfly</button>
              <button type="button" data-mahjong-scene="fortress" aria-pressed="false">Fortress</button>
            </div>
            <button type="button" data-mahjong-play aria-controls="mahjong-video">Play demo</button>
          </div>
        </figure>
      </div>
    </section>
    <section class="beat" id="tools" aria-labelledby="tools-title">
      <div class="frame">
        <div class="frame-inner">
          <h2 id="tools-title">
            Everyday browser tools.
          </h2><GlanceDemo /><GestureDemo /><div class="tools-list">
            <article>
              <h3>Use your 1Password logins.</h3><p>
                On macOS, the optional integration fills a matching login when
                you ask.
              </p><p class="material-limit">
                Off by default; requires the installed 1Password app and account
                on macOS. Lookup and filling remain explicit actions. <a
                  href="/support#1password">Setup and shortcuts →</a>
              </p>
            </article><article>
              <h3>Free memory with Quiet Tabs.</h3><p>
                Quiet Tabs can release memory from eligible inactive background
                pages while retaining their tabs.
              </p><p class="material-limit">
                A quiet page reloads when revisited. Active, unfinished or
                otherwise ineligible pages stay awake.
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>
    <section class="beat" id="closing" aria-labelledby="closing-title">
      <div class="frame">
        <div class="trust-intro">
          <section class="home-foundations" aria-label="About the browser">
            <div>
              <span class="foundation-label"
                ><span class="foundation-icons" aria-hidden="true"
                  ><Fragment set:html={chromiumMark} /><Fragment
                    set:html={electronMark}
                  /></span
                >Built on</span
              ><strong>Chromium + Electron</strong><a
                href="/trust#engine">How they fit together ↗</a>
            </div><div>
              <span>Open source</span><strong>MIT for Blanc’s own code</strong><a
                href="/support#open-source">Licensing and exceptions ↗</a>
            </div><div>
              <span>Official downloads</span><strong
                >Release evidence, in public</strong
              ><a href="/trust#release-verification-title">Check your download ↗</a>
            </div>
          </section>
          <div class="trust-summary">
            <h2 id="closing-title">Built by Bananify.</h2>
            <div class="trust-links">
              <a href="/about">About Blanc</a>
              <a href="https://github.com/bnfy/blanc">Source code</a>
              <a href="/trust">Privacy and security</a>
            </div>
          </div>
        </div><section
          class="patron-section"
          id="patron"
          aria-labelledby="patron-title"
        >
          <span
            class="patron-anchor"
            id="home-patron-title"
            aria-hidden="true"
          ></span>
          <div class="patron-layout">
            <div class="patron-intro">
              <BrandMark class="patron-mark" />
              <h2 class="patron-title" id="patron-title">Blanc Patron.</h2>
              <p class="patron-description">
                Support Blanc and save named window sets with Named Workspaces.
                The browser remains free; Patron is an optional subscription.
              </p>
              <a class="patron-help" href="/support#workspaces" data-track="feature_cta_click" data-feature="named-workspaces" data-cta-position="home-patron"
                >Explore Named Workspaces →</a>
            </div>
            <div class="patron-offer">
              <p class="patron-price">
                <span class="patron-annual"
                  ><span class="patron-currency">US$</span><span
                    class="patron-amount">30</span><span class="patron-period"
                    > / year</span></span>
                <span class="patron-monthly"
                  >or US$4 / month, plus applicable tax.</span>
              </p>
              <a
                class="patron-cta"
                data-track="supporter_click"
                data-feature="patron"
                data-cta-position="home-patron-close"
                href="https://buy.polar.sh/polar_cl_auwRq39Q2hIVLJwANEqFWgWuZ8DGjdJmEI4mE0JaNDf"
                >Become a Patron <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <p class="patron-boundary">
            Creating a named workspace requires an active Patron subscription.
            If membership lapses, existing workspaces remain openable,
            switchable, and automatically updated. Renaming and removing
            existing workspaces continue to work if it lapses. Earlier
            one-time supporters keep their lifetime Patron access.
          </p>
        </section><div class="download-close">
          <h3>Ready to try Blanc?</h3><div
            class="platforms"
            aria-label="Available desktop platforms"
          >
            <span><PlatformLogo platform="apple" />macOS</span><span
              ><PlatformLogo platform="windows" />Windows</span
            ><span><PlatformLogo platform="linux" />Linux</span>
          </div><a class="planned-action" href="/download" data-track="download_click" data-cta-position="home-close"
            >Choose your download</a
          ><p class="closing-links" style="margin-top:20px">
            <a href="/support">Support</a> · <a href="/changelog">What’s new</a>
          </p>
        </div>
      </div>
    </section>
  </main>
  <script src="../scripts/home.js"></script>
</BaseLayout>
