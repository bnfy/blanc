---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MailBar from '../../components/MailBar.astro';
import { checkoutHrefFor, priceFor } from '../../data/mail-commerce.mjs';
import '../../styles/mail.css';
const plans = [
  { key: 'mail', name: 'Blanc Mail', features: ['Blanc Mail on macOS', 'Gmail-first native app', '14-day local trial'] },
  { key: 'suite', name: 'Blanc Suite', features: ['Blanc Browser Patron on macOS, Windows, and Linux', 'Blanc Mail on macOS', 'Your Browser and Mail license keys in one subscription'] },
];
---
<BaseLayout title="Blanc Mail pricing — macOS" description="Planned Blanc Mail and Blanc Suite pricing. Mail is coming soon for macOS, with a 14-day local trial." path="/mail/pricing" header="solid">
  <MailBar />
  <main id="main-content" class="mail-page mail-pricing">
    <header class="mail-page-head">
      <p class="mail-eyebrow">Blanc Mail · Planned pricing</p>
      <h1>A good home for your mail.</h1>
      <p class="mail-lead">Start with a 14-day local trial when Mail launches. No card is needed to begin.</p>
    </header>
    <!-- Status first, so nobody reads the prices as an open offer. -->
    <p class="mail-callout"><svg class="mail-callout-glyph" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></svg><span>Purchases are not open yet. Current Browser Patron subscribers will be able to upgrade to Suite through Polar on the same billing period, and their Browser license key keeps working without being entered again. Existing Patron and founding benefits continue to apply to Browser only.</span></p>
    <div class="mail-plans">
      {plans.map(plan => <article class="mail-plan">
        <h2>{plan.name}</h2>
        <p class="mail-plan-price"><strong>{priceFor(`${plan.key}-monthly`)}</strong> / month<br />or <strong>{priceFor(`${plan.key}-annual`)}</strong> / year</p>
        <ul>{plan.features.map(feature => <li>{feature}</li>)}</ul>
        {['monthly', 'annual'].map(period => {
          const href = checkoutHrefFor(`${plan.key}-${period}`);
          return href ? <a href={href}>{`Choose ${plan.name} — ${period}`}</a> : null;
        })}
      </article>)}
    </div>
    <section class="mail-quiet"><h2>What happens when a subscription ends?</h2><p>Blanc Mail keeps your mail readable, searchable, and exportable. Composing and sending pause until a valid license is available. Browser's free features remain free.</p></section>
  </main>
</BaseLayout>
