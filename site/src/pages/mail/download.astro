---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MailBar from '../../components/MailBar.astro';
import MailIcon from '../../components/MailIcon.astro';
import MailWaitlistForm from '../../components/MailWaitlistForm.astro';
import '../../styles/mail.css';
---
<BaseLayout title="Download Blanc Mail for macOS — coming soon" description="Blanc Mail is coming soon for macOS. Signed, notarized downloads will appear after the release checks pass." path="/mail/download" header="solid">
  <MailBar />
  <main id="main-content" class="mail-page mail-download">
    <div class="mail-download-grid">
      <div class="mail-download-main">
        <header class="mail-page-head">
          <p class="mail-eyebrow">macOS only · Coming soon</p>
          <h1>Blanc Mail for Mac.</h1>
          <p class="mail-lead">The first download will appear here after the signed macOS build, Gmail sign-in, Private Push, and Sparkle update checks pass.</p>
        </header>
        <MailWaitlistForm id="download-waitlist" />
      </div>
      <aside class="mail-card mail-requirements" aria-labelledby="mail-requirements">
        <MailIcon class="mail-requirements-icon" decorative />
        <h2 id="mail-requirements">Requirements</h2>
        <p>macOS 14 or later on an Apple Silicon or Intel Mac, plus a Google account. Blanc Mail does not have a Windows or Linux edition planned for launch.</p>
        <p>Blanc Browser already has separate <a href="/download">macOS, Windows, and Linux downloads</a>.</p>
      </aside>
    </div>
  </main>
</BaseLayout>
