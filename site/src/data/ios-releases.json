                  {
                    "type": "text",
                    "value": "Blanc now runs on iPad: full screen in every orientation, with Split View, Glance, windows of their own, and keyboard shortcuts like ⌘L and ⌘T."
                  }
                ],
                "url": null
              },
              {
                "spans": [
                  {
                    "type": "text",
                    "value": "Websites open below the status bar again, instead of starting under the clock until you pull them down. In landscape they stay clear of the Dynamic Island."
                  }
                ],
                "url": null
              },
              {
                "spans": [
                  {
                    "type": "text",
                    "value": "On iOS 26, tapping the trash after swiping a tab to the left in the tab list closes the tab."
                  }
                ],
                "url": null
              }
            ]
          }
        ]
