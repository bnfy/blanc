            "type": "list",
            "items": [
              {
                "spans": [
                  {
                    "type": "text",
                    "value": "Back, Forward and New Tab are on the Island, and you can turn Back and Forward off in Settings. Reload and Settings are in the Sunrise menu, and you can pull down on a page to reload it."
                  }
                ],
                "url": null
              },
              {
                "spans": [
                  {
                    "type": "text",
                    "value": "The Island is a little taller and rounder, with an easier-to-read address. On iOS 26, a site's own bottom bars and banners sit above it instead of under it."
                  }
                ],
                "url": null
              },
              {
                "spans": [
                  {
                    "type": "text",
                    "value": "Swipe a tab to the left in the tab list to close it."
                  }
                ],
                "url": null
              },
              {
                "spans": [
                  {
                    "type": "text",
                    "value": "Sunrise is the standard app icon. Sunrise Gold and the new Sunrise Bronze are in Settings → Appearance → App icon."
                  }
                ],
                "url": null
              },
              {
                "spans": [
                  {
                    "type": "text",
                    "value": "Search suggestions from your search engine, off until you turn them on in Settings → Privacy."
                  }
                ],
                "url": null
              },
              {
                "spans": [
                  {
                    "type": "text",
                    "value": "Files a page can't show open in the share sheet, so you can save them to Files or send them."
                  }
                ],
                "url": null
              },
              {
                "spans": [
                  {
                    "type": "text",
                    "value": "Page Zoom and Request Desktop Website in the Sunrise menu."
                  }
                ],
                "url": null
              },
              {
                "spans": [
                  {
                    "type": "text",
                    "value": "Alerts and prompts from websites now appear, and a page that doesn't load says why, with Try again."
                  }
                ],
                "url": null
              }
            ]
          }
        ]
      }
    ]
