                  {
                    "type": "text",
                    "value": "A new Start Page: the time over your wallpaper, with shortcuts to the sites you visit most, each with its own icon. Customize adds your Favorites and your other devices’ tabs, sets how many shortcuts show, and changes the clock and wallpaper."
                  }
                ],
                "url": null
              },
              {
                "spans": [
                  {
                    "type": "text",
                    "value": "Hold a shortcut to pin it, hide it or open it in a new tab."
                  }
                ],
                "url": null
              },
              {
                "spans": [
                  {
                    "type": "text",
                    "value": "On iPad, a website’s full screen button now works, so videos can fill the screen."
                  }
                ],
                "url": null
              }
            ]
