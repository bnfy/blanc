      "id": "built-in",
      "label": "What’s built in",
      "rows": [
        "blocking",
        "extensions",
        "ai"
      ]
    },
    {
      "id": "tabs",
      "label": "Organizing your tabs",
      "rows": [
        "spaces",
        "side-tabs",
        "split"
      ]
    },
    {
      "id": "devices",
      "label": "Across your devices",
      "rows": [
