{
  "$comment": "Source of truth for window.browserAPI. Edit HERE, then run npm run browser-api:build. See browser-api/README.md.",
  "version": 1,
  "surfaces": [
    "blanc-chrome://index/",
    "blanc-chrome://overlay/",
    "blanc-chrome://permission/"
  ],
  "types": {
    "Platform": {
      "ts": "'darwin' | 'win32' | 'linux'",
      "doc": "Supported desktop platforms."
    },
    "TabId": {
      "ts": "string",
      "doc": "Opaque tab id minted by main (a UUID today)."
    },
    "GroupId": {
      "ts": "string",
      "doc": "Opaque tab group id minted by main."
    },
    "WorkspaceId": {
      "ts": "string",
      "doc": "Opaque Named Workspace id."
    },
    "ClosedEntryId": {
      "ts": "string",
      "doc": "Opaque closed-entry id."
    },
    "PermissionPromptId": {
      "ts": "number",
      "doc": "Id of a pending permission prompt: a per-process counter in main."
    },
    "CaptureSurfaceId": {
      "ts": "string",
      "doc": "Id of a capturing surface: a TabId for a tab, or `popup:<webContentsId>` for an auxiliary popup."
    },
    "DisplayShareId": {
      "ts": "string",
      "doc": "Id of an active screen share (`share-<n>`), minted by the display-capture registry."
    },
    "BlockingProviderId": {
      "ts": "'blanc' | 'ublock-origin'",
      "doc": "A blocking provider."
    },
    "ConnectionState": {
      "ts": "'https' | 'http' | 'local'",
      "doc": "Connection claim for a committed URL. null in a payload means no claim (loading, or not HTTP)."
    },
    "TabLayout": {
      "ts": "'island' | 'vertical'",
      "doc": "Tab presentation; main ignores other values."
    },
    "ThemePreference": {
      "ts": "'system' | 'light' | 'dark'",
      "doc": "Appearance preference."
    },
    "WorkspaceMoveDirection": {
      "ts": "'up' | 'down'",
      "doc": "Direction for reordering a workspace."
    },
    "CreateTabOptions": {
      "ts": "{ private?: boolean }",
      "doc": "Options for a new tab. Only `private` is read by main today."
    },
    "OpenWorkspaceOptions": {
      "ts": "{ force?: boolean }",
      "doc": "`force` skips the scratch guard after a confirmed \"discard and switch\"."
    },
    "Point": {
      "doc": "A point in window coordinates.",
      "fields": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "Rect": {
      "doc": "A rectangle in window coordinates.",
      "fields": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    },
    "Anchor": {
      "ts": "unknown",
      "doc": "Popover anchor geometry sent by the strip. Shape not yet pinned."
    },
    "PermissionPromptPayload": {
      "doc": "A pending permission prompt, built by the permission prompter in main.js.",
      "fields": {
        "id": {
          "type": "PermissionPromptId"
        },
        "origin": {
          "type": "string"
        },
        "permission": {
          "type": "string",
          "doc": "Electron permission name, such as media or geolocation."
        },
        "mediaTypes": {
          "type": "string[]",
          "doc": "Requested media types, per the prompter JSDoc in permissions.js."
        }
      }
    },
    "TabCapture": {
      "doc": "A tab's live capture state.",
      "fields": {
        "audio": {
          "type": "boolean"
        },
        "video": {
          "type": "boolean"
        }
      }
    },
    "ShieldChip": {
      "doc": "Shield chip state, derived by shieldChipState() in shield-model.js.",
      "fields": {
        "mode": {
          "type": "'hidden' | 'off' | 'count' | 'quiet'"
        },
        "count": {
          "type": "number"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "CertificateSummary": {
      "doc": "Certificate fields sanitized by sanitizeCertificate() in site-security.js.",
      "fields": {
        "subject": {
          "type": "string | null"
        },
        "issuer": {
          "type": "string | null"
        },
        "validFrom": {
          "type": "number | null",
          "doc": "Milliseconds since the epoch."
        },
        "validTo": {
          "type": "number | null",
          "doc": "Milliseconds since the epoch."
        },
        "fingerprint": {
          "type": "string | null"
        }
      }
    },
    "SiteInfo": {
      "doc": "Page-info model, built by buildSiteInfo() in site-security.js.",
      "fields": {
        "state": {
          "type": "'neutral' | 'certificate-error' | 'secure' | 'local' | 'insecure' | 'internal'"
        },
        "origin": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "certificate": {
          "type": "CertificateSummary | null"
        },
        "blockedCount": {
          "type": "number"
        },
        "permissions": {
          "type": "unknown[]",
          "doc": "Always empty in tabs:updated today."
        },
        "error": {
          "type": "string | null",
          "doc": "Present only when state is certificate-error.",
          "optional": true
        }
      }
    },
    "TabEntry": {
      "doc": "One tab in tabs:updated, projected by serializeTabs() in main.js. Main-only state never crosses this projection.",
      "fields": {
        "id": {
          "type": "TabId"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "isLoading": {
          "type": "boolean"
        },
        "canGoBack": {
          "type": "boolean"
        },
        "canGoForward": {
          "type": "boolean"
        },
        "favicon": {
          "type": "string | null",
          "doc": "A data:image/png;base64 URL, or null. Always null for private tabs."
        },
        "bookmarked": {
          "type": "boolean",
          "doc": "Whether the page is a Favorite."
        },
        "blockedCount": {
          "type": "number"
        },
        "private": {
          "type": "boolean"
        },
        "pinned": {
          "type": "boolean"
        },
        "muted": {
          "type": "boolean"
        },
        "audible": {
          "type": "boolean",
          "doc": "Playing sound that can reach the speakers."
        },
        "groupId": {
          "type": "GroupId | null"
        },
        "pageBg": {
          "type": "string | null",
          "doc": "Sampled top-edge page color."
        },
        "themeColor": {
          "type": "string | null",
          "doc": "The page theme-color meta value."
        },
        "asleep": {
          "type": "boolean",
          "doc": "Quiet Tabs state."
        },
        "capture": {
          "type": "TabCapture"
        },
        "fillHint": {
          "type": "boolean",
          "doc": "A login form is present (structure only)."
        },
        "excepted": {
          "type": "boolean",
          "doc": "Ads are allowed on this site."
        },
        "shield": {
          "type": "ShieldChip"
        },
        "connection": {
          "type": "ConnectionState | null"
        },
        "siteInfo": {
          "type": "SiteInfo"
        }
      }
    },
    "TabGroup": {
      "doc": "A tab group. Groups have names, not colors.",
      "fields": {
        "id": {
          "type": "GroupId"
        },
        "name": {
          "type": "string"
        },
        "collapsed": {
          "type": "boolean"
        }
      }
    },
    "ClosedEntrySummary": {
      "doc": "A closed entry as renderers see it, projected by projectEntries() in closed-tabs.js.",
      "fields": {
        "id": {
          "type": "ClosedEntryId"
        },
        "title": {
          "type": "string"
        },
        "favicon": {
          "type": "string | null"
        },
        "tabCount": {
          "type": "number"
        }
      }
    },
    "ShieldProviderControls": {
      "doc": "Blocking provider controls, from shieldProviderModel() in shield-model.js.",
      "fields": {
        "active": {
          "type": "BlockingProviderId"
        },
        "selected": {
          "type": "BlockingProviderId"
        },
        "choice": {
          "type": "BlockingProviderId"
        },
        "restartPending": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "disabled": {
          "type": "boolean"
        },
        "activeLabel": {
          "type": "'Off' | 'Active' | 'Starting' | 'Unavailable'"
        },
        "ublockAvailable": {
          "type": "boolean"
        },
        "canOpenUblock": {
          "type": "boolean"
        },
        "detail": {
          "type": "string"
        },
        "availability": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        }
      }
    },
    "ShieldPopover": {
      "doc": "The active tab's shield popover: shieldPopoverModel() plus provider controls.",
      "fields": {
        "variant": {
          "type": "'site' | 'global-off' | 'recovery' | 'ublock'"
        },
        "host": {
          "type": "string"
        },
        "on": {
          "type": "boolean"
        },
        "countLine": {
          "type": "string"
        },
        "connection": {
          "type": "ConnectionState | null"
        },
        "controls": {
          "type": "ShieldProviderControls"
        }
      }
    },
    "CaptureChip": {
      "doc": "Window-wide capture chip state.",
      "fields": {
        "audio": {
          "type": "boolean"
        },
        "video": {
          "type": "boolean"
        }
      }
    },
    "CaptureRow": {
      "doc": "One capturing surface in the capture popover.",
      "fields": {
        "surfaceId": {
          "type": "CaptureSurfaceId"
        },
        "host": {
          "type": "string"
        },
        "kind": {
          "type": "'tab' | 'popup'"
        },
        "audio": {
          "type": "boolean"
        },
        "video": {
          "type": "boolean"
        }
      }
    },
    "CapturePopover": {
      "doc": "Capture popover rows.",
      "fields": {
        "rows": {
          "type": "CaptureRow[]"
        }
      }
    },
    "DisplayShareSummary": {
      "doc": "A screen share, projected by projectDisplayShares() in display-capture-indicator.js.",
      "fields": {
        "shareId": {
          "type": "DisplayShareId"
        },
        "pending": {
          "type": "boolean"
        },
        "origin": {
          "type": "string | null"
        },
        "surfaceLabel": {
          "type": "string | null"
        },
        "surfaceKind": {
          "type": "string | null"
        },
        "computerAudio": {
          "type": "boolean"
        },
        "tabId": {
          "type": "TabId | null"
        }
      }
    },
    "TabsSnapshot": {
      "doc": "Result of getAllTabs, built by the tabs:get-all handler in main.js.",
      "fields": {
        "tabs": {
          "type": "TabEntry[]"
        },
        "activeTabId": {
          "type": "TabId | null"
        },
        "glanceTabId": {
          "type": "TabId | null"
        },
        "groups": {
          "type": "TabGroup[]"
        },
        "closed": {
          "type": "ClosedEntrySummary[]"
        },
        "tabLayout": {
          "type": "TabLayout"
        },
        "verticalTabsWidth": {
          "type": "number"
        },
        "verticalTabsPreferredWidth": {
          "type": "number"
        },
        "verticalTabsMinWidth": {
          "type": "number"
        },
        "verticalTabsMaxWidth": {
          "type": "number"
        },
        "verticalTabsDefaultWidth": {
          "type": "number"
        }
      }
    },
    "TabsUpdatedPayload": {
      "doc": "The tabs:updated broadcast, built by currentTabsPayload() in main.js.",
      "fields": {
        "tabs": {
          "type": "TabEntry[]"
        },
        "activeTabId": {
          "type": "TabId | null"
        },
        "glanceTabId": {
          "type": "TabId | null"
        },
        "groups": {
          "type": "TabGroup[]"
        },
        "closed": {
          "type": "ClosedEntrySummary[]"
        },
        "tabLayout": {
          "type": "TabLayout"
        },
        "adblockEnabled": {
          "type": "boolean"
        },
        "shieldPopover": {
          "type": "ShieldPopover | null"
        },
        "captureChip": {
          "type": "CaptureChip"
        },
        "capturePopover": {
          "type": "CapturePopover"
        },
        "displayShares": {
          "type": "DisplayShareSummary[]"
        },
        "verticalTabsWidth": {
          "type": "number"
        },
        "verticalTabsPreferredWidth": {
          "type": "number"
        },
        "verticalTabsMinWidth": {
          "type": "number"
        },
        "verticalTabsMaxWidth": {
          "type": "number"
        },
        "verticalTabsDefaultWidth": {
          "type": "number"
        }
      }
    },
    "ShieldAnchorUpdate": {
      "doc": "Where the shield popover's arrow sits, sent by syncShieldAnchor() in main.js.",
      "fields": {
        "x": {
          "type": "number",
          "doc": "Horizontal position in the overlay's own coordinates."
        },
        "connected": {
          "type": "boolean",
          "doc": "Whether the popover is anchored to a known chip."
        }
      }
    },
    "VerticalTabsMetrics": {
      "doc": "Vertical tab rail widths, from verticalTabsMetrics() in main.js.",
      "fields": {
        "verticalTabsWidth": {
          "type": "number"
        },
        "verticalTabsPreferredWidth": {
          "type": "number"
        },
        "verticalTabsMinWidth": {
          "type": "number"
        },
        "verticalTabsMaxWidth": {
          "type": "number"
        },
        "verticalTabsDefaultWidth": {
          "type": "number"
        }
      }
    },
    "GlanceLayout": {
      "doc": "Glance split geometry, from calculateGlanceLayout() in glance-layout.js.",
      "fields": {
        "direction": {
          "type": "'horizontal' | 'vertical'"
        },
        "ratio": {
          "type": "number"
        },
        "page": {
          "type": "Rect"
        },
        "primary": {
          "type": "Rect"
        },
        "divider": {
          "type": "Rect"
        },
        "glanceHeader": {
          "type": "Rect"
        },
        "glanceContent": {
          "type": "Rect"
        },
        "glance": {
          "type": "Rect",
          "doc": "Alias of glanceContent kept for older consumers."
        }
      }
    },
    "WorkspaceSaveStatus": {
      "ts": "'saved' | 'pending' | 'read-failed' | 'future-format' | 'repair-failed' | 'storage-failed'",
      "doc": "Named Workspaces storage status, from workspaces.js."
    },
    "DeletedWorkspace": {
      "doc": "A recently deleted workspace that can still be restored.",
      "fields": {
        "id": {
          "type": "WorkspaceId"
        },
        "name": {
          "type": "string"
        },
        "deletedAt": {
          "type": "number",
          "doc": "Milliseconds since the epoch."
        }
      }
    },
    "WorkspaceListItem": {
      "doc": "A Named Workspace row.",
      "fields": {
        "id": {
          "type": "WorkspaceId"
        },
        "name": {
          "type": "string"
        },
        "active": {
          "type": "boolean",
          "doc": "Bound to this window."
        },
        "openElsewhere": {
          "type": "boolean",
          "doc": "Open in another window."
        },
        "resident": {
          "type": "boolean"
        },
        "revision": {
          "type": "number"
        },
        "tabCount": {
          "type": "number"
        }
      }
    },
    "WorkspacesPayload": {
      "doc": "Named Workspaces projection, from workspacesProjection() in main.js.",
      "fields": {
        "patronActive": {
          "type": "boolean"
        },
        "status": {
          "type": "WorkspaceSaveStatus"
        },
        "deleted": {
          "type": "DeletedWorkspace[]"
        },
        "items": {
          "type": "WorkspaceListItem[]"
        }
      }
    },
    "ThemeAppearance": {
      "ts": "'light' | 'dark' | 'pending'",
      "doc": "The chrome's effective appearance; pending while a system theme is still resolving."
    },
    "PageTint": {
      "doc": "A tab's sampled page color, sent as a color-only update.",
      "fields": {
        "id": {
          "type": "TabId"
        },
        "color": {
          "type": "string"
        }
      }
    },
    "DownloadsActivity": {
      "doc": "Download activity for the strip, from downloadsActivity() in downloads.js.",
      "fields": {
        "active": {
          "type": "number",
          "doc": "Downloads in flight."
        },
        "hasRecent": {
          "type": "boolean",
          "doc": "A finished download is unacknowledged."
        },
        "receivedBytes": {
          "type": "number"
        },
        "totalBytes": {
          "type": "number"
        },
        "lastCompletedAt": {
          "type": "number | null",
          "doc": "Milliseconds since the epoch."
        }
      }
    },
    "OverlayMode": {
      "ts": "'panel' | 'palette' | 'find' | 'shield' | 'capture' | 'glance' | 'display-share'",
      "doc": "Overlay modes; every showOverlay() call in main.js passes one of these literals."
    },
    "ShieldTrigger": {
      "ts": "'shield' | 'insecure'",
      "doc": "Which strip control opened the shield popover."
    },
    "RestoreTrigger": {
      "ts": "'shield' | 'insecure' | 'capture' | 'glance-change'",
      "doc": "The strip control that should regain focus when the overlay closes."
    },
    "OverlayShowPayload": {
      "doc": "Sent when main shows the overlay.",
      "fields": {
        "mode": {
          "type": "OverlayMode"
        },
        "prefill": {
          "type": "string | null",
          "doc": "Initial input text."
        },
        "purpose": {
          "type": "unknown",
          "doc": "Mode-specific: a string for Glance, an object for panel flows, a model for screen sharing."
        },
        "pillRect": {
          "type": "Rect | null",
          "doc": "The resting pill in the overlay's coordinates; absent when replayed after the overlay loads.",
          "optional": true
        }
      }
    },
    "OverlayHidePayload": {
      "doc": "Sent when main hides the overlay.",
      "fields": {
        "retract": {
          "type": "boolean",
          "doc": "Animate the panel back into the pill."
        }
      }
    },
    "IslandState": {
      "doc": "Island presentation state for the strip.",
      "fields": {
        "mode": {
          "type": "OverlayMode | null"
        },
        "trigger": {
          "type": "ShieldTrigger | null"
        },
        "restoreTrigger": {
          "type": "RestoreTrigger | null",
          "doc": "Present only when the overlay closes.",
          "optional": true
        }
      }
    },
    "FindResult": {
      "doc": "Find-in-page counts for the active tab, sent from tab-view.js.",
      "fields": {
        "activeMatchOrdinal": {
          "type": "number"
        },
        "matches": {
          "type": "number"
        }
      }
    }
  },
  "members": [
    {
      "name": "platform",
      "group": "environment",
      "kind": "value",
      "type": "Platform",
      "source": "process.platform",
      "doc": "The host OS as Electron's sandboxed process reports it."
    },
    {
      "name": "createTab",
      "group": "tabs",
      "kind": "invoke",
      "channel": "tabs:create",
      "params": [
        {
          "name": "url",
          "type": "string",
          "optional": true
        },
        {
          "name": "opts",
          "type": "CreateTabOptions",
          "optional": true
        }
      ],
      "returns": "TabId",
      "doc": "Open a new tab. A plain new tab is always ungrouped. Resolves to the new tab id."
    },
    {
      "name": "closeTab",
      "group": "tabs",
      "kind": "invoke",
      "channel": "tabs:close",
      "params": [
        {
          "name": "id",
          "type": "TabId"
        }
      ],
      "returns": "void",
      "doc": "Close a tab and record a closed entry."
    },
    {
      "name": "reopenClosedTab",
      "group": "tabs",
      "kind": "invoke",
      "channel": "tabs:reopen-closed",
      "params": [],
      "returns": "void",
      "doc": "Reopen the most recent closed entry in this window."
    },
    {
      "name": "reopenClosedEntry",
      "group": "tabs",
      "kind": "invoke",
      "channel": "tabs:reopen-entry",
      "params": [
        {
          "name": "entryId",
          "type": "ClosedEntryId"
        }
      ],
      "returns": "void",
      "doc": "Reopen a specific closed entry."
    },
    {
      "name": "forgetClosedEntry",
      "group": "tabs",
      "kind": "invoke",
      "channel": "tabs:forget-closed-entry",
      "params": [
        {
          "name": "entryId",
          "type": "ClosedEntryId"
        }
      ],
      "returns": "boolean",
      "doc": "Forget one closed entry and destroy any parked view."
    },
    {
      "name": "clearClosedEntries",
      "group": "tabs",
      "kind": "invoke",
      "channel": "tabs:clear-closed",
      "params": [],
      "returns": "boolean",
      "doc": "Forget every closed entry in this window."
    },
    {
      "name": "switchTab",
      "group": "tabs",
      "kind": "invoke",
      "channel": "tabs:switch",
      "params": [
        {
          "name": "id",
          "type": "TabId"
        }
      ],
      "returns": "void",
      "doc": "Activate a tab."
    },
    {
      "name": "navigate",
      "group": "navigation",
      "kind": "invoke",
      "channel": "tabs:navigate",
      "params": [
        {
          "name": "id",
          "type": "TabId"
        },
        {
          "name": "url",
          "type": "string"
        }
      ],
      "returns": "unknown",
      "doc": "Navigate a tab to typed input; main normalizes it."
    },
    {
      "name": "search",
      "group": "navigation",
      "kind": "invoke",
      "channel": "tabs:search",
      "params": [
        {
          "name": "id",
          "type": "TabId"
        },
        {
          "name": "query",
          "type": "string"
        },
        {
          "name": "engine",
          "type": "string",
          "optional": true,
          "doc": "Ignored by main; the engine comes from Settings."
        }
      ],
      "returns": "unknown",
      "doc": "Search for a query in a tab."
    },
    {
      "name": "goBack",
      "group": "navigation",
      "kind": "invoke",
      "channel": "tabs:back",
      "params": [
        {
          "name": "id",
          "type": "TabId"
        }
      ],
      "returns": "unknown",
      "doc": "Go back in a tab."
    },
    {
      "name": "goForward",
      "group": "navigation",
      "kind": "invoke",
      "channel": "tabs:forward",
      "params": [
        {
          "name": "id",
          "type": "TabId"
        }
      ],
      "returns": "unknown",
      "doc": "Go forward in a tab."
    },
    {
      "name": "reload",
      "group": "navigation",
      "kind": "invoke",
      "channel": "tabs:reload",
      "params": [
        {
          "name": "id",
          "type": "TabId"
        }
      ],
      "returns": "unknown",
      "doc": "Reload a tab."
    },
    {
      "name": "stop",
      "group": "navigation",
      "kind": "invoke",
