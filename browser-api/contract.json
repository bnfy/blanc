{
  "$comment": "Source of truth for window.browserAPI. Edit HERE, then run npm run browser-api:build. See browser-api/README.md.",
  "version": 1,
  "surfaces": [
    "blanc-chrome://index/",
    "blanc-chrome://overlay/",
    "blanc-chrome://permission/"
  ],
  "types": {
    "Platform": {
      "ts": "'darwin' | 'win32' | 'linux'",
      "doc": "Supported desktop platforms."
    },
    "TabId": {
      "ts": "string",
      "doc": "Opaque tab id minted by main (a UUID today)."
    },
    "GroupId": {
      "ts": "string",
      "doc": "Opaque tab group id minted by main."
    },
    "WorkspaceId": {
      "ts": "string",
      "doc": "Opaque Named Workspace id."
    },
    "ClosedEntryId": {
      "ts": "string",
      "doc": "Opaque closed-entry id."
    },
    "PermissionPromptId": {
      "ts": "unknown",
      "doc": "Id of a pending permission prompt. Shape not yet pinned."
    },
    "CaptureSurfaceId": {
      "ts": "unknown",
      "doc": "Id of a capturing surface. Shape not yet pinned."
    },
    "DisplayShareId": {
      "ts": "unknown",
      "doc": "Id of an active screen share. Shape not yet pinned."
    },
    "TabLayout": {
      "ts": "'island' | 'vertical'",
      "doc": "Tab presentation; main ignores other values."
    },
    "ThemePreference": {
      "ts": "'system' | 'light' | 'dark'",
      "doc": "Appearance preference."
    },
    "WorkspaceMoveDirection": {
      "ts": "'up' | 'down'",
      "doc": "Direction for reordering a workspace."
    },
    "CreateTabOptions": {
      "ts": "{ private?: boolean }",
      "doc": "Options for a new tab. Only `private` is read by main today."
    },
    "OpenWorkspaceOptions": {
      "ts": "{ force?: boolean }",
      "doc": "`force` skips the scratch guard after a confirmed \"discard and switch\"."
    },
    "Point": {
      "ts": "{ x: number; y: number }",
      "doc": "A point in window coordinates."
    },
    "Rect": {
      "ts": "{ x: number; y: number; width: number; height: number }",
      "doc": "A rectangle in window coordinates."
    },
    "Anchor": {
      "ts": "unknown",
      "doc": "Popover anchor geometry. Shape not yet pinned."
    },
    "TabsSnapshot": {
      "ts": "{ tabs: unknown[]; activeTabId: TabId | null; glanceTabId: TabId | null; [key: string]: unknown }",
      "doc": "Result of getAllTabs. Tab entries not yet pinned."
    },
    "TabsUpdatedPayload": {
      "ts": "{ tabs: unknown[]; activeTabId: TabId | null; glanceTabId: TabId | null; groups: unknown[]; closed: unknown[]; tabLayout: TabLayout; adblockEnabled: boolean; [key: string]: unknown }",
      "doc": "The tabs:updated projection built by currentTabsPayload() in main. Tab, group and closed-entry shapes not yet pinned."
    },
    "PermissionPromptPayload": {
      "ts": "unknown",
      "doc": "A pending permission prompt. Shape not yet pinned."
    }
  },
  "members": [
    {
