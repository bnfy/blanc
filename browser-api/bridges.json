  "blancFillStatus": {
    "preload": "src/main/fill-status-preload.js",
    "global": "blancFillStatus",
    "document": "blanc-chrome://fill-status/",
    "types": {
      "FillKind": {
        "ts": "'setup-enable' | 'setup-account' | 'confirm-heuristic' | 'busy' | 'unsupported-page' | 'page-changed' | 'no-form' | 'no-match' | 'empty-login' | 'nothing-filled' | 'unexpected' | 'desktop-unavailable' | 'account-not-found' | 'not-authorized' | 'session-expired' | 'timed-out' | 'broker-stopped' | 'sdk-error' | 'selection-changed' | 'filled'",
        "doc": "A fixed capsule message kind, keyed in FILL_KINDS (src/main/fill-status-kinds.js)."
      },
      "FillMode": {
        "ts": "'decision' | 'notice'",
        "doc": "Capsule mode (MODES in fill-status-kinds.js)."
      },
      "FillVerb": {
        "ts": "'open-settings' | 'cancel' | 'fill' | 'dismiss'",
        "doc": "A capsule button verb: every verb some FILL_KINDS entry allows."
      },
      "FillShowPayload": {
        "doc": "Show the capsule. Credential-free: fixed ids only.",
        "fields": {
          "kind": {
            "type": "FillKind"
          },
          "mode": {
            "type": "FillMode"
          },
          "requestId": {
            "type": "number",
            "doc": "Per-process counter; replies must echo it."
          }
        }
      },
      "FillHidePayload": {
        "doc": "Hide the capsule for a request.",
        "fields": {
          "requestId": {
            "type": "number"
          }
        }
      },
      "FillReplyPayload": {
        "doc": "The user picked a verb. main checks the requestId echo and the kind's verb set.",
        "fields": {
          "requestId": {
            "type": "number"
          },
          "verb": {
            "type": "FillVerb"
          }
        }
      }
    },
    "members": [
      {
        "name": "onShow",
        "kind": "event",
        "channel": "fill:show",
        "payload": "FillShowPayload",
        "unsubscribe": false,
        "doc": "Show the capsule with a fixed message kind."
      },
      {
        "name": "onHide",
        "kind": "event",
        "channel": "fill:hide",
        "payload": "FillHidePayload",
        "unsubscribe": false,
        "doc": "Hide the capsule."
      },
      {
        "name": "reply",
        "kind": "send",
        "channel": "fill:reply",
        "params": [
          {
            "name": "payload",
            "type": "FillReplyPayload"
          }
        ],
        "doc": "Answer the capsule. Accepted only from this window's capsule view."
      }
    ]
  }
}
