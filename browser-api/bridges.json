          "tab-handoff",
          "bookmarks",
          "history",
          "downloads",
          "shortcuts",
          "tab-import",
          "settings"
        ],
        "params": [
          {
            "name": "armed",
            "type": "boolean"
          }
        ],
        "returns": "unknown",
        "doc": "Tell main that the next Escape belongs to an in-page consumer (an open picker) before the sheet dismisses.",
