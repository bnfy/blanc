+TEST_F(DownloadManagerShutdownTest, ObserveIfRunningTracksShutdownAtomically) {
+  MockDownloadManagerObserver accepted;
+  MockDownloadManagerObserver second;
+  MockDownloadManagerObserver late;
+  EXPECT_FALSE(download_manager_->AddObserverIfRunning(nullptr));
+  EXPECT_TRUE(download_manager_->AddObserverIfRunning(&accepted));
+  EXPECT_FALSE(download_manager_->AddObserverIfRunning(&accepted));
+  EXPECT_TRUE(download_manager_->AddObserverIfRunning(&second));
+  base::test::TestFuture<bool> off_sequence;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce([](DownloadManager* manager, DownloadManager::Observer* observer) {
+        return manager->AddObserverIfRunning(observer);
+      }, base::Unretained(download_manager_.get()), base::Unretained(&late)),
+      off_sequence.GetCallback());
+  EXPECT_FALSE(off_sequence.Get());
+  EXPECT_CALL(GetMockObserver(), ManagerGoingDown(download_manager_.get()));
+  EXPECT_CALL(accepted, ManagerGoingDown(download_manager_.get()))
+      .WillOnce([&](DownloadManager*) {
+        download_manager_->RemoveObserver(&accepted);
+        EXPECT_FALSE(download_manager_->AddObserverIfRunning(&late));
+      });
+  EXPECT_CALL(second, ManagerGoingDown(download_manager_.get()));
+  EXPECT_CALL(late, ManagerGoingDown(_)).Times(0);
+  download_manager_->Shutdown();
+  EXPECT_FALSE(download_manager_->AddObserverIfRunning(&late));
+}
