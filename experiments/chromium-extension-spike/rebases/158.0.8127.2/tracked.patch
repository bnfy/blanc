+  if (!host_->GetWidget()) return false;
+  auto* root = host_->GetWidget()->GetRootView();
+  gfx::Point in_root = point;
+  View::ConvertPointToTarget(host_, root, &in_root);
+  return root->GetEventHandlerForPoint(in_root) == host_;
