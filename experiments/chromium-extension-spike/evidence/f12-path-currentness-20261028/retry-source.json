    "relevantLines": [
      {
        "line": 5,
        "text": "// Explainer: https://github.com/explainers-by-googlers/fetch-retry."
      },
      {
        "line": 9,
        "text": "dictionary RetryOptions {"
      },
      {
        "line": 10,
        "text": "  // Required: Maximum number of retry attempts after the initial one fails."
      },
      {
        "line": 14,
        "text": "  // Optional: Delay before the first retry attempt in milliseconds."
      },
      {
        "line": 22,
        "text": "  // Maximum total time allowed for all retry attempts in milliseconds, measure"
      },
      {
        "line": 31,
        "text": "  boolean retryAfterUnload = false;"
      },
      {
        "line": 33,
        "text": "  // Optional: Specifies whether to retry when the HTTP request method is"
      },
      {
        "line": 35,
        "text": "  // request method of the fetch is non-idempotent, no retry will be attempted."
      },
      {
        "line": 37,
        "text": "  boolean retryNonIdempotent = false;"
      },
      {
        "line": 39,
        "text": "  // Optional: Specifies whether to retry when the network request is guaranteed"
      },
      {
        "line": 41,
        "text": "  boolean retryOnlyIfServerUnreached = false;"
      }
    ]
  }
