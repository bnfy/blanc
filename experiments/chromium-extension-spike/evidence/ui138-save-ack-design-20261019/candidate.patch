diff --git a/private/tmp/blanc-save-ack-plan/before/components/sessions/core/command_storage_manager.cc b/private/tmp/blanc-save-ack-plan/after/components/sessions/core/command_storage_manager.cc
index ecc8ce78..d74b25b9 100644
--- a/private/tmp/blanc-save-ack-plan/before/components/sessions/core/command_storage_manager.cc
+++ b/private/tmp/blanc-save-ack-plan/after/components/sessions/core/command_storage_manager.cc
@@ -435,0 +436,24 @@ void CommandStorageManager::Save() {
+void CommandStorageManager::SaveAndFlush(base::OnceCallback<void(bool)> callback) {
+  Save();
+  FlushSavedCommands(std::move(callback));
+}
+
+void CommandStorageManager::FlushSavedCommands(
+    base::OnceCallback<void(bool)> callback) {
+  const auto stage = GetEncryptSessionStorageStage();
+  const bool encrypted =
+      stage == EncryptSessionStorageStage::kWriteBothReadPreferEncrypted ||
+      stage == EncryptSessionStorageStage::kWriteEncryptedReadPreferEncrypted;
+  if (encrypted && !encrypted_backend_) {
+    pending_encrypted_ops_.push_back(base::BindOnce(
+        &CommandStorageManager::FlushSavedCommands, weak_factory_.GetWeakPtr(),
+        std::move(callback)));
+    return;
+  }
+  auto backend = encrypted ? encrypted_backend_ : backend_;
+  backend_task_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&CommandStorageBackend::FlushCurrentSession, backend),
+      std::move(callback));
+}
+
