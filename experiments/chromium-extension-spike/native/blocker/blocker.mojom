// Blanc experimental utility service. Engine code/data are authenticated by the
// browser before transfer. No network or filesystem interface is exposed.
module blanc.mojom;
import "sandbox/policy/mojom/sandbox.mojom";
[ServiceSandbox=sandbox.mojom.Sandbox.kService]
interface Blocker {
  Initialize(string script) => (bool ready);
  Decide(string url, string resource_type, string referrer) => (int32 decision);
  Cosmetics(string input) => (bool ready, string output);
};
// Explicit prototype switch only; the browser binds this to the current document.
interface DocumentStart {
  [Sync] GetScript(string url) => (bool ready, string code, string token);
  [Sync] Complete(string token) => (bool accepted);
};

// Bound by the browser to the requesting document. The renderer supplies only
// bounded DOM hints; URL and ancestor authority remain in the browser.
interface Cosmetics {
  [Sync] Get(bool initial, string hints) => (bool ready, string output);
};
