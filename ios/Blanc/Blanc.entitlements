<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Blanc for iPhone's entitlements. Apple granted the default-browser entitlement
  for me.bnfy.blanc on 2026-11-04. It is a managed entitlement, so signing fails
  unless Default Web Browser stays on for the App ID in the developer portal.
  See docs/ios/app-store-connect.md.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.web-browser</key>
	<true/>
</dict>
</plist>
