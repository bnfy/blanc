{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "comment": "iOS camera permission prompt (NSCameraUsageDescription). Generated into ios/Blanc/Blanc/InfoPlist.xcstrings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc uses the camera only to scan the pairing code on your computer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc verwendet die Kamera nur, um den Kopplungscode auf deinem Computer zu scannen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc usa la cámara solo para escanear el código de vinculación de tu ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc utilise l’appareil photo uniquement pour scanner le code de jumelage sur votre ordinateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc usa la fotocamera solo per scansionare il codice di abbinamento sul computer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Blanc usa a câmera só para escanear o código de pareamento do seu computador."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "iOS permission prompt for saving to Photos (NSPhotoLibraryAddUsageDescription), shown the first time someone saves an image from a page. Add-only: Blanc never reads the library. Generated into ios/Blanc/Blanc/InfoPlist.xcstrings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc saves images to your photo library only when you ask it to."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc speichert Bilder nur dann in deiner Fotomediathek, wenn du es möchtest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc guarda imágenes en tu fototeca solo cuando se lo pides."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc enregistre des images dans votre photothèque uniquement lorsque vous le demandez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc salva le immagini nella tua libreria foto solo quando glielo chiedi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Blanc salva imagens na sua fototeca só quando você pedir."
          }
        }
      }
    }
  },
  "version": "1.0"
}
