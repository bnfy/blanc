    "linuxSandbox.refusal": {
      "comment": "Linux dialog when Blanc is launched with sandboxing disabled. Shown before Blanc can read the interface language, so it is always English.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc refused to start because Chromium sandboxing was disabled. Use a Linux environment that permits Chromium sandboxing and launch Blanc without sandbox-disabling options."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc wurde nicht gestartet, weil die Chromium-Sandbox deaktiviert war. Nutze eine Linux-Umgebung, die die Chromium-Sandbox erlaubt, und starte Blanc ohne Optionen, die die Sandbox deaktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc no se inició porque el aislamiento de Chromium estaba desactivado. Usa un entorno Linux que permita el aislamiento de Chromium e inicia Blanc sin opciones que lo desactiven."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc a refusé de démarrer car le bac à sable de Chromium était désactivé. Utilisez un environnement Linux qui autorise le bac à sable de Chromium et lancez Blanc sans option qui le désactive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc si è rifiutato di avviarsi perché il sandboxing di Chromium era disattivato. Usa un ambiente Linux che consenta il sandboxing di Chromium e avvia Blanc senza opzioni che lo disattivano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Blanc não iniciou porque o sandbox do Chromium estava desativado. Use um ambiente Linux que permita o sandbox do Chromium e inicie o Blanc sem opções que o desativem."
          }
        }
      }
    },
    "linuxSandbox.guidance": {
      "comment": "Terminal output when Blanc refuses a Linux launch with sandboxing disabled; {refusal} is linuxSandbox.refusal and {url} the setup guide’s address (always English).",
