    "linuxSandbox.detailCopy": {
      "comment": "Linux dialog detail when the guide cannot open (always English).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nBlanc can’t open the setup guide itself while it can’t start. Copy the link and open it in another browser.\n\n%2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nBlanc kann die Einrichtungsanleitung nicht selbst öffnen, solange es nicht starten kann. Kopiere den Link und öffne ihn in einem anderen Browser.\n\n%2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nBlanc no puede abrir la guía de configuración mientras no pueda iniciarse. Copia el enlace y ábrelo en otro navegador.\n\n%2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nBlanc ne peut pas ouvrir lui-même le guide de configuration tant qu’il ne peut pas démarrer. Copiez le lien et ouvrez-le dans un autre navigateur.\n\n%2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nBlanc non può aprire da solo la guida alla configurazione finché non riesce ad avviarsi. Copia il link e aprilo in un altro browser.\n\n%2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nO Blanc não consegue abrir o guia de configuração enquanto não puder iniciar. Copie o link e abra-o em outro navegador.\n\n%2$@"
          }
        }
      }
    },
    "linuxSandbox.detailOpenElsewhere": {
      "comment": "Linux dialog detail when the guide cannot open and the link cannot be copied (always English).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nBlanc can’t open the setup guide itself while it can’t start. Open this address in another browser.\n\n%2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nBlanc kann die Einrichtungsanleitung nicht selbst öffnen, solange es nicht starten kann. Öffne diese Adresse in einem anderen Browser.\n\n%2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nBlanc no puede abrir la guía de configuración mientras no pueda iniciarse. Abre esta dirección en otro navegador.\n\n%2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nBlanc ne peut pas ouvrir lui-même le guide de configuration tant qu’il ne peut pas démarrer. Ouvrez cette adresse dans un autre navigateur.\n\n%2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nBlanc non può aprire da solo la guida alla configurazione finché non riesce ad avviarsi. Apri questo indirizzo in un altro browser.\n\n%2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nO Blanc não consegue abrir o guia de configuração enquanto não puder iniciar. Abra este endereço em outro navegador.\n\n%2$@"
          }
        }
      }
    },
