    },
    "settings.sync.setup.intro": {
      "comment": "Settings → Sync setup: introduction before a path is chosen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync your favorites and settings across your devices, and, if you choose, open tabs. Everything is end-to-end encrypted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisiere deine Favoriten und Einstellungen und auf Wunsch auch offene Tabs zwischen deinen Geräten. Alles ist Ende-zu-Ende-verschlüsselt."
          }
        }
      }
    },
    "settings.sync.setup.joinTitle": {
      "comment": "Settings → Sync setup: heading when joining a sync from another device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect this device"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät verbinden"
          }
        }
      }
    },
    "settings.sync.setup.joinIntro": {
      "comment": "Settings → Sync setup: introduction when joining a sync from another device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the same sync name and passphrase as your other device. Blanc checks them before saving anything here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende denselben Synchronisierungsnamen und dieselbe Passphrase wie auf deinem anderen Gerät. Blanc prüft sie, bevor hier etwas gespeichert wird."
          }
        }
      }
    },
    "settings.sync.setup.handleHint": {
      "comment": "Settings → Sync setup: hint under the sync name field when starting a new sync.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A label for your sync, like a username. You’ll type it again on your other devices."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Bezeichnung für deine Synchronisierung, ähnlich einem Benutzernamen. Du gibst sie auf deinen anderen Geräten erneut ein."
          }
        }
      }
    },
    "settings.sync.setup.joinHandleHint": {
      "comment": "Settings → Sync setup: hint under the sync name field when joining.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the exact sync name you used on your other device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib genau den Synchronisierungsnamen ein, den du auf deinem anderen Gerät verwendet hast."
          }
        }
      }
    },
    "settings.sync.setup.passphraseHint": {
      "comment": "Settings → Sync setup: hint under the passphrase field when starting a new sync.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "16+ characters, or 10+ mixing letters, numbers and symbols. Blanc can’t recover it if you forget it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens 16 Zeichen oder mindestens 10 mit Buchstaben, Zahlen und Symbolen gemischt. Blanc kann sie nicht wiederherstellen, wenn du sie vergisst."
          }
        }
      }
    },
    "settings.sync.setup.joinPassphraseHint": {
      "comment": "Settings → Sync setup: hint under the passphrase field when joining.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the exact passphrase. Case matters."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die Passphrase genau ein. Groß- und Kleinschreibung zählt."
          }
        }
      }
    },
