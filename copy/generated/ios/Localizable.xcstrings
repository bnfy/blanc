    "settings.privacy.resetInstallId.failed": {
      "comment": "Settings → Privacy → Usage and data: error after Reset install ID.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save the reset — check disk space and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zurücksetzen konnte nicht gespeichert werden – prüfe den freien Speicherplatz und versuch es noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el restablecimiento: comprueba el espacio en disco e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer la réinitialisation — vérifiez l’espace disque et réessayez."
          }
        },
        "it": {
