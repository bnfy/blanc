    "settings.general.tabLayout.hint": {
      "comment": "Settings → General: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep tabs in the Island or show them in a left rail; search and commands always stay in the Island"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs in der Island behalten oder in einer linken Leiste zeigen; Suche und Befehle bleiben immer in der Island"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén las pestañas en la Island o muéstralas en una barra a la izquierda; la búsqueda y los comandos siempre siguen en la Island"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez les onglets dans l’Island ou affichez-les dans une barre à gauche ; la recherche et les commandes restent toujours dans l’Island"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni le schede nell’Island o mostrale in una barra a sinistra; ricerca e comandi restano sempre nell’Island"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha as abas na Island ou mostre-as numa barra à esquerda; a busca e os comandos sempre ficam na Island"
          }
        }
      }
    },
