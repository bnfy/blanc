    "settings.profiles.deleteWarning": {
      "comment": "Settings → Profiles: warning above the field that confirms deletion; {name} is the profile’s name, which must be typed exactly.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes this profile’s local browser data. Downloaded files stay where you saved them. Type “%1$@” to continue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht die lokalen Browserdaten dieses Profils endgültig. Heruntergeladene Dateien bleiben, wo du sie gespeichert hast. Gib „%1$@“ ein, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina para siempre los datos locales del navegador de este perfil. Los archivos descargados se quedan donde los guardaste. Escribe «%1$@» para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement les données de navigation locales de ce profil. Les fichiers téléchargés restent là où vous les avez enregistrés. Saisissez « %1$@ » pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina definitivamente i dati locali del browser di questo profilo. I file scaricati restano dove li hai salvati. Digita «%1$@» per continuare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui permanentemente os dados locais do navegador deste perfil. Os arquivos baixados ficam onde você os salvou. Digite “%1$@” para continuar."
          }
        }
      }
    },
