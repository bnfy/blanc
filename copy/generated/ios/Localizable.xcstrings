    "settings.onePassword.notFoundMac": {
      "comment": "Settings → Privacy → 1Password: hint on a Mac when the app is not in the Applications folder. “Verify” is the button below.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc couldn’t find the 1Password app in Applications — if it’s installed elsewhere, Verify below still works."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc hat die 1Password-App nicht im Ordner „Programme“ gefunden – wenn sie woanders installiert ist, funktioniert „Prüfen“ unten trotzdem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc no encontró la app de 1Password en Aplicaciones; si está instalada en otro lugar, el botón Verificar de abajo sigue funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc n’a pas trouvé l’app 1Password dans Applications — si elle est installée ailleurs, Vérifier ci-dessous fonctionne quand même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc non ha trovato l’app 1Password in Applicazioni; se è installata altrove, il pulsante Verifica qui sotto funziona comunque."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Blanc não encontrou o app do 1Password em Aplicativos — se ele estiver instalado em outro lugar, o Verificar abaixo ainda funciona."
          }
        }
      }
    },
