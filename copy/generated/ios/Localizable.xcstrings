    "settings.help.somethingBrokenOrWorking": {
      "comment": "Settings → Help: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something broken, or working in a way it shouldn’t? Reports go to Blanc’s public issue tracker on GitHub. Saying which version you’re on, which operating system, and what page you were looking at makes a report much faster to act on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert etwas nicht oder anders, als es sollte? Meldungen gehen an Blancs öffentlichen Issue-Tracker auf GitHub. Wenn du angibst, welche Version und welches Betriebssystem du nutzt und welche Seite du angesehen hast, lässt sich eine Meldung viel schneller bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Algo no funciona o hace lo que no debería? Los informes van al gestor público de incidencias de Blanc en GitHub. Indicar tu versión, tu sistema operativo y la página que estabas viendo hace que un informe se resuelva mucho antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose ne marche pas, ou pas comme prévu ? Les signalements vont dans le suivi public des problèmes de Blanc sur GitHub. Indiquer votre version, votre système d’exploitation et la page consultée permet de traiter un signalement bien plus vite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa non funziona, o funziona in modo sbagliato? Le segnalazioni vanno al tracker pubblico dei problemi di Blanc su GitHub. Indicare la versione, il sistema operativo e la pagina che stavi guardando rende una segnalazione molto più rapida da gestire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo quebrado ou funcionando de um jeito que não deveria? Os relatos vão para o rastreador público de problemas do Blanc no GitHub. Informar sua versão, seu sistema operacional e a página que você estava vendo faz um relato ser resolvido muito mais rápido."
          }
        }
      }
    },
    "settings.help.reportAnIssue": {
