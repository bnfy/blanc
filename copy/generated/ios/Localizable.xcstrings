          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Strict — plus sûr avec un proxy, mais peut bloquer certains appels vidéo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rigoroso — più protezione con un proxy, ma può bloccare alcune videochiamate"
          }
        },
        "pt-BR": {
