    "ws.editor.help": {
      "comment": "Help text under the space name field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordinary tabs save automatically on this device, in this profile. Private pages are excluded. Spaces share this profile’s sign-ins."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normale Tabs werden auf diesem Gerät in diesem Profil automatisch gespeichert. Private Seiten sind ausgenommen. Spaces teilen die Anmeldungen dieses Profils."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas normales se guardan automáticamente en este dispositivo, en este perfil. Las páginas privadas no se incluyen. Los Spaces comparten las sesiones iniciadas de este perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets ordinaires sont enregistrés automatiquement sur cet appareil, dans ce profil. Les pages privées sont exclues. Les Spaces partagent les connexions de ce profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le schede normali vengono salvate automaticamente su questo dispositivo, in questo profilo. Le pagine private sono escluse. Gli Spaces condividono gli accessi di questo profilo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As abas comuns são salvas automaticamente neste dispositivo, neste perfil. Páginas privadas ficam de fora. Os Spaces compartilham os logins deste perfil."
          }
        }
      }
    },
    "ws.editor.saving": {
      "comment": "The save button’s text while the space is being saved.",
