            "state": "translated",
            "value": "Cette adresse n’est pas valide — le fournisseur précédent reste utilisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo indirizzo non è valido: resta in uso il provider precedente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse endereço não é válido — o provedor anterior continua em uso."
          }
        }
      }
    },
