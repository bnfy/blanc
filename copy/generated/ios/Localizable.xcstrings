    "settings.privacy.ublockLimits": {
      "comment": "Settings → Privacy & Security → Blocking: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter lists update automatically. Executable resources update with Blanc releases; custom resource URLs and cloud storage are unavailable. Turning blocking off removes cosmetic CSS; reload a page to undo changes already made by scriptlets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Filterlisten werden automatisch aktualisiert. Ausführbare Ressourcen werden mit Blanc-Releases aktualisiert; eigene Ressourcen-URLs und Cloud-Speicher sind nicht verfügbar. Das Ausschalten des Blockers entfernt kosmetisches CSS; lade eine Seite neu, um bereits von Scriptlets vorgenommene Änderungen rückgängig zu machen."
          }
        }
      }
    },
    "settings.privacy.adblockEnabled.label": {
      "comment": "Settings → Privacy & Security → Blocking: setting name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block ads & trackers"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werbung & Tracker blockieren"
          }
        }
      }
    },
    "settings.privacy.adblockEnabled.hint": {
      "comment": "Settings → Privacy & Security → Blocking: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops ads and the hidden trackers that follow you from site to site. On by default."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppt Werbung und die versteckten Tracker, die dir von Website zu Website folgen. Standardmäßig an."
          }
        }
      }
    },
    "settings.privacy.sitesListedHereLoad": {
      "comment": "Settings → Privacy & Security → Blocking: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sites listed here load with ad-blocking turned off, e.g. for sites that break under it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier aufgeführte Websites laden ohne Werbeblocker, z. B. für Websites, die damit nicht funktionieren."
          }
        }
      }
    },
    "settings.privacy.exceptionAdd": {
      "comment": "Settings → Privacy & Security → Blocking: button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzufügen"
          }
        }
      }
    },
    "settings.privacy.callsAndConnections.title": {
      "comment": "Settings → Privacy & Security → Calls and connections: card heading.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calls and connections"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anrufe und Verbindungen"
          }
        }
      }
    },
    "settings.privacy.webrtcPolicy.label": {
      "comment": "Settings → Privacy & Security → Calls and connections: setting name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IP address in video calls"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "IP-Adresse in Videoanrufen"
          }
        }
      }
    },
    "settings.privacy.webrtcPolicy.hint": {
      "comment": "Settings → Privacy & Security → Calls and connections: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard limits calls to your default network route. If a call stutters or won't connect, try Compatibility; it can reveal local network addresses to the site. Strict is for application-proxy users."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard beschränkt Anrufe auf deine Standard-Netzwerkroute. Wenn ein Anruf ruckelt oder keine Verbindung zustande kommt, versuche Kompatibilität; dabei kann die Website lokale Netzwerkadressen sehen. Streng ist für Nutzer von Anwendungs-Proxys."
          }
        }
      }
    },
    "settings.privacy.webrtcPolicy.standard": {
      "comment": "Settings → Privacy & Security → Calls and connections: choice in a dropdown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard (recommended)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard (empfohlen)"
          }
        }
      }
    },
    "settings.privacy.webrtcPolicy.compatibility": {
      "comment": "Settings → Privacy & Security → Calls and connections: choice in a dropdown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatibility — widest call support, less IP privacy"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompatibilität – beste Anrufunterstützung, weniger IP-Schutz"
          }
        }
      }
    },
    "settings.privacy.webrtcPolicy.strict": {
      "comment": "Settings → Privacy & Security → Calls and connections: choice in a dropdown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strict — stronger for proxy users, but can break some video calls"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streng – besser für Proxy-Nutzer, kann manche Videoanrufe stören"
          }
        }
      }
    },
    "settings.privacy.webrtcAudioBuffer.label": {
      "comment": "Settings → Privacy & Security → Calls and connections: setting name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call audio"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anruf-Audio"
          }
        }
      }
    },
    "settings.privacy.webrtcAudioBuffer.hint": {
      "comment": "Settings → Privacy & Security → Calls and connections: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic keeps conversation delay as low as possible. Stable targets about 400 ms of receive buffering. Resilient targets about 1 second for severe crackling or chopped speech, making back-and-forth conversation slower. Start a new call after changing it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch hält die Gesprächsverzögerung so gering wie möglich. Stabil puffert beim Empfang etwa 400 ms. Belastbar puffert etwa 1 Sekunde gegen starkes Knistern oder abgehackte Sprache, was Gespräche träger macht. Starte nach einer Änderung einen neuen Anruf."
          }
        }
      }
    },
    "settings.privacy.webrtcAudioBuffer.automatic": {
      "comment": "Settings → Privacy & Security → Calls and connections: choice in a dropdown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic (lowest latency)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch (geringste Verzögerung)"
          }
        }
      }
    },
    "settings.privacy.webrtcAudioBuffer.stable": {
      "comment": "Settings → Privacy & Security → Calls and connections: choice in a dropdown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stable — smoother playback, about 400 ms buffer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabil – flüssigere Wiedergabe, etwa 400 ms Puffer"
          }
        }
      }
    },
    "settings.privacy.webrtcAudioBuffer.resilient": {
      "comment": "Settings → Privacy & Security → Calls and connections: choice in a dropdown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resilient — high stability, about 1 second buffer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belastbar – sehr stabil, etwa 1 Sekunde Puffer"
          }
        }
      }
    },
    "settings.privacy.secureDns.label": {
      "comment": "Settings → Privacy & Security → Calls and connections: setting name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted DNS"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsseltes DNS"
          }
        }
      }
    },
    "settings.privacy.secureDns.hint": {
      "comment": "Settings → Privacy & Security → Calls and connections: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypts the behind-the-scenes lookups that turn a web address into a connection, so someone sniffing those lookups can't read the names. It does not hide the sites you visit from your network, and it makes the DNS provider someone you trust. Automatic uses encryption when it can and may fall back to ordinary DNS — safe to leave on. If a Wi-Fi login page won't load, switch to Automatic or Off temporarily."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselt die Hintergrundabfragen, die eine Webadresse in eine Verbindung übersetzen, sodass jemand, der diese Abfragen mitliest, die Namen nicht lesen kann. Es verbirgt die besuchten Websites nicht vor deinem Netzwerk und macht den DNS-Anbieter zu jemandem, dem du vertraust. Automatisch verschlüsselt, wenn möglich, und kann auf normales DNS zurückfallen – du kannst es bedenkenlos anlassen. Wenn eine WLAN-Anmeldeseite nicht lädt, wechsle vorübergehend zu Automatisch oder Aus."
          }
        }
      }
    },
    "settings.privacy.secureDns.auto": {
      "comment": "Settings → Privacy & Security → Calls and connections: choice in a dropdown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic (recommended)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch (empfohlen)"
          }
        }
      }
    },
    "settings.privacy.secureDns.off": {
      "comment": "Settings → Privacy & Security → Calls and connections: choice in a dropdown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off — use your system setting (best with a VPN)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus – Systemeinstellung verwenden (am besten mit VPN)"
          }
        }
      }
    },
    "settings.privacy.secureDns.quad9": {
