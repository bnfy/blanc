    "settings.help.youCanBrowseChrome": {
      "comment": "Settings → Help → Extensions and password managers: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can browse Chrome Web Store pages, but Blanc cannot install Chrome extensions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst Seiten des Chrome Web Store ansehen, aber Blanc kann keine Chrome-Erweiterungen installieren."
          }
        }
      }
    },
    "settings.help.onMacOSWindowsAnd": {
      "comment": "Settings → Help → Extensions and password managers: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On macOS, Windows and Linux, Blanc offers explicit login fill from the installed 1Password app. This integration does not save passwords or fill automatically."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter macOS, Windows und Linux bietet Blanc ausdrückliches Ausfüllen von Logins aus der installierten 1Password-App. Diese Integration speichert keine Passwörter und füllt nichts automatisch aus."
          }
        }
      }
    },
    "settings.help.connectionsBlancCanMake.title": {
      "comment": "Settings → Help → Connections Blanc can make: card heading.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connections Blanc can make"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindungen, die Blanc herstellen kann"
          }
        }
      }
    },
    "settings.help.blancConnectsToWebsites": {
      "comment": "Settings → Help → Connections Blanc can make: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc connects to websites you open and GitHub for app updates. Searches and enabled suggestions go to your selected search provider; DNS lookups use your system or selected DNS provider. Selecting Google sends searches and eligible suggestion prefixes to Google."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc verbindet sich mit Websites, die du öffnest, und mit GitHub für App-Updates. Suchen und aktivierte Vorschläge gehen an deinen gewählten Suchanbieter; DNS-Abfragen nutzen dein System oder den gewählten DNS-Anbieter. Wenn du Google wählst, gehen Suchen und geeignete Vorschlagsanfänge an Google."
          }
        }
      }
    },
    "settings.help.enabledUsageMeasurementGoes": {
      "comment": "Settings → Help → Connections Blanc can make: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled usage measurement goes to a Blanc-owned Cloudflare collector and, when configured, its Google Analytics mirror. Sync, Patron, 1Password and tab handoff make separate connections when configured or requested. This describes behavior; it is not a live network monitor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktivierte Nutzungsmessung geht an einen Cloudflare-Sammler von Blanc und, falls eingerichtet, an dessen Google-Analytics-Spiegel. Synchronisierung, Patron, 1Password und Tab-Übergabe stellen eigene Verbindungen her, wenn sie eingerichtet oder angefordert sind. Dies beschreibt das Verhalten; es ist keine Live-Netzwerküberwachung."
          }
        }
      }
    },
    "settings.help.dataRecipientsAndControls": {
      "comment": "Settings → Help → Connections Blanc can make: link.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data, recipients and controls ↗"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten, Empfänger und Kontrolle ↗"
          }
        }
      }
    },
    "settings.help.somethingBrokenOrWorking": {
      "comment": "Settings → Help: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something broken, or working in a way it shouldn’t? Reports go to Blanc’s public issue tracker on GitHub. Saying which version you’re on, which operating system, and what page you were looking at makes a report much faster to act on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert etwas nicht oder anders, als es sollte? Meldungen gehen an Blancs öffentlichen Issue-Tracker auf GitHub. Wenn du angibst, welche Version und welches Betriebssystem du nutzt und welche Seite du angesehen hast, lässt sich eine Meldung viel schneller bearbeiten."
          }
        }
      }
    },
    "settings.help.reportAnIssue": {
      "comment": "Settings → Help: link to the public issue tracker; <0>↗</0> is the external-link arrow, keep it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report an issue <0>↗</0>"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Problem melden <0>↗</0>"
          }
        }
      }
    },
