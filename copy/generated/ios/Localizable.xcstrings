          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse des eigenen Anbieters"
          }
        }
      }
    },
    "settings.privacy.secureDnsTemplate.hint": {
      "comment": "Settings → Privacy & Security → Calls and connections: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The secure DNS address your provider gave you (an https:// link), e.g. https://dns.nextdns.io/<profile>."
          }
        },
        "de": {
