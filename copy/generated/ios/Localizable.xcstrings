    "ws.error.duplicateName": {
      "comment": "Workspace switcher error when a workspace name is already taken.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That name is already in use. Choose another name."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Name wird schon verwendet. Wähle einen anderen Namen."
          }
        }
      }
    },
    "ws.error.invalidName": {
      "comment": "Workspace switcher error when the name field is empty.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a workspace name."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Namen für den Arbeitsbereich ein."
          }
        }
      }
    },
    "ws.error.limit": {
      "comment": "Workspace switcher error at the workspace limit; {limit} is the maximum number of workspaces (always more than one).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have %1$@ workspaces. Delete one before adding another."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %1$@ Arbeitsbereiche. Lösche einen, bevor du einen weiteren hinzufügst."
          }
        }
      }
    },
    "ws.error.notPatron": {
      "comment": "Workspace switcher error when someone without Blanc Patron tries to create a workspace.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creating workspaces needs Blanc Patron."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Anlegen von Arbeitsbereichen brauchst du Blanc Patron."
          }
        }
      }
    },
    "ws.error.notFound": {
      "comment": "Workspace switcher error when the chosen workspace was removed meanwhile.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That workspace is no longer available."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Arbeitsbereich ist nicht mehr verfügbar."
          }
        }
      }
    },
    "ws.error.readFailed": {
      "comment": "Workspace switcher error when the saved workspace file cannot be read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read your workspace file. Restart Blanc after checking that the file is accessible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Arbeitsbereich-Datei konnte nicht gelesen werden. Prüfe, ob die Datei zugänglich ist, und starte Blanc dann neu."
          }
        }
      }
    },
    "ws.error.storageFailed": {
      "comment": "Workspace switcher error when saving workspaces to disk fails.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save changes. Check available disk space and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen konnten nicht gespeichert werden. Prüfe den freien Speicherplatz und versuche es erneut."
          }
        }
      }
    },
    "ws.error.futureFormat": {
      "comment": "Workspace switcher error when the workspace file was written by a newer Blanc.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These workspaces need a newer version of Blanc. Your saved file has not been changed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Arbeitsbereiche brauchen eine neuere Version von Blanc. Deine gespeicherte Datei wurde nicht verändert."
          }
        }
      }
    },
    "ws.error.repairFailed": {
      "comment": "Workspace switcher error when Blanc cannot back up a damaged workspace file before repairing it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t preserve a recovery copy. Your workspace file has not been changed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es konnte keine Wiederherstellungskopie angelegt werden. Deine Arbeitsbereich-Datei wurde nicht verändert."
          }
        }
      }
    },
    "ws.error.busy": {
      "comment": "Workspace switcher error while another workspace action is in progress.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another workspace action is still finishing. Try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere Aktion für Arbeitsbereiche läuft noch. Versuche es erneut."
          }
        }
      }
    },
    "ws.error.activationFailed": {
      "comment": "Workspace switcher error when switching to a workspace fails.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t open the workspace. Your current pages are still available."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Arbeitsbereich konnte nicht geöffnet werden. Deine aktuellen Seiten sind weiterhin verfügbar."
          }
        }
      }
    },
    "ws.error.savedNotOpened": {
      "comment": "Workspace switcher error when a new workspace was saved but switching to it failed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workspace was saved, but Blanc couldn’t open it. It remains in your workspace list."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Arbeitsbereich wurde gespeichert, aber Blanc konnte ihn nicht öffnen. Er bleibt in deiner Liste der Arbeitsbereiche."
          }
        }
      }
    },
    "ws.error.recoveryDuplicate": {
      "comment": "Workspace switcher error when restoring a deleted workspace whose name is now taken.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An existing workspace uses this name. Rename it before restoring this workspace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein vorhandener Arbeitsbereich verwendet diesen Namen. Benenne ihn um, bevor du diesen Arbeitsbereich wiederherstellst."
          }
        }
      }
    },
    "ws.error.generic": {
      "comment": "Workspace switcher error for any other failure.",
