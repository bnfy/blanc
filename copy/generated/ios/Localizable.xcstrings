    "settings.patron.title": {
      "comment": "Settings → Blanc Patron: section heading.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc Patron"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc Patron"
          }
        }
      }
    },
    "settings.patron.blancPatronUnlocksBlanc": {
      "comment": "Settings → Blanc Patron: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc Patron unlocks Blanc Spaces on every platform. A one-time founding license activates once, with no further contact. A monthly or annual subscription checks in with Polar about once a day — your license key and activation id only, never browsing data — to confirm it’s still active. On a lapse, existing spaces stay available while creating new ones pauses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc Patron schaltet Blanc Spaces auf allen Plattformen frei. Eine einmalige Gründerlizenz wird einmal aktiviert, ohne weiteren Kontakt. Ein Monats- oder Jahresabo meldet sich etwa einmal am Tag bei Polar – nur mit Lizenzschlüssel und Aktivierungs-ID, nie mit Browserdaten –, um zu bestätigen, dass es noch aktiv ist. Läuft es aus, bleiben bestehende Spaces verfügbar, neue können aber nicht mehr erstellt werden."
          }
        }
      }
    },
    "settings.patron.patronCheckout": {
      "comment": "Settings → Blanc Patron: button that opens checkout; keep the prices and currency as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Become a Patron — $4/month or $30/year"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Patron werden – $4/Monat oder $30/Jahr"
          }
        }
      }
    },
    "settings.patron.patronActivateHint": {
      "comment": "Settings → Blanc Patron: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already a Patron? Enter the license key available under Purchases in Polar to activate this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon Patron? Gib den Lizenzschlüssel ein, den du bei Polar unter Käufe findest, um dieses Gerät zu aktivieren."
          }
        }
      }
    },
