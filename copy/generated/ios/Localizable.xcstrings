    "ws.recovery.help": {
      "comment": "Help text in Recently Deleted; {limit} is how many deleted spaces are kept (always more than one).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved spaces are recoverable for seven days. Up to %1$@ deleted spaces are kept."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Spaces lassen sich sieben Tage lang wiederherstellen. Bis zu %1$@ gelöschte Spaces werden aufbewahrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los Spaces guardados se pueden recuperar durante siete días. Se conservan hasta %1$@ Spaces eliminados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Spaces enregistrés sont récupérables pendant sept jours. Jusqu’à %1$@ Spaces supprimés sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli Spaces salvati sono recuperabili per sette giorni. Vengono conservati fino a %1$@ Spaces eliminati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaces salvos podem ser recuperados por sete dias. Até %1$@ Spaces excluídos são mantidos."
          }
        }
      }
    },
