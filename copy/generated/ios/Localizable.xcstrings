    "settings.diagnostics.blancKeepsALocal": {
      "comment": "Settings → Diagnostics: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc keeps a local, 50-event crash ledger with timestamps, process type, and failure reason. It never includes URLs, page titles, history, profile names, account data, identifiers, quiet-tab state, or closed-tab state, and nothing is sent automatically."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc führt ein lokales Absturzprotokoll mit 50 Einträgen samt Zeitstempel, Prozesstyp und Fehlergrund. Es enthält nie URLs, Seitentitel, Verlauf, Profilnamen, Kontodaten, Kennungen, den Zustand ruhender Tabs oder geschlossener Tabs, und nichts wird automatisch gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc guarda un registro local de fallos de 50 eventos con fecha y hora, tipo de proceso y motivo del fallo. Nunca incluye URL, títulos de páginas, historial, nombres de perfiles, datos de cuentas, identificadores, estado de pestañas en reposo ni de pestañas cerradas, y nada se envía automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc conserve un journal local de 50 plantages avec leur horodatage, le type de processus et la cause. Il n’inclut jamais d’URL, de titres de pages, d’historique, de noms de profils, de données de compte, d’identifiants, d’état des onglets en veille ni des onglets fermés, et rien n’est envoyé automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc conserva un registro locale degli arresti anomali di 50 eventi con data e ora, tipo di processo e motivo dell’errore. Non include mai URL, titoli delle pagine, cronologia, nomi dei profili, dati degli account, identificatori, stato delle schede in riposo o delle schede chiuse, e niente viene inviato automaticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Blanc mantém um registro local de 50 falhas com data e hora, tipo de processo e motivo da falha. Ele nunca inclui URLs, títulos de páginas, histórico, nomes de perfis, dados de contas, identificadores, estado de abas em repouso ou de abas fechadas, e nada é enviado automaticamente."
          }
        }
      }
    },
