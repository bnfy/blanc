    "onboarding.blocking.body": {
      "comment": "Onboarding dialog → step 4: explanation; /off-leash is a command.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocks known ads and trackers using bundled rules. It cannot stop every tracker. Turn it off per-site with /off-leash."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blockiert bekannte Werbung und Tracker mit mitgelieferten Regeln. Nicht jeder Tracker lässt sich stoppen. Schalte es pro Website mit /off-leash aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea anuncios y rastreadores conocidos con reglas incluidas. No puede detener todos los rastreadores. Desactívalo en un sitio con /off-leash."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloque les publicités et traceurs connus grâce à des règles intégrées. Il ne peut pas arrêter tous les traceurs. Désactivez-le site par site avec /off-leash."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca gli annunci e i tracker noti usando regole integrate. Non può fermare tutti i tracker. Disattivalo sito per sito con /off-leash."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia anúncios e rastreadores conhecidos com regras incluídas. Não consegue impedir todos os rastreadores. Desative por site com /off-leash."
          }
        }
      }
    },
