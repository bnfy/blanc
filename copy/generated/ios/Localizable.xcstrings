    "arcImport.mode.spaces": {
      "comment": "Shown to Blanc Patrons. Blanc Spaces is the Patron feature; a space is one saved set.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each Arc Space becomes a space in Blanc Spaces. Folders become groups, and tabs load only when you open them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Space aus Arc wird zu einem Space in Blanc Spaces. Ordner werden zu Gruppen, und Tabs laden erst, wenn du sie öffnest."
          }
        }
      }
    },
    "arcImport.mode.windows": {
      "comment": "Shown when Blanc Patron is not active.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each Arc Space opens in its own window. Folders become groups, and tabs load only when you open them. With Blanc Patron, you can save them as spaces."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Space aus Arc öffnet sich in einem eigenen Fenster. Ordner werden zu Gruppen, und Tabs laden erst, wenn du sie öffnest. Mit Blanc Patron kannst du sie als Spaces speichern."
          }
        }
      }
    },
