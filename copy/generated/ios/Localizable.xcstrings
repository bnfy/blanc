    "settings.help.blancConnectsToWebsites": {
      "comment": "Settings → Help → Connections Blanc can make: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc connects to websites you open and GitHub for app updates. Searches and enabled suggestions go to your selected search provider; DNS lookups use your system or selected DNS provider. Selecting Google sends searches and eligible suggestion prefixes to Google."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc verbindet sich mit Websites, die du öffnest, und mit GitHub für App-Updates. Suchen und aktivierte Vorschläge gehen an deinen gewählten Suchanbieter; DNS-Abfragen nutzen dein System oder den gewählten DNS-Anbieter. Wenn du Google wählst, gehen Suchen und geeignete Vorschlagsanfänge an Google."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc se conecta a los sitios web que abres y a GitHub para las actualizaciones de la app. Las búsquedas y las sugerencias activadas van al buscador elegido; las consultas DNS usan tu sistema o el proveedor de DNS elegido. Elegir Google envía a Google las búsquedas y los comienzos de sugerencias aptos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc se connecte aux sites web que vous ouvrez et à GitHub pour les mises à jour de l’app. Les recherches et les suggestions activées vont au moteur de recherche choisi ; les requêtes DNS utilisent votre système ou le fournisseur DNS choisi. Choisir Google envoie à Google les recherches et les débuts de suggestions éligibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc si connette ai siti web che apri e a GitHub per gli aggiornamenti dell’app. Le ricerche e i suggerimenti attivati vanno al motore di ricerca scelto; le ricerche DNS usano il sistema o il provider DNS scelto. Se scegli Google, le ricerche e i prefissi idonei per i suggerimenti vengono inviati a Google."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Blanc se conecta aos sites que você abre e ao GitHub para atualizações do app. As pesquisas e as sugestões ativadas vão para o provedor de pesquisa escolhido; as consultas de DNS usam o sistema ou o provedor de DNS escolhido. Escolher o Google envia ao Google as pesquisas e os começos de sugestões elegíveis."
          }
        }
      }
    },
    "settings.help.enabledUsageMeasurementGoes": {
      "comment": "Settings → Help → Connections Blanc can make: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled usage measurement goes to a Blanc-owned Cloudflare collector and, when configured, its Google Analytics mirror. Sync, Patron, 1Password and tab handoff make separate connections when configured or requested. This describes behavior; it is not a live network monitor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktivierte Nutzungsmessung geht an einen Cloudflare-Sammler von Blanc und, falls eingerichtet, an dessen Google-Analytics-Spiegel. Synchronisierung, Patron, 1Password und Tab-Übergabe stellen eigene Verbindungen her, wenn sie eingerichtet oder angefordert sind. Dies beschreibt das Verhalten; es ist keine Live-Netzwerküberwachung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La medición de uso activada va a un recopilador de Cloudflare propiedad de Blanc y, si está configurado, a su espejo de Google Analytics. Sync, Patron, 1Password y el traspaso de pestañas hacen conexiones aparte cuando se configuran o se solicitan. Esto describe el comportamiento; no es un monitor de red en directo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mesure d’utilisation activée est envoyée à un collecteur Cloudflare appartenant à Blanc et, si configuré, à son miroir Google Analytics. Sync, Patron, 1Password et le transfert d’onglets établissent des connexions distinctes quand ils sont configurés ou sollicités. Ceci décrit le comportement ; ce n’est pas un moniteur réseau en direct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La misurazione dell’utilizzo, se attiva, va a un raccoglitore Cloudflare gestito da Blanc e, se configurato, al suo mirror di Google Analytics. Sincronizzazione, Patron, 1Password e il passaggio delle schede effettuano connessioni separate quando sono configurati o richiesti. Questa è una descrizione del comportamento, non un monitor di rete in tempo reale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A medição de uso ativada vai para um coletor da Cloudflare do próprio Blanc e, quando configurado, para o espelho dele no Google Analytics. Sync, Patron, 1Password e a transferência de abas fazem conexões separadas quando configurados ou solicitados. Isto descreve o comportamento; não é um monitor de rede ao vivo."
          }
        }
      }
    },
    "settings.help.dataRecipientsAndControls": {
      "comment": "Settings → Help → Connections Blanc can make: link.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data, recipients and controls ↗"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten, Empfänger und Kontrolle ↗"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
