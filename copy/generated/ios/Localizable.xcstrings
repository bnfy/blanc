    "settings.privacy.adblockProvider.hint": {
      "comment": "Settings → Privacy & Security → Blocking: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes take effect after restarting Blanc. uBlock Origin protects regular tabs. Blanc’s browser engine can load uBO only in saved sessions, so private sessions stay in memory and use Blanc Blocker. Each provider keeps separate site settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen werden nach einem Neustart von Blanc wirksam. uBlock Origin schützt normale Tabs. Blancs Browser-Engine kann uBO nur in gespeicherten Sitzungen laden, deshalb bleiben private Sitzungen im Speicher und nutzen Blanc Blocker. Jeder Blocker hat eigene Website-Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se aplican después de reiniciar Blanc. uBlock Origin protege las pestañas normales. El motor de Blanc solo puede cargar uBO en sesiones guardadas, así que las sesiones privadas se quedan en memoria y usan Blanc Blocker. Cada proveedor guarda sus propios ajustes por sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications prennent effet après le redémarrage de Blanc. uBlock Origin protège les onglets ordinaires. Le moteur de Blanc ne peut charger uBO que dans les sessions enregistrées : les sessions privées restent en mémoire et utilisent Blanc Blocker. Chaque fournisseur conserve ses propres réglages par site."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche si applicano dopo il riavvio di Blanc. uBlock Origin protegge le schede normali. Il motore di Blanc può caricare uBO solo nelle sessioni salvate, quindi le sessioni private restano in memoria e usano Blanc Blocker. Ogni sistema di blocco conserva impostazioni dei siti separate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações valem depois de reiniciar o Blanc. O uBlock Origin protege as abas comuns. O motor do Blanc só carrega o uBO em sessões salvas, então as sessões privadas ficam na memória e usam o Blanc Blocker. Cada provedor mantém configurações próprias por site."
          }
        }
      }
    },
