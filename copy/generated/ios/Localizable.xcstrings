    "mahjong.setup.autoClears": {
      "comment": "Mahjong → Boards (choose your game): text (span).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<0>Auto clears</0> Every fifth combo clears another available pair automatically."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<0>Auto-Abräumen</0> Jede fünfte Combo räumt automatisch ein weiteres verfügbares Paar ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<0>Retiros automáticos</0> Cada quinto combo retira automáticamente otra pareja disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<0>Retraits auto</0> Tous les cinq combos, une autre paire disponible est retirée automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "<0>Rimozioni automatiche</0> Ogni quinta combo rimuove automaticamente un’altra coppia disponibile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "<0>Limpezas automáticas</0> A cada cinco combos, outro par disponível é retirado automaticamente."
          }
        }
      }
    },
    "mahjong.setup.zen": {
      "comment": "Mahjong → Boards (choose your game): text (span).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<0>Zen game</0> Hide time and score, and keep this game out of Records."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<0>Zen-Spiel</0> Zeit und Punkte ausblenden und dieses Spiel nicht in die Rekorde aufnehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<0>Partida Zen</0> Oculta el tiempo y los puntos, y deja esta partida fuera de los récords."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<0>Partie Zen</0> Masque le temps et les points, et exclut cette partie du palmarès."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "<0>Partita Zen</0> Nascondi tempo e punteggio, e tieni questa partita fuori dai record."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "<0>Partida Zen</0> Oculta o tempo e a pontuação, e deixa esta partida fora dos recordes."
          }
        }
      }
    },
    "mahjong.setup.freeHighlight": {
      "comment": "Mahjong → Boards (choose your game): text (span).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<0>Stronger free-tile highlight</0> Adds a persistent high-contrast ring to every tile available to play."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<0>Stärkere Hervorhebung freier Steine</0> Fügt jedem spielbaren Stein einen dauerhaften, kontrastreichen Ring hinzu."
          }
        },
