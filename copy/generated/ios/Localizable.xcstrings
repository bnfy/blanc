    },
    "settings.privacy.fillAMatchingLogin": {
      "comment": "Settings → Privacy & Security → 1Password: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill a matching Login item from your installed 1Password app when you ask. While this is on, Blanc checks pages for a login form so the island can offer Fill — it never reads what you type and never contacts 1Password until you ask."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füllt auf deinen Wunsch ein passendes Login-Objekt aus deiner installierten 1Password-App aus. Solange dies an ist, prüft Blanc Seiten auf ein Anmeldeformular, damit die Island Ausfüllen anbieten kann – es liest nie, was du tippst, und kontaktiert 1Password erst, wenn du es verlangst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellena un elemento de inicio de sesión coincidente desde tu app de 1Password instalada cuando lo pides. Mientras esto está activado, Blanc busca formularios de inicio de sesión en las páginas para que la Island pueda ofrecer Rellenar; nunca lee lo que escribes ni contacta con 1Password hasta que lo pides."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplit sur demande un élément de connexion correspondant depuis l’app 1Password installée. Tant que c’est activé, Blanc repère les formulaires de connexion pour que l’Island puisse proposer Remplir — il ne lit jamais ce que vous saisissez et ne contacte jamais 1Password avant votre demande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compila un elemento Login corrispondente dall’app 1Password installata quando lo chiedi. Mentre questa opzione è attiva, Blanc cerca moduli di accesso nelle pagine per permettere a Island di offrire Compila: non legge mai ciò che digiti e non contatta mai 1Password finché non lo chiedi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preenche um item de login correspondente do app do 1Password instalado quando você pede. Enquanto isso estiver ativado, o Blanc procura formulários de login nas páginas para que a Island possa oferecer Preencher — ele nunca lê o que você digita e nunca contata o 1Password até você pedir."
          }
        }
      }
    },
