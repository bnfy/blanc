        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Blanc não conseguiu verificar esta transferência. Ela pode ter sido alterada ou aberta com o link errado."
          }
        }
      }
    },
    "handoff.error.unavailable": {
