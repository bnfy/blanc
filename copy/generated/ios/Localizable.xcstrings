    "import.permissionGuidance": {
      "comment": "Shown when importing from another browser on macOS needs Full Disk Access; System Settings → Privacy & Security is macOS’s own menu path, use its localized names.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS blocked access to this browser’s profile folder. Grant Blanc Full Disk Access in System Settings → Privacy & Security, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat den Zugriff auf den Profilordner dieses Browsers blockiert. Gib Blanc in den Systemeinstellungen unter Datenschutz & Sicherheit den Festplattenvollzugriff und versuche es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS bloqueó el acceso a la carpeta de perfil de este navegador. Concede a Blanc acceso total al disco en Ajustes del Sistema → Privacidad y seguridad y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a bloqué l’accès au dossier de profil de ce navigateur. Accordez à Blanc l’accès complet au disque dans Réglages Système → Confidentialité et sécurité, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ha bloccato l’accesso alla cartella del profilo di questo browser. Concedi a Blanc l’accesso completo al disco in Impostazioni di Sistema → Privacy e sicurezza, poi riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS bloqueou o acesso à pasta de perfil deste navegador. Dê ao Blanc Acesso Total ao Disco em Ajustes do Sistema → Privacidade e Segurança e tente de novo."
          }
        }
      }
    },
