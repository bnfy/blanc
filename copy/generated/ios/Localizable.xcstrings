                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld nicht gespeicherte Tabs werden geschlossen. Seitenentwürfe werden nicht auf dem Datenträger gespeichert."
                }
              }
            }
          }
        }
      }
