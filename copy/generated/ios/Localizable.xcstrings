    "settings.sync.syncSetupIntro": {
      "comment": "Settings → Sync → Set up Sync: text (p).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync your favorites and settings across your devices, and, if you choose, open tabs. Everything is end-to-end encrypted — Blanc can’t read it, and can’t recover it if you forget your passphrase."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisiere deine Favoriten und Einstellungen und auf Wunsch auch offene Tabs zwischen deinen Geräten. Alles ist Ende-zu-Ende-verschlüsselt – Blanc kann es weder lesen noch wiederherstellen, wenn du deine Passphrase vergisst."
          }
        }
      }
    },
    "settings.sync.syncPaths.ariaLabel": {
      "comment": "Settings → Sync → Set up Sync: accessible name of a div.",
