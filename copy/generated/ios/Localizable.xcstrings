    "settings.privacy.webrtcAudioBuffer.hint": {
      "comment": "Settings → Privacy & Security → Calls and connections: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic keeps conversation delay as low as possible. Stable targets about 400 ms of receive buffering. Resilient targets about 1 second for severe crackling or chopped speech, making back-and-forth conversation slower. Start a new call after changing it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch hält die Gesprächsverzögerung so gering wie möglich. Stabil puffert beim Empfang etwa 400 ms. Belastbar puffert etwa 1 Sekunde gegen starkes Knistern oder abgehackte Sprache, was Gespräche träger macht. Starte nach einer Änderung einen neuen Anruf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático mantiene el retardo de la conversación lo más bajo posible. Estable busca unos 400 ms de búfer de recepción. Resistente busca alrededor de 1 segundo para crujidos fuertes o voz entrecortada, lo que hace más lenta la conversación. Inicia una llamada nueva después de cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique garde le délai de conversation aussi bas que possible. Stable vise environ 400 ms de mémoire tampon en réception. Résilient vise environ 1 seconde en cas de crépitements forts ou de voix hachée, ce qui ralentit les échanges. Lancez un nouvel appel après l’avoir modifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatico mantiene il ritardo della conversazione il più basso possibile. Stabile punta a circa 400 ms di buffer in ricezione. Resistente punta a circa 1 secondo, per audio molto disturbato o voce a scatti, rendendo più lento il botta e risposta. Avvia una nuova chiamata dopo averlo cambiato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático mantém o atraso da conversa o mais baixo possível. Estável busca cerca de 400 ms de buffer de recepção. Resiliente busca cerca de 1 segundo para chiados fortes ou voz cortada, deixando a conversa mais lenta. Comece uma nova chamada depois de mudar."
          }
        }
      }
    },
