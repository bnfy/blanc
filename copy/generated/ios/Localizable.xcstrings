    "ws.decision.protected": {
      "comment": "Shown before switching space when a page in this window is busy (for example uploading or capturing).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This window has pages that need to stay open. Open the space in another window, or finish the active page operation and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Fenster sind Seiten, die geöffnet bleiben müssen. Öffne den Space in einem anderen Fenster oder schließe den laufenden Vorgang auf der Seite ab und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ventana tiene páginas que deben seguir abiertas. Abre el Space en otra ventana o termina la operación en curso de la página e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette fenêtre contient des pages qui doivent rester ouvertes. Ouvrez le Space dans une autre fenêtre, ou terminez l’opération en cours sur la page et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa finestra ha pagine che devono restare aperte. Apri lo Space in un’altra finestra oppure termina l’operazione in corso nella pagina e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta janela tem páginas que precisam continuar abertas. Abra o Space em outra janela, ou conclua a operação em andamento na página e tente de novo."
          }
        }
      }
    },
    "ws.decision.closePrivate": {
      "comment": "Shown before switching space when every tab that would close is private.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld private tab will close. Page drafts are not saved to disk."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld private tabs will close. Page drafts are not saved to disk."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
