    "settings.help.youCanBrowseChrome": {
      "comment": "Settings → Help → Extensions and password managers: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can browse Chrome Web Store pages, but Blanc cannot install Chrome extensions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst Seiten des Chrome Web Store ansehen, aber Blanc kann keine Chrome-Erweiterungen installieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes navegar por las páginas de Chrome Web Store, pero Blanc no puede instalar extensiones de Chrome."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez parcourir les pages du Chrome Web Store, mais Blanc ne peut pas installer d’extensions Chrome."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi navigare nelle pagine del Chrome Web Store, ma Blanc non può installare estensioni di Chrome."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode navegar pelas páginas da Chrome Web Store, mas o Blanc não instala extensões do Chrome."
          }
        }
      }
    },
    "settings.help.onMacOSWindowsAnd": {
      "comment": "Settings → Help → Extensions and password managers: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On macOS, Windows and Linux, Blanc offers explicit login fill from the installed 1Password app. This integration does not save passwords or fill automatically."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter macOS, Windows und Linux bietet Blanc ausdrückliches Ausfüllen von Logins aus der installierten 1Password-App. Diese Integration speichert keine Passwörter und füllt nichts automatisch aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En macOS, Windows y Linux, Blanc ofrece rellenar inicios de sesión a petición desde la app de 1Password instalada. Esta integración no guarda contraseñas ni rellena automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur macOS, Windows et Linux, Blanc propose de remplir les identifiants sur demande depuis l’app 1Password installée. Cette intégration n’enregistre pas de mots de passe et ne remplit rien automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su macOS, Windows e Linux, Blanc compila gli accessi su richiesta dall’app 1Password installata. Questa integrazione non salva password e non compila automaticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No macOS, no Windows e no Linux, o Blanc oferece o preenchimento de login sob demanda pelo app do 1Password instalado. Essa integração não salva senhas nem preenche automaticamente."
          }
        }
      }
    },
    "settings.help.connectionsBlancCanMake.title": {
      "comment": "Settings → Help → Connections Blanc can make: card heading.",
      "extractionState": "manual",
      "localizations": {
