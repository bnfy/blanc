          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a escolha de recuperação. Verifique o acesso ao disco e tente de novo."
          }
        }
      }
    },
    "handoff.error.invalidExpiry": {
      "comment": "Tab handoff error (tabs sent from another browser).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This handoff has expired or your device clock is incorrect. Check the clock and create a new handoff."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Übergabe ist abgelaufen oder die Uhr deines Geräts geht falsch. Prüfe die Uhr und erstelle eine neue Übergabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este traspaso caducó o el reloj de tu dispositivo no es correcto. Comprueba el reloj y crea un traspaso nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce transfert a expiré ou l’horloge de votre appareil est incorrecte. Vérifiez l’horloge et créez un nouveau transfert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo trasferimento è scaduto o l’orologio del tuo dispositivo non è corretto. Controlla l’orologio e crea un nuovo trasferimento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta transferência expirou ou o relógio do seu dispositivo está errado. Confira o relógio e crie uma nova transferência."
          }
        }
      }
    },
    "handoff.error.tooManyTabs": {
      "comment": "Tab handoff error; {limit} is the maximum number of tabs (always more than one).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This handoff has more than %1$@ tabs. Select a smaller set and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Übergabe enthält mehr als %1$@ Tabs. Wähle weniger aus und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este traspaso tiene más de %1$@ pestañas. Selecciona menos e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce transfert contient plus de %1$@ onglets. Sélectionnez-en moins et réessayez."
