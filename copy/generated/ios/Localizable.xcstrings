        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il file degli Spaces. Verifica che il file sia accessibile e riavvia Blanc."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler seu arquivo de Spaces. Verifique se o arquivo está acessível e reinicie o Blanc."
          }
        }
      }
    },
    "ws.error.storageFailed": {
      "comment": "Space switcher error when saving spaces to disk fails.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save changes. Check available disk space and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen konnten nicht gespeichert werden. Prüfe den freien Speicherplatz und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar los cambios. Comprueba el espacio libre en el disco e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer les modifications. Vérifiez l’espace disque disponible et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare le modifiche. Controlla lo spazio libero su disco e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar as alterações. Verifique o espaço livre em disco e tente de novo."
          }
        }
      }
    },
    "ws.error.futureFormat": {
      "comment": "Space switcher error when the space file was written by a newer Blanc.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These spaces need a newer version of Blanc. Your saved file has not been changed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Spaces brauchen eine neuere Version von Blanc. Deine gespeicherte Datei wurde nicht verändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos Spaces necesitan una versión más reciente de Blanc. Tu archivo guardado no se ha modificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces Spaces nécessitent une version plus récente de Blanc. Votre fichier enregistré n’a pas été modifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi Spaces richiedono una versione più recente di Blanc. Il file salvato non è stato modificato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes Spaces precisam de uma versão mais nova do Blanc. Seu arquivo salvo não foi alterado."
          }
        }
      }
    },
    "ws.error.repairFailed": {
      "comment": "Space switcher error when Blanc cannot back up a damaged space file before repairing it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t preserve a recovery copy. Your space file has not been changed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es konnte keine Wiederherstellungskopie angelegt werden. Deine Spaces-Datei wurde nicht verändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conservar una copia de recuperación. Tu archivo de Spaces no se ha modificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de conserver une copie de récupération. Votre fichier de Spaces n’a pas été modifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile conservare una copia di recupero. Il file degli Spaces non è stato modificato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível manter uma cópia de recuperação. Seu arquivo de Spaces não foi alterado."
          }
        }
      }
    },
    "ws.error.busy": {
      "comment": "Space switcher error while another space action is in progress.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another space action is still finishing. Try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere Aktion für Spaces läuft noch. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía está terminando otra acción de Spaces. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre action sur les Spaces est en cours. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’altra azione sugli Spaces è ancora in corso. Riprova."
          }
