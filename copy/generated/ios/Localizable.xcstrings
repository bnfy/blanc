    "settings.trust.factsCheckedOnThis": {
      "comment": "Settings → About & Trust: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Facts checked on this device. Opening this section makes no network request."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät geprüfte Fakten. Das Öffnen dieses Bereichs löst keine Netzwerkanfrage aus."
          }
        }
      }
    },
