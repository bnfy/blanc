    "fill.setupEnable.body": {
      "comment": "Fill capsule body; the quoted text is the Settings toggle's label and must match it exactly.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on “Fill logins from 1Password” in Settings. Blanc only reads a matching login when you ask."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere „Logins aus 1Password ausfüllen“ in den Einstellungen. Blanc liest Logins nur auf Anfrage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa «Rellenar inicios de sesión desde 1Password» en Configuración. Blanc solo lee si lo pides."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez « Remplir les identifiants depuis 1Password » (Réglages). Blanc ne lit que sur demande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva «Compila gli accessi da 1Password» in Impostazioni. Blanc legge solo su tua richiesta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative “Preencher logins do 1Password” nas Configurações. O Blanc só lê um login quando você pede."
          }
        }
      }
    },
