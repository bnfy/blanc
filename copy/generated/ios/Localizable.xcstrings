    "linuxSandbox.refusal": {
      "comment": "Linux dialog when Blanc is launched with sandboxing disabled. Shown before Blanc can read the interface language, so it is always English.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc refused to start because Chromium sandboxing was disabled. Use a Linux environment that permits Chromium sandboxing and launch Blanc without sandbox-disabling options."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc wurde nicht gestartet, weil die Chromium-Sandbox deaktiviert war. Nutze eine Linux-Umgebung, die die Chromium-Sandbox erlaubt, und starte Blanc ohne Optionen, die die Sandbox deaktivieren."
          }
        }
      }
    },
