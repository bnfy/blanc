            "state": "translated",
            "value": "Impossibile salvare la reimpostazione: controlla lo spazio su disco e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a redefinição — verifique o espaço em disco e tente de novo."
          }
        }
      }
    },
