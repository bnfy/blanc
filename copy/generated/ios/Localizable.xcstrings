    "settings.privacy.adblockProvider.hint": {
      "comment": "Settings → Privacy & Security → Blocking: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes take effect after restarting Blanc. uBlock Origin protects regular tabs. Blanc’s browser engine can load uBO only in saved sessions, so private sessions stay in memory and use Blanc Blocker. Each provider keeps separate site settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen werden nach einem Neustart von Blanc wirksam. uBlock Origin schützt normale Tabs. Blancs Browser-Engine kann uBO nur in gespeicherten Sitzungen laden, deshalb bleiben private Sitzungen im Speicher und nutzen Blanc Blocker. Jeder Blocker hat eigene Website-Einstellungen."
          }
        }
      }
    },
    "settings.privacy.ublockDashboard": {
      "comment": "Settings → Privacy & Security → Blocking: button.",
      "extractionState": "manual",
