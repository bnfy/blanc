            "state": "translated",
            "value": "Digite exatamente o nome de sincronização que você usou no outro dispositivo."
          }
        }
      }
    },
    "settings.sync.setup.passphraseHint": {
      "comment": "Settings → Sync setup: hint under the passphrase field when starting a new sync.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "16+ characters, or 10+ mixing letters, numbers and symbols. Blanc can’t recover it if you forget it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens 16 Zeichen oder mindestens 10 mit Buchstaben, Zahlen und Symbolen gemischt. Blanc kann sie nicht wiederherstellen, wenn du sie vergisst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "16 caracteres o más, o 10 o más que mezclen letras, números y símbolos. Blanc no puede recuperarla si la olvidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "16 caractères ou plus, ou 10 ou plus mêlant lettres, chiffres et symboles. Blanc ne peut pas la récupérer si vous l’oubliez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Almeno 16 caratteri, oppure almeno 10 combinando lettere, numeri e simboli. Blanc non può recuperarla se la dimentichi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "16 caracteres ou mais, ou 10 ou mais misturando letras, números e símbolos. O Blanc não consegue recuperá-la se você esquecer."
          }
        }
      }
    },
    "settings.sync.setup.joinPassphraseHint": {
      "comment": "Settings → Sync setup: hint under the passphrase field when joining.",
      "extractionState": "manual",
      "localizations": {
        "en": {
