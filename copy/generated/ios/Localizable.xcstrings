    "handoff.error.unverified": {
      "comment": "Tab handoff error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc could not verify this handoff. It may have been changed or opened with the wrong link."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc konnte diese Übergabe nicht überprüfen. Sie wurde möglicherweise verändert oder über den falschen Link geöffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc no pudo verificar este traspaso. Es posible que se haya modificado o abierto con el enlace equivocado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc n’a pas pu vérifier ce transfert. Il a peut-être été modifié ou ouvert avec le mauvais lien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
