    "error.certificate.warning": {
      "comment": "Error page for an untrusted certificate: warning above the continue button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This site’s certificate isn’t trusted, so Blanc can’t confirm who you’re talking to. Someone on your network could be impersonating it. Only continue if you know this device — for example, a router, NAS or server on your own network."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zertifikat dieser Website ist nicht vertrauenswürdig, daher kann Blanc nicht bestätigen, mit wem du kommunizierst. Jemand in deinem Netzwerk könnte sich als sie ausgeben. Fahre nur fort, wenn du dieses Gerät kennst – zum Beispiel einen Router, ein NAS oder einen Server in deinem eigenen Netzwerk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El certificado de este sitio no es de confianza, así que Blanc no puede confirmar con quién estás hablando. Alguien de tu red podría estar suplantándolo. Continúa solo si conoces este dispositivo, por ejemplo, un router, un NAS o un servidor de tu propia red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat de ce site n’est pas fiable, donc Blanc ne peut pas confirmer avec qui vous communiquez. Quelqu’un sur votre réseau pourrait se faire passer pour lui. Ne continuez que si vous connaissez cet appareil — par exemple un routeur, un NAS ou un serveur de votre propre réseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il certificato di questo sito non è attendibile, quindi Blanc non può confermare con chi stai comunicando. Qualcuno sulla tua rete potrebbe spacciarsi per questo sito. Continua solo se conosci questo dispositivo — per esempio un router, un NAS o un server sulla tua rete."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O certificado deste site não é confiável, então o Blanc não consegue confirmar com quem você está falando. Alguém na sua rede pode estar se passando por ele. Só continue se você conhece este dispositivo — por exemplo, um roteador, NAS ou servidor da sua própria rede."
          }
        }
      }
    },
