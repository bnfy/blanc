    "settings.sync.nothingWasFoundUnder": {
      "comment": "Settings → Sync → Set up Sync: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was found under that name and passphrase. Check for typos, including capital letters, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter diesem Namen und dieser Passphrase wurde nichts gefunden. Prüfe auf Tippfehler, auch bei Groß- und Kleinschreibung, und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró nada con ese nombre y esa frase de contraseña. Revisa si hay errores, incluidas las mayúsculas, e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’a été trouvé avec ce nom et cette phrase secrète. Vérifiez les fautes de frappe, majuscules comprises, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato trovato nulla con quel nome e quella passphrase. Controlla eventuali errori di battitura, maiuscole comprese, poi riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
