        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Farbe kann Blanc nicht verwenden. Wähle ein Farbfeld oder gib einen Hex-Wert wie #426C4C ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc no puede usar ese color. Elige una muestra o escribe un color hexadecimal como #426C4C."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc ne peut pas utiliser cette couleur. Choisissez une pastille ou saisissez une couleur hexadécimale comme #426C4C."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc non può usare questo colore. Scegli un campione o inserisci un colore esadecimale come #426C4C."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Blanc não pode usar essa cor. Escolha uma amostra ou digite uma cor hexadecimal como #426C4C."
          }
        }
      }
    },
