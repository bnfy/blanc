    "update.downloading.detail": {
      "comment": "Dialog detail while an update downloads.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update is downloading in the background. Blanc will prompt you as soon as it is ready to restart."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Update wird im Hintergrund heruntergeladen. Blanc meldet sich, sobald es für einen Neustart bereit ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización se está descargando en segundo plano. Blanc te avisará en cuanto esté lista para reiniciar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour se télécharge en arrière-plan. Blanc vous préviendra dès qu’elle sera prête à redémarrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aggiornamento viene scaricato in background. Blanc ti avviserà non appena sarà pronto per il riavvio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização está sendo baixada em segundo plano. O Blanc vai avisar assim que estiver pronta para reiniciar."
          }
        }
      }
    },
