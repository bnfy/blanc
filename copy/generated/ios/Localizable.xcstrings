    "ws.error.readFailed": {
      "comment": "Space switcher error when the saved space file cannot be read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read your spaces file. Restart Blanc after checking that the file is accessible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Spaces-Datei konnte nicht gelesen werden. Prüfe, ob die Datei zugänglich ist, und starte Blanc dann neu."
          }
        }
      }
    },
    "ws.error.storageFailed": {
      "comment": "Space switcher error when saving spaces to disk fails.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save changes. Check available disk space and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen konnten nicht gespeichert werden. Prüfe den freien Speicherplatz und versuche es erneut."
          }
        }
      }
    },
    "ws.error.futureFormat": {
      "comment": "Space switcher error when the space file was written by a newer Blanc.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These spaces need a newer version of Blanc. Your saved file has not been changed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Spaces brauchen eine neuere Version von Blanc. Deine gespeicherte Datei wurde nicht verändert."
          }
        }
      }
    },
    "ws.error.repairFailed": {
      "comment": "Space switcher error when Blanc cannot back up a damaged space file before repairing it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t preserve a recovery copy. Your space file has not been changed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es konnte keine Wiederherstellungskopie angelegt werden. Deine Spaces-Datei wurde nicht verändert."
          }
        }
      }
    },
    "ws.error.busy": {
      "comment": "Space switcher error while another space action is in progress.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another space action is still finishing. Try again."
