    "onboarding.privacy.saveFailed": {
      "comment": "Onboarding → step 5 (privacy choices): error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save these choices. Check disk access and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Auswahl konnte nicht gespeichert werden. Prüfe den Zugriff auf den Speicher und versuch es noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar estas opciones. Comprueba el acceso al disco e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer ces choix. Vérifiez l’accès au disque et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare queste scelte. Controlla l’accesso al disco e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar estas escolhas. Verifique o acesso ao disco e tente de novo."
          }
        }
      }
    },
