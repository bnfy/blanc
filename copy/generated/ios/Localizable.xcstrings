    "tabImport.error.permission": {
      "comment": "Bring Your Tabs page → step 1 (choose a browser and profile): error on macOS; “Full Disk Access” is the macOS privacy setting, use its name in this language.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS blocked this profile. Grant Blanc Full Disk Access, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat dieses Profil blockiert. Gib Blanc den Festplattenvollzugriff und versuch es dann noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS bloqueó este perfil. Concede a Blanc acceso total al disco y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a bloqué ce profil. Accordez à Blanc l’accès complet au disque, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ha bloccato questo profilo. Concedi a Blanc l’accesso completo al disco, poi riprova."
          }
        },
