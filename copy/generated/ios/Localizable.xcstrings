    "tabImport.error.notReadable": {
      "comment": "Bring Your Tabs page → step 1, when the other browser is still open: error after the browser quit; {source} names the browser and profile, {browser} the browser.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The latest %1$@ session is not safely readable. Reopen %2$@; Blanc will not use an older snapshot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neueste Sitzung von %1$@ lässt sich nicht sicher lesen. Öffne %2$@ erneut; Blanc verwendet keinen älteren Stand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última sesión de %1$@ no se puede leer con seguridad. Vuelve a abrir %2$@; Blanc no usará una instantánea más antigua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière session %1$@ ne peut pas être lue en toute sécurité. Rouvrez %2$@ ; Blanc n’utilisera pas d’instantané plus ancien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ultima sessione di %1$@ non può essere letta in sicurezza. Riapri %2$@; Blanc non userà un’istantanea meno recente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão mais recente do %1$@ não pode ser lida com segurança. Abra o %2$@ de novo; o Blanc não vai usar um retrato mais antigo."
          }
        }
      }
    },
