    "newtab.recovery.message": {
      "comment": "Start page → card shown after Blanc quit unexpectedly: explanation; {tabs} is “3 tabs” (newtab.recovery.tabs), {windows} is “across 2 windows” (newtab.recovery.windows). “Personal” is the name of the built-in profile.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc did not close normally. Restore %1$@ %2$@, or start with a clean Personal window. No saved website will open until you choose."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc wurde nicht normal beendet. Stelle %1$@ %2$@ wieder her oder beginne mit einem leeren Personal-Fenster. Bis du wählst, wird keine gespeicherte Website geöffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc no se cerró correctamente. Restaura %1$@ %2$@ o empieza con una ventana de Personal limpia. Ningún sitio web guardado se abrirá hasta que elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc ne s’est pas fermé normalement. Restaurez %1$@ %2$@, ou commencez avec une fenêtre Personal vierge. Aucun site web enregistré ne s’ouvrira avant votre choix."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc non è stato chiuso normalmente. Ripristina %1$@ %2$@ oppure inizia con una finestra Personal pulita. Nessun sito salvato si aprirà finché non scegli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Blanc não fechou normalmente. Restaure %1$@ %2$@ ou comece com uma janela Personal limpa. Nenhum site salvo vai abrir até você escolher."
          }
        }
      }
    },
