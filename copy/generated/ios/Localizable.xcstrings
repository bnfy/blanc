    "onboarding.privacy.title": {
      "comment": "Onboarding → step 5 (privacy choices): heading.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what Blanc may send"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, was Blanc senden darf"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué puede enviar Blanc"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez ce que Blanc peut envoyer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli cosa può inviare Blanc"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o que o Blanc pode enviar"
          }
        }
      }
    },
    "onboarding.privacy.body": {
      "comment": "Onboarding → step 5 (privacy choices): explanation; it ends with a colon before the two choices.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc checks for app updates and ships its blocking lists with each release. These optional choices start sending only after you save them by continuing. You can turn either off now or later in Settings:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc sucht nach App-Updates und liefert seine Blockierlisten mit jedem Release aus. Diese optionalen Daten werden erst gesendet, nachdem du sie durch Fortfahren speicherst. Du kannst beide jetzt oder später in den Einstellungen ausschalten:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc busca actualizaciones de la app e incluye sus listas de bloqueo en cada versión. Estas opciones solo empiezan a enviar datos cuando las guardas al continuar. Puedes desactivar cualquiera ahora o más tarde en Configuración:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc recherche les mises à jour de l’app et livre ses listes de blocage avec chaque version. Ces choix facultatifs n’envoient rien tant que vous ne les avez pas enregistrés en continuant. Vous pouvez désactiver l’un ou l’autre maintenant ou plus tard dans les Réglages :"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc controlla gli aggiornamenti dell’app e include le sue liste di blocco in ogni versione. Queste scelte facoltative iniziano a inviare dati solo dopo che le salvi continuando. Puoi disattivarle ora o più tardi nelle Impostazioni:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Blanc verifica atualizações do app e traz as listas de bloqueio em cada versão. Estas escolhas opcionais só começam a enviar dados depois que você as salvar ao continuar. Você pode desativar qualquer uma agora ou depois nas Configurações:"
          }
        }
      }
    },
    "onboarding.privacy.suggestions": {
      "comment": "Onboarding → step 5 (privacy choices): switch name, then (tag 0) its explanation in smaller type.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search suggestions<0>Eligible typed prefixes go to your selected search provider, including Google if selected. Private tabs and recognized sensitive-looking text are excluded.</0>"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchvorschläge<0>Geeignete eingetippte Anfänge gehen an deinen gewählten Suchanbieter, auch an Google, falls ausgewählt. Private Tabs und erkennbar sensibel wirkender Text sind ausgenommen.</0>"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerencias de búsqueda<0>Los comienzos aptos de lo que escribes van al buscador elegido, incluido Google si lo eliges. Se excluyen las pestañas privadas y el texto que parece sensible.</0>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggestions de recherche<0>Les débuts de saisie éligibles vont au moteur de recherche choisi, y compris Google si vous l’avez choisi. Les onglets privés et les textes qui semblent sensibles sont exclus.</0>"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerimenti di ricerca<0>I prefissi digitati idonei vengono inviati al motore di ricerca selezionato, incluso Google se lo hai scelto. Sono esclusi le schede private e il testo riconosciuto come potenzialmente sensibile.</0>"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugestões de pesquisa<0>Os começos elegíveis do que você digita vão para o provedor de pesquisa escolhido, inclusive o Google, se escolhido. Abas privadas e textos que parecem sensíveis ficam de fora.</0>"
          }
        }
      }
    },
    "onboarding.privacy.suggestionsLabel": {
      "comment": "Onboarding → step 5 (privacy choices): accessible name of the switch.",
      "extractionState": "manual",
