    "onboarding.island.body": {
      "comment": "Onboarding dialog → step 3: explanation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs, search and navigation, all in one place."
          }
