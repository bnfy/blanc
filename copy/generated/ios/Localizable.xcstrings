    "ws.decision.label": {
      "comment": "Accessible name of the box asking what to do with this window’s tabs before switching workspace.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workspace switch decision"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entscheidung zum Wechsel des Arbeitsbereichs"
          }
        }
      }
    },
    "ws.decision.capacity": {
      "comment": "Shown before switching workspace when no more workspaces can be kept in memory.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your retained workspaces are full. Open this workspace in another window to keep your pages available."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine im Speicher gehaltenen Arbeitsbereiche sind voll. Öffne diesen Arbeitsbereich in einem anderen Fenster, damit deine Seiten verfügbar bleiben."
          }
        }
      }
    },
    "ws.decision.protected": {
      "comment": "Shown before switching workspace when a page in this window is busy (for example uploading or capturing).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This window has pages that need to stay open. Open the workspace in another window, or finish the active page operation and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Fenster sind Seiten, die geöffnet bleiben müssen. Öffne den Arbeitsbereich in einem anderen Fenster oder schließe den laufenden Vorgang auf der Seite ab und versuche es erneut."
          }
        }
      }
    },
    "ws.decision.closePrivate": {
      "comment": "Shown before switching workspace when every tab that would close is private.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld private tab will close. Page drafts are not saved to disk."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld private tabs will close. Page drafts are not saved to disk."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld privater Tab wird geschlossen. Seitenentwürfe werden nicht auf dem Datenträger gespeichert."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld private Tabs werden geschlossen. Seitenentwürfe werden nicht auf dem Datenträger gespeichert."
                }
              }
            }
          }
        }
      }
    },
    "ws.decision.closeUnsaved": {
      "comment": "Shown before switching workspace when tabs that are not saved in any workspace would close.",
