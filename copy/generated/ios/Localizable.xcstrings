    "onboarding.island.caption": {
      "comment": "Onboarding dialog → step 3: screen-reader description of the Island picture.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet Island with Back and Forward, three tab dots, the site's favicon and address, New Tab, blocker shield, Reload, Favorite and Close."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhige Island mit Zurück und Vorwärts, drei Tab-Punkten, dem Favicon und der Adresse der Website, Neuer Tab, Blocker-Schild, Neu laden, Favorit und Schließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Island en reposo con Atrás y Adelante, tres puntos de pestañas, el favicon y la dirección del sitio, Nueva pestaña, el escudo del bloqueador, Recargar, Favorito y Cerrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Island au repos avec Précédent et Suivant, trois points d’onglets, le favicon et l’adresse du site, Nouvel onglet, le bouclier du bloqueur, Actualiser, Favori et Fermer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Island in riposo con Indietro e Avanti, tre punti delle schede, la favicon e l’indirizzo del sito, Nuova scheda, lo scudo del blocco, Ricarica, Preferito e Chiudi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Island em repouso com Voltar e Avançar, três pontos de abas, o favicon e o endereço do site, Nova aba, o escudo do bloqueador, Recarregar, Favorito e Fechar."
          }
        }
      }
    },
