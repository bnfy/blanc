    "settings.sync.setup.joinIntro": {
      "comment": "Settings → Sync setup: introduction when joining a sync from another device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the same sync name and passphrase as your other device. Blanc checks them before saving anything here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende denselben Synchronisierungsnamen und dieselbe Passphrase wie auf deinem anderen Gerät. Blanc prüft sie, bevor hier etwas gespeichert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el mismo nombre de sincronización y la misma frase de contraseña que en tu otro dispositivo. Blanc los comprueba antes de guardar nada aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le même nom de synchronisation et la même phrase secrète que sur votre autre appareil. Blanc les vérifie avant d’enregistrer quoi que ce soit ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa lo stesso nome di sincronizzazione e la stessa passphrase dell’altro dispositivo. Blanc li verifica prima di salvare qualcosa qui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o mesmo nome de sincronização e a mesma frase secreta do seu outro dispositivo. O Blanc confere os dois antes de salvar qualquer coisa aqui."
          }
        }
      }
    },
    "settings.sync.setup.handleHint": {
      "comment": "Settings → Sync setup: hint under the sync name field when starting a new sync.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A label for your sync, like a username. You’ll type it again on your other devices."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Bezeichnung für deine Synchronisierung, ähnlich einem Benutzernamen. Du gibst sie auf deinen anderen Geräten erneut ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una etiqueta para tu sincronización, como un nombre de usuario. Tendrás que volver a escribirla en tus otros dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une étiquette pour votre synchronisation, comme un nom d’utilisateur. Vous la saisirez de nouveau sur vos autres appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’etichetta per la tua sincronizzazione, come un nome utente. Dovrai digitarla di nuovo sugli altri dispositivi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um rótulo para sua sincronização, como um nome de usuário. Você vai digitá-lo de novo nos outros dispositivos."
          }
        }
      }
    },
    "settings.sync.setup.joinHandleHint": {
      "comment": "Settings → Sync setup: hint under the sync name field when joining.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the exact sync name you used on your other device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib genau den Synchronisierungsnamen ein, den du auf deinem anderen Gerät verwendet hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe exactamente el nombre de sincronización que usaste en tu otro dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
