    },
    "settings.privacy.secureDnsTemplate.label": {
      "comment": "Settings → Privacy & Security → Calls and connections: setting name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
