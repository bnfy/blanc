        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere Aktion für Spaces läuft noch. Versuche es erneut."
          }
        }
      }
    },
    "ws.error.activationFailed": {
      "comment": "Space switcher error when switching to a space fails.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t open the space. Your current pages are still available."
