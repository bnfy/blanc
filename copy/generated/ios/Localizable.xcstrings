    "settings.general.islandSiteColors.hint": {
      "comment": "Settings → General: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tint the Island bar with the color of the page you’re on. Off keeps it on your theme’s background."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Färbt die Island-Leiste in der Farbe der aktuellen Seite. Aus behält den Hintergrund deines Designs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiñe la barra de la Island con el color de la página en la que estás. Si está desactivado, mantiene el fondo de tu tema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teinte la barre de l’Island avec la couleur de la page affichée. Désactivé, elle garde le fond de votre thème."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colora la barra dell’Island con il colore della pagina in cui ti trovi. Se è disattivato, mantiene lo sfondo del tuo tema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinge a barra da Island com a cor da página em que você está. Desativado, ela mantém o fundo do seu tema."
          }
        }
      }
    },
