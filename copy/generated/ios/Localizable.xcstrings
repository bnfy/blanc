    "update.stalled.detail": {
      "comment": "Dialog detail; {command} is the Check for Updates… menu command’s name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update download stopped making progress. You can retry with “%1$@”, or reinstall from blanc.day."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download des Updates kommt nicht mehr voran. Versuche es erneut mit „%1$@“ oder installiere Blanc neu von blanc.day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga de la actualización dejó de avanzar. Puedes reintentarlo con «%1$@» o reinstalar desde blanc.day."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement de la mise à jour n’avance plus. Vous pouvez réessayer avec « %1$@ » ou réinstaller depuis blanc.day."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il download dell’aggiornamento ha smesso di avanzare. Puoi riprovare con «%1$@» o reinstallare Blanc da blanc.day."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O download da atualização parou de avançar. Você pode tentar de novo com “%1$@” ou reinstalar a partir de blanc.day."
          }
        }
      }
    },
