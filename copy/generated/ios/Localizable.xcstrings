    "fill.notAuthorized.body": {
      "comment": "Fill notice body; \"Blanc\" is the name 1Password shows in its approval prompt (macOS: \"Blanc Browser\").",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock 1Password and approve Blanc, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperre 1Password, erlaube Blanc und versuche es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea 1Password y aprueba Blanc; luego inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez 1Password et approuvez Blanc, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca 1Password e approva Blanc, poi riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie o 1Password e aprove o Blanc; depois tente de novo."
          }
        }
      }
    },
