      }
    },
    "pill.fillHint": {
      "comment": "Tooltip and accessible name of the 1Password fill chip; {shortcut} is ⌥⌘P on macOS or Ctrl+Shift+P on Windows and Linux.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill login from 1Password (%1$@)"
          }
