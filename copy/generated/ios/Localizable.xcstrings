    "tabImport.source.none": {
      "comment": "Bring Your Tabs page → step 1 (choose a browser and profile): shown when no supported browser is found; {browsers} is a list such as “Google Chrome, Brave and Chromium”. “Import HTML…” is the Favorites page button (favorites.import.html); use its translation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc can bring open tabs from %1$@, but none of them has a profile on this device. To bring bookmarks from another browser, export them to an HTML file, then use “Import HTML…” in Favorites."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc kann offene Tabs aus %1$@ mitbringen, aber keiner davon hat ein Profil auf diesem Gerät. Um Lesezeichen aus einem anderen Browser mitzubringen, exportiere sie in eine HTML-Datei und nutze dann „HTML importieren…“ in den Favoriten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc puede traer pestañas abiertas de %1$@, pero ninguno tiene un perfil en este dispositivo. Para traer marcadores de otro navegador, expórtalos a un archivo HTML y usa «Importar HTML…» en Favoritos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc peut récupérer les onglets ouverts de %1$@, mais aucun n’a de profil sur cet appareil. Pour récupérer les marque-pages d’un autre navigateur, exportez-les dans un fichier HTML, puis utilisez « Importer HTML… » dans les Favoris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc può portare qui le schede aperte da %1$@, ma nessuno di questi ha un profilo su questo dispositivo. Per portare i segnalibri da un altro browser, esportali in un file HTML, poi usa “Importa HTML…” nei Preferiti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Blanc consegue trazer abas abertas de %1$@, mas nenhum deles tem um perfil neste dispositivo. Para trazer favoritos de outro navegador, exporte-os para um arquivo HTML e use “Importar HTML…” em Favoritos."
          }
        }
      }
    },
