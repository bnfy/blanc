    "settings.general.darkWebsites.hint": {
      "comment": "Settings → General: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While Blanc is dark, darken websites that have no dark mode of their own. Uses the open-source Dark Reader engine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange Blanc dunkel ist, werden Websites ohne eigenen Dunkelmodus abgedunkelt. Nutzt die Open-Source-Engine Dark Reader."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras Blanc está oscuro, oscurece los sitios web que no tienen modo oscuro propio. Usa el motor de código abierto Dark Reader."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand Blanc est sombre, assombrit les sites web sans mode sombre. Utilise le moteur open source Dark Reader."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando Blanc è scuro, scurisce i siti web che non hanno una modalità scura propria. Usa il motore open source Dark Reader."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto o Blanc está escuro, escurece os sites que não têm modo escuro próprio. Usa o motor de código aberto Dark Reader."
          }
        }
      }
    },
    "settings.general.sitesListedHereKeep": {
      "comment": "Settings → General: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
