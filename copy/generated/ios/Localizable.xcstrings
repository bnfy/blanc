    "settings.help.blancUsesChromiumThrough": {
      "comment": "Settings → Help → About Blanc: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc uses Chromium through Electron to render websites. Updates to Electron and Chromium arrive with new Blanc releases and replace the whole app. Applying an update requires restarting Blanc."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc nutzt Chromium über Electron, um Websites darzustellen. Updates von Electron und Chromium kommen mit neuen Blanc-Releases und ersetzen die ganze App. Zum Anwenden eines Updates muss Blanc neu gestartet werden."
          }
        }
      }
    },
    "settings.help.checkForUpdates": {
