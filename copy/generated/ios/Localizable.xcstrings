    "settings.privacy.useViewFill": {
      "comment": "Settings → Privacy & Security → 1Password: how to fill a login; <0>/1password</0> is a slash command (keep it), the menu path and shortcuts are the app’s own.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use View → Fill Login from 1Password or <0>/1password</0>. On Mac: ⌥⌘P. On Windows and Linux: Ctrl+Shift+P."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze Darstellung → Login aus 1Password ausfüllen oder <0>/1password</0>. Auf dem Mac: ⌥⌘P. Unter Windows und Linux: Strg+Umschalt+P."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Visualización → Rellenar el inicio de sesión desde 1Password o <0>/1password</0>. En Mac: ⌥⌘P. En Windows y Linux: Ctrl+Mayús+P."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Présentation → Remplir l’identifiant depuis 1Password ou <0>/1password</0>. Sur Mac : ⌥⌘P. Sur Windows et Linux : Ctrl+Maj+P."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Vista → Compila l’accesso da 1Password oppure <0>/1password</0>. Su Mac: ⌥⌘P. Su Windows e Linux: Ctrl+Maiusc+P."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Visualizar → Preencher login do 1Password ou <0>/1password</0>. No Mac: ⌥⌘P. No Windows e no Linux: Ctrl+Shift+P."
          }
        }
      }
    },
