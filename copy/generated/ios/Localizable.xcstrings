    "settings.privacy.webrtcPolicy.hint": {
      "comment": "Settings → Privacy & Security → Calls and connections: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard limits calls to your default network route. If a call stutters or won't connect, try Compatibility; it can reveal local network addresses to the site. Strict is for application-proxy users."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard beschränkt Anrufe auf deine Standard-Netzwerkroute. Wenn ein Anruf ruckelt oder keine Verbindung zustande kommt, versuche Kompatibilität; dabei kann die Website lokale Netzwerkadressen sehen. Streng ist für Nutzer von Anwendungs-Proxys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estándar limita las llamadas a tu ruta de red predeterminada. Si una llamada se corta o no conecta, prueba Compatibilidad; puede revelar al sitio las direcciones de tu red local. Estricto es para quienes usan un proxy de aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard limite les appels à votre route réseau par défaut. Si un appel saccade ou ne se connecte pas, essayez Compatibilité ; cela peut révéler au site les adresses de votre réseau local. Strict est destiné aux utilisateurs d’un proxy d’application."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard limita le chiamate al percorso di rete predefinito. Se una chiamata va a scatti o non si connette, prova Compatibilità; può rivelare al sito gli indirizzi della tua rete locale. Rigoroso è per chi usa un proxy a livello di applicazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Padrão limita as chamadas à sua rota de rede padrão. Se uma chamada falhar ou não conectar, tente Compatibilidade; ela pode revelar ao site endereços da sua rede local. Restrito é para quem usa proxy de aplicativo."
          }
        }
      }
    },
