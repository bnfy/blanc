    "arcImport.stays": {
      "comment": "What the Arc import does not bring.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-ins, passwords, history and archived tabs stay in Arc. Blanc only reads Arc’s file and changes nothing there."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldungen, Passwörter, Verlauf und archivierte Tabs bleiben in Arc. Blanc liest nur die Datei von Arc und ändert dort nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los inicios de sesión, contraseñas, historial y pestañas archivadas se quedan en Arc. Blanc solo lee el archivo de Arc y no cambia nada allí."
          }
