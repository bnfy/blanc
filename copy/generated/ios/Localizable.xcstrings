    "onboarding.blocking.title": {
      "comment": "Onboarding dialog → step 4: heading.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block ads & trackers"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werbung & Tracker blockieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea anuncios y rastreadores"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquez les publicités et traceurs"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca annunci e tracker"
          }
        },
        "pt-BR": {
