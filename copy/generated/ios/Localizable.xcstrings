    "settings.privacy.webrtcPolicy.label": {
      "comment": "Settings → Privacy & Security → Calls and connections: setting name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IP address in video calls"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "IP-Adresse in Videoanrufen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirección IP en videollamadas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse IP dans les appels vidéo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indirizzo IP nelle videochiamate"
          }
        },
        "pt-BR": {
