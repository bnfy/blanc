    "slash.private.hint": {
      "comment": "Slash command hint shown in the ⌘L palette for /private.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a private tab (history stays untouched)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Privaten Tab öffnen (der Verlauf bleibt unberührt)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir una pestaña privada (no afecta al historial)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir un onglet privé (l’historique reste intact)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri una scheda privata (la cronologia resta intatta)"
