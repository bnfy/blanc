    "siteSecurity.secure.summaryPrivateRoot": {
      "comment": "Site information summary for HTTPS whose certificate chains to a locally installed root (for example a company proxy).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted. The certificate is trusted by this device, but its issuer is not a standard public root."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselt. Dieses Gerät vertraut dem Zertifikat, sein Aussteller ist aber keine öffentliche Standard-Stammzertifizierungsstelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifrada. Este dispositivo confía en el certificado, pero su emisor no es una raíz pública estándar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffrée. Cet appareil fait confiance au certificat, mais son émetteur n’est pas une racine publique standard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifrata. Questo dispositivo considera attendibile il certificato, ma il suo emittente non è una radice pubblica standard."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criptografada. Este dispositivo confia no certificado, mas o emissor não é uma raiz pública padrão."
          }
        }
      }
    },
