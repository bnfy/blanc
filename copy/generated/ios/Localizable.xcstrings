    "settings.privacy.secureDnsError": {
      "comment": "Settings → Privacy & Security → Calls and connections: error shown when the custom DNS address is invalid.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That address isn't valid — the previous provider is still in use."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
