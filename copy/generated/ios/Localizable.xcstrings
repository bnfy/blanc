    "tabHandoff.summaryHere": {
      "comment": "Tab handoff page (tabs sent to Blanc from another browser): summary; {source} is a browser name or “your other browser”, {profile} a Blanc profile name such as “Personal”. Quiet tabs are Quiet Tabs.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld tab from %2$@ will open in this %3$@ window. Only the selected imported tab loads now; the rest start quiet."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld tabs from %2$@ will open in this %3$@ window. Only the selected imported tab loads now; the rest start quiet."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld Tab aus %2$@ wird in diesem %3$@-Fenster geöffnet. Nur der ausgewählte importierte Tab wird jetzt geladen; der Rest startet ruhend."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld Tabs aus %2$@ werden in diesem %3$@-Fenster geöffnet. Nur der ausgewählte importierte Tab wird jetzt geladen; der Rest startet ruhend."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld pestaña de %2$@ se abrirá en esta ventana de %3$@. Solo se carga ahora la pestaña importada seleccionada; las demás empiezan en reposo."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld pestañas de %2$@ se abrirán en esta ventana de %3$@. Solo se carga ahora la pestaña importada seleccionada; las demás empiezan en reposo."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld pestañas de %2$@ se abrirán en esta ventana de %3$@. Solo se carga ahora la pestaña importada seleccionada; las demás empiezan en reposo."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld onglet de %2$@ s’ouvrira dans cette fenêtre %3$@. Seul l’onglet importé sélectionné se charge maintenant ; les autres démarrent en veille."
                }
              },
              "many": {
                "stringUnit": {
