    "settings.onePassword.error.unsupportedDevice": {
      "comment": "Settings → Privacy → 1Password: shown in place of the app hint and as the Verify result on a PC where fill can’t work. Keep “Windows on Arm”, “x64” and “Arm” as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1Password fill isn’t available on this PC. On Windows on Arm, Blanc runs as an x64 app, and the Arm version of 1Password can’t connect to it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausfüllen mit 1Password ist auf diesem PC nicht verfügbar. Unter Windows on Arm läuft Blanc als x64-App, und die Arm-Version von 1Password kann sich nicht damit verbinden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellenar con 1Password no está disponible en este PC. En Windows on Arm, Blanc funciona como una app x64 y la versión Arm de 1Password no puede conectarse con ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le remplissage avec 1Password n’est pas disponible sur ce PC. Sur Windows on Arm, Blanc fonctionne comme une app x64, et la version Arm de 1Password ne peut pas s’y connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La compilazione con 1Password non è disponibile su questo PC. Su Windows on Arm, Blanc funziona come app x64 e la versione Arm di 1Password non può connettersi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O preenchimento com o 1Password não está disponível neste PC. No Windows on Arm, o Blanc roda como um app x64, e a versão Arm do 1Password não consegue se conectar a ele."
          }
        }
      }
    },
    "settings.onePassword.error.timedOut": {
