    "settings.diagnostics.blancKeepsALocal": {
      "comment": "Settings → Diagnostics: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc keeps a local, 50-event crash ledger with timestamps, process type, and failure reason. It never includes URLs, page titles, history, profile names, account data, identifiers, quiet-tab state, or closed-tab state, and nothing is sent automatically."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc führt ein lokales Absturzprotokoll mit 50 Einträgen samt Zeitstempel, Prozesstyp und Fehlergrund. Es enthält nie URLs, Seitentitel, Verlauf, Profilnamen, Kontodaten, Kennungen, den Zustand ruhender Tabs oder geschlossener Tabs, und nichts wird automatisch gesendet."
          }
        }
      }
    },
    "settings.diagnostics.diagnosticsSummary": {
      "comment": "Settings → Diagnostics: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
