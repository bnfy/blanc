    "settings.general.tabSleep.hint": {
      "comment": "Settings → General: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc frees the memory of tabs you have not opened in a while, and reloads them when you come back to them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc gibt den Speicher von Tabs frei, die du länger nicht geöffnet hast, und lädt sie neu, wenn du zu ihnen zurückkehrst. Solche Tabs werden zu ruhenden Tabs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc libera la memoria de las pestañas que no has abierto en un tiempo y las recarga cuando vuelves a ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc libère la mémoire des onglets que vous n’avez pas ouverts depuis un moment, et les recharge quand vous y revenez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc libera la memoria delle schede che non apri da un po’ e le ricarica quando ci torni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Blanc libera a memória das abas que você não abre há algum tempo e as recarrega quando você volta a elas."
          }
        }
      }
    },
