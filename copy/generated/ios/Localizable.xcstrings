          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati del profilo sono stati rimossi, ma la pulizia finale verrà ritentata automaticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados do perfil foram removidos, mas a limpeza final será refeita automaticamente."
          }
        }
      }
    },
    "window.closeFailed.message": {
      "comment": "Dialog when a window’s workspace could not be saved before closing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t close this window safely"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Fenster konnte nicht sicher geschlossen werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cerrar esta ventana con seguridad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de fermer cette fenêtre en toute sécurité"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile chiudere questa finestra in sicurezza"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível fechar esta janela com segurança"
          }
        }
      }
    },
    "window.closeFailed.detail": {
      "comment": "Dialog detail when a window could not close safely.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc couldn’t save its latest workspace state. Check available disk space and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc konnte den letzten Stand des Arbeitsbereichs nicht speichern. Prüfe den freien Speicherplatz und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc no pudo guardar el último estado de su espacio de trabajo. Comprueba el espacio libre en el disco e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc n’a pas pu enregistrer le dernier état de son espace de travail. Vérifiez l’espace disque disponible et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc non è riuscito a salvare lo stato più recente del suo spazio di lavoro. Controlla lo spazio libero su disco e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Blanc não conseguiu salvar o estado mais recente do espaço de trabalho. Verifique o espaço livre em disco e tente de novo."
          }
        }
      }
    },
    "session.error.replaceFailed": {
      "comment": "Start page session-recovery error after choosing to start fresh.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t replace the saved session. Check disk access and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherte Sitzung konnte nicht ersetzt werden. Prüfe den Zugriff auf den Datenträger und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo reemplazar la sesión guardada. Comprueba el acceso al disco e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de remplacer la session enregistrée. Vérifiez l’accès au disque et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile sostituire la sessione salvata. Controlla l’accesso al disco e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível substituir a sessão salva. Verifique o acesso ao disco e tente de novo."
          }
        }
      }
    },
    "session.error.choiceFailed": {
      "comment": "Start page session-recovery error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save the recovery choice. Check disk access and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiederherstellungsauswahl konnte nicht gespeichert werden. Prüfe den Zugriff auf den Datenträger und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
