{
  "sourceLanguage": "en",
  "strings": {
    "slash.favorites.hint": {
      "comment": "Slash command hint shown in the ⌘L palette for /favorites.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open favorites"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriten öffnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir favoritos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir les favoris"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri i preferiti"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir favoritos"
          }
        }
      }
    },
    "slash.bringTabs.hint": {
      "comment": "Slash command hint shown in the ⌘L palette for /bring-tabs.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring open tabs from another browser"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offene Tabs aus einem anderen Browser übernehmen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traer las pestañas abiertas de otro navegador"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupérer les onglets ouverts d’un autre navigateur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta qui le schede aperte da un altro browser"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trazer abas abertas de outro navegador"
          }
        }
      }
    },
    "slash.save.hint": {
      "comment": "Slash command hint shown in the ⌘L palette for /save.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save this page to favorites — name a folder to file it"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Seite zu den Favoriten hinzufügen – mit Ordnernamen direkt einsortieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar esta página en favoritos; escribe el nombre de una carpeta para archivarla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer cette page dans les favoris — indiquez un dossier pour l’y classer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva questa pagina nei preferiti — indica una cartella per archiviarla"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar esta página nos favoritos — digite o nome de uma pasta para arquivá-la"
          }
        }
      }
    },
    "slash.save.doc": {
      "comment": "Reference description of /save [folder] on blanc://shortcuts and in Help → Slash Commands.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save this page to favorites, into a folder if you name one"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Seite zu den Favoriten hinzufügen, in einen Ordner, wenn du einen nennst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda esta página en favoritos, en una carpeta si indicas su nombre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre cette page dans les favoris, dans un dossier si vous en indiquez un"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva questa pagina nei preferiti, in una cartella se ne indichi una"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva esta página nos favoritos, numa pasta se você informar o nome"
          }
        }
      }
    },
    "slash.history.hint": {
      "comment": "Slash command hint shown in the ⌘L palette for /history.",
      "extractionState": "manual",
      "localizations": {
        "en": {
