    "tabImport.quit.body": {
      "comment": "Bring Your Tabs page → step 1, when the other browser is still open: explanation; {browser} is its name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Blanc found a saved, restorable session with %1$lld tab. Quit %2$@ normally so it can finish saving the latest session. Blanc only reads it and never removes tabs from %2$@."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Blanc found a saved, restorable session with %1$lld tabs. Quit %2$@ normally so it can finish saving the latest session. Blanc only reads it and never removes tabs from %2$@."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Blanc hat eine gespeicherte, wiederherstellbare Sitzung mit %1$lld Tab gefunden. Beende %2$@ normal, damit die neueste Sitzung fertig gespeichert wird. Blanc liest sie nur und entfernt nie Tabs aus %2$@."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Blanc hat eine gespeicherte, wiederherstellbare Sitzung mit %1$lld Tabs gefunden. Beende %2$@ normal, damit die neueste Sitzung fertig gespeichert wird. Blanc liest sie nur und entfernt nie Tabs aus %2$@."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Blanc encontró una sesión guardada y restaurable con %1$lld pestaña. Cierra %2$@ con normalidad para que termine de guardar la última sesión. Blanc solo la lee y nunca quita pestañas de %2$@."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Blanc encontró una sesión guardada y restaurable con %1$lld pestañas. Cierra %2$@ con normalidad para que termine de guardar la última sesión. Blanc solo la lee y nunca quita pestañas de %2$@."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Blanc encontró una sesión guardada y restaurable con %1$lld pestañas. Cierra %2$@ con normalidad para que termine de guardar la última sesión. Blanc solo la lee y nunca quita pestañas de %2$@."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Blanc a trouvé une session enregistrée et restaurable avec %1$lld onglet. Quittez %2$@ normalement pour qu’il termine d’enregistrer la dernière session. Blanc la lit seulement et ne retire jamais d’onglets de %2$@."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Blanc a trouvé une session enregistrée et restaurable avec %1$lld onglets. Quittez %2$@ normalement pour qu’il termine d’enregistrer la dernière session. Blanc la lit seulement et ne retire jamais d’onglets de %2$@."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Blanc a trouvé une session enregistrée et restaurable avec %1$lld onglets. Quittez %2$@ normalement pour qu’il termine d’enregistrer la dernière session. Blanc la lit seulement et ne retire jamais d’onglets de %2$@."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Blanc ha trovato una sessione salvata e ripristinabile con %1$lld scheda. Esci da %2$@ normalmente, così potrà completare il salvataggio dell’ultima sessione. Blanc si limita a leggerla e non rimuove mai schede da %2$@."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Blanc ha trovato una sessione salvata e ripristinabile con %1$lld schede. Esci da %2$@ normalmente, così potrà completare il salvataggio dell’ultima sessione. Blanc si limita a leggerla e non rimuove mai schede da %2$@."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Blanc ha trovato una sessione salvata e ripristinabile con %1$lld schede. Esci da %2$@ normalmente, così potrà completare il salvataggio dell’ultima sessione. Blanc si limita a leggerla e non rimuove mai schede da %2$@."
                }
              }
            }
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "O Blanc encontrou uma sessão salva e restaurável com %1$lld aba. Feche o %2$@ normalmente para ele terminar de salvar a sessão mais recente. O Blanc só a lê e nunca remove abas do %2$@."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "O Blanc encontrou uma sessão salva e restaurável com %1$lld abas. Feche o %2$@ normalmente para ele terminar de salvar a sessão mais recente. O Blanc só a lê e nunca remove abas do %2$@."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "O Blanc encontrou uma sessão salva e restaurável com %1$lld abas. Feche o %2$@ normalmente para ele terminar de salvar a sessão mais recente. O Blanc só a lê e nunca remove abas do %2$@."
                }
              }
            }
          }
        }
      }
    },
