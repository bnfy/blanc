    "arcImport.mode.spaces": {
      "comment": "Bring Your Tabs → Arc preview: what the import does. Blanc Spaces is the feature; a space is one saved set.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each Arc Space becomes a space in Blanc Spaces. Folders become groups, and tabs load only when you open them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Space aus Arc wird zu einem Space in Blanc Spaces. Ordner werden zu Gruppen, und Tabs laden erst, wenn du sie öffnest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada Space de Arc se convierte en un Space de Blanc Spaces. Las carpetas pasan a ser grupos y las pestañas solo se cargan cuando las abres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque Space d’Arc devient un Space dans Blanc Spaces. Les dossiers deviennent des groupes, et les onglets ne se chargent que lorsque vous les ouvrez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni Space di Arc diventa uno Space in Blanc Spaces. Le cartelle diventano gruppi e le schede si caricano solo quando le apri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada Space do Arc vira um Space no Blanc Spaces. As pastas viram grupos, e as abas só carregam quando você as abre."
          }
        }
      }
    },
