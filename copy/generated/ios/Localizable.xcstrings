        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo trasferimento contiene più di %1$@ schede. Selezionane meno e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta transferência tem mais de %1$@ abas. Selecione um conjunto menor e tente de novo."
          }
        }
      }
    },
