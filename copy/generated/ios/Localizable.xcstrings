    "settings.help.blancUsesChromiumThrough": {
      "comment": "Settings → Help → About Blanc: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc uses Chromium through Electron to render websites. Updates to Electron and Chromium arrive with new Blanc releases and replace the whole app. Applying an update requires restarting Blanc."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc nutzt Chromium über Electron, um Websites darzustellen. Updates von Electron und Chromium kommen mit neuen Blanc-Releases und ersetzen die ganze App. Zum Anwenden eines Updates muss Blanc neu gestartet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc usa Chromium a través de Electron para mostrar los sitios web. Las actualizaciones de Electron y Chromium llegan con las nuevas versiones de Blanc y sustituyen la app entera. Para aplicar una actualización hay que reiniciar Blanc."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc utilise Chromium via Electron pour afficher les sites web. Les mises à jour d’Electron et de Chromium arrivent avec les nouvelles versions de Blanc et remplacent l’app entière. Appliquer une mise à jour nécessite de redémarrer Blanc."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc usa Chromium tramite Electron per mostrare i siti web. Gli aggiornamenti di Electron e Chromium arrivano con le nuove versioni di Blanc e sostituiscono l’intera app. Per applicare un aggiornamento bisogna riavviare Blanc."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Blanc usa o Chromium por meio do Electron para exibir os sites. As atualizações do Electron e do Chromium chegam com as novas versões do Blanc e substituem o app inteiro. Aplicar uma atualização exige reiniciar o Blanc."
          }
        }
      }
    },
