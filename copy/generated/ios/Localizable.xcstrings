    "settings.sync.syncSetupIntro": {
      "comment": "Settings → Sync → Set up Sync: text (p).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync your favorites and settings across your devices, and, if you choose, open tabs. Everything is end-to-end encrypted — Blanc can’t read it, and can’t recover it if you forget your passphrase."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisiere deine Favoriten und Einstellungen und auf Wunsch auch offene Tabs zwischen deinen Geräten. Alles ist Ende-zu-Ende-verschlüsselt – Blanc kann es weder lesen noch wiederherstellen, wenn du deine Passphrase vergisst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza tus favoritos y tus ajustes entre tus dispositivos y, si quieres, también las pestañas abiertas. Todo está cifrado de extremo a extremo: Blanc no puede leerlo ni recuperarlo si olvidas tu frase de contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisez vos favoris et vos réglages entre vos appareils et, si vous le souhaitez, vos onglets ouverts. Tout est chiffré de bout en bout : Blanc ne peut pas le lire, ni le récupérer si vous oubliez votre phrase secrète."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizza i tuoi preferiti e le impostazioni tra i tuoi dispositivi e, se vuoi, anche le schede aperte. Tutto è crittografato end-to-end: Blanc non può leggerlo né recuperarlo se dimentichi la passphrase."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronize seus favoritos e configurações entre seus dispositivos e, se quiser, as abas abertas. Tudo é criptografado de ponta a ponta — o Blanc não consegue ler nem recuperar se você esquecer sua frase secreta."
          }
        }
      }
    },
