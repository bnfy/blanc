    "settings.privacy.secureDns.label": {
      "comment": "Settings → Privacy & Security → Calls and connections: setting name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted DNS"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsseltes DNS"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS cifrado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS chiffré"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS crittografato"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS criptografado"
          }
        }
      }
    },
    "settings.privacy.secureDns.hint": {
      "comment": "Settings → Privacy & Security → Calls and connections: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypts the behind-the-scenes lookups that turn a web address into a connection, so someone sniffing those lookups can't read the names. It does not hide the sites you visit from your network, and it makes the DNS provider someone you trust. Automatic uses encryption when it can and may fall back to ordinary DNS — safe to leave on. If a Wi-Fi login page won't load, switch to Automatic or Off temporarily."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselt die Hintergrundabfragen, die eine Webadresse in eine Verbindung übersetzen, sodass jemand, der diese Abfragen mitliest, die Namen nicht lesen kann. Es verbirgt die besuchten Websites nicht vor deinem Netzwerk und macht den DNS-Anbieter zu jemandem, dem du vertraust. Automatisch verschlüsselt, wenn möglich, und kann auf normales DNS zurückfallen – du kannst es bedenkenlos anlassen. Wenn eine WLAN-Anmeldeseite nicht lädt, wechsle vorübergehend zu Automatisch oder Aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifra las consultas internas que convierten una dirección web en una conexión, para que quien espíe esas consultas no pueda leer los nombres. No oculta a tu red los sitios que visitas y convierte al proveedor de DNS en alguien en quien confías. Automático usa cifrado cuando puede y puede volver al DNS normal: es seguro dejarlo activado. Si no carga la página de inicio de sesión de una red wifi, cambia temporalmente a Automático o Desactivado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffre les requêtes en coulisses qui transforment une adresse web en connexion, pour qu’une personne qui les espionne ne puisse pas lire les noms. Cela ne cache pas à votre réseau les sites que vous visitez, et vous devez faire confiance au fournisseur DNS. Automatique utilise le chiffrement quand c’est possible et peut revenir au DNS ordinaire — vous pouvez le laisser activé. Si une page de connexion Wi-Fi ne se charge pas, passez temporairement à Automatique ou Désactivé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crittografa le ricerche dietro le quinte che trasformano un indirizzo web in una connessione, così chi intercetta quelle ricerche non può leggerne i nomi. Non nasconde alla tua rete i siti che visiti e rende il provider DNS qualcuno di cui ti fidi. Automatico usa la crittografia quando può e può tornare al DNS normale: puoi lasciarlo attivo senza problemi. Se la pagina di accesso di una rete Wi-Fi non si carica, passa temporaneamente ad Automatico o Disattivato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criptografa as consultas internas que transformam um endereço da web em uma conexão, para que quem bisbilhota essas consultas não consiga ler os nomes. Isso não esconde da sua rede os sites que você visita, e faz do provedor de DNS alguém em quem você confia. Automático usa criptografia quando pode e pode voltar ao DNS comum — dá para deixar ativado. Se uma página de login de Wi-Fi não carregar, mude temporariamente para Automático ou Desativado."
          }
        }
      }
    },
