    "settings.general.searchSuggestions.hint": {
      "comment": "Settings → General: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send eligible typed prefixes to your selected search provider, including Google if selected. Private tabs and recognized sensitive-looking input are excluded. Submitting a search sends the completed query even when suggestions are off."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet geeignete eingetippte Anfänge an deinen gewählten Suchanbieter, auch an Google, wenn ausgewählt. Private Tabs und erkennbar sensibel wirkende Eingaben sind ausgenommen. Eine abgeschickte Suche sendet die vollständige Anfrage, auch wenn Vorschläge aus sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía los comienzos aptos de lo que escribes al buscador elegido, incluido Google si lo eliges. Se excluyen las pestañas privadas y lo que parece información sensible. Al enviar una búsqueda se manda la consulta completa aunque las sugerencias estén desactivadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie les débuts de saisie éligibles au moteur de recherche choisi, y compris Google si vous l’avez choisi. Les onglets privés et les saisies qui semblent sensibles sont exclus. Lancer une recherche envoie la requête complète même si les suggestions sont désactivées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia i prefissi idonei che digiti al motore di ricerca selezionato, incluso Google se lo hai scelto. Le schede private e il testo riconosciuto come potenzialmente sensibile sono esclusi. Avviare una ricerca invia la query completa anche quando i suggerimenti sono disattivati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia os começos elegíveis do que você digita ao provedor de pesquisa escolhido, inclusive o Google, se escolhido. Abas privadas e textos que parecem sensíveis ficam de fora. Fazer uma pesquisa envia a consulta completa mesmo com as sugestões desativadas."
          }
        }
      }
    },
