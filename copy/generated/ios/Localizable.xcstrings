    "settings.privacy.useViewFill": {
      "comment": "Settings → Privacy & Security → 1Password: how to fill a login; <0>/1password</0> is a slash command (keep it), the menu path and shortcuts are the app’s own.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use View → Fill Login from 1Password or <0>/1password</0>. On Mac: ⌥⌘P. On Windows and Linux: Ctrl+Shift+P."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze Darstellung → Login aus 1Password ausfüllen oder <0>/1password</0>. Auf dem Mac: ⌥⌘P. Unter Windows und Linux: Strg+Umschalt+P."
          }
        }
      }
    },
