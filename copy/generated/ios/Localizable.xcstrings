    "mahjong.live.rackNeedsMatch": {
      "comment": "Mahjong: announced to screen readers.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Burst rack needs a match. Use Undo or Shuffle instead of filling the last slot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Burst-Ablage braucht ein Paar. Nutze Rückgängig oder Mischen, statt den letzten Platz zu füllen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La bandeja Burst necesita una pareja. Usa Deshacer o Barajar en lugar de llenar el último hueco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réserve Burst a besoin d’une paire. Utilisez Annuler ou Mélanger plutôt que de remplir la dernière case."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vassoio Burst ha bisogno di una coppia. Usa Annulla o Mescola invece di riempire l’ultima casella."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A bandeja Burst precisa de um par. Use Desfazer ou Embaralhar em vez de ocupar o último espaço."
          }
        }
      }
    },
