    "slash.blockAds.hint": {
      "comment": "Slash command hint shown in the ⌘L palette for /block-ads.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block ads here, or toggle blocking everywhere"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werbung hier blockieren oder das Blockieren überall umschalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear anuncios aquí o activar o desactivar el bloqueo en todas partes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
