        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra ação de Spaces ainda está terminando. Tente de novo."
          }
        }
      }
    },
    "ws.error.activationFailed": {
      "comment": "Space switcher error when switching to a space fails.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t open the space. Your current pages are still available."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Space konnte nicht geöffnet werden. Deine aktuellen Seiten sind weiterhin verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir el Space. Tus páginas actuales siguen disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir le Space. Vos pages actuelles restent disponibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire lo Space. Le pagine attuali sono ancora disponibili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o Space. Suas páginas atuais continuam disponíveis."
          }
        }
      }
    },
    "ws.error.savedNotOpened": {
      "comment": "Space switcher error when a new space was saved but switching to it failed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The space was saved, but Blanc couldn’t open it. It remains in your space list."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Space wurde gespeichert, aber Blanc konnte ihn nicht öffnen. Er bleibt in deiner Liste der Spaces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Space se guardó, pero Blanc no pudo abrirlo. Sigue en tu lista de Spaces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Space a été enregistré, mais Blanc n’a pas pu l’ouvrir. Il reste dans votre liste de Spaces."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo Space è stato salvato, ma Blanc non è riuscito ad aprirlo. Resta nel tuo elenco degli Spaces."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Space foi salvo, mas o Blanc não conseguiu abri-lo. Ele continua na sua lista de Spaces."
          }
        }
      }
    },
    "ws.error.recoveryDuplicate": {
