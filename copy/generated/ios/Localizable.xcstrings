    "slash.close.hint": {
      "comment": "Slash command hint shown in the ⌘L palette for /close.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close this tab"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Tab schließen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar esta pestaña"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer cet onglet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi questa scheda"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar esta aba"
          }
        }
      }
    },
    "slash.reopen.hint": {
      "comment": "Slash command hint shown in the ⌘L palette for /reopen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopen the tab you just closed"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuletzt geschlossenen Tab wieder öffnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a abrir la pestaña que acabas de cerrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouvrir l’onglet que vous venez de fermer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riapri la scheda che hai appena chiuso"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reabrir a aba que você acabou de fechar"
          }
        }
      }
    },
    "slash.pin.hint": {
      "comment": "Slash command hint shown in the ⌘L palette for /pin.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin or unpin this tab"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Tab anheften oder lösen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijar o soltar esta pestaña"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épingler ou détacher cet onglet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fissa o rilascia questa scheda"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixar ou desafixar esta aba"
          }
        }
      }
    },
    "slash.mute.hint": {
      "comment": "Slash command hint shown in the ⌘L palette for /mute.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute or unmute this tab"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Tab stummschalten oder den Ton wieder einschalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Silenciar o activar el sonido de esta pestaña"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couper ou rétablir le son de cet onglet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva o riattiva l’audio di questa scheda"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Silenciar ou reativar o som desta aba"
          }
        }
      }
    },
    "slash.sleep.hint": {
      "comment": "Slash command hint shown in the ⌘L palette for /sleep.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet background tabs and free their memory"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrund-Tabs ruhen lassen und ihren Speicher freigeben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poner en reposo las pestañas en segundo plano y liberar su memoria"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre en veille les onglets en arrière-plan et libérer leur mémoire"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti in riposo le schede in background e libera la loro memoria"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar as abas em segundo plano em repouso e liberar a memória delas"
          }
        }
      }
    },
    "slash.group.hint": {
      "comment": "Slash command hint shown in the ⌘L palette for /group.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a space, then a group name — e.g. \"work\""
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leerzeichen, dann einen Gruppennamen eingeben – z. B. „arbeit“"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un espacio y luego el nombre de un grupo, p. ej., «trabajo»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un espace, puis un nom de groupe — p. ex. « travail »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita uno spazio, poi il nome di un gruppo — ad es. «lavoro»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um espaço e depois o nome de um grupo — por exemplo, “trabalho”"
          }
        }
      }
    },
    "slash.group.doc": {
      "comment": "Reference description of /group <name> on blanc://shortcuts and in Help → Slash Commands.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move this tab into a group, creating it on first use"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Tab in eine Gruppe verschieben (wird beim ersten Mal angelegt)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve esta pestaña a un grupo y lo crea la primera vez"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplace cet onglet dans un groupe, en le créant la première fois"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta questa scheda in un gruppo, creandolo al primo utilizzo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Move esta aba para um grupo, criando-o no primeiro uso"
          }
        }
      }
    },
    "slash.ungroup.hint": {
      "comment": "Slash command hint shown in the ⌘L palette for /ungroup.",
