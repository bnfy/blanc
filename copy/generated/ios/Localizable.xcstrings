    "ws.decision.capacity": {
      "comment": "Shown before switching space when no more spaces can be kept in memory.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your retained spaces are full. Open this space in another window to keep your pages available."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine im Speicher gehaltenen Spaces sind voll. Öffne diesen Space in einem anderen Fenster, damit deine Seiten verfügbar bleiben."
          }
        }
      }
    },
    "ws.decision.protected": {
      "comment": "Shown before switching space when a page in this window is busy (for example uploading or capturing).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This window has pages that need to stay open. Open the space in another window, or finish the active page operation and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Fenster sind Seiten, die geöffnet bleiben müssen. Öffne den Space in einem anderen Fenster oder schließe den laufenden Vorgang auf der Seite ab und versuche es erneut."
          }
        }
      }
    },
    "ws.decision.closePrivate": {
      "comment": "Shown before switching space when every tab that would close is private.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
