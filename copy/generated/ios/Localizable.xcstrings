    "settings.profiles.namedProfilesKeepSeparate": {
      "comment": "Settings → Profiles: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Named profiles keep separate cookies, site data, Favorites, history, downloads, and remembered permissions. Device settings and Patron status stay shared; Sync belongs to Personal only."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benannte Profile haben getrennte Cookies, Websitedaten, Favoriten, Verlauf, Downloads und gespeicherte Berechtigungen. Geräteeinstellungen und der Patron-Status bleiben gemeinsam; die Synchronisierung gehört nur zu Personal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los perfiles con nombre tienen sus propias cookies, datos de sitios, Favoritos, historial, descargas y permisos recordados. Los ajustes del dispositivo y el estado de Patron se comparten; la sincronización solo pertenece a Personal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils nommés ont leurs propres cookies, données de sites, Favoris, historique, téléchargements et autorisations mémorisées. Les réglages de l’appareil et le statut Patron restent partagés ; la synchronisation appartient uniquement à Personal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I profili con nome hanno cookie, dati dei siti, Preferiti, cronologia, download e autorizzazioni ricordate separati. Le impostazioni del dispositivo e lo stato di Patron restano condivisi; la sincronizzazione appartiene solo a Personale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfis com nome mantêm cookies, dados de sites, Favoritos, histórico, downloads e permissões lembradas separados. As configurações do dispositivo e o status de Patron são compartilhados; a sincronização pertence só a Personal."
          }
        }
      }
    },
