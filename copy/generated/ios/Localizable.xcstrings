        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arc no está instalado aquí. Si copiaste su archivo StorableSidebar.json desde otro ordenador, elígelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
