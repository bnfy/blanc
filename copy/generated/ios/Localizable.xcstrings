    "settings.privacy.adblockEnabled.hint": {
      "comment": "Settings → Privacy & Security → Blocking: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops ads and the hidden trackers that follow you from site to site. On by default."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppt Werbung und die versteckten Tracker, die dir von Website zu Website folgen. Standardmäßig an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene los anuncios y los rastreadores ocultos que te siguen de un sitio a otro. Activado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloque les publicités et les traceurs cachés qui vous suivent d’un site à l’autre. Activé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferma gli annunci e i tracker nascosti che ti seguono da un sito all’altro. Attivo per impostazione predefinita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia anúncios e os rastreadores ocultos que seguem você de site em site. Ativado por padrão."
          }
        }
      }
    },
    "settings.privacy.sitesListedHereLoad": {
      "comment": "Settings → Privacy & Security → Blocking: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
