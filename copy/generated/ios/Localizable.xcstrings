    "siteSecurity.certException.summary": {
      "comment": "Site information summary after continuing past a certificate error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You chose to continue even though this site’s certificate isn’t trusted. Blanc will warn you again after it restarts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast trotz eines nicht vertrauenswürdigen Zertifikats fortgefahren. Blanc warnt dich nach einem Neustart erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegiste continuar aunque el certificado de este sitio no es de confianza. Blanc te volverá a avisar después de reiniciarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez choisi de continuer même si le certificat de ce site n’est pas fiable. Blanc vous avertira de nouveau après son redémarrage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai scelto di continuare anche se il certificato di questo sito non è attendibile. Blanc ti avviserà di nuovo dopo il riavvio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você escolheu continuar mesmo com o certificado deste site não sendo confiável. O Blanc vai avisar de novo depois de reiniciar."
          }
        }
      }
    },
