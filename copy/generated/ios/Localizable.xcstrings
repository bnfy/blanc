    "settings.sync.setup.intro": {
      "comment": "Settings → Sync setup: introduction before a path is chosen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync your favorites and settings across your devices, and, if you choose, open tabs. Everything is end-to-end encrypted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisiere deine Favoriten und Einstellungen und auf Wunsch auch offene Tabs zwischen deinen Geräten. Alles ist Ende-zu-Ende-verschlüsselt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza tus favoritos y tus ajustes entre tus dispositivos y, si quieres, también las pestañas abiertas. Todo está cifrado de extremo a extremo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisez vos favoris et vos réglages entre vos appareils et, si vous le souhaitez, vos onglets ouverts. Tout est chiffré de bout en bout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizza preferiti e impostazioni tra i tuoi dispositivi e, se vuoi, anche le schede aperte. Tutto è crittografato end-to-end."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronize seus favoritos e configurações entre seus dispositivos e, se quiser, as abas abertas. Tudo é criptografado de ponta a ponta."
          }
        }
      }
    },
    "settings.sync.setup.joinTitle": {
