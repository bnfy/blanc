    "mahjong.live.rackFull": {
      "comment": "Mahjong: announced to screen readers.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Burst rack is full. Undo, shuffle and continue, or restart."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Burst-Ablage ist voll. Mach einen Zug rückgängig, misch und spiel weiter oder starte neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La bandeja Burst está llena. Deshaz, baraja y continúa, o reinicia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réserve Burst est pleine. Annulez, mélangez et continuez, ou recommencez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vassoio Burst è pieno. Annulla, mescola e continua, o ricomincia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A bandeja Burst está cheia. Desfaça, embaralhe e continue, ou reinicie."
          }
        }
      }
    },
    "mahjong.live.rackStillFull": {
      "comment": "Mahjong: announced to screen readers.",
