    "settings.privacy.ublockLimits": {
      "comment": "Settings → Privacy & Security → Blocking: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter lists update automatically. Executable resources update with Blanc releases; custom resource URLs and cloud storage are unavailable. Turning blocking off removes cosmetic CSS; reload a page to undo changes already made by scriptlets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Filterlisten werden automatisch aktualisiert. Ausführbare Ressourcen werden mit Blanc-Releases aktualisiert; eigene Ressourcen-URLs und Cloud-Speicher sind nicht verfügbar. Das Ausschalten des Blockers entfernt kosmetisches CSS; lade eine Seite neu, um bereits von Scriptlets vorgenommene Änderungen rückgängig zu machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las listas de filtros se actualizan automáticamente. Los recursos ejecutables se actualizan con las versiones de Blanc; las URL de recursos personalizados y el almacenamiento en la nube no están disponibles. Desactivar el bloqueo quita el CSS cosmético; recarga la página para deshacer los cambios que ya hayan hecho los scriptlets."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les listes de filtres se mettent à jour automatiquement. Les ressources exécutables sont mises à jour avec les versions de Blanc ; les URL de ressources personnalisées et le stockage cloud ne sont pas disponibles. Désactiver le blocage retire le CSS cosmétique ; rechargez une page pour annuler les modifications déjà faites par les scriptlets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elenchi di filtri si aggiornano automaticamente. Le risorse eseguibili si aggiornano con le versioni di Blanc; gli URL di risorse personalizzate e l’archiviazione cloud non sono disponibili. Disattivare il blocco rimuove il CSS cosmetico; ricarica la pagina per annullare le modifiche già fatte dagli scriptlet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As listas de filtros se atualizam automaticamente. Os recursos executáveis se atualizam com as versões do Blanc; URLs de recursos personalizados e armazenamento em nuvem não estão disponíveis. Desativar o bloqueio remove o CSS cosmético; recarregue a página para desfazer as mudanças já feitas pelos scriptlets."
          }
        }
      }
    },
    "settings.privacy.adblockEnabled.label": {
      "comment": "Settings → Privacy & Security → Blocking: setting name.",
