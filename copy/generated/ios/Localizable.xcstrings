          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzung und Daten"
          }
        }
      }
    },
    "settings.privacy.usagePing.label": {
      "comment": "Settings → Privacy & Security → Usage and data: setting name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help improve Blanc"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc verbessern helfen"
          }
        }
      }
    },
    "settings.privacy.usagePing.hint": {
      "comment": "Settings → Privacy & Security → Usage and data: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts active users and which start-page layouts and local features get used. Sends a random install and session id, app version, platform, architecture, coarse OS major, and fixed feature names; never URLs, searches, page content, or private-tab activity. This is pseudonymous measurement sent to a Blanc-owned Cloudflare collector. It stores a keyed hash of the install id; an optional Google Analytics mirror receives that hash and the same limited fields. Turn this off to stop future events."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählt aktive Nutzer und welche Startseiten-Layouts und lokalen Funktionen genutzt werden. Sendet eine zufällige Installations- und Sitzungs-ID, App-Version, Plattform, Architektur, grobe Hauptversion des Betriebssystems und feste Funktionsnamen; nie URLs, Suchen, Seiteninhalte oder Aktivitäten in privaten Tabs. Das ist eine pseudonyme Messung an einen Cloudflare-Sammler von Blanc. Er speichert einen verschlüsselten Hash der Installations-ID; ein optionaler Google-Analytics-Spiegel erhält diesen Hash und dieselben eingeschränkten Felder. Schalte dies aus, um künftige Ereignisse zu stoppen."
          }
        }
      }
    },
    "settings.privacy.resetInstallId": {
      "comment": "Settings → Privacy & Security → Usage and data: button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset install ID"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installations-ID zurücksetzen"
          }
        }
      }
    },
    "settings.privacy.removesCookiesCacheAnd": {
      "comment": "Settings → Privacy & Security → Usage and data: explanation under a setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
