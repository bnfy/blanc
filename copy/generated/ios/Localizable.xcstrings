    "newtab.startup.failedMessage": {
      "comment": "Start page → blocker startup card: explanation when the filters failed; {error} is a technical error message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc has not opened queued web pages because its ad and tracker filters are unavailable. Retry, or explicitly continue with blocking turned off. Diagnostic: %1$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc hat wartende Webseiten nicht geöffnet, weil seine Werbe- und Trackerfilter nicht verfügbar sind. Versuch es erneut oder fahre ausdrücklich ohne Blockieren fort. Diagnose: %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc no ha abierto las páginas web en cola porque sus filtros de anuncios y rastreadores no están disponibles. Reinténtalo o continúa explícitamente con el bloqueo desactivado. Diagnóstico: %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc n’a pas ouvert les pages web en attente, car ses filtres contre les publicités et les traceurs ne sont pas disponibles. Réessayez, ou continuez explicitement avec le blocage désactivé. Diagnostic : %1$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc non ha aperto le pagine web in attesa perché i suoi filtri per annunci e tracker non sono disponibili. Riprova oppure continua esplicitamente con il blocco disattivato. Diagnostica: %1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Blanc não abriu as páginas da web na fila porque os filtros de anúncios e rastreadores não estão disponíveis. Tente de novo ou continue explicitamente com o bloqueio desativado. Diagnóstico: %1$@"
          }
        }
      }
    },
