    "settings.sync.notice.offline": {
      "comment": "Settings → Sync setup: error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t reach the sync server. Check your connection and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sync-Server ist nicht erreichbar. Prüfe deine Verbindung und versuch es noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con el servidor de sincronización. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
