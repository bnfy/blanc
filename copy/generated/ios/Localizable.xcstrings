            "value": "La eliminación del perfil aún está terminando: la limpieza se reintentará automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression du profil n’est pas encore terminée : le nettoyage sera relancé automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’eliminazione del profilo non è ancora completata: la pulizia verrà ritentata automaticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A exclusão do perfil ainda está terminando: a limpeza será refeita automaticamente."
          }
        }
      }
    },
    "profile.delete.bookkeeping": {
      "comment": "Settings → Profiles message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile data was removed, but final cleanup bookkeeping will retry automatically."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Profildaten wurden entfernt, die abschließende Bereinigung wird aber automatisch wiederholt."
