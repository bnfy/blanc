    "settings.general.newtabDynamicWallpaper.syncedHint": {
      "comment": "Settings → General → Time-of-day wallpaper: explanation under the setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallpaper follows this machine’s local time. The on/off choice syncs across devices."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hintergrund folgt der Ortszeit dieses Geräts. Ob er an oder aus ist, wird zwischen deinen Geräten synchronisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El fondo sigue la hora local de este equipo. La opción de activarlo o no se sincroniza entre dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fond suit l’heure locale de cet ordinateur. Le choix activé ou désactivé est synchronisé entre les appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo sfondo segue l’ora locale di questo computer. La scelta di attivarlo o meno si sincronizza tra i dispositivi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fundo acompanha a hora local deste computador. A escolha de ativar ou não é sincronizada entre os dispositivos."
          }
        }
      }
    },
