      }
    },
    "pill.fillHint": {
      "comment": "Tooltip and accessible name of the macOS-only 1Password fill chip.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill login from 1Password (⌥⌘P)"
