    "fill.unsupportedDevice.body": {
      "comment": "Fill notice body. “Windows on Arm” is Microsoft’s name for Windows on Arm-based PCs; keep “x64” and “Arm” as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Windows on Arm, Blanc runs as an x64 app, and the Arm version of 1Password can’t connect to it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter Windows on Arm läuft Blanc als x64-App, und die Arm-Version von 1Password kann sich nicht damit verbinden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Windows on Arm, Blanc funciona como una app x64 y la versión Arm de 1Password no puede conectarse con ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur Windows on Arm, Blanc fonctionne comme une app x64, et la version Arm de 1Password ne peut pas s’y connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su Windows on Arm, Blanc funziona come app x64 e la versione Arm di 1Password non riesce a connettersi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Windows on Arm, o Blanc roda como um app x64, e a versão Arm do 1Password não consegue se conectar a ele."
          }
        }
      }
    },
