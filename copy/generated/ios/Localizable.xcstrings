    "ws.editor.help": {
      "comment": "Help text under the workspace name field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordinary tabs save automatically on this device, in this profile. Private pages are excluded. Workspaces share this profile’s sign-ins."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normale Tabs werden auf diesem Gerät in diesem Profil automatisch gespeichert. Private Seiten sind ausgenommen. Arbeitsbereiche teilen die Anmeldungen dieses Profils."
          }
        }
      }
    },
    "ws.editor.save": {
      "comment": "Button that saves the workspace name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern"
          }
        }
      }
    },
    "ws.editor.saving": {
      "comment": "The save button’s text while the workspace is being saved.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern…"
          }
        }
      }
